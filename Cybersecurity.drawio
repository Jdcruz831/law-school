        <mxCell id="classsys--nispom" edge="1" parent="1" source="classsys" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="nispom" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fisma--fismareq" edge="1" parent="1" source="fisma" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="fismareq" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cuirules--cuireq" edge="1" parent="1" source="cuirules" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="cuireq" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfars--dfarsreq" edge="1" parent="1" source="dfars" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="dfarsreq" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nispom--classreq" edge="1" parent="1" source="nispom" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="classreq" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fismareq--nist" edge="1" parent="1" source="fismareq" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="nist" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dfarsreq--cmmc" edge="1" parent="1" source="dfarsreq" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="cmmc" value="">
