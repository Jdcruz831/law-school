  <diagram id="qUQgivWHdCShQOKEDiPo" name="Ch 2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="4120" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ch2-title" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Chapter 2: Cybersecurity Litigation&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Consumers, employees and banks may sue after a breach: analyze standing → claims → class treatment, then insurance and discovery protections.&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="1260" x="1430" y="40" as="geometry" />
        </mxCell>
        <mxCell id="ch2-standing" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;1. CAN THIS PLAINTIFF SUE IN FEDERAL COURT?&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Article III requires injury, traceability, and redressability for each claim and form of relief; merits remain a separate inquiry.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="740" x="40" y="230" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Injury in Fact | Spokeo (2016)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;The plaintiff needs a concrete, personal injury that is actual or imminent; a bare statutory violation alone does not suffice.&lt;/p&gt;" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" id="ch2-injury">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="75" y="365" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-trace" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Fair Traceability&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Connect the injury to the challenged security failure; this is less demanding than proximate cause, and hackers do not automatically sever the connection.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="75" y="470" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Redressability&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;The requested remedy must likely address the plaintiff’s injury; damages and preventive relief require their own standing analysis.&lt;/p&gt;" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" id="ch2-redress">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="75" y="575" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Damages Standing | TransUnion, 594 U.S. 413 (2021)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Future risk alone is insufficient; financial loss, a qualifying disclosure injury, or a separate present harm may establish concreteness.&lt;/p&gt;" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" id="ch2-damages">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="75" y="680" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bohnak, 79 F.4th 276 (2d Cir. 2023)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Standing rested on unauthorized PII disclosure analogous to a privacy tort and, alternatively, present harms from a substantial identity-theft risk.&lt;/p&gt;" link="https://openjurist.org/79/f4th/276/bohnak-v-marsh-mclennan-companies-inc" id="ch2-bohnak">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="110" y="785" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Injunction Standing&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;A sufficiently imminent, substantial threat may support prevention, if traceability and redressability also hold; past exposure alone does not establish future need.&lt;/p&gt;" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" id="ch2-injunction">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="75" y="890" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-mitigation" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Risk and Mitigation | Clapper (2013)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Examine targeting, sensitivity, access and misuse; self-imposed spending against a speculative threat cannot manufacture standing.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="110" y="995" as="geometry" />
        </mxCell>
        <mxCell id="ch2-krottner" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Krottner, 628 F.3d 1139 (9th Cir. 2010)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;A stolen laptop with unencrypted employee PII supported a credible immediate identity-theft threat; this was not a public-posting case.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="75" y="1100" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Read Older Risk Cases Through TransUnion&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Krottner is not wholly overruled, but its risk analysis must be distinguished from current damages-standing requirements.&lt;/p&gt;" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" id="ch2-casecontext">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="110" y="1205" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-facts" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Fact Patterns, Not a Strict/Flexible Circuit Table&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Clemens (3d Cir. 2022) involved targeted theft, publication and mitigation; Beck (4th Cir. 2017) rejected a speculative chain of misuse.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="75" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="ch2-proof" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Procedure and Proof&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Rule 12(b)(1) tests jurisdiction; factual challenges may require evidence, and the plaintiff’s standing proof must match the litigation stage.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="75" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="ch2-claims" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;2. WHAT CLAIM AND RECOVERABLE HARM?&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;State law determines duties, elements, defenses and remedies; standing does not establish negligence or entitlement to damages.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="740" x="860" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ch2-negligence" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Negligence: Four Elements&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Prove a recognized duty, unreasonable breach, factual/proximate causation, and a legally compensable injury.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="365" as="geometry" />
        </mxCell>
        <mxCell id="ch2-duty" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Duty and Breach&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Foreseeability, the parties’ relationship and security standards may support reasonable-care duties; Ramirez v. Paradies Shops (11th Cir. 2023) illustrates employee-data protection.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ch2-causation" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Causation and Cognizable Harm&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Tie the specific breach to recoverable harm; AvMed (11th Cir. 2012) used matching stolen data and surrounding facts, not timing alone.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="575" as="geometry" />
        </mxCell>
        <mxCell id="ch2-econ" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Economic Loss Doctrine&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Some states restrict tort recovery for purely economic loss; independent-duty and special-relationship exceptions depend on the governing state law.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="680" as="geometry" />
        </mxCell>
        <mxCell id="ch2-misrep" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Misrepresentation or Material Omission&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Identify a material falsehood or actionable omission, required reliance and resulting harm; vague puffery depends on wording and context.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="785" as="geometry" />
        </mxCell>
        <mxCell id="ch2-fraud" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Fraudulent vs. Negligent Misrepresentation&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Fraud generally requires knowledge/recklessness and intent to induce reliance; negligent misrepresentation turns on a duty of care in supplying information.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="890" as="geometry" />
        </mxCell>
        <mxCell id="ch2-specificity" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Plead the Statement and Reliance&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Specify what was false, who said it, and how it mattered; Rule 9(b) applies to fraud, while omissions require a disclosure duty.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="995" as="geometry" />
        </mxCell>
        <mxCell id="ch2-contract" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Breach of Contract&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Identify an enforceable security obligation, breach and resulting recoverable damage; a breach incident alone does not establish broken promises.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="ch2-express" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Express Promise&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;A privacy policy must be part of the bargain and sufficiently definite; Marriott (D. Md. 2020) accepted a reasonable-safeguards promise.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="1205" as="geometry" />
        </mxCell>
        <mxCell id="ch2-implied" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Implied-in-Fact Promise&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Conduct and consideration must show mutual intent; Hannaford recognized reasonable safeguards, not an absolute guarantee against every intrusion.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="1310" as="geometry" />
        </mxCell>
        <mxCell id="ch2-beneficiary" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Intended Third-Party Beneficiary&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;An outsider must show intended, not incidental, benefit; Sovereign Bank v. BJ’s (3d Cir. 2008) allowed a bank’s contract theory to proceed.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="930" y="1415" as="geometry" />
        </mxCell>
        <mxCell id="ch2-warranty" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Warranty and Contract Limitations&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;UCC warranties concern goods; service warranties, disclaimers, liability limits and unconscionability depend on applicable law (Sony PlayStation litigation).&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="ch2-privacy" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Privacy Torts&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Publication of private facts and intentional intrusion have distinct elements; a concrete disclosure injury for standing does not itself prove either tort.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="1625" as="geometry" />
        </mxCell>
        <mxCell id="ch2-unjust" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Unjust Enrichment&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Show a knowingly retained benefit whose retention is inequitable; a governing contract may bar recovery, although alternative pleading may be allowed (AvMed).&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="ch2-udap" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;State UDAP Statutes&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Confirm a private action, covered conduct, required injury/reliance and available relief; UCL restitution/injunctions differ from statutes authorizing damages.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="895" y="1835" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CCPA: Limited Breach Action | §1798.150&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;A covered business’s unreasonable security must cause qualifying unauthorized access/exfiltration, theft or disclosure; most CCPA violations are not privately actionable.&lt;/p&gt;" link="https://openjurist.org/state-code/ca/civ/1798.150" id="ch2-ccpa">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="930" y="1940" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Covered Data and Notice&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Coverage includes specified nonencrypted/nonredacted identifiers or email-plus-login credentials; statutory-damages suits require 30-day notice, and later security improvements alone do not cure.&lt;/p&gt;" link="https://openjurist.org/state-code/ca/civ/1798.150" id="ch2-ccpadata">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="635" x="965" y="2045" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CCPA Remedies | Amounts Effective January 1, 2025&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Recover $107–$799 per consumer per incident or actual damages, whichever is greater; injunctive relief is available, and federal Article III remains separate.&lt;/p&gt;" link="https://cppa.ca.gov/regulations/cpi_adjustment.html" id="ch2-ccparemedy">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="635" x="965" y="2150" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;3. CAN THE CASE PROCEED AS A CLASS?&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Rule 23 certification is separate from standing and merits, and requires a rigorous analysis of the proposed class.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_23" id="ch2-class">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="740" x="1680" y="230" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Rule 23(a): All Four Prerequisites&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Show numerosity, commonality, typicality and adequate representatives/counsel.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_23" id="ch2-rulea">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="1715" y="365" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-common" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Common Answers | Wal-Mart v. Dukes (2011)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Shared questions must yield common answers that resolve the litigation; identify the security conduct and proof common to this class.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="1750" y="470" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Rule 23(b)(3): Damages Classes&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Common issues must predominate, and class treatment must be superior to individual litigation.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_23" id="ch2-b3">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="1715" y="575" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Individual Differences Are Not Automatically Fatal&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Assess injury, causation, reliance and state-law variations; workable proof, subclasses or issue certification may address some differences.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_23" id="ch2-variation">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="1750" y="680" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-hannaford" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Hannaford (D. Me. 2013) vs. Heartland (S.D. Tex. 2012)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Hannaford lacked adequate common damages proof; Heartland certified a settlement class, where trial manageability was not an obstacle.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="635" x="1785" y="785" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Rule 23(b)(2): Classwide Preventive Relief&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Generally applicable conduct must justify relief for the class as a whole, and the representative still needs standing for that relief.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_23" id="ch2-b2">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="1715" y="890" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Standing of Damages Recipients | TransUnion&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Every member recovering individual damages needs concrete injury; TransUnion left open whether every member must show standing before certification.&lt;/p&gt;" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" id="ch2-classinjury">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="1715" y="995" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Settlement and Review&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Rule 23(e) requires court approval; (b)(3) classes receive notice/opt-out rights, and Rule 23(f) permits discretionary review of certification.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_23" id="ch2-settlement">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="1715" y="1100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-insurance" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;4. WHO PAYS FOR THE BREACH?&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Apply the actual policy, endorsements and governing law; neither CGL nor dedicated cyber insurance guarantees complete coverage.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="740" x="2500" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ch2-firstparty" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;First-Party Cyber Coverage&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;The insured’s own response, restoration, interruption and extortion losses may be covered, subject to policy conditions and lawful payments.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="2535" y="365" as="geometry" />
        </mxCell>
        <mxCell id="ch2-thirdparty" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Third-Party Cyber Coverage&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Defense, settlements and judgments may be covered; regulatory penalties and card-network assessments require suitable coverage and legal insurability.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="2535" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ch2-cgl" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Traditional CGL: Publication and Property&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Privacy-publication language, tangible-property provisions and electronic-data exclusions produce different outcomes; hacker involvement is not a universal bar.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="2535" y="575" as="geometry" />
        </mxCell>
        <mxCell id="ch2-portal" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Travelers v. Portal Healthcare (4th Cir. 2016)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Publicly accessible medical records triggered a duty to defend under the policy’s publication language; defense and indemnity are distinct inquiries.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="2570" y="680" as="geometry" />
        </mxCell>
        <mxCell id="ch2-conditions" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Triggers, Limits and Exclusions&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Check claims/reporting deadlines, retentions, sublimits, vendor consent, business-interruption terms, contractual-liability exclusions and representations in the application.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="2535" y="785" as="geometry" />
        </mxCell>
        <mxCell id="ch2-war" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;War / State-Backed Attack Exclusions&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Attribution alone does not decide coverage; wording and jurisdiction control, including any specific cyber-war endorsement.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="2535" y="890" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Merck v. ACE (N.J. App. Div. 2023)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;The traditional hostile/warlike-action exclusion did not bar NotPetya losses under those policies; the decision did not define all cyber-war exclusions.&lt;/p&gt;" link="https://www.njcourts.gov/system/files/court-opinions/2023/a1879-21a1882-21.pdf" id="ch2-merck">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="2570" y="995" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;5. WHAT INVESTIGATION MATERIAL IS DISCOVERABLE?&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Relevant, proportional nonprivileged material is discoverable; the party withholding material must establish the particular protection.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_26" id="ch2-discovery">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="740" x="3320" y="230" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-acp" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Attorney–Client Privilege&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Protect confidential communications made for legal advice, including necessary assisting consultants; underlying facts and ordinary business advice remain distinct.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="3355" y="365" as="geometry" />
        </mxCell>
        <mxCell id="ch2-purpose" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Dual-Purpose Communications&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Apply the jurisdiction’s legal-purpose test; copying counsel, privilege labels or counsel’s retention of a vendor cannot alone protect business work.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="670" x="3390" y="470" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Work Product | Rule 26(b)(3)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Protect materials prepared by or for a party because of anticipated litigation under the applicable test; ordinary-course reports may fail that test.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_26" id="ch2-wp">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="3355" y="575" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Qualified Protection and Opinion Work&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Substantial need plus undue hardship may overcome ordinary work product; courts must protect counsel’s mental impressions and legal theories.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_26" id="ch2-need">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="3390" y="680" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Consulting Experts | Rule 26(b)(4)(D)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Litigation-retained, nontestifying experts ordinarily resist interrogatories/depositions about their knowledge and opinions, subject to exceptional circumstances.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/frcp/rule_26" id="ch2-expert">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="3355" y="785" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Target | 2015 WL 6777384 (D. Minn.)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;The court protected reviewed legal-task-force materials from a distinct legal investigation, but ordered production of business-only board updates.&lt;/p&gt;" link="https://static1.1.sqspcdn.com/static/f/1495878/26809007/1453478043243/In%2Bre%2BTarget%2BCorporation%2BCustomer%2BData%2BSecurity%2BBreach%2BLitigation.pdf" id="ch2-target">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="3355" y="890" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Dominion Dental | 429 F. Supp. 3d 190 (2019)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;An essentially unchanged incident-response scope and business uses defeated work-product protection despite counsel’s involvement.&lt;/p&gt;" link="https://www.casemine.com/judgement/us/627cf991714d585d57c92c8f" id="ch2-dominion">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="3355" y="995" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-capital" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Capital One | E.D. Va. (2020)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Mandiant’s business-response report was discoverable; a separate PwC analysis received work-product protection based on its demonstrated litigation purpose.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="3355" y="1100" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Two Tracks Can Help; Labels Do Not Decide&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Separate genuine operational and legal functions, document the legal purpose and limit dissemination; neither two reports nor two vendors guarantees protection.&lt;/p&gt;" link="https://law.justia.com/cases/federal/district-courts/district-of-columbia/dcdce/1:2019cv03195/212234/49/" id="ch2-twotrack">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="3355" y="1205" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="ch2-waiver" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Waiver and Exceptions&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Disclosure or reliance on privileged advice may waive protection; work-product waiver follows different rules, and crime-fraud can defeat privilege.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="705" x="3355" y="1310" as="geometry" />
        </mxCell>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FRE 502(d): Nonwaiver Orders&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;A federal order can prevent waiver through litigation disclosures, but cannot make otherwise unprotected material privileged.&lt;/p&gt;" link="https://www.law.cornell.edu/rules/fre/rule_502" id="ch2-502">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="670" x="3390" y="1415" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;SEC v. Covington &amp;amp; Burling | D.D.C., July 24, 2023&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px 8px;&quot;&gt;Client names were generally unprivileged absent revelation of legal communications; the court narrowed compelled disclosure to seven clients.&lt;/p&gt;" link="https://app.midpage.ai/document/securities-and-exchange-commission-v-1000366225565" id="ch2-covington">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;" vertex="1">
            <mxGeometry height="90" width="705" x="3355" y="1520" as="geometry" />
          </mxCell>
        </UserObject>
