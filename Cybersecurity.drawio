        <mxCell id="RG5dxqq2be1gqHxqXK9y-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Chapter 4:&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Corporate Governance Authorities&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="100" y="-340" as="geometry" />
        </mxCell>
        <mxCell id="AokDBw-c1ePKC33Lrl_w-2" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-4" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="AokDBw-c1ePKC33Lrl_w-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-2" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-4" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hJjpbS0wt0D_eDkoki05-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RG5dxqq2be1gqHxqXK9y-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;SEC Securities Regulations&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Form 10-K&lt;/b&gt;: Annual Governance and Risk Strategy Disclosures&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Form 8-K:&lt;/b&gt; Material Incident Disclosure Rule&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Rule 10b-5:&lt;/b&gt; Securities Fraud and Material Misrepresentations&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="-1240" y="320" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-8" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hJjpbS0wt0D_eDkoki05-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-10" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hJjpbS0wt0D_eDkoki05-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-12" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hJjpbS0wt0D_eDkoki05-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-3" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-6" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0XxI8YbMeLsKgxDe8oOH-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RG5dxqq2be1gqHxqXK9y-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;State Corporate Law &amp;amp; Fiduciary Duties&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;I. The Fiduciary Framework: Care and Loyalty&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;II. The Business Judgment Rule (BJR)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;III. The Caremark Oversight Standard&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;IV. Corporate Waste and Pleading Standards&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="-270" y="300" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-10" edge="1" parent="1" source="RG5dxqq2be1gqHxqXK9y-8" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0XxI8YbMeLsKgxDe8oOH-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RG5dxqq2be1gqHxqXK9y-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CFIUS Authority&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;50 U.S.C. § 4565&lt;/b&gt;: Grants the President and CFIUS the authority to review &quot;covered transactions&quot; to determine their effect on the national security of the United States.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Jurisdictional Reach&lt;/b&gt;: Jurisdiction extends to any transaction that could result in foreign control of a U.S. business, particularly those involving &quot;TID&quot; (Technology, Infrastructure, and Data) businesses.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="730" y="340" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-6" edge="1" parent="1" source="AokDBw-c1ePKC33Lrl_w-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0XxI8YbMeLsKgxDe8oOH-1" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-862.5" y="1070" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="AokDBw-c1ePKC33Lrl_w-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Form 8-K: Material Incident Disclosure Rule&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A. The &quot;4-Business-Day&quot; Trigger:** Public companies are required to disclose any cybersecurity incident determined to be &quot;material&quot; within four business days.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;B. &lt;b&gt;Materiality Determination Time Standard&lt;/b&gt;: The obligation to file is not triggered by the discovery of the incident itself, but by the determination of its materiality. This determination must be made **without unreasonable delay** following the discovery of the event.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;C. &lt;b&gt;Required Disclosure Contents&lt;/b&gt;: Issuers must describe the material aspects of the incident’s nature, scope, and timing, as well as the material impact (or reasonably likely material impact) on the company’s financial condition and results of operations.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;D. &lt;b&gt;Technical Disclosure Exceptions:&lt;/b&gt;&amp;nbsp;Disclosure may be delayed only if the U.S. Attorney General determines that the notification poses a substantial risk to national security or public safety. This exception is narrowly construed and requires formal coordination with the Department of Justice.&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="450" x="-1200" y="660" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Form 10-K: Annual Governance and Risk Strategy Disclosures&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;A. Risk Management and Strategy:&amp;nbsp;&lt;/b&gt;Under the 2023 revisions, companies must describe their processes for assessing, identifying, and managing material risks from cybersecurity threats. This includes whether these processes are integrated into the overall risk management system and whether the company engages assessors or consultants.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;B. Board and Management Governance&lt;/b&gt;: Issuers must detail the board’s oversight of cybersecurity risks and management’s role in assessing and managing such threats. This mandates a high degree of specificity regarding which board committees are responsible for oversight and the relevant expertise of the management-level personnel involved.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="420" x="-1700" y="660" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;I. The Fiduciary Framework: Care and Loyalty&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Title 8 of the Delaware Code&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;A. Duty of Care&lt;/b&gt;: Requires directors to be adequately informed and to act with the care an ordinarily prudent person would exercise. In cyber governance, this involves overseeing the implementation of risk management systems.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;B. Duty of Loyalty&lt;/b&gt;: Requires directors to act in the best interests of the corporation. A conscious disregard for known risks (bad faith) constitutes a breach of the duty of loyalty.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="420" x="-710" y="600" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;II. The Business Judgment Rule (BJR) (Affirmative B&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;usiness Decision)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;A. Presumption of Validity&lt;/b&gt;: The BJR is a presumption that in making a business decision, the directors acted on an informed basis, in good faith, and in the honest belief that the action taken was in the best interests of the company.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;B. Rebutting the Presumption&lt;/b&gt;: To overcome the BJR in the wake of a data breach, plaintiffs must prove that the board’s decision-making process was grossly negligent, lacked a rational business purpose, or involved a conflict of interest.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="-450" y="840" as="geometry" />
        </mxCell>
        <mxCell id="hJjpbS0wt0D_eDkoki05-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;III. The Caremark Oversight Standard (&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;inaction or a complete failure to monitor)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;A. The &quot;Sustained or Systemic Failure&quot; Test:&lt;/b&gt; Under &lt;i&gt;Caremark&lt;/i&gt;, directors may be held liable for a failure of oversight only if:&lt;br&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: medium; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. The directors utterly failed to implement any reporting or information system or controls; or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Having implemented such a system or controls, the directors consciously failed to monitor or oversee its operations, thus disabling themselves from being informed of risks.&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;B. Mission-Critical Application&lt;/b&gt;: Modern courts apply this standard strictly to &quot;mission-critical&quot; risks like data security, where the board must ensure a &quot;bottom-up&quot; flow of information regarding cyber threats.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="420" x="20" y="830" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Rule 10b-5: M&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;ateriality Standard&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Yahoo&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The materiality of a breach is evaluated based on whether there is a &lt;u&gt;substantial likelihood that a reasonable investor would consider the information important&lt;/u&gt; in making an investment decision.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Inadequate disclosure creates an evidentiary basis for federal securities fraud, moving the legal battle from technical negligence to the realm of intentional or reckless deception&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="450" x="-1050" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;IV. Corporate Waste and Pleading Standards&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;A. Corporate Waste Legal Test:&lt;/b&gt; This is an extremely high threshold requiring proof that the board’s expenditure on cybersecurity (or a breach settlement) was so one-sided that no person of ordinary sound business judgment could believe the corporation received adequate consideration.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;B. Pleading Standards and Litigation Lessons&lt;/b&gt;:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Wyndham&lt;/i&gt;: Established that a company’s status as a victim of a criminal hack does not immunize it from liability if the conduct (e.g., storing data in clear text) made the harm foreseeable.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Home Depot / Zendesk / Marriott&lt;/i&gt;: These cases collectively illustrate the difficulty of pleading a *Caremark* claim. To survive a motion to dismiss, plaintiffs must plead with particularity that the board was &quot;on notice&quot; of specific &quot;red flags&quot; (such as repeated audit warnings or previous minor breaches) and deliberately chose to ignore them. Without evidence of such conscious disregard, most derivative suits fail for lack of standing or failure to rebut the BJR.&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="460" x="50" y="515" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Cybersecurity Mitigation Plans&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;31 C.F.R. § 800.402&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;CFIUS may condition deal approval on mandatory mitigation agreements. Required components often include:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: medium; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. Mandatory data security safeguards and the localization of sensitive data.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Requirement for periodic independent security audits conducted by third-party monitors.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. Granting U.S. government agencies the right to oversee and inspect the company&#39;s information security systems&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="170" width="540" x="610" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;3. 2022 Executive Order Evaluation Criteria&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Focus on Sensitive Data&lt;/b&gt;: The 2022 Order directs CFIUS to prioritize the protection of &quot;U.S. person data&quot; and the resilience of &quot;critical infrastructure.&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Adversarial Access&lt;/b&gt;: Evaluation now includes whether a transaction allows a foreign person or a third party to gain access to sensitive datasets that could be used for malicious cyber activities or intelligence gathering.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;The &quot;So What?&quot;&lt;/b&gt;: For foreign investors, cybersecurity is now a primary determinant of deal viability. A target&#39;s poor security posture is not just a financial liability to be negotiated; it is a regulatory &quot;deal-killer&quot; that can lead to a permanent block or forced divestiture.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="430" x="1210" y="890" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-14" edge="1" parent="1" source="0XxI8YbMeLsKgxDe8oOH-11" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="0XxI8YbMeLsKgxDe8oOH-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-16" edge="1" parent="1" source="0XxI8YbMeLsKgxDe8oOH-11" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0XxI8YbMeLsKgxDe8oOH-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-17" edge="1" parent="1" source="0XxI8YbMeLsKgxDe8oOH-11" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="0XxI8YbMeLsKgxDe8oOH-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-20" edge="1" parent="1" source="0XxI8YbMeLsKgxDe8oOH-11" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="0XxI8YbMeLsKgxDe8oOH-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;CFIUS Evaluation&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. Mandatory Cybersecurity Plan Requirement&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp; &amp;nbsp; - Standard Practical Assessment Factors&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Industry &amp;amp;amp; Risk Factors That Trigger Heightened Scrutiny&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. President Biden&#39;s 2022 Executive Order Criteria&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;*CFIUS conducts much of its review proceedings in confidence without publishing public investigation findings&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="350" x="630" y="640" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;1. Mandatory Cybersecurity Plan Requirement&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Access and Authorization Procedures&lt;/b&gt;: How network access is authenticated and restricted.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Technical Safeguards&lt;/b&gt;; Defensive Infrastructure: Protective measures shielding data networks.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Internal Security Organization&lt;/b&gt;: Governance, CISO/security team oversight, and administrative structures.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Incident Response Plans&lt;/b&gt;: Operational protocols for detecting, containing, and remediating cyber breaches.&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="350" x="1270" y="450" as="geometry" />
        </mxCell>
        <mxCell id="0XxI8YbMeLsKgxDe8oOH-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;2. Industry &amp;amp;amp; Risk Factors That Trigger Heightened Scrutiny&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Critical Infrastructure&lt;/b&gt;: Operators of telecommunications/cellular carriers, electric utilities, or smart grids&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;National Security&lt;/b&gt;; Defense: Companies with direct relationships to defense contracting or military support&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Critical Technologies&lt;/b&gt;: Research, development, or production of technologies where the U.S. is a leading global producer&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;High-Risk Vendor Equipment&lt;/b&gt;: Transaction structures or supply chains that rely on foreign hardware or software with known national security concerns (e.g., equipment from Huawei or ZTE)&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="460" x="1260" y="660" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-4" edge="1" parent="1" source="qdzHJBSUSSVVZZFoA0rX-1" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="qdzHJBSUSSVVZZFoA0rX-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-6" edge="1" parent="1" source="qdzHJBSUSSVVZZFoA0rX-1" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="qdzHJBSUSSVVZZFoA0rX-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-8" edge="1" parent="1" source="qdzHJBSUSSVVZZFoA0rX-1" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="qdzHJBSUSSVVZZFoA0rX-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;ABA Formal Opinion 483&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;I. ABA Formal Opinion 483: Ethical Duties Post-Breach&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;II. Common-Law Professional Negligence&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;III. Industry Precedents and Regulatory Stakes&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="2125" y="280" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;I. ABA Formal Opinion 483: Ethical Duties Post-Breach&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;This opinion provides a structured 5-part duty framework for attorneys:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;Monitoring: Lawyers must take reasonable steps to monitor for data breaches (e.g., implementing intrusion detection).&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Assessment: Upon discovering an incident, the firm must promptly investigate its nature and scope to determine if client data was compromised.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3). Notification: Attorneys have an ethical duty to notify *current* clients if their information was subject to a material breach.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Stopping the Breach: The firm must act immediately to stop the unauthorized access.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5) Post-Breach Communication: Attorneys must keep clients reasonably informed about the status of the breach and the integrity of their data.&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="420" x="1770" y="530" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;II. Common-Law Professional Negligence&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A. &lt;b&gt;Duty of Care&lt;/b&gt;: A law firm owes a common-law duty to its clients to act with the degree of care and skill reasonably expected of members of the legal profession.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;B. &lt;b&gt;Standard of Practice&lt;/b&gt;: Failing to meet industry-standard benchmarks—such as multi-factor authentication or encryption of sensitive work product—may constitute professional negligence, leading to malpractice liability for lost trade secrets.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="1950" y="870" as="geometry" />
        </mxCell>
        <mxCell id="qdzHJBSUSSVVZZFoA0rX-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;III. Industry Precedents and Regulatory Stakes&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A. &lt;b&gt;Hiscox v. Warden Grier Holding:&lt;/b&gt; This precedent underscores the financial and professional consequences of failing to meet cybersecurity benchmarks. It establishes that firms can be held liable for the costs of a breach if their security fails to align with the benchmarks promised in client engagement letters or industry standards.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;B. &lt;b&gt;SEC v. Covington; Burling&lt;/b&gt;: This case highlights that the attorney-client privilege does not provide a blanket shield against regulatory subpoenas following a breach. The SEC may successfully compel firms to disclose the identities of clients whose data was potentially accessed during a cyberattack, emphasizing that the firm&#39;s security failure can expose its clients to unwanted regulatory scrutiny.&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="420" x="2370" y="550" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="TgPBiHlZEYdaZI4smNWG" name="Ch. 8">
