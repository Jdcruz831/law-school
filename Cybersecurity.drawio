        <mxCell id="WX6wBkluUK8sDe5oUTeB-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Chapter 8: Federal Government Contractor Authorities&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="-250" y="460" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-13" edge="1" parent="1" source="WX6wBkluUK8sDe5oUTeB-7" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="WX6wBkluUK8sDe5oUTeB-8" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-458.39080459770094" y="1389.9999999999998" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FISMA&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;44 U.S.C. § 3552&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Applies to&lt;/b&gt;: Federal agencies &amp;amp; companies that:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) hold federal government contracts&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) &lt;/span&gt;operate federal systems&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3) &lt;/span&gt;or process federal data&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a) &lt;/span&gt;Controlled Unclassified Information (CUI)&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;or&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b) &lt;/span&gt; Covered Defense Information (CDI) &lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Non-Technical&amp;nbsp;Program Requirements&lt;/i&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Periodic risk assessments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Policies and procedures: that are directly informed by those risk assessments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Subordinate plans: for information security&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Security awareness training: &amp;nbsp;for all agency employees and third-party contractors&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5)&amp;nbsp;Annual testing and evaluation&amp;nbsp;of information security policies, procedures, and controls&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(6) Remedial action plans: to correct identified security vulnerabilities and flaws&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(7) Security incident detection, reporting, and response procedures&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(8) Continuity of operations plans: &amp;nbsp;for agency information systems&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Department of Homeland Security&lt;/b&gt;:&amp;nbsp;Responsible for operational monitoring, centralized incident reporting, and providing technical assistance across civilian agencies&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;NIST&lt;/b&gt;: Technical Standards&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;OMB (Office of Management and Budget): Standardizing,&amp;nbsp;reviewing and standardizing federal procurement contracts to enforce incident reporting&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="430" width="590" x="-1200" y="780" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-15" edge="1" parent="1" source="WX6wBkluUK8sDe5oUTeB-8" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="WX6wBkluUK8sDe5oUTeB-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NIST Frameworks&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;FIPS 200’s Security Control Families: 17 total&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;NIST SP 800-53: Categorize as&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) &lt;b&gt;L&lt;/b&gt;&lt;/span&gt;&lt;b&gt;ow&lt;/b&gt; :&amp;nbsp;Compromise would have a limited adverse effect.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) &lt;b&gt;M&lt;/b&gt;&lt;/span&gt;&lt;b&gt;edium&lt;/b&gt;:&amp;nbsp;Compromise would have a serious adverse effect.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3) &lt;b&gt;H&lt;/b&gt;&lt;/span&gt;&lt;b&gt;igh&lt;/b&gt;:&amp;nbsp;Compromise would have a severe or catastrophic effect (e.g., threat to human life, critical infrastructure, or major economic collapse).&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="-1275" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NISPOM (32 C.F.R. § 117.18)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="20" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;DFARS 252.204-7012&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="410" y="750" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CMMC 2.0&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="-350" y="840" as="geometry" />
        </mxCell>
        <mxCell id="WX6wBkluUK8sDe5oUTeB-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;17 &amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;FIPS 200’s Security Control Families&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Access control&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Awareness &amp;amp; Training&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Audit &amp;amp; Accountability&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) certification, accreditation, and security assessments&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5) configuration management&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(6) contingency planning&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(7) Identification &amp;amp; authentication&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(8) Incident Report&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(9) Maintenance&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(10) Media protection&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(11) Physical &amp;amp; environmental protection&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(12) Planning&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(13) Personnel security&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(14) risk assessment&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(15) System &amp;amp; Service accusation&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(16) System and communications protection&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(17) System and info integrity&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="290" width="460" x="-980" y="1650" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Chat Ch.8" id="3vry4I1lq9k9cEGshzgk"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="3070" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="title" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Chapter 8: Federal Government Contractor Authorities&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;Kosseff, &lt;i&gt;Cybersecurity Law&lt;/i&gt;, fourth edition (2026).&lt;br&gt;&lt;br&gt;Chapter §§8.1–8.4: federal systems, classified information, and controlled unclassified information.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;PDF viewer pp. 536–558&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="40" width="600" height="120" />
    </mxCell>
    <mxCell id="start" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Applicability: information + system + contract&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;The regimes can overlap. A federal contract alone does not make every company system a federal system. Identify the data, the system’s function, and the incorporated requirements.&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="190" width="600" height="140" />
    </mxCell>
    <mxCell id="fisma" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FISMA — Federal Agency Systems&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;FISMA:&lt;/b&gt; 2002 framework, modernized in 2014. Covers agency information and systems, including systems a contractor operates &lt;b&gt;on behalf of an agency&lt;/b&gt;. Agency duties reach contractors through applicable requirements and contracts.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.1 • PDF pp. 537–539 • 44 U.S.C. §§3553–3554&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="420" width="600" height="190" />
    </mxCell>
    <mxCell id="classified" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NISPOM — Classified Information&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;NISPOM:&lt;/b&gt; heightened rules for contractor systems handling classified information. Codified in 2021 at &lt;b&gt;32 C.F.R. part 117&lt;/b&gt;; information-system duties are in §117.18. CUI is unclassified and follows a separate route.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.3 • PDF p. 546&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="420" width="600" height="190" />
    </mxCell>
    <mxCell id="cui" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CUI / Covered Defense Information&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;Unclassified does not mean unrestricted.&lt;/b&gt; CUI has safeguarding or dissemination controls rooted in law, regulation, or government-wide policy. For contractor-owned systems, identify the applicable agreement or contract clause.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 547–548 • E.O. 13556; 32 C.F.R. part 2002&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="1440" y="420" width="600" height="190" />
    </mxCell>
    <mxCell id="roles" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FISMA: Agency Responsibilities&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;Agency head:&lt;/b&gt; risk-proportionate protection, accountable personnel, trained staff, senior-official risk assessments and control testing, CIO delegation, and annual effectiveness reporting.&lt;br&gt;&lt;br&gt;&lt;b&gt;OMB:&lt;/b&gt; government-wide policy and oversight; coordinates standards with NIST.&lt;br&gt;&lt;b&gt;DHS:&lt;/b&gt; civilian-agency monitoring, incident-reporting requirements, risk mitigation, operational and technical assistance.&lt;br&gt;&lt;b&gt;NIST:&lt;/b&gt; technical standards and security guidance.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.1 • PDF pp. 537–539&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="670" width="600" height="220" />
    </mxCell>
    <mxCell id="program" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FISMA: Eight Program Requirements&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Periodic risk assessments&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Policies and procedures grounded in those assessments&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Subordinate security plans for systems, facilities, and networks&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Security awareness training, including contractors&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Testing and evaluation at least annually&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Documented remedial action for deficiencies&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Incident detection, reporting, and response&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; Continuity-of-operations plans&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.1 • PDF pp. 538–539 • 44 U.S.C. §3554(b)&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="950" width="600" height="220" />
    </mxCell>
    <UserObject id="standards" label="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NIST Frameworks: FIPS 199 → FIPS 200 → SP 800-53&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;FIPS 199:&lt;/b&gt; categorize confidentiality, integrity, and availability impact: &lt;b&gt;Low&lt;/b&gt; = limited; &lt;b&gt;Moderate&lt;/b&gt; = serious; &lt;b&gt;High&lt;/b&gt; = severe or catastrophic harm.&lt;br&gt;&lt;br&gt;&lt;b&gt;FIPS 200:&lt;/b&gt; 17 minimum security requirement areas.&lt;br&gt;&lt;b&gt;SP 800-53:&lt;/b&gt; detailed control catalog used to implement safeguards. Choose and tailor controls to system risk; the current baseline companion is &lt;b&gt;SP 800-53B&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Impact categorization is not a classification level. “High impact” does not itself mean classified. See the FIPS 200 requirement boxes below.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.2 • PDF pp. 539–546 • FIPS 199 clarification; current 800-53B reference&lt;/i&gt;&lt;/p&gt;" link="https://csrc.nist.gov/pubs/fips/199/final">
      <mxCell parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
        <mxGeometry as="geometry" x="40" y="1230" width="600" height="220" />
      </mxCell>
    </UserObject>
    <mxCell id="nispom" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NISPOM: Contractor Security Program&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;Maintain a security program covering risk reduction, data-spill/compromise response, training, insider threats, continuous threat evaluation, configuration management, and user awareness.&lt;br&gt;&lt;br&gt;Certify appropriate controls to the government; appoint a qualified employee &lt;b&gt;Information System Security Manager (ISSM)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Users must follow the program, protect credentials, avoid credential sharing, and remain accountable for their activity. Security must extend across the system life cycle.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.3 • PDF p. 546 • 32 C.F.R. §117.18&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="670" width="600" height="220" />
    </mxCell>
    <UserObject id="rmf" label="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NISPOM: Risk Management &amp; Authorization&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;The chapter calls for a risk management framework that implements, tests, validates, and obtains approval of selected controls.&lt;br&gt;&lt;br&gt;&lt;b&gt;Regulatory detail:&lt;/b&gt; Prepare → Categorize → Select → Implement → Assess → Authorize → Monitor.&lt;br&gt;The cognizant security agency must authorize the system &lt;b&gt;before&lt;/b&gt; it processes classified information. Monitoring and corrective action continue afterward.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;Textbook §8.3 + §117.18(d)–(e) clarification&lt;/i&gt;&lt;/p&gt;" link="https://www.ecfr.gov/current/title-32/subtitle-A/chapter-I/subchapter-D/part-117/section-117.18">
      <mxCell parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
        <mxGeometry as="geometry" x="740" y="950" width="600" height="220" />
      </mxCell>
    </UserObject>
    <mxCell id="cmmcbook" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CMMC 2.0 — Textbook Account&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;Textbook account (§8.4):&lt;/b&gt; the initial 2020 model had five levels; the revised model uses &lt;b&gt;Foundational, Advanced, Expert&lt;/b&gt;. Contracts specify the required level.&lt;br&gt;&lt;br&gt;Foundational: annual self-assessment.&lt;br&gt;Advanced: described as triennial third-party assessments plus annual self-assessments.&lt;br&gt;Expert: triennial government assessment; enhanced SP 800-172 protections address advanced threats.&lt;br&gt;&lt;br&gt;&lt;b&gt;Read with the dated update below:&lt;/b&gt; the book’s assessment shorthand and rollout timing need qualification.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 556–557 • This box reports the textbook, not current rollout policy.&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="1230" width="600" height="220" />
    </mxCell>
    <mxCell id="cdi" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CUI / CDI: Definitions and Contract Nexus&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;NARA&lt;/b&gt; implements the executive-branch CUI program and maintains the CUI Registry.&lt;br&gt;&lt;br&gt;&lt;b&gt;CDI&lt;/b&gt; is qualifying controlled technical or other registry information requiring protection, plus a contract nexus: it is &lt;b&gt;(1)&lt;/b&gt; identified in the contract/order and furnished by or for DoD, or &lt;b&gt;(2)&lt;/b&gt; collected, developed, received, used, stored, or transmitted by/for the contractor in contract performance.&lt;br&gt;&lt;br&gt;The category is broad, but not every company record or every defense contract automatically constitutes CDI.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 547–548 • DFARS 252.204-7012(a)&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="1440" y="670" width="600" height="220" />
    </mxCell>
    <UserObject id="report" label="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;DFARS 252.204-7012: Safeguarding &amp; Reporting&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;Chapter’s two anchors:&lt;/b&gt; adequate safeguards and reporting to DoD &lt;b&gt;within 72 hours of discovery&lt;/b&gt;.&lt;br&gt;&lt;br&gt;A cyber incident includes compromise or an actual/potential adverse effect; a confirmed data theft is not required. The clause ties reporting to affected covered systems/CDI or designated operationally critical support.&lt;br&gt;&lt;br&gt;&lt;b&gt;System distinction:&lt;/b&gt; an IT service/system operated on the government’s behalf follows its contract security requirements; other covered contractor systems use SP 800-171 under the clause.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF p. 548; clause (b)–(c) scope clarification&lt;/i&gt;&lt;/p&gt;" link="https://www.acquisition.gov/dfars/252.204-7012-safeguarding-covered-defense-information-and-cyber-incident-reporting.">
      <mxCell parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
        <mxGeometry as="geometry" x="1440" y="950" width="600" height="220" />
      </mxCell>
    </UserObject>
    <UserObject id="171" label="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;NIST SP 800-171 Revision 2&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;The chapter expressly uses &lt;b&gt;Revision 2&lt;/b&gt;, the contractor baseline it identifies as of early 2025: &lt;b&gt;110 requirements in 14 families&lt;/b&gt;.&lt;br&gt;&lt;br&gt;These requirements are tailored from the SP 800-53 moderate baseline for CUI in &lt;b&gt;nonfederal systems&lt;/b&gt;. This is not wholesale adoption of every 800-53 moderate control.&lt;br&gt;&lt;br&gt;Safeguards reach components that handle CUI and those that protect them. The legal duty comes from the applicable regulation, contract, or agreement—not merely publication of a NIST document. See the SP 800-171 requirement boxes below.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 548–556 • NIST Rev. 2 scope clarification&lt;/i&gt;&lt;/p&gt;" link="https://csrc.nist.gov/pubs/sp/800/171/r2/upd1/final">
      <mxCell parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
        <mxGeometry as="geometry" x="1440" y="1230" width="600" height="220" />
      </mxCell>
    </UserObject>
    <mxCell id="fips1" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FIPS 200: 17 Minimum Requirement Areas (1–6)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;01  Access control&lt;/b&gt;&lt;br&gt;Authorize users, processes, and devices; manage accounts; least privilege and separation of duties; limit sessions, remote/wireless/mobile access, external systems, and public content.&lt;br&gt;&lt;br&gt;&lt;b&gt;02  Awareness &amp; training&lt;/b&gt;&lt;br&gt;Train managers and users on risks and responsibilities. Provide role-specific instruction, keep training records, and maintain security-community contacts.&lt;br&gt;&lt;br&gt;&lt;b&gt;03  Audit &amp; accountability&lt;/b&gt;&lt;br&gt;Create protected audit records traceable to users. Review events, synchronize timestamps, manage log capacity/failures, and support investigation and nonrepudiation.&lt;br&gt;&lt;br&gt;&lt;b&gt;04  Certification, accreditation &amp; security assessments&lt;/b&gt;&lt;br&gt;Assess control effectiveness and correct deficiencies. Examples: security assessments, interconnections, certification, continuous monitoring, and penetration testing. This is FIPS 200’s legacy label.&lt;br&gt;&lt;br&gt;&lt;b&gt;05  Configuration management&lt;/b&gt;&lt;br&gt;Maintain hardware/software/firmware inventories and secure baselines. Control changes; assess security effects; restrict software and unnecessary functions.&lt;br&gt;&lt;br&gt;&lt;b&gt;06  Contingency planning&lt;/b&gt;&lt;br&gt;Plan and test continuity during emergencies. Train personnel; maintain backups and alternate storage to sustain and recover operations.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.2 • PDF pp. 539–546&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="1520" width="600" height="410" />
    </mxCell>
    <mxCell id="fips2" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FIPS 200: Minimum Requirement Areas (7–12)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;07  Identification &amp; authentication&lt;/b&gt;&lt;br&gt;Identify and authenticate organizational users, devices, and services before access. Manage identifiers and authentication mechanisms.&lt;br&gt;&lt;br&gt;&lt;b&gt;08  Incident response&lt;/b&gt;&lt;br&gt;Prepare to detect, contain, respond to, and report incidents. Train and test responders; handle, monitor, document, and communicate incidents.&lt;br&gt;&lt;br&gt;&lt;b&gt;09  Maintenance&lt;/b&gt;&lt;br&gt;Maintain systems and security controls on time. Control maintenance tools and the personnel who use them.&lt;br&gt;&lt;br&gt;&lt;b&gt;10  Media protection&lt;/b&gt;&lt;br&gt;Restrict media access and use; securely store media; sanitize before disposal or reuse; control media downgrading.&lt;br&gt;&lt;br&gt;&lt;b&gt;11  Physical &amp; environmental protection&lt;/b&gt;&lt;br&gt;Authorize and monitor physical access, record visitors, and protect against power loss, fire, water, temperature, and humidity hazards.&lt;br&gt;&lt;br&gt;&lt;b&gt;12  Planning&lt;/b&gt;&lt;br&gt;Document system safeguards and user rules of behavior. Include system security plans, privacy impact assessment, and coordinated management.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.2 • PDF pp. 539–546&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="1960" width="600" height="400" />
    </mxCell>
    <mxCell id="fips3" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;FIPS 200: Minimum Requirement Areas (13–17)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;13  Personnel security&lt;/b&gt;&lt;br&gt;Screen personnel and service providers; use access agreements. Protect systems during transfers/termination and sanction violations.&lt;br&gt;&lt;br&gt;&lt;b&gt;14  Risk assessment&lt;/b&gt;&lt;br&gt;Periodically assess risk to operations, assets, and people. Categorize security impact and scan for vulnerabilities; consider technical-surveillance threats.&lt;br&gt;&lt;br&gt;&lt;b&gt;15  System &amp; services acquisition&lt;/b&gt;&lt;br&gt;Budget for security throughout development and procurement. Control software installation; require supplier safeguards; address developer configuration and tamper resistance.&lt;br&gt;&lt;br&gt;&lt;b&gt;16  System &amp; communications protection&lt;/b&gt;&lt;br&gt;Protect external and key internal boundaries. Use secure architecture, isolation, denial-of-service defenses, transmission protection, key management, and session authenticity.&lt;br&gt;&lt;br&gt;&lt;b&gt;17  System &amp; information integrity&lt;/b&gt;&lt;br&gt;Find, report, and correct flaws. Defend against malicious code, monitor systems and alerts, protect software/firmware integrity, and prevent predictable failures.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.2 • PDF pp. 539–546&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="2400" width="600" height="350" />
    </mxCell>
    <mxCell id="req1" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;SP 800-171: 14 Security Requirement Families (1–4)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;01  Access control&lt;/b&gt;&lt;br&gt;Allow only authorized users, devices, transactions, and CUI flows. Separate duties; minimize privilege; use ordinary accounts for ordinary work. Limit failed logins, lock/terminate sessions, and display notices. Control and encrypt remote/wireless access; authorize mobile connections and encrypt mobile CUI. Limit external systems, removable storage, and public-system CUI.&lt;br&gt;&lt;br&gt;&lt;b&gt;02  Awareness &amp; training&lt;/b&gt;&lt;br&gt;Teach managers, administrators, and users the risks, policies, and procedures tied to their work. Train personnel for assigned security duties. Include recognition and reporting of potential insider threats.&lt;br&gt;&lt;br&gt;&lt;b&gt;03  Audit &amp; accountability&lt;/b&gt;&lt;br&gt;Retain logs sufficient to detect and investigate activity and trace it to individual users. Review audited events, alert on logging failures, correlate records, and generate reports. Synchronize clocks, protect audit information, and limit log administration to designated privileged users.&lt;br&gt;&lt;br&gt;&lt;b&gt;04  Configuration management&lt;/b&gt;&lt;br&gt;Maintain inventories and secure baselines throughout the life cycle. Approve, record, and assess changes; control physical/logical access to change functions. Enable only essential functions; disable unnecessary services and ports. Restrict unauthorized software and monitor user-installed programs.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 549–556&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="1520" width="600" height="410" />
    </mxCell>
    <mxCell id="req2" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;SP 800-171: Security Requirement Families (5–8)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;05  Identification &amp; authentication&lt;/b&gt;&lt;br&gt;Identify and authenticate users, processes, and devices. Use multifactor authentication for privileged local/network access; Rev. 2 also covers network access to nonprivileged accounts. Control identifier reuse/inactivity, password complexity and reuse, temporary passwords, protected password representations, and obscured login feedback.&lt;br&gt;&lt;br&gt;&lt;b&gt;06  Incident response&lt;/b&gt;&lt;br&gt;Maintain preparation, detection, analysis, containment, recovery, and user-response capabilities. Track and document incidents, report to appropriate internal/external authorities, and test response capability. The 72-hour DoD deadline comes from the clause, not this family alone.&lt;br&gt;&lt;br&gt;&lt;b&gt;07  Maintenance&lt;/b&gt;&lt;br&gt;Control maintenance tools, techniques, mechanisms, and personnel. Sanitize equipment sent off site; check diagnostic media for malicious code. Use MFA for remote maintenance and close sessions afterward. Supervise maintenance personnel lacking authorization.&lt;br&gt;&lt;br&gt;&lt;b&gt;08  Media protection&lt;/b&gt;&lt;br&gt;Physically protect paper and digital CUI; restrict access, mark media, and track transport. Sanitize or destroy before reuse/disposal. Encrypt transported digital CUI unless otherwise physically protected. Control removable media; prohibit ownerless portable storage; protect backup confidentiality.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 549–556&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="1440" y="1520" width="600" height="410" />
    </mxCell>
    <mxCell id="req3" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;SP 800-171: Security Requirement Families (9–12)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;09  Personnel security&lt;/b&gt;&lt;br&gt;Screen individuals before granting access to CUI systems. Protect those systems during and after terminations, transfers, and other personnel changes.&lt;br&gt;&lt;br&gt;&lt;b&gt;10  Physical protection&lt;/b&gt;&lt;br&gt;Limit access to systems, equipment, and operating environments. Protect and monitor facilities and supporting infrastructure. Escort visitors, retain physical-access logs, and manage access devices. Safeguard CUI at alternate workplaces, including telework sites.&lt;br&gt;&lt;br&gt;&lt;b&gt;11  Risk assessment&lt;/b&gt;&lt;br&gt;Periodically evaluate risks to operations, assets, and individuals from systems processing, storing, or transmitting CUI. Scan systems and applications periodically and when relevant new vulnerabilities appear. Prioritize remediation using the risk assessment.&lt;br&gt;&lt;br&gt;&lt;b&gt;12  Security assessment&lt;/b&gt;&lt;br&gt;Periodically test safeguard effectiveness; develop corrective action plans; monitor controls continuously. Rev. 2 also requires a system security plan describing boundaries, environment, implementation, and connections (§3.12.4)—a detail omitted from the chapter’s shortened list.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 549–556&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="740" y="1960" width="600" height="400" />
    </mxCell>
    <mxCell id="req4" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;SP 800-171: Security Requirement Families (13–14)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;13  System &amp; communications protection&lt;/b&gt;&lt;br&gt;Protect boundaries; separate management and user functions and public-facing/internal networks. Deny traffic by default; prevent unauthorized shared-resource flows and split tunneling. Protect CUI in transit and at rest; manage keys and session authenticity/timeouts. Control mobile code, VoIP, and collaborative devices; prevent remote activation.&lt;br&gt;&lt;br&gt;&lt;b&gt;14  System &amp; information integrity&lt;/b&gt;&lt;br&gt;Promptly identify, report, and fix flaws. Deploy and update malware defenses; monitor advisories and take action. Scan periodically and scan external files in real time. Monitor inbound/outbound traffic for attacks and detect unauthorized system use.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;§8.4 • PDF pp. 549–556&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="1440" y="1960" width="600" height="300" />
    </mxCell>
    <UserObject id="updates" label="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Later Developments / Clarifications — October 16, 2026&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;Current rollout:&lt;/b&gt; the official CIO site states Phase II was suspended July 13, 2026; implementation remains paused in Phase 1. Phase 1 self-assessment duties and DFARS safeguarding remain in place.&lt;br&gt;&lt;br&gt;&lt;b&gt;Program-rule distinction:&lt;/b&gt; Level 1 uses annual self-assessments. Level 2 has self-assessment and C3PAO certification routes, generally on a three-year cycle, with &lt;b&gt;annual affirmations&lt;/b&gt;. An affirmation is not a fresh annual full assessment. The solicitation/contract and current implementation direction determine the required route.&lt;br&gt;&lt;br&gt;&lt;b&gt;Version matters:&lt;/b&gt; NIST superseded 800-171 Rev. 2 with Rev. 3 in May 2024; that does not automatically change a contract’s incorporated version. Current CIO guidance still identifies Rev. 2.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;Sources: CIO About CMMC; 32 C.F.R. §§170.15–170.17; NIST publication record. Click for current CIO policy.&lt;/i&gt;&lt;/p&gt;" link="https://dodcio.defense.gov/cmmc/About/">
      <mxCell parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
        <mxGeometry as="geometry" x="740" y="2400" width="600" height="350" />
      </mxCell>
    </UserObject>
    <UserObject id="clauseextra" label="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;DFARS Clause Details Beyond the Chapter Summary&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;After reporting:&lt;/b&gt; preserve affected-system images and relevant monitoring/packet data for &lt;b&gt;at least 90 days after report submission&lt;/b&gt;; submit isolated malware to DC3; provide requested forensic access.&lt;br&gt;&lt;br&gt;&lt;b&gt;Supply chain:&lt;/b&gt; flow the clause to covered subcontracts; subcontractors supply the incident report number up the chain. External cloud providers handling CDI must meet FedRAMP Moderate-equivalent requirements and specified reporting/cooperation duties.&lt;br&gt;&lt;br&gt;These clause duties accompany safeguarding; they are distinct from CMMC assessment status.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;DFARS 252.204-7012(b)(2)(ii)(D), (d)–(g), (m) • Current clause detail, checked October 16, 2026&lt;/i&gt;&lt;/p&gt;" link="https://www.acquisition.gov/dfars/252.204-7012-safeguarding-covered-defense-information-and-cyber-incident-reporting.">
      <mxCell parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
        <mxGeometry as="geometry" x="1440" y="2400" width="600" height="350" />
      </mxCell>
    </UserObject>
    <mxCell id="exam" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Applying Chapter 8 to a Fact Pattern&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;margin-right:8px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Identify the information: agency data, classified, CUI, or CDI?&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Identify the system: operated for the agency, or the contractor’s own business system?&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Identify authority: statute → regulation → contract/flow-down → incorporated standard.&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Separate safeguards, incident reporting, assessment, and authorization.&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Identify trigger and clock: incident discovery, assessment anniversary, or contract requirement?&lt;br&gt;&lt;br&gt;&lt;b&gt;Example:&lt;/b&gt; maintaining an agency system points to the FISMA branch; storing defense CUI in the contractor’s own design system points to the CUI/CDI branch; processing classified design material adds the NISPOM branch.&lt;/p&gt;&lt;p style=&quot;margin:12px 8px 4px;&quot;&gt;&lt;i&gt;Study synthesis • The Snowden disclosures and OPM breach frame the chapter’s concern about contractor access (PDF p. 536).&lt;/i&gt;&lt;/p&gt;" parent="1" vertex="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;">
      <mxGeometry as="geometry" x="40" y="2810" width="965" height="200" />
    </mxCell>
