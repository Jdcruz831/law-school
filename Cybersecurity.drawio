        </mxCell>
        <mxCell id="us_CvvVvdu692c3TlEkv-18" edge="1" parent="1" source="us_CvvVvdu692c3TlEkv-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="us_CvvVvdu692c3TlEkv-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="us_CvvVvdu692c3TlEkv-20" edge="1" parent="1" source="us_CvvVvdu692c3TlEkv-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="us_CvvVvdu692c3TlEkv-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="us_CvvVvdu692c3TlEkv-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Section 5 of the FTC Act:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Since no federal legislation, all actions are brought by FTC under the “&lt;u&gt;unfair&lt;/u&gt; or &lt;u&gt;deceptive&lt;/u&gt; acts or practices in or affecting commerce.”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="340" x="-390" y="670" as="geometry" />
        </mxCell>
        <mxCell id="us_CvvVvdu692c3TlEkv-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Deceptive&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Representation, omission or practice ... likely to mislead the consumer&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Reasonableness from the perspective of that group.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Practice effects the consumer&#39;s conduct with regard to a product or service.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="340" x="-280" y="860" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-3" edge="1" parent="1" source="us_CvvVvdu692c3TlEkv-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HbV3fGGYhGRoSepIOriY-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="us_CvvVvdu692c3TlEkv-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Unfair:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;FTC v. Sperry &amp;amp; Hutchinson Co.&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Cigarette Rule:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;whether the practice offends public policy as it&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;has been established by statutes, the common law, or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;otherwise&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;unscrupulous&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;causes substantial injury&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="310" x="-620" y="850" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-5" edge="1" parent="1" source="HbV3fGGYhGRoSepIOriY-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HbV3fGGYhGRoSepIOriY-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-7" edge="1" parent="1" source="HbV3fGGYhGRoSepIOriY-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HbV3fGGYhGRoSepIOriY-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-9" edge="1" parent="1" source="HbV3fGGYhGRoSepIOriY-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HbV3fGGYhGRoSepIOriY-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Updated Version:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Unfairness Policy Statement&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Cigarette Rule:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) the injury must be &lt;u&gt;substantial&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) the injury must not be &lt;u&gt;outweighed&lt;/u&gt; by any offsetting consumer or competitive benefits that the sales practice also produces,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) the injury must be one which consumers could not &lt;u&gt;reasonably have avoided&lt;/u&gt;.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="-580" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Substantial&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Examples:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- involves monetary harm (Identity Theft)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- sellers coerce consumers into purchasing unwanted goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Does not count:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Emotional harm&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="-980" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Outweighed&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- &quot;Will not find that a practice unfairly injures&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;consumers unless it is injurious in its net effects.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- if the company can demonstrate that it would have&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;been very difficult for the company to avoid the data breach. Note&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;that this is a very high bar; a company cannot merely argue that&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;cybersecurity safeguards were too expensive. The company must&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;be able to demonstrate that either the remedy would have been&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;impossible or the costs would have been so high that customers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;would have suffered even more than they did because of the data&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;breach.&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="380" x="-660" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="HbV3fGGYhGRoSepIOriY-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Updated Version:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Unfairness Policy Statement&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Examples:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- customer’s failure to install updates on an operating system led to&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;a virus that deleted all of the customer’s files from the hard drive,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the FTC is not likely to bring an action against the maker of the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;operating system&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="390" x="-210" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="Brhlpvq3LLfeeRYChfTd-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Outweighed&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- &quot;Will not find that a practice unfairly injures&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;consumers unless it is injurious in its net effects.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- if the company can demonstrate that it would have&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;been very difficult for the company to avoid the data breach. Note&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;that this is a very high bar; a company cannot merely argue that&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;cybersecurity safeguards were too expensive. The company must&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;be able to demonstrate that either the remedy would have been&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;impossible or the costs would have been so high that customers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;would have suffered even more than they did because of the data&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;breach.&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="380" x="-400" y="1610" as="geometry" />
        </mxCell>
        <mxCell id="RxFAWItDkVmXLz-C5p4G-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Article III standing&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) injury-in-fact&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;Broad View&lt;/b&gt;: a credible, increased risk of identity theft following&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; a breach is a sufficient injury-in-fact&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;Narrow View&lt;/b&gt;:  actual, present identity theft or fraud (what about an argument that data that is leaked could potentially&lt;/span&gt;&amp;nbsp;be harmful once bought and used by social media companies )&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) traceability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) repressibility&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="140" y="880" as="geometry" />
        </mxCell>
        <mxCell id="RxFAWItDkVmXLz-C5p4G-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Common Causes of Action in Data Breach Lawsuits&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Negligence&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Negligent Misrepresentation&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Breach of Contract&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- State Consumer Protection Laws&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="340" x="-40" y="750" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
