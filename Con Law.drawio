        <mxCell id="live" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=2.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" value="&lt;div style=&quot;text-align:center;font:bold 21px Helvetica;color:#ffffff&quot;&gt;&lt;u&gt;Constitutional issue to decide?&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;margin:10px 0 8px;border-top:1px solid #81a7aa&quot;&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font:16px/1.3 Helvetica;color:#f3f7f7&quot;&gt;After applicable thresholds are satisfied, does resolving the claim require deciding a constitutional issue? If yes, proceed to constitutional judicial review.&lt;/div&gt;" vertex="1">
