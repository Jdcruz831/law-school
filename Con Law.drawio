          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-37" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;Arms of the State&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;i&gt;Galette&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Arms of the state are also immune, but some state organizations might have a separate legal identity&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Consider:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- &lt;b&gt;Legal Separateness &amp;amp; Corporate Form&lt;/b&gt;: Corporate form is the &amp;nbsp;power to sue and be sued, hold property, and contract&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- &amp;nbsp;&lt;b&gt;Financial Liability&lt;/b&gt;: Would a judgment come out of the state coffers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- &lt;b&gt;State Control&lt;/b&gt;: like school boards&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="675" x="7325" y="1292.5" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-39" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;Arms of the State&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;i&gt;Galette&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Since a ruling against the&amp;nbsp;NJ Transit would not come from the state coffers (financial liability), it was not an arm of the state&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="390" x="7180" y="1517.5" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-44" edge="1" parent="1" source="wovAwqLVVU2Vwa51t1SS-41" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="wovAwqLVVU2Vwa51t1SS-43" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-46" edge="1" parent="1" source="wovAwqLVVU2Vwa51t1SS-41" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="wovAwqLVVU2Vwa51t1SS-45" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-48" edge="1" parent="1" source="wovAwqLVVU2Vwa51t1SS-41" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="wovAwqLVVU2Vwa51t1SS-47" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-50" edge="1" parent="1" source="wovAwqLVVU2Vwa51t1SS-41" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="wovAwqLVVU2Vwa51t1SS-49" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-52" edge="1" parent="1" source="wovAwqLVVU2Vwa51t1SS-41" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="wovAwqLVVU2Vwa51t1SS-51" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-41" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;Bypassing State Sovereign Immunity&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. State Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Implicit Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. Appeals of State Court Judgments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. Congressional Abrogation&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;5. Defiance of State Authority&lt;/p&gt;" vertex="1">
          <mxGeometry height="133.75" width="290" x="8430" y="1308.75" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-43" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;State Consent&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Statutory Waiver&lt;/b&gt; : A state can waive immunity via a statute w/ &quot;unmistakably clear&quot; language&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Federal Spending Programs&lt;/b&gt;: Congress can condition the receipt of federal funds on a state&#39;s waiver of Eleventh Amendment immunity&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(21, 23, 25), rgb(0, 102, 0));&quot;&gt;(See Dole Elements)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Litigation&lt;/b&gt; Conduct: he state voluntarily chooses to remove the case to federal court, the state forfeits its Eleventh Amendment immunity&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="400" x="7960" y="1542.5" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-45" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;Implicit Consent&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the states implicitly surrendered their sovereign immunity to a narrow list of lawsuits:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Actions brought by sister states&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Actions brought by the federal government&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Claims arising in bankruptcy proceedings&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Eminent domain condemnation proceedings brought by private delegates&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Actions brought under federal statutes enacted under Congress&#39;s authority to build and maintain a national military&amp;nbsp;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="310" x="8110" y="1742.5" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-47" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;Appeals of State Court Judgments&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- does not bar the U.S. Supreme Court from exercising its appellate jurisdiction to review state court judgments on &lt;b&gt;federal issues&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="8430" y="1882.5" as="geometry" />
        </mxCell>
        <mxCell id="ZBiD-sHZWwkju_W-4F7V-5" edge="1" parent="1" source="wovAwqLVVU2Vwa51t1SS-49" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="ZBiD-sHZWwkju_W-4F7V-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-49" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;Congressional Abrogation&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Fitzpatrick v. Bitzer&lt;/font&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress has the power to pass statutes that strip states of their sovereign immunity, only if in 14th amendment § 5 powers.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Congress clearly states its intent to subject states to suit.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The legislation is valid under §5, including congruence and proportionality where applicable.&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="360" x="8720" y="1712.5" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-51" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=light-dark(#FFFFFF,#B9C6CA);fontColor=light-dark(#151719,#000000);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;Defiance of State Authority&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Ex parte Young&amp;nbsp;&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;When a state officer attempts to enforce an unconstitutional law, they are acting outside the scope of their lawful state authority and are not &quot;the state&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Limits&lt;/b&gt;: Only ongoing/future violation of federal law, not previous ones. (&lt;b&gt;Prospective&lt;/b&gt; v. retrospective)&amp;nbsp;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="430" x="8900" y="1502.5" as="geometry" />
        </mxCell>
        <mxCell id="wovAwqLVVU2Vwa51t1SS-54" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;If state is&amp;nbsp;plaintiff, can remove to Federal court&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Cohens&lt;/font&gt;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Criminal suit against a the Cohen brothers was allowed because the state was the original prosecutor.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;relief on review of the conviction, not new suit&lt;/i&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="143.75" width="325" x="8385" y="968.75" as="geometry" />
        </mxCell>
        <mxCell id="ZBiD-sHZWwkju_W-4F7V-3" edge="1" parent="1" source="ZBiD-sHZWwkju_W-4F7V-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="wovAwqLVVU2Vwa51t1SS-49">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZBiD-sHZWwkju_W-4F7V-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#a0522d;fontColor=#ffffff;strokeColor=#6D1F00;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Fourteenth Amendment §1&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Protected rights:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Equal Protection - States must give every person equal protection of the laws.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Due Process - States cannot deprive a person of life, liberty, or property without due process.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Privileges or Immunities of U.S. citizens - States cannot abridge rights of national citizenship&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="360" x="9230" y="1692.5" as="geometry" />
        </mxCell>
        <mxCell id="ZBiD-sHZWwkju_W-4F7V-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;&amp;nbsp;S&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;ex discrimination&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;under Title VII&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Fitzpatrick v. Bitzer&lt;/font&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress strip the states of their sovereign immunity in regard to Sex discrimination under Title VII.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="350" x="9140" y="1922.5" as="geometry" />
        </mxCell>
