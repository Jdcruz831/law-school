5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="814" y="989" width="350" height="60" as="geometry" /></mxCell></object><mxCell id="edge3" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;" edge="1" source="gate" target="g1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="211.5" y="277" /><mxPoint x="209" y="277" /></Array></mxGeometry></mxCell><mxCell id="edge4" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;" edge="1" source="merit" target="g2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="799.0" y="277" /><mxPoint x="609" y="277" /></Array></mxGeometry></mxCell><mxCell id="edge5" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;" edge="1" source="merit" target="g3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="799.0" y="277" /><mxPoint x="989" y="277" /></Array></mxGeometry></mxCell><mxCell id="edge6" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;" edge="1" source="merit" target="g4" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="799" y="258" /><mxPoint x="425" y="258" /><mxPoint x="425" y="765" /><mxPoint x="609" y="765" /></Array></mxGeometry></mxCell><mxCell id="edge7" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;" edge="1" source="merit" target="g5" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="799" y="258" /><mxPoint x="1180" y="258" /><mxPoint x="1180" y="765" /><mxPoint x="989" y="765" /></Array></mxGeometry></mxCell><mxCell id="edge8" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=0.5;exitY=1;exitPerimeter=1;entryX=0.5;entryY=0;entryPerimeter=1;" edge="1" source="start" target="g0" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="599" y="120" /><mxPoint x="12" y="120" /><mxPoint x="12" y="770" /><mxPoint x="209" y="770" /></Array></mxGeometry></mxCell><mxCell id="s1" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Constitutional foundations&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Chs. 1–2 · pp. 11–32&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Which government acted, and what kind of limit does the question invoke?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="1340" width="400" height="150" as="geometry" /></mxCell><object id="backs1" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="1290" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs1" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Identify the actor → locate the grant or prohibition → test any structural or rights limit.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="1504" width="400" height="106" as="geometry" /></mxCell><object id="nexts1" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Judicial review&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s2&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="1718" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r1" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Allocation of power&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The Articles left the national government dependent on states for revenue and enforcement.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The Constitution grants national powers, divides them among branches, preserves state authority and limits government to protect individuals. Identify the actor before choosing a test.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“All legislative Powers herein granted” · Art. I, §1 · p. 19&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 11–18&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="1340" width="400" height="270" as="geometry" /></mxCell><mxCell id="r2" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Federalism and supremacy&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state measure conflicts with a federal enactment.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask first whether the enactment falls within federal power. Valid federal law binds state judges. States generally retain police power over health, safety and welfare.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the supreme Law of the Land” · Art. VI, cl. 2 · p. 25&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 12–15, 25&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="1340" width="400" height="250" as="geometry" /></mxCell><mxCell id="edge9" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r1" target="r2" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="1475.0" /><mxPoint x="999" y="1465.0" /></Array></mxGeometry></mxCell><mxCell id="r3" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Separation of powers&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A dispute pits Congress against the President or a federal court.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify who makes, executes or adjudicates law. Then ask whether text permits a shared function, such as Senate advice and consent.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 12–16, 19–25&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="1618" width="400" height="220" as="geometry" /></mxCell><mxCell id="edge10" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r1" target="r3" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="1475.0" /><mxPoint x="999" y="1728.0" /></Array></mxGeometry></mxCell><mxCell id="r4" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Ratification and change&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The Convention compromised on representation through a population-based House and equal state representation in the Senate.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Article VII required nine ratifying state conventions. Article V ordinarily requires two-thirds of both houses to propose and three-fourths of states to ratify. Two-thirds of state legislatures can require a proposing convention. Equal suffrage in the Senate requires the affected state's consent.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“equal Suffrage in the Senate” · Art. V · p. 25&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 13–17, 25–26&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="1866" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge11" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r1" target="r4" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="1475.0" /><mxPoint x="999" y="2031.0" /></Array></mxGeometry></mxCell><mxCell id="r5" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Representation and original compromises&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Large and small states disputed representation. Enslavement shaped the bargaining over representation, taxation and the slave trade.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish the original compromises from the amendments that superseded them. Direct election of senators, abolition of slavery, equal protection and later voting amendments changed the original arrangement.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 12–15, 19–22&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="2224" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge12" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r1" target="r5" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="1475.0" /><mxPoint x="999" y="2379.0" /></Array></mxGeometry></mxCell><mxCell id="r6" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Articles of Confederation → constitutional union&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Under the Articles each state had one vote; central revenue depended on state contributions and amendment required unanimity.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The Constitution permitted direct federal taxation and regulation of individuals and created separate executive and judicial institutions. Use this structural change when evaluating asserted state vetoes over valid federal law.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 12–15&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="2562" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge13" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r1" target="r6" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="1475.0" /><mxPoint x="999" y="2717.0" /></Array></mxGeometry></mxCell><mxCell id="edge14" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s1" target="r1" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="1415.0" /><mxPoint x="479" y="1475.0" /></Array></mxGeometry></mxCell><mxCell id="r7" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Constitutional interpretation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A dispute persists although the relevant words have remained unchanged.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish the text, its historical understanding, structural implications, precedent and application to new facts. Judicial decisions, implementing statutes and political practice operate at different levels.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 15–18&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="2900" width="400" height="240" as="geometry" /></mxCell><mxCell id="r8" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Countermajoritarian judicial review&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Life-tenured judges decline to enforce a law adopted by elected officials.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Explain the constitutional basis for applying higher law and the democratic objection to judicial control. Separate judgment in an actual case from political acceptance, enforcement, amendment and future changes in precedent.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 15–18, 48–51&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="2900" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge15" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r7" target="r8" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="3020.0" /><mxPoint x="999" y="3030.0" /></Array></mxGeometry></mxCell><mxCell id="edge16" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s1" target="r7" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="1415.0" /><mxPoint x="479" y="3020.0" /></Array></mxGeometry></mxCell><mxCell id="r9" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Identify the source of a restriction&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A provision constrains Congress, the states, or both.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Read its addressee. Article I, §9 principally limits the federal government and §10 limits states. Later amendments alter the original allocation. Trace state liability for an incorporated right through the Fourteenth Amendment.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 19–32&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="3188" width="400" height="240" as="geometry" /></mxCell><mxCell id="edge17" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s1" target="r9" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="1415.0" /><mxPoint x="479" y="3308.0" /></Array></mxGeometry></mxCell><mxCell id="s2" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Judicial review&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 3 · pp. 33–54&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Which court is reviewing which act, and what relief may it grant?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="1340" width="400" height="150" as="geometry" /></mxCell><object id="backs2" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="1290" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs2" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Identify the court and challenged act → establish jurisdiction → identify the enforceable duty → tailor relief.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="1504" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs2" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Judicial Review Q1–5&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="1622" width="400" height="82" as="geometry" /></mxCell><object id="nexts2" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Federal jurisdiction and immunity&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s3&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="1718" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r10" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State or federal claim and standard of review&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A litigant challenges a state law in state court and later appeals on a federal constitutional ground.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;State judges are bound by federal law. On review, identify the federal question actually decided, the final state judgment and the relief the federal ruling could change. Federal courts lack a general power to revise a state court’s authoritative construction of its own law.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 33–35, 51–54&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="1340" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge18" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s2" target="r10" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="1415.0" /><mxPoint x="2739" y="1495.0" /></Array></mxGeometry></mxCell><mxCell id="r11" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Duty to apply superior law&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Marbury v. Madison&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Marbury had a vested commission and a legal remedy in principle. His mandamus application sought original Supreme Court relief outside the constitutional categories.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Marbury’s mandamus would require an original exercise of jurisdiction not conferred by Article III. A court deciding a case must apply the Constitution over an inconsistent statute. Congress cannot enlarge the Supreme Court’s original jurisdiction by statute.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the province and duty of the Judicial Department to say what the law is” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 42&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 35–48&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="1678" width="400" height="400" as="geometry" /></mxCell><mxCell id="r12" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Ministerial duty or political discretion?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Delivery of an already completed commission involved a vested individual right.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;An officer's legally prescribed duty affecting individual rights is judicially examinable. Identify a legally enforceable duty before ordering relief. Political discretion presents a different question.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 38–45&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="1678" width="400" height="240" as="geometry" /></mxCell><mxCell id="edge19" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r11" target="r12" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="1878.0" /><mxPoint x="3259" y="1798.0" /></Array></mxGeometry></mxCell><mxCell id="edge20" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s2" target="r11" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="1415.0" /><mxPoint x="2739" y="1878.0" /></Array></mxGeometry></mxCell><mxCell id="r13" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State law or state judgment?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A Minnesota speaker challenges a state restriction in state court, then seeks federal review.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Both state and federal courts can apply federal constitutional law in cases within their jurisdiction. Supreme Court appellate review of the federal issue extends to state civil and criminal judgments, including a prosecution by the state.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 51–54&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="2106" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge21" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s2" target="r13" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="1415.0" /><mxPoint x="2739" y="2236.0" /></Array></mxGeometry></mxCell><mxCell id="r14" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Judgment, injunction and enforcement&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A court holds immigration detention unlawful and orders the officer to release the plaintiff.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Separate the constitutional holding from the binding judgment. An injunction binds its addressees and may be enforced through contempt. A ruling does not erase the enactment from the statute book.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 48–51, 70–71&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="2394" width="400" height="240" as="geometry" /></mxCell><mxCell id="r15" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Who must receive relief?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Trump v. CASA, Inc.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An individual seeks an order protecting similarly situated nonparties.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Federal equitable relief ordinarily extends only as far as necessary to give complete relief to plaintiffs. Examine the parties, any certified class and whether broader relief is necessary to resolve the parties’ injuries.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Though flexible, this equitable authority is not freewheeling” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 49&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 49–51&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="2394" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge22" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r14" target="r15" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="2514.0" /><mxPoint x="3259" y="2564.0" /></Array></mxGeometry></mxCell><mxCell id="edge23" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s2" target="r14" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="1415.0" /><mxPoint x="2739" y="2514.0" /></Array></mxGeometry></mxCell><mxCell id="s3" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Federal jurisdiction and immunity&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 4 · pp. 55–75&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Start with the forum. Then test subject matter, statutory jurisdiction and any immunity separately.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="1340" width="400" height="150" as="geometry" /></mxCell><object id="backs3" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="1290" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs3" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Forum → Article III category → statutory grant → original or appellate posture → defendant, immunity and remedy.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="1504" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs3" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Subject Matter Jurisdiction Q1–4 · Regulating Federal Courts Q1–6 · Eleventh Amendment Q1–12&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="1622" width="400" height="82" as="geometry" /></mxCell><object id="nexts3" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Justiciability and timing&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s4&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="1718" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r16" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Federal judicial power · Article III, §2, cl. 1&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A California egg farmer sues California’s attorney general in federal district court solely under California law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify an enumerated case or controversy. Federal questions, admiralty, ambassador cases, United States as party, specified interstate or foreign-party controversies, and same-state claimants under different states’ land grants are distinct bases. These facts alone supply none.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“The judicial Power shall extend to all Cases” · Art. III, §2, cl. 1 · p. 24&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 55–58&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="1340" width="400" height="370" as="geometry" /></mxCell><mxCell id="r17" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Lower federal court&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Kline v. Burke Construction Co.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal question falls within Article III, but Congress limits the court’s statutory grant to disputes above a dollar threshold.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Both constitutional authority and a statutory grant are required. Congress may establish or abolish inferior Article III courts and confer less than the constitutional maximum. Subject-matter jurisdiction cannot be created by consent or forfeiture.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“it requires an act of Congress to confer it” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 59&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 55–60&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="1340" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge24" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r16" target="r17" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="1525.0" /><mxPoint x="5519" y="1510.0" /></Array></mxGeometry></mxCell><mxCell id="r18" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State trial court&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Change the forum in the egg-farmer problem to state superior court.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Article III limits federal courts. State courts generally may hear federal as well as state claims under their own jurisdictional rules, subject to valid federal exclusivity and nondiscrimination requirements.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 55–58&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="1708" width="400" height="240" as="geometry" /></mxCell><mxCell id="edge25" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r16" target="r18" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="1525.0" /><mxPoint x="5519" y="1828.0" /></Array></mxGeometry></mxCell><mxCell id="r19" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Supreme Court · Article III, §2, cl. 2&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal writ application begins in the Supreme Court. Another case arrives on appeal after a state prosecution.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Original jurisdiction covers cases affecting ambassadors, other public ministers and consuls, and cases within Article III in which a state is a party. Identify the actual posture. A state’s participation below does not categorically preclude appellate review.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the supreme Court shall have original Jurisdiction” · Art. III, §2, cl. 2 · p. 24&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 56–57, 60–65&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="1976" width="400" height="350" as="geometry" /></mxCell><mxCell id="r20" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Exceptions to appellate jurisdiction&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Ex parte McCardle&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress repealed the statutory route for McCardle’s pending habeas appeal. Another route remained.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress may make exceptions to appellate jurisdiction. Identify the jurisdiction withdrawn, what survives, and any independent constitutional constraint. The decision did not settle every limit on jurisdiction stripping.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Without jurisdiction, the court cannot proceed at all in any cause” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 62&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 60–65&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="1976" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge26" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r19" target="r20" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="2151.0" /><mxPoint x="6039" y="2146.0" /></Array></mxGeometry></mxCell><mxCell id="r21" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Original versus exclusive jurisdiction&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress authorizes a district court to hear a federal claim by a state. A different case is a controversy between two states.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Original describes where a case may begin. It does not always mean exclusive. Check statutory exclusivity for controversies between states and distinguish concurrent original jurisdiction.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 56–57, 63–65&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="2344" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge27" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r19" target="r21" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="2151.0" /><mxPoint x="6039" y="2474.0" /></Array></mxGeometry></mxCell><mxCell id="r22" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Rule of decision or change in law?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress alters jurisdiction or instructs a court to disregard the legal effect of a presidential pardon.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish changing governing law, including for pending cases, from prescribing a result under existing law or impairing another branch’s constitutional power.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 63–65&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="2632" width="400" height="240" as="geometry" /></mxCell><mxCell id="edge28" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r19" target="r22" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="2151.0" /><mxPoint x="6039" y="2752.0" /></Array></mxGeometry></mxCell><mxCell id="r23" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;All review foreclosed?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A statute closes one appellate route. A broader variant would foreclose every federal avenue for a constitutional challenge.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish available state-court review, alternative Supreme Court routes and independent guarantees such as the Suspension Clause when habeas is involved. The book treats the outer limit of the Exceptions Clause as unsettled.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 63–65&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="2900" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge29" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r19" target="r23" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="2151.0" /><mxPoint x="6039" y="3040.0" /></Array></mxGeometry></mxCell><mxCell id="edge30" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r16" target="r19" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="1525.0" /><mxPoint x="5519" y="2151.0" /></Array></mxGeometry></mxCell><mxCell id="edge31" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s3" target="r16" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="1415.0" /><mxPoint x="4999" y="1525.0" /></Array></mxGeometry></mxCell><mxCell id="r24" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Is the defendant the state?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A citizen seeks an injunction directly against Missouri. Change the defendant to its attorney general or to a city.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A private federal suit against an unconsenting state generally encounters sovereign immunity even when brought by its own citizen. Determine the real party in interest and analyze each requested remedy separately.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“commenced or prosecuted against one of the United States” · Amend. XI · p. 27&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 65–75&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="3208" width="400" height="330" as="geometry" /></mxCell><mxCell id="r25" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Separate entity or arm of the state?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Galette v. New Jersey Transit Corp.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A separately incorporated transit entity can be responsible for its own judgments.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine legal identity, structural independence and responsibility for judgments under state law. Ordinary municipalities lack the state’s immunity. Funding or oversight alone does not make an entity an arm of the state.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a corporation that was liable for its own judgments” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 69&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 68–70&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="3208" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge32" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r25" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="3378.0" /></Array></mxGeometry></mxCell><mxCell id="r26" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Official capacity · ongoing federal violation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Plaintiff asks a state officer to stop enforcing an allegedly unconstitutional law and also seeks back payments.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;An officer connected to enforcement may be enjoined prospectively for an ongoing federal violation. Retrospective payment from the treasury generally remains barred. Costs incidental to prospective compliance can be permissible. Under Ex parte Young, an asserted violation of state law alone does not support this federal exception.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 70–74&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="3576" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge33" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r26" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="3751.0" /></Array></mxGeometry></mxCell><mxCell id="r27" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Individual capacity&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Damages are sought from an officer personally for conduct performed at work.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;State sovereign immunity generally permits a personal-capacity claim. Then test available personal defenses, including qualified immunity for damages where the federal right was not clearly established.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 71–72&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="3954" width="400" height="240" as="geometry" /></mxCell><mxCell id="edge34" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r27" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="4074.0" /></Array></mxGeometry></mxCell><mxCell id="r28" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Consent or surrender?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state initiates litigation, accepts a clearly conditioned grant, or faces suit by another state.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Look for unequivocal consent to the particular forum and suit. Voluntary invocation of jurisdiction can waive immunity within the litigation. The constitutional plan also surrendered immunity in limited settings, including suits by other states or the United States.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 66–69, 74–75&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="4222" width="400" height="260" as="geometry" /></mxCell><mxCell id="r29" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Five plan-of-the-Convention settings&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Compare a sister state protecting its own sovereign interests with a suit by a foreign nation, tribe or state nominally pursuing private interests.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Check suits by the United States or a sister state in its own interest, bankruptcy proceedings, federal eminent domain including authorized private delegates, and federal military-power legislation. A sovereign-sounding plaintiff is insufficient.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 67–68&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="4222" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge35" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r28" target="r29" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="4352.0" /><mxPoint x="6039" y="4362.0" /></Array></mxGeometry></mxCell><mxCell id="r30" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Litigation conduct and conditional funding&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state files its own claim or voluntarily removes a case. Another merely appears to contest jurisdiction or consents only to suit in state court.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine the precise litigation act and the scope of the waiver. Express consent must encompass federal court. For funding, examine whether Congress gave clear notice and whether the state voluntarily accepted the conditions.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 66–68&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="4530" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge36" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r28" target="r30" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="4352.0" /><mxPoint x="6039" y="4685.0" /></Array></mxGeometry></mxCell><mxCell id="edge37" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r28" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="4352.0" /></Array></mxGeometry></mxCell><mxCell id="r31" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional abrogation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress authorizes employment-discrimination damages against a state employer.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Require an unmistakably clear abrogation and a valid constitutional power to effect it. Examine §5 of the Fourteenth Amendment as applied to this conduct. A statute may regulate a state under commerce power yet fail to authorize private damages against it.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 72–75, 215–216&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="4868" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge38" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r31" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="4998.0" /></Array></mxGeometry></mxCell><mxCell id="r32" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State-initiated suit and defensive review&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A public university sues a professor. He invokes the First Amendment in defense or appeals an adverse final state judgment.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Immunity does not suppress a federal defense to the state’s own suit or bar Supreme Court review merely because the state is an opposing party. Distinguish an independent affirmative damages claim.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 67–69&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="5156" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge39" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r32" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="5301.0" /></Array></mxGeometry></mxCell><mxCell id="r33" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Immunity beyond Article III&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A private claimant chooses a state court or an administrative adjudication instead of a federal district court.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The constitutional structure affords states protection beyond the Eleventh Amendment’s words. Changing forums alone does not remove immunity from unconsented private suits. Identify waiver, valid abrogation or structural surrender in that forum.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 74–75&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="5474" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge40" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r24" target="r33" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="3373.0" /><mxPoint x="5519" y="5614.0" /></Array></mxGeometry></mxCell><mxCell id="edge41" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s3" target="r24" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="1415.0" /><mxPoint x="4999" y="3373.0" /></Array></mxGeometry></mxCell><mxCell id="s4" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Justiciability and timing&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 5 · pp. 77–104&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;At filing, identify a plaintiff, a challenged act and each remedy. Then check whether a live dispute persists.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="2909" width="400" height="150" as="geometry" /></mxCell><object id="backs4" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="2859" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs4" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Adverse parties → injury in fact → causation → redressability for each remedy → timing and continuing stake. An unmet element prevents a merits ruling.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="3073" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs4" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Injury in Fact Q1–10 · Causation and Redressability Q1–4&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="3191" width="400" height="82" as="geometry" /></mxCell><object id="nexts4" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Political questions and state grounds&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s5&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="3287" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r34" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Advisory opinion&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Officials seek advance approval of a proposed law or reserve authority to revise the court’s decision.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Require adverse parties with an actual legal dispute and a binding judicial resolution. A declaratory judgment can resolve present adverse legal rights.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 77–79&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="2909" width="400" height="220" as="geometry" /></mxCell><mxCell id="edge42" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s4" target="r34" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="2984.0" /><mxPoint x="2739" y="3019.0" /></Array></mxGeometry></mxCell><mxCell id="r35" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Injury in fact&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Spokeo, Inc. v. Robins&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A plaintiff challenges an inaccurate report. Ask who was affected, whether the asserted harm was real, and when it occurred or will occur.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Injury must be concrete, particularized, and actual or imminent. Tangible and intangible harms can qualify. Many people may suffer the same concrete injury.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“it must actually exist” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 89&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 79–94&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="3157" width="400" height="300" as="geometry" /></mxCell><mxCell id="r36" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Statutory right and intangible harm&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;TransUnion LLC v. Ramirez&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A credit agency disseminates a misleading alert to a third party, or keeps it only in an internal file.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;For damages, identify concrete harm and a close historical analogue where appropriate. A bare statutory violation alone is insufficient. Future risk may support prospective relief under a different showing.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“traditionally recognized as providing a basis for a lawsuit in American courts” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 92&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 89–94&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="3157" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge43" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r35" target="r36" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="3307.0" /><mxPoint x="3259" y="3327.0" /></Array></mxGeometry></mxCell><mxCell id="r37" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Environmental and procedural injury&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Summers v. Earth Island Institute&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A regular visitor expects harm to the area she uses. Another plaintiff objects to the same conduct but cannot identify a site she expects to visit.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Connect injury to a particular person, place and likely use. A procedural right protects standing only with a threatened concrete interest. A statutory invitation to sue cannot replace it.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“some concrete interest that is affected by the deprivation” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 83&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 79–86&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="3525" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge44" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r35" target="r37" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="3307.0" /><mxPoint x="3259" y="3695.0" /></Array></mxGeometry></mxCell><mxCell id="r38" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Taxpayer, observer or regulated party?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A taxpayer objects to government policy. A driver personally owes a challenged tax. A meeting attendee encounters the disputed practice.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;General disagreement or taxpayer status ordinarily fails. A personal payment, exposure, loss of use or other direct effect can establish personal injury. Trace it to this challenged provision.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 84–94&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="3893" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge45" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r35" target="r38" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="3307.0" /><mxPoint x="3259" y="4023.0" /></Array></mxGeometry></mxCell><mxCell id="r39" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Association, multiple parties and claims&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An association sues for members, or several plaintiffs attack different statutory provisions.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;For representational standing require a member with standing, germaneness to the organization’s purpose, and no need for individual participation in the claim or relief. For each claim and form of relief identify at least one plaintiff who can obtain it.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 84–86, 99–101&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="4181" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge46" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r35" target="r39" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="3307.0" /><mxPoint x="3259" y="4326.0" /></Array></mxGeometry></mxCell><mxCell id="edge47" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s4" target="r35" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="2984.0" /><mxPoint x="2739" y="3307.0" /></Array></mxGeometry></mxCell><mxCell id="r40" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Causation and redressability&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Allen v. Wright&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Parents challenged IRS treatment of discriminatory schools. Tax treatment, school decisions and parents’ enrollment choices separated the IRS from the alleged integration injury.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask separately whether injury is fairly traceable to the defendant and whether the requested relief is likely to alleviate it. A predictable third-party response may suffice. Identify evidence for each disputed link.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“independent action of some third party not before the court” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 97&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 94–102&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="4499" width="400" height="360" as="geometry" /></mxCell><mxCell id="r41" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Remedy-specific standing&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Past exposure supports damages; plaintiff also wants to enjoin future encounters. Or a second independent policy would still bar the plaintiff from flying.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;For an injunction identify a real threat of repetition to this plaintiff. Ask what would actually change if the court granted this order. Partial relief can suffice, but an independent sufficient obstacle may defeat redressability.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 93–102&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="4499" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge48" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r40" target="r41" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="4679.0" /><mxPoint x="3259" y="4639.0" /></Array></mxGeometry></mxCell><mxCell id="r42" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Predictable response or speculation?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Census nonresponse may predictably reduce a state’s federal funding. In the housing problem, changing zoning rules may still leave builders unwilling to supply affordable units.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Trace each intermediate decision. Empirical evidence, incentives and economic constraints can make third-party responses sufficiently likely. Explain why an injunction would alter the outcome.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 94–102&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="4807" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge49" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r40" target="r42" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="4679.0" /><mxPoint x="3259" y="4947.0" /></Array></mxGeometry></mxCell><mxCell id="r43" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Procedure, forum and merits&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A person challenges denial of a required hearing, or an Arizona taxpayer brings a federal claim in state court.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;For a concrete interest protected by a procedural right, causation and redressability may be relaxed without proof the agency would reach a different result. Article III does not prescribe state-court standing. Distinguish jurisdiction from whether the pleaded claim ultimately succeeds.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 77–79, 93–94, 101–102&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="5115" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge50" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r40" target="r43" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="4679.0" /><mxPoint x="3259" y="5265.0" /></Array></mxGeometry></mxCell><mxCell id="edge51" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s4" target="r40" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="2984.0" /><mxPoint x="2739" y="4679.0" /></Array></mxGeometry></mxCell><mxCell id="r44" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Ripeness and pre-enforcement review&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Susan B. Anthony List v. Driehaus&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A speaker intends to repeat speech arguably covered by a prohibition and faces a credible enforcement threat.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify intended conduct, arguable coverage and credible threat. A plaintiff need not first incur punishment. Contingent plans or a speculative enforcement chain may be premature.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“there exists a credible threat of prosecution thereunder” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 102&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 102–103&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="5443" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge52" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s4" target="r44" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="2984.0" /><mxPoint x="2739" y="5613.0" /></Array></mxGeometry></mxCell><mxCell id="r45" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Mootness and exceptions&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Chafin v. Chafin&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Relief was available at filing, but the pregnancy ends, defendant changes policy, or challenged proceedings conclude.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask whether any effectual relief remains. For repetition evading review, require inherently short duration and a reasonable expectation the same complaining party will face it again. For voluntary cessation, defendant bears the heavy burden of showing recurrence cannot reasonably be expected.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“impossible for a court to grant any effectual relief whatever” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 103&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 103–104&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="5811" width="400" height="380" as="geometry" /></mxCell><mxCell id="r46" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Continuing injury after release&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A defendant completes his sentence while his conviction is on appeal. An airline removes a passenger from its list before he files suit.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask what the requested judgment could still remedy. Collateral consequences of conviction can sustain an appeal. A past exclusion may support proven damages while removal from the list weakens future injunctive standing.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 99–104&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="5811" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge53" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r45" target="r46" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="6001.0" /><mxPoint x="3259" y="5951.0" /></Array></mxGeometry></mxCell><mxCell id="edge54" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s4" target="r45" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="2984.0" /><mxPoint x="2739" y="6001.0" /></Array></mxGeometry></mxCell><mxCell id="s5" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Political questions and state grounds&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 6 · pp. 105–116&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Can a court supply a legal standard, and could federal review change the judgment?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="3603" width="400" height="150" as="geometry" /></mxCell><object id="backs5" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="3553" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs5" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Political question? → textually committed or no manageable standard? For review of a state judgment, also test adequacy and independence.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="3767" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs5" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Adequate and Independent State Grounds Q1–4&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="3885" width="400" height="82" as="geometry" /></mxCell><object id="nexts5" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Political checks on the courts&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s6&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="3981" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r47" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Commitment and judicial standards&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Zivotofsky v. Clinton&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A citizen claims a statutory right to a passport entry. Deciding the claim requires interpreting Congress’s and the President’s powers.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine textual commitment to another branch and judicially discoverable, manageable standards. Sensitivity in foreign affairs alone does not preclude adjudication. Distinguish justiciability from who prevails on the merits.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“This is a familiar judicial exercise” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 108&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 105–112&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="3603" width="400" height="340" as="geometry" /></mxCell><mxCell id="r48" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Partisan gerrymandering&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Rucho v. Common Cause&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Voters argue a map allocates political power too heavily to one party.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Federal partisan-gerrymandering claims lack a judicially manageable constitutional measure of excessive partisanship. Separate racial discrimination, population equality, state-law challenges and Congress’s Elections Clause authority.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“clear, manageable, and politically neutral” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 113&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 112–114&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="3603" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge55" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r47" target="r48" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="3773.0" /><mxPoint x="999" y="3773.0" /></Array></mxGeometry></mxCell><mxCell id="edge56" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s5" target="r47" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="3678.0" /><mxPoint x="479" y="3773.0" /></Array></mxGeometry></mxCell><mxCell id="r49" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Adequate and independent state ground&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Ohio’s high court addresses challenges to one statute under both the Ohio and federal constitutions.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask whether changing the federal answer could change the judgment. An independently sufficient state-law ground forecloses Supreme Court review. Consider whether the state court’s rule actually depends on federal interpretation.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 114–116&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="3971" width="400" height="290" as="geometry" /></mxCell><mxCell id="r50" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Apply all four Ohio outcomes&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;State ground independent. Physician seeks the same injunction under either constitution.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Federal violation alone → review available. State violation alone → barred. Both claims rejected → review available on the federal claim. Both violations found → barred because state law still supports the injunction.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 114–116&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="3971" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge57" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r49" target="r50" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="4116.0" /><mxPoint x="999" y="4101.0" /></Array></mxGeometry></mxCell><mxCell id="r51" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Unclear state-law basis&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state court relies on parallel constitutional guarantees and federal precedent. The opinion does not clearly say whether state law alone controls.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine whether the judgment fairly appears to rest primarily on federal law or to be interwoven with it. A clear statement of an adequate, independent state ground forecloses federal review.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 114–116&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="4259" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge58" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r49" target="r51" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="4116.0" /><mxPoint x="999" y="4389.0" /></Array></mxGeometry></mxCell><mxCell id="edge59" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s5" target="r49" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="3678.0" /><mxPoint x="479" y="4116.0" /></Array></mxGeometry></mxCell><mxCell id="s6" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Political checks on the courts&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 7 · pp. 117–120&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Which branch can change an institution, its membership, or the controlling law?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="4694" width="400" height="150" as="geometry" /></mxCell><object id="backs6" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="4644" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs6" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Institutional change → identify the political branch → locate a lawful mechanism → apply Article III safeguards.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="4858" width="400" height="106" as="geometry" /></mxCell><object id="nexts6" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Enumerated ends and implied means&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s7&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="5072" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r52" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional checks&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress changes appropriations, creates judgeships or changes the Supreme Court’s size.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress sets the Court’s size by statute and controls appropriations, subject to Article III protections including undiminished judicial compensation during service. Congress may propose constitutional amendments. Ordinary legislation cannot overturn a constitutional holding simply by declaring it wrong.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“shall not be diminished during their Continuance in Office” · Art. III, §1 · p. 24&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 117–119&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="4694" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge60" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s6" target="r52" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="4769.0" /><mxPoint x="479" y="4869.0" /></Array></mxGeometry></mxCell><mxCell id="r53" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Appointment, tenure and removal&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A vacancy arises or Congress seeks to remove a sitting federal judge.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;President nominates and Senate confirms. Article III tenure during good behavior protects decisional independence. The House may impeach and the Senate may convict by two-thirds of members present. The President cannot dismiss an Article III judge.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“shall hold their Offices during good Behaviour” · Art. III, §1 · p. 24&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 117–120&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="5072" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge61" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s6" target="r53" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="4769.0" /><mxPoint x="479" y="5237.0" /></Array></mxGeometry></mxCell><mxCell id="s7" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Enumerated ends and implied means&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 8 · pp. 121–138&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;What end may Congress pursue, and how does the challenged measure help achieve it?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="5577" width="400" height="150" as="geometry" /></mxCell><object id="backs7" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="5527" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs7" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Enumerated end → appropriate means → constitutional limits → consequences for contrary state action.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="5741" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs7" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Meaning of McCulloch Q1–6&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="5859" width="400" height="82" as="geometry" /></mxCell><object id="nexts7" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Interstate commerce&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s8&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="5955" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r54" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Necessary and Proper Clause&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;McCulloch v. Maryland&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress chartered a bank to assist in carrying out fiscal powers. An express bank-chartering clause was unnecessary.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify a legitimate constitutional end. Select means appropriate and plainly adapted to it, consistent with the Constitution’s letter and spirit and not prohibited. Necessary does not require indispensable. The clause is derivative.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Let the end be legitimate, let it be within the scope of the constitution” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 128&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 121–136&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="5577" width="400" height="360" as="geometry" /></mxCell><mxCell id="r55" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Means, pretext and independent restrictions&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An otherwise useful measure regulates a subject Congress could not reach independently.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the enumerated end and how the means actually serve it. Check for an independent constitutional prohibition or a claimed power that would alter the federal structure. A useful means may still be improper.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 128–136&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="5577" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge62" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r54" target="r55" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="5757.0" /><mxPoint x="999" y="5722.0" /></Array></mxGeometry></mxCell><mxCell id="edge63" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s7" target="r54" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="5652.0" /><mxPoint x="479" y="5757.0" /></Array></mxGeometry></mxCell><mxCell id="r56" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Supremacy and state interference&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Maryland taxed a national bank. A state declares secession, purports to exempt residents from federal law, or taxes federal vaccination sites.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Valid federal law governs throughout the Union. A state cannot nullify it, control federal operations or impose a direct tax on the United States absent consent. Separately ask whether a state merely declined to punish federally prohibited conduct.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 130–138&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="5965" width="400" height="280" as="geometry" /></mxCell><mxCell id="r57" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State immunity from a federal claim?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Doe v. Dynamic Physical Therapy, LLC&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Louisiana immunized health providers under state law. A state court applied that immunity to a federal cause of action.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A state defines the scope of state liability. It cannot eliminate liability established by federal law. Examine any defenses supplied by federal law itself.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a State has no power to confer immunity from federal causes of action” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 138&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 137–138&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="5965" width="400" height="320" as="geometry" /></mxCell><mxCell id="edge64" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r56" target="r57" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="6105.0" /><mxPoint x="999" y="6125.0" /></Array></mxGeometry></mxCell><mxCell id="edge65" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s7" target="r56" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="5652.0" /><mxPoint x="479" y="6105.0" /></Array></mxGeometry></mxCell><mxCell id="s8" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Interstate commerce&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 9 · pp. 139–164&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Define precisely the class of conduct Congress regulates. Which of the three categories covers it?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="5929" width="400" height="150" as="geometry" /></mxCell><object id="backs8" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="5879" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs8" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Channel or instrumentality? Otherwise test substantial effects → economic class or integrated scheme → activity versus compelled entry.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="6093" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs8" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Commerce Building Blocks Q1–4 · Complex Applications Q1–11&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="6211" width="400" height="82" as="geometry" /></mxCell><object id="nexts8" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Taxing and spending&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s9&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="6307" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r58" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Channels, instrumentalities, or substantial effects?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;United States v. Lopez&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Possessing a gun near a school lacked a commercial element or a statutory interstate nexus in the original Act.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Test use of interstate channels, protection of instrumentalities or persons or things in interstate commerce, then activities substantially affecting interstate commerce. A connection under one category suffices.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Congress may regulate the use of the channels of interstate commerce” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 144&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 143–150&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="5929" width="400" height="380" as="geometry" /></mxCell><mxCell id="r59" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Channel or instrumentality?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Compare discharge into a navigable waterway with discharge anywhere ecologically sensitive. Compare an airline carry-on restriction with a possession ban anywhere.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A channel is an avenue of interstate movement. An instrumentality is a means by which commerce moves. Congress can protect interstate instrumentalities even against intrastate threats. Identify the medium, movement or instrument the law actually reaches.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 143–150&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="5929" width="400" height="320" as="geometry" /></mxCell><mxCell id="edge66" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r58" target="r59" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="6119.0" /><mxPoint x="5519" y="6089.0" /></Array></mxGeometry></mxCell><mxCell id="r60" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Economic activity → aggregation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Wickard v. Filburn&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Homegrown wheat replaced purchases. A hotel served interstate travelers; a local restaurant purchased food moving in commerce.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Production, distribution and consumption of commodities may be considered as a class. Ask whether Congress could rationally find a substantial aggregate effect. One producer’s small personal contribution does not defeat regulation.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“if it exerts a substantial economic effect on interstate commerce” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 141&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 139–145&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="6277" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge67" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r58" target="r60" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="6119.0" /><mxPoint x="5519" y="6457.0" /></Array></mxGeometry></mxCell><mxCell id="r61" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Noneconomic conduct → limit on aggregation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;United States v. Morrison&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A civil damages remedy covered gender-motivated violence. The government traced its economic effects through reduced travel and employment.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Remote aggregate economic consequences of local noneconomic violence ordinarily do not suffice. Findings supply evidence, but cannot erase the distinction between national and local authority.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Gender-motivated crimes of violence are not, in any sense of the phrase, economic activity” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 151&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 145–152&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="6665" width="400" height="360" as="geometry" /></mxCell><mxCell id="r62" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Jurisdictional element&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A felon-in-possession law requires proof the particular firearm traveled in interstate commerce. Compare bare possession of an image with its electronic transmission.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Inspect the actual elements. A case-specific nexus can confine the statute to conduct with the requisite connection. A general legislative finding is not an element the prosecution must prove.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 145–152&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="6665" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge68" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r61" target="r62" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="6845.0" /><mxPoint x="6039" y="6805.0" /></Array></mxGeometry></mxCell><mxCell id="r63" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Integral part of broader regulation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Gonzales v. Raich&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Homegrown marijuana was intended for personal medical use. A comprehensive federal law controlled the interstate market in the same fungible commodity.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask whether excluding the local class could undermine a valid broader economic scheme. Congress had a rational basis to include local production and possession. Identify the larger scheme and explain the risk to its operation.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“that have a substantial effect on interstate commerce” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 154&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 152–161&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="6114" y="6973" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge69" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r61" target="r63" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="6039" y="6845.0" /><mxPoint x="6039" y="7153.0" /></Array></mxGeometry></mxCell><mxCell id="edge70" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r58" target="r61" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="6119.0" /><mxPoint x="5519" y="6845.0" /></Array></mxGeometry></mxCell><mxCell id="r64" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Inactivity → separate source?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;National Federation of Independent Business v. Sebelius · Roberts, C.J.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An uninsured individual is directed to purchase coverage so the insurance market will work better.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The commerce power presupposes existing activity. Compelling entry creates the predicate for regulation. Even if useful, the mandate raises a distinct proper-means problem. Test a payment separately under the taxing power.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“actively engaged in the production of wheat” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 162&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 161–164&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="7361" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge71" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r58" target="r64" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="6119.0" /><mxPoint x="5519" y="7531.0" /></Array></mxGeometry></mxCell><mxCell id="r65" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Historical change and civil-rights legislation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Early decisions distinguished manufacture from commerce. Later statutes regulated hotel access and restaurant service.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the regulated class and connection to interstate travel or trade. Congressional motive to remedy discrimination does not defeat a valid commerce regulation. Private businesses can be reached through commerce even where Fourteenth Amendment enforcement alone would fail.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 139–143&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="7729" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge72" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r58" target="r65" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="6119.0" /><mxPoint x="5519" y="7894.0" /></Array></mxGeometry></mxCell><mxCell id="edge73" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s8" target="r58" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="6004.0" /><mxPoint x="4999" y="6119.0" /></Array></mxGeometry></mxCell><mxCell id="s9" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Taxing and spending&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 10 · pp. 165–184&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Is the federal government collecting money, authorizing expenditure, or attaching conditions?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="6366" width="400" height="150" as="geometry" /></mxCell><object id="backs9" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="6316" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs9" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Receipt or expenditure? Payment → tax or punishment. Grant → appropriation, recipient, notice, relation, constitutional limits and genuine choice.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="6530" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs9" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Taxing Power Q1–5 · Spending Power Q1–5&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="6648" width="400" height="82" as="geometry" /></mxCell><object id="nexts9" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Other powers and enforcement&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s10&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="6744" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r66" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Tax or punitive sanction?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;National Federation of Independent Business v. Sebelius&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The ACA payment was collected with returns, produced revenue, lacked a scienter requirement and left a lawful choice to pay.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine practical operation. Revenue, amount, collection machinery and consequences of nonpayment distinguish a tax from punishment. A tax may aim to alter behavior. Congress’s statutory label is not controlling.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“it produces at least some revenue for the Government” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 167&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 165–174&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="6366" width="400" height="380" as="geometry" /></mxCell><mxCell id="r67" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Criminal enforcement and a valid tax base&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Compare a criminal face-covering fine, a modest IRS vaccination assessment, and prison for knowingly understating taxable income.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A payment imposed as punishment for an unlawful act may fall outside the taxing power as a tax. Punishment of tax evasion can still be an appropriate means of collecting an independently valid tax. Identify the underlying power.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 167–174&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="6366" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge74" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r66" target="r67" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="6556.0" /><mxPoint x="3259" y="6521.0" /></Array></mxGeometry></mxCell><mxCell id="r68" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Real choice to pay?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A $250 assessment is collected with ordinary tax returns. A different law targets knowing violations, authorizes imprisonment and routes enforcement through criminal prosecution.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Assess the exaction as designed. A punitive amount, scienter and criminal enforcement point toward a penalty. Congress can impose a genuine revenue-raising tax on conduct it might lack power to command directly.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 166–174&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="6704" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge75" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r66" target="r68" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="6556.0" /><mxPoint x="3259" y="6854.0" /></Array></mxGeometry></mxCell><mxCell id="r69" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Direct taxes and income&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A hypothetical raises top marginal income rates or taxes existing net wealth. The problem expressly sets apportionment aside.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress may tax income without apportionment under the Sixteenth Amendment. Where the question preserves the issue, analyze direct-tax apportionment and geographic uniformity for duties, imposts and excises. Do not assume the wealth-tax classification has been resolved.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“taxes on incomes, from whatever source derived” · Amend. XVI · p. 28&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 165–174, 30&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="7032" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge76" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r66" target="r69" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="6556.0" /><mxPoint x="3259" y="7207.0" /></Array></mxGeometry></mxCell><mxCell id="edge77" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s9" target="r66" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="6441.0" /><mxPoint x="2739" y="6556.0" /></Array></mxGeometry></mxCell><mxCell id="r70" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Appropriation and private grants&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;DHS receives $2 billion for barriers and the President orders it to spend $7 billion. A nonprofit clinic takes funds limited to particular services.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Treasury expenditures need a congressional appropriation covering the amount and purpose. Congress may spend for the general welfare beyond its direct regulatory powers. Distinguish defining a funded program from conditioning support on surrender of rights outside it.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“in Consequence of Appropriations made by Law” · Art. I, §9, cl. 7 · p. 22&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 174–176&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="7410" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge78" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s9" target="r70" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="6441.0" /><mxPoint x="2739" y="7585.0" /></Array></mxGeometry></mxCell><mxCell id="r71" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Conditions on state grants&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;South Dakota v. Dole&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress conditioned a modest share of highway funds on adoption of a drinking age of 21.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask separately about general welfare, unambiguous notice, relation to the federal program, an independent constitutional bar and coercion. The funded objective and the condition must be identified concretely.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“pressure turns into compulsion” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 179&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 175–184&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="7788" width="400" height="320" as="geometry" /></mxCell><mxCell id="r72" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Notice, relation and independent bar&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A school grant expressly conditions aid on a gun-free zone. A different statute requires only a safe environment and an agency later demands criminalization.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Test what the state could knowingly accept. A condition can be sufficiently related even if Congress lacks power to command it directly. Congress may not induce a state to engage in independently unconstitutional conduct.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 176–182&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="7788" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge79" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r71" target="r72" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="7948.0" /><mxPoint x="3259" y="7938.0" /></Array></mxGeometry></mxCell><mxCell id="r73" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Coercion and remedy&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;National Federation of Independent Business v. Sebelius&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;States declining the ACA expansion faced loss of all existing Medicaid funds. Compare forfeiting only a new grant or a small portion of one program.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Evaluate size, dependence, surprise and change in kind. Threatening entrenched funding can eliminate genuine choice. The remedy barred withdrawal of existing Medicaid funds while allowing the new offer.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“penalize States that choose not to participate in that new program by taking away their existing Medicaid funding” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 183&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 182–184&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="8116" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge80" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r71" target="r73" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="7948.0" /><mxPoint x="3259" y="8306.0" /></Array></mxGeometry></mxCell><mxCell id="edge81" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s9" target="r71" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="6441.0" /><mxPoint x="2739" y="7948.0" /></Array></mxGeometry></mxCell><mxCell id="s10" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Other powers and enforcement&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 11 · pp. 185–202&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Identify the constitutional right, regulated actor, place or institution that supplies the power.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="6460" width="400" height="150" as="geometry" /></mxCell><object id="backs10" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="6410" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs10" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Right, actor, location or institution → select a grant → fit the means to the grant → test independent limits.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="6624" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs10" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Other Legislative Powers Q1–2&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="6742" width="400" height="82" as="geometry" /></mxCell><object id="nexts10" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Federal regulation of states&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s11&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="6838" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r74" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Fourteenth Amendment §5&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;City of Boerne v. Flores&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;RFRA imposed a broad statutory religious-exemption standard on state and local government after the Court had construed free exercise more narrowly.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress may enforce judicially recognized rights, including by prophylactic rules. Compare the record and pattern of violations with the statute’s breadth, duration, geographic reach and remedies. Congress cannot redefine the right.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a congruence and proportionality between the injury to be prevented or remedied and the means adopted to that end” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 190&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 185–196&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="6460" width="400" height="380" as="geometry" /></mxCell><mxCell id="r75" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Actual violation, overbreadth or private conduct?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A law targets intentional sex discrimination by state officers. A variant creates a remedy against a private assailant; another prohibits conduct assumed constitutionally permissible.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Direct enforcement of an actual state violation fits §5. For prophylaxis, show congruence and proportionality. §5 does not directly regulate wholly private misconduct. Separate public and private applications of a law reaching both.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 193–196&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="6460" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge82" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r74" target="r75" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="6650.0" /><mxPoint x="999" y="6625.0" /></Array></mxGeometry></mxCell><mxCell id="edge83" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s10" target="r74" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="6535.0" /><mxPoint x="479" y="6650.0" /></Array></mxGeometry></mxCell><mxCell id="r76" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Thirteenth Amendment §2 · private actors&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Runyon v. McCrary&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A private lender refuses mortgage loans because of race. The absence of state action would defeat reliance on Fourteenth Amendment §5.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress may rationally identify and address badges and incidents of slavery, including private racial discrimination. The statute’s reach must connect to slavery, involuntary servitude or their badges and incidents. A religion-only classification needs a different grant.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“operating upon the acts of individuals” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 197&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 196–197&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="6868" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge84" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s10" target="r76" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="6535.0" /><mxPoint x="479" y="7058.0" /></Array></mxGeometry></mxCell><mxCell id="r77" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Fifteenth Amendment §2 · voting discrimination&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress targets denial or abridgment of voting on account of race, color or previous condition of servitude.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the constitutional violation and evidence the enforcement measure addresses it. If particular jurisdictions face special preclearance burdens, examine the relation between present conditions and geographic coverage. The book reserves detailed §2 treatment for the supplement.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“on account of race, color, or previous condition of servitude” · Amend. XV, §1 · p. 28&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;pp. 197, 216–218 · supplement topic&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="7276" width="400" height="370" as="geometry" /></mxCell><mxCell id="edge85" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s10" target="r77" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="6535.0" /><mxPoint x="479" y="7461.0" /></Array></mxGeometry></mxCell><mxCell id="r78" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Elections, land, territory or citizenship?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Other Legislative Powers Q2 changes the regulated district, territory, institution or person.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Use each fact to locate an independent grant. More than one may suffice. The same underlying conduct can fall within federal power when Congress regulates federal property or a territory.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 197–199&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="7674" width="400" height="240" as="geometry" /></mxCell><mxCell id="r79" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Federal elections and courts&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress redraws U.S. House districts, also draws state legislative districts, or divides the Ninth Circuit.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Art. I, §4 permits alteration of congressional election rules. It does not itself govern state legislative districts. Art. I, §8, cl. 9 and Art. III, §1 support organizing inferior federal tribunals.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the Congress may at any time by Law make or alter such Regulations” · Art. I, §4, cl. 1 · p. 20&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 19–24, 58–60, 197–199&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="7674" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge86" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r78" target="r79" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="7794.0" /><mxPoint x="999" y="7819.0" /></Array></mxGeometry></mxCell><mxCell id="r80" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Federal land, D.C., territories and citizenship&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Violence occurs on federal parkland, in D.C., or in Guam. A citizenship rule concerns a child born abroad.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Federal parkland → Property Clause, Art. IV, §3, cl. 2. Territory → territorial power in the same clause. D.C. → Art. I, §8, cl. 17. Citizenship by statute for foreign-born children → uniform naturalization power, Art. I, §8, cl. 4.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“needful Rules and Regulations respecting the Territory or other Property” · Art. IV, §3, cl. 2 · p. 25&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 197–199&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="7992" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge87" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r78" target="r80" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="7794.0" /><mxPoint x="999" y="8167.0" /></Array></mxGeometry></mxCell><mxCell id="r81" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Other Article I powers&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Classify a law governing bankruptcy, currency, patents, the post or military supply.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Check borrowing, bankruptcy, coinage and counterfeiting, postal powers, limited-time intellectual property protection, war, armed forces and militia. Connect any ancillary regulation to the specific end under the Necessary and Proper Clause.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 197–199&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="8370" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge88" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r78" target="r81" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="7794.0" /><mxPoint x="999" y="8500.0" /></Array></mxGeometry></mxCell><mxCell id="edge89" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s10" target="r78" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="6535.0" /><mxPoint x="479" y="7794.0" /></Array></mxGeometry></mxCell><mxCell id="r82" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Treaty implementation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Missouri v. Holland&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The United States undertakes treaty obligations concerning migratory birds and Congress enacts implementing law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The President makes treaties with concurrence of two-thirds of senators present. Congress may enact appropriate implementing legislation for a valid treaty. Treaties cannot override constitutional rights. Check treaty scope and actual statutory authorization.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“cannot be accepted as a test of the treaty power” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 199&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 198–200&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="8658" width="400" height="360" as="geometry" /></mxCell><mxCell id="r83" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Treaty versus rights limitation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A treaty-implementing statute protects birds crossing national borders. Change the statute to deny an express individual constitutional protection.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A valid treaty can support appropriate legislation on matters beyond ordinary enumerated regulatory powers. It cannot confer authority to override constitutional prohibitions. Interpret the implementing statute before reaching that boundary.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 199–200&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="8658" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge90" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r82" target="r83" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="8838.0" /><mxPoint x="999" y="8798.0" /></Array></mxGeometry></mxCell><mxCell id="edge91" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s10" target="r82" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="6535.0" /><mxPoint x="479" y="8838.0" /></Array></mxGeometry></mxCell><mxCell id="r84" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Investigations and congressional immunity&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A committee compels testimony or records. A member invokes immunity for legislative conduct.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;An investigation must further a valid legislative purpose. Test scope, individual rights and separation of powers. Speech or Debate protects acts within the legislative sphere. Political advocacy, publicity and private conduct require separate analysis. The arrest privilege affords no general criminal immunity.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“for any Speech or Debate in either House” · Art. I, §6, cl. 1 · p. 20&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 200–202&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="9046" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge92" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s10" target="r84" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="6535.0" /><mxPoint x="479" y="9221.0" /></Array></mxGeometry></mxCell><mxCell id="s11" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Federal regulation of states&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 12 · pp. 203–218&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Does Congress regulate the state’s own conduct, direct its government, or offer a choice?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="8234" width="400" height="150" as="geometry" /></mxCell><object id="backs11" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="8184" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs11" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;State as regulated actor or sovereign regulator? → command, genuine choice or private federal rule → immunity and unequal burdens.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="8398" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs11" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Anti-Commandeering Q1–9&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="8516" width="400" height="82" as="geometry" /></mxCell><object id="nexts11" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Presidential power and accountability&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s12&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="8612" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r85" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Legislative commandeering&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;New York v. United States&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The radioactive-waste law required a state to regulate as instructed or take title to waste. Both alternatives imposed federal commands.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress may regulate private parties directly, preempt conflicting rules, offer eligible funding or let states regulate to federal standards in lieu of federal regulation. It cannot force a state legislature to administer a federal program.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“The Federal Government may not compel the States to enact or administer a federal regulatory program” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 210&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 203–215&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="8234" width="400" height="360" as="geometry" /></mxCell><mxCell id="r86" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Executive commandeering&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Printz v. United States&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Local officers must conduct federal background checks or detain and transfer people for federal enforcement.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Compelled state or local executive administration ordinarily violates dual sovereignty even when the tasks are temporary or ministerial. State judges have a distinct duty under Article VI to apply controlling federal law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“It matters not whether policymaking is involved” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 211&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 210–213&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="8234" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge93" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r85" target="r86" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="8414.0" /><mxPoint x="5519" y="8404.0" /></Array></mxGeometry></mxCell><mxCell id="r87" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State as employer, owner or operator&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Reno v. Condon&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal law covers public and private employers. Another regulates disclosure of drivers’ information by state database owners.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Regulating a state’s own activity can be permissible. Identify who must do what. Compliance by a state as employer, data supplier or waste generator differs from requiring it to govern other actors.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“in their sovereign capacity to regulate their own citizens” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 212&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 203–204, 211–213&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="8602" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge94" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r85" target="r87" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="8414.0" /><mxPoint x="5519" y="8772.0" /></Array></mxGeometry></mxCell><mxCell id="r88" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Preemption or forced retention?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Murphy v. NCAA&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress forbids states to authorize sports betting. Compare a federal prohibition on private conduct with a state’s repeal of its own drug prohibition.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Valid preemption rests on a federal rule governing private conduct or rights. Congress may not dictate the contents of a state legislature’s code merely by forbidding repeal. State decriminalization leaves a valid federal ban enforceable by federal authorities.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“It is as if federal officers were installed in state legislative chambers” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 215&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 213–215&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="8970" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge95" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r85" target="r88" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="8414.0" /><mxPoint x="5519" y="9150.0" /></Array></mxGeometry></mxCell><mxCell id="edge96" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s11" target="r85" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="8309.0" /><mxPoint x="4999" y="8414.0" /></Array></mxGeometry></mxCell><mxCell id="r89" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Equal state sovereignty&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Shelby County v. Holder&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Voting Rights Act preclearance depended on a coverage formula reflecting historic registration and turnout conditions.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Where Congress singles out states for extraordinary burdens on sovereign functions, examine whether geographic coverage is sufficiently related to the problem today. Distinguish invalidating the outdated coverage formula from invalidating every possible preclearance regime.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“imposes current burdens and must be justified by current needs” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 217&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 216–218&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="9358" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge97" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s11" target="r89" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="8309.0" /><mxPoint x="4999" y="9548.0" /></Array></mxGeometry></mxCell><mxCell id="r90" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State damages liability&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state is subject to a federal substantive rule, but a private plaintiff also seeks money from it.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Test valid regulation, clear congressional abrogation and an authority capable of overcoming immunity separately. Then consider prospective relief against an appropriate officer.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 215–216&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="9766" width="400" height="240" as="geometry" /></mxCell><mxCell id="edge98" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s11" target="r90" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="8309.0" /><mxPoint x="4999" y="9886.0" /></Array></mxGeometry></mxCell><mxCell id="s12" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Presidential power and accountability&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 13 · pp. 219–238&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;What exactly did the President do, what did Congress provide, and what relief is sought?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="8671" width="400" height="150" as="geometry" /></mxCell><object id="backs12" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="8621" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs12" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Identify the act → classify Congress’s posture → test independent Article II power → classify the remedy or privilege.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="8835" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs12" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Powers of the President Q1–8&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="8953" width="400" height="82" as="geometry" /></mxCell><object id="nexts12" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Appointment and removal&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s13&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="9049" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r91" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Source of executive authority&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Youngstown Sheet &amp;amp; Tube Co. v. Sawyer&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;During the Korean War, Truman ordered the seizure of domestic steel mills to avert a strike.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify statutory or constitutional authority for this particular act. The executive implements enacted policy. A perceived emergency or need for military supplies did not confer domestic lawmaking power.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“an act of Congress or from the Constitution itself” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 223&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 219–232&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="8671" width="400" height="320" as="geometry" /></mxCell><mxCell id="r92" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Category 1 · Congress authorizes&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Youngstown Sheet &amp;amp; Tube Co. v. Sawyer · Jackson, J., concurring&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal prosecutor enforces a criminal statute as enacted.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the express or implied delegation, its conditions, Congress’s power to legislate and any independent constitutional limit. Presidential authority operates at its maximum when supported by both branches.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“his authority is at its maximum” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 225&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 225–231&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="8671" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge99" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r92" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="8841.0" /></Array></mxGeometry></mxCell><mxCell id="r93" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Category 2 · Congress is silent&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Youngstown Sheet &amp;amp; Tube Co. v. Sawyer · Jackson, J., concurring&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The statute leaves the precise action unresolved. The executive relies on its own functions and historical practice.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Determine whether Congress truly left room for independent action. Concurrent authority, historical acquiescence and practical context matter. A statute addressing the subject can imply approval or opposition.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a zone of twilight in which he and Congress may have concurrent authority” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 226&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 225–231&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="9039" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge100" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r93" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="9229.0" /></Array></mxGeometry></mxCell><mxCell id="r94" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Category 3 · Congress opposes&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Youngstown Sheet &amp;amp; Tube Co. v. Sawyer · Jackson, J., concurring&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The executive acts contrary to a statutory mandate or a legislative scheme that implicitly rejects the chosen means.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Power is at its lowest ebb. To prevail, the President needs an exclusive constitutional power over this act that disables Congress from imposing its contrary rule. Identify the competing Article I power.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“his power is at its lowest ebb” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 226&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 225–234&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="9447" width="400" height="340" as="geometry" /></mxCell><mxCell id="r95" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Recognition of sovereignty&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Zivotofsky v. Kerry&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress required a Jerusalem passport designation inconsistent with the executive’s recognition determination. Compare a military-aid law dictating official statements about Crimea.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Formal recognition of governments and territorial sovereignty belongs exclusively to the President. Congress retains independent powers over foreign commerce, appropriations and related foreign affairs. Separate the funding provision from the compelled recognition.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“speak with one voice” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 233&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 232–234&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3854" y="9447" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge101" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r94" target="r95" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3779" y="9617.0" /><mxPoint x="3779" y="9637.0" /></Array></mxGeometry></mxCell><mxCell id="edge102" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r94" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="9617.0" /></Array></mxGeometry></mxCell><mxCell id="r96" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Nonenforcement and impoundment&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Enforcement resources permit only a fraction of removals. In a second problem Congress expressly requires spending, but the President objects to the program.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Good-faith priority setting may be necessary within appropriations and delegated discretion. Analyze statutory text, scope and practical constraints. A categorical suspension or refusal to spend mandatory funds for policy reasons poses a different Take Care problem.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“he shall take Care that the Laws be faithfully executed” · Art. II, §3 · p. 24&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 220–232, 281–283&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="9855" width="400" height="370" as="geometry" /></mxCell><mxCell id="edge103" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r96" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="10040.0" /></Array></mxGeometry></mxCell><mxCell id="r97" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Command of armed forces&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A domestic seizure is defended as necessary to supply troops.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Separate operational command from Congress’s powers to declare war, raise and fund forces, and prescribe military rules. Apply the statutory posture to the specific act. Domestic industry does not become a theater of military command merely because its output supports war.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“The President shall be Commander in Chief” · Art. II, §2, cl. 1 · p. 23&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 19–23, 232 · supplement topic&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="10253" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge104" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r97" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="10418.0" /></Array></mxGeometry></mxCell><mxCell id="r98" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Genuine constitutional objection?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The President believes a mandatory foreign-aid statute violates Article II. In the alternative, the objection is simply that the program wastes funds.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the asserted exclusive power and the strength of the conflict. State the competing Take Care and constitutional-oath arguments. A sincere belief alone does not establish exclusive authority or resolve the law’s validity.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 220–232, 283–284&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="10611" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge105" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r98" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="10751.0" /></Array></mxGeometry></mxCell><mxCell id="r99" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Statute and discretion to spend&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An agency may select among aid projects. The President refuses to fund any project under a mandatory appropriation.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish a ceiling, discretion within a program, and a command to spend a specified amount. Read operative verbs, deadlines and any statutory withholding authority. Identify the resulting category of presidential power.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 174–175, 220–232, 281–283&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="10919" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge106" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r91" target="r99" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="8831.0" /><mxPoint x="3259" y="11059.0" /></Array></mxGeometry></mxCell><mxCell id="edge107" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s12" target="r91" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="8746.0" /><mxPoint x="2739" y="8831.0" /></Array></mxGeometry></mxCell><mxCell id="r100" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Reprieves and pardons&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A family member receives a pardon, possibly before indictment. Identify when the offense occurred and which sovereign would prosecute.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The President may pardon completed federal offenses, including before charges or conviction. The pardon power does not extend to future offenses, state crimes or impeachment. Criminal clemency does not itself extinguish independent civil claims.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“for Offences against the United States, except in Cases of Impeachment” · Art. II, §2, cl. 1 · p. 23&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 234–235&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="11227" width="400" height="330" as="geometry" /></mxCell><mxCell id="r101" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional limit on family pardons?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress prohibits a President from pardoning relatives for completed federal crimes.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The grant identifies its own subject and express impeachment exception. A statutory exclusion of an additional class collides with the President’s exclusive clemency power. Distinguish a state prosecution outside that power.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 234–235&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="11227" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge108" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r100" target="r101" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="11392.0" /><mxPoint x="3259" y="11357.0" /></Array></mxGeometry></mxCell><mxCell id="edge109" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s12" target="r100" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="8746.0" /><mxPoint x="2739" y="11392.0" /></Array></mxGeometry></mxCell><mxCell id="r102" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Damages, prosecution or disclosure?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Nixon v. Fitzgerald&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A fired DOJ attorney seeks damages from the President personally, then seeks a declaration that her termination was unlawful.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Civil damages immunity covers presidential acts within the outer perimeter of official responsibility. It does not confer immunity for unofficial conduct. A challenge to legality or a request for prospective relief requires separate analysis of standing, defendant and remedy.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“absolute Presidential immunity from damages liability” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 235&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 235–238&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="11585" width="400" height="380" as="geometry" /></mxCell><mxCell id="r103" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Criminal proceedings&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Trump v. United States&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Identify whether prosecution concerns a sitting or former President and whether the charged act was official.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;DOJ takes the position that a sitting President may not be federally prosecuted while in office. For a former President, classify the act. Core exclusive powers receive absolute immunity; other official acts receive at least presumptive immunity, rebuttable only absent danger of intrusion on executive functions. Unofficial acts receive none. Classify conduct objectively.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“courts may not inquire into the President’s motives” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 237&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 236–238&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="11585" width="400" height="420" as="geometry" /></mxCell><mxCell id="edge110" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r102" target="r103" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="11775.0" /><mxPoint x="3259" y="11795.0" /></Array></mxGeometry></mxCell><mxCell id="r104" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Executive privilege&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A prosecutor seeks confidential communications for a criminal trial.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the communication, purpose and competing evidentiary need. Presidential confidentiality is qualified. A generalized interest in secrecy can yield to a demonstrated, specific need in a criminal proceeding.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 238&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="12033" width="400" height="260" as="geometry" /></mxCell><mxCell id="r105" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Impeachment subpoena and diplomacy&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The House seeks a presidential recording of a meeting with a foreign leader as evidence in an impeachment inquiry.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Explain both interests: direct presidential diplomacy strengthens confidentiality; specific evidence of alleged self-dealing needed for the House’s constitutional function strengthens disclosure. Consider alternative evidence and the feasibility of narrowing the demand. A criminal-trial precedent does not automatically settle this dispute.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 119–120, 238&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3854" y="12033" width="400" height="320" as="geometry" /></mxCell><mxCell id="edge111" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r104" target="r105" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3779" y="12163.0" /><mxPoint x="3779" y="12193.0" /></Array></mxGeometry></mxCell><mxCell id="edge112" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r102" target="r104" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="11775.0" /><mxPoint x="3259" y="12163.0" /></Array></mxGeometry></mxCell><mxCell id="edge113" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s12" target="r102" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="8746.0" /><mxPoint x="2739" y="11775.0" /></Array></mxGeometry></mxCell><mxCell id="s13" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Appointment and removal&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 14 · pp. 239–258&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Which duties does the official actually perform? Who selected the officer and who controls removal?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="9571" width="400" height="150" as="geometry" /></mxCell><object id="backs13" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="9521" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs13" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Function → officer or employee → principal or inferior → actual appointer. For removal, follow the chain of control separately.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="9735" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs13" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Appointment Q1–5 · Removal Q1–6&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="9853" width="400" height="82" as="geometry" /></mxCell><object id="nexts13" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Delegation, legislative veto and presentment&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s14&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="9949" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r106" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Officer or employee?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Lucia v. SEC&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;SEC ALJs held continuing statutory positions, conducted adversarial hearings, took testimony, ruled on evidence and issued decisions.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A continuing federal office plus significant authority under federal law triggers the Appointments Clause. Analyze functions and discretion. Advising Congress or performing subordinate clerical work presents a different case.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“significant authority pursuant to the laws of the United States” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 242&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 239–245&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="9571" width="400" height="360" as="geometry" /></mxCell><mxCell id="r107" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Principal or inferior?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Kennedy v. Braidwood Management, Inc.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Preventive-services task-force recommendations carried legal consequences. The Secretary could supervise the members and review recommendations before they bound others.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Test direction and supervision, including review, removal and whether decisions are final for the United States. The title, reporting line and practical importance of the work do not alone resolve status.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“directed and supervised at some level by others” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 248&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 245–257&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="9571" width="400" height="340" as="geometry" /></mxCell><mxCell id="r108" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Who made the appointment?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The FDA Commissioner reports to HHS but makes some final decisions. A subordinate director’s decisions are reviewable.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Nomination by the President with Senate confirmation is valid for principal and inferior officers. For inferior officers only, Congress may by law vest appointment in the President alone, a court of law or a department head.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the Congress may by Law vest the Appointment of such inferior Officers” · Art. II, §2, cl. 2 · p. 24&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 239–240, 254–257&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1594" y="9571" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge114" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r107" target="r108" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1519" y="9741.0" /><mxPoint x="1519" y="9736.0" /></Array></mxGeometry></mxCell><mxCell id="r109" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Agency chief or department head?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An FDA Commissioner selects a reviewable division director. Change whether the HHS Secretary must approve that selection.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Locate the constitutional department. A subordinate bureau chief does not become a department head by exercising supervision. Determine who legally makes the final appointment and whether Congress vested it there.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 254–257&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1594" y="9929" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge115" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r107" target="r109" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1519" y="9741.0" /><mxPoint x="1519" y="10069.0" /></Array></mxGeometry></mxCell><mxCell id="edge116" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r106" target="r107" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="9751.0" /><mxPoint x="999" y="9741.0" /></Array></mxGeometry></mxCell><mxCell id="r110" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Legislative assistance only?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A microchip adviser reports to Congress. A variant gives the adviser binding authority over private firms.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Congress may choose staff to assist its legislative work. If the position exercises significant federal executive authority, Congress cannot retain appointment through legislative leaders. Reclassify the office if its duties change.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 239–245, 257&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="10237" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge117" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r106" target="r110" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="9751.0" /><mxPoint x="999" y="10367.0" /></Array></mxGeometry></mxCell><mxCell id="edge118" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s13" target="r106" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="9646.0" /><mxPoint x="479" y="9751.0" /></Array></mxGeometry></mxCell><mxCell id="r111" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Who can remove whom?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A statute gives an at-will Attorney General authority to remove a subordinate. Another statute gives Congress removal control over a Comptroller.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Map every link: executive or legislative duties, officer or employee, remover, at-will or for-cause protection, review and intervening supervisors. Congress may not reserve removal of officers executing federal law outside impeachment. Pure legislative research changes the analysis.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;p. 257 · supplement topic; Removal Q1–6&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="10525" width="400" height="300" as="geometry" /></mxCell><mxCell id="r112" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Principal executive officer or subordinate?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Compare protected commissioners exercising binding executive power, a reviewable general counsel, and staff attorneys.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;For a principal officer exercising executive power, test impairment of presidential removal control. A multimember structure alone does not establish validity. For inferior officers, examine supervision, review and tenure protections at every level. Ordinary employees require a separate inquiry.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;p. 257 · existing Executive tab; Removal Q1–2, 5–6&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="10525" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge119" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r111" target="r112" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="10675.0" /><mxPoint x="999" y="10690.0" /></Array></mxGeometry></mxCell><mxCell id="r113" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;One layer or two?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The general counsel is protected for cause. Ask whether the commissioners who supervise that officer are themselves protected.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Two effective layers of for-cause insulation can prevent presidential accountability. If the superior is removable at will, reassess the single restriction. For a congressionally removable official, a cause requirement does not cure congressional control over execution.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;p. 257 · existing Executive tab; Removal Q3–6&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="10883" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge120" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r111" target="r113" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="10675.0" /><mxPoint x="999" y="11033.0" /></Array></mxGeometry></mxCell><mxCell id="edge121" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s13" target="r111" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="9646.0" /><mxPoint x="479" y="10675.0" /></Array></mxGeometry></mxCell><mxCell id="s14" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Delegation, legislative veto and presentment&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 15 · pp. 259–284&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Is the dispute about the scope of the statute, the delegation itself, or a later change in law?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="10181" width="400" height="150" as="geometry" /></mxCell><object id="backs14" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="10131" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs14" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Statutory scope → major question → delegation limits. For later alterations of legal rights, test bicameralism and presentment.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="10345" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs14" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Legislative Vetoes Q1–4 · Line-Item Veto Q1–3&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="10463" width="400" height="82" as="geometry" /></mxCell><object id="nexts14" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Federal immunity and preemption&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s15&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="10559" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r114" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Did Congress authorize this action?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An agency invokes general language as authority for a decision of exceptional political and economic significance.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Read text and context first. For extraordinary claims of delegated power, seek clear congressional authorization. History, scale, novelty and the agency’s customary role matter. Failure of authorization can resolve the case without invalidating the statute.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 259–271&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="10181" width="400" height="280" as="geometry" /></mxCell><mxCell id="r115" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Major questions and tariffs&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Learning Resources, Inc. v. Trump · Roberts, C.J., plurality on this issue&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The President claimed IEEPA’s import-regulation language authorized broad tariffs. Other tariff delegations used explicit terms and limits.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The Court found IEEPA did not confer this tariff power. Three justices used major-questions reasoning in this portion. Distinguish their rationale from the judgment and from ordinary statutory interpretation.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“broad, expansive power on an uncertain statutory basis” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 268&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 266–271&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="10181" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge122" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r114" target="r115" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="10321.0" /><mxPoint x="5519" y="10371.0" /></Array></mxGeometry></mxCell><mxCell id="r116" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Is the delegation itself constitutional?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Whitman v. American Trucking Associations, Inc.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress directed EPA to set standards requisite to protect public health with an adequate margin of safety.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the policy, regulated subject and boundaries that guide the delegate. An intelligible principle generally suffices; required guidance depends on the scope of discretion. Agency self-restraint cannot cure a standardless grant.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“intelligible principle” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 262&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 259–266&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="10589" width="400" height="340" as="geometry" /></mxCell><mxCell id="edge123" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r114" target="r116" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="10321.0" /><mxPoint x="5519" y="10759.0" /></Array></mxGeometry></mxCell><mxCell id="edge124" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s14" target="r114" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="10256.0" /><mxPoint x="4999" y="10321.0" /></Array></mxGeometry></mxCell><mxCell id="r117" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Does congressional action change outside legal rights?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;INS v. Chadha&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The House overturned the Attorney General’s suspension of Chadha’s deportation.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Determine whether the action is legislative in purpose and effect. Binding alteration of outside legal rights generally requires passage by both houses and presentment to the President, subject to expressly assigned constitutional functions.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“altering the legal rights, duties, and relations of persons” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 277&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 271–281&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="10957" width="400" height="360" as="geometry" /></mxCell><mxCell id="r118" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Veto by one house, both houses or committee?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;INS v. Chadha&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;One chamber, both chambers without presentment, or a committee blocks a grant. A variant only requires a report and a waiting period.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Count both steps. Bicameral approval alone leaves presentment unsatisfied. Advisory objections and report-and-wait provisions leave legal authority with the executive unless Congress enacts a new law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“passage by a majority of both Houses and presentment” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 278&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 275–281&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="10957" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge125" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r117" target="r118" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="11137.0" /><mxPoint x="5519" y="11137.0" /></Array></mxGeometry></mxCell><mxCell id="edge126" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s14" target="r117" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="10256.0" /><mxPoint x="4999" y="11137.0" /></Array></mxGeometry></mxCell><mxCell id="r119" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Whole-bill veto or post-enactment cancellation?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Compare separately presented spending bills with an omnibus law allowing selected enacted items to be canceled.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The President may sign or veto each presented bill in full. After enactment, canceling statutory provisions changes the law outside Article I, §7. Distinguish cancellation from exercising spending discretion that the enacted law itself creates.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“if not he shall return it” · Art. I, §7, cl. 2 · p. 21&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 281–283&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="11345" width="400" height="330" as="geometry" /></mxCell><mxCell id="r120" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Signing statements and objections&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The President signs legislation but states that an application would intrude on Article II.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A signing statement may announce an interpretation or constitutional position. It cannot excise text or change legal effect by itself. Analyze the underlying constitutional objection and subsequent execution separately.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 283–284&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="11345" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge127" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r119" target="r120" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="11510.0" /><mxPoint x="5519" y="11475.0" /></Array></mxGeometry></mxCell><mxCell id="edge128" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s14" target="r119" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="10256.0" /><mxPoint x="4999" y="11510.0" /></Array></mxGeometry></mxCell><mxCell id="s15" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Federal immunity and preemption&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 16 · pp. 285–308&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Does state law burden the United States itself, discriminate against federal interests, or conflict with federal law?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="11358" width="400" height="150" as="geometry" /></mxCell><object id="backs15" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="11308" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs15" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Federal government or officer burdened? → direct incidence or discrimination. Competing laws? → express, field and both conflict routes.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="11522" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs15" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Preemption Q1–5 · Meaning of McCulloch Q2–6&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="11640" width="400" height="82" as="geometry" /></mxCell><object id="nexts15" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Dormant Commerce Clause&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s16&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="11736" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r121" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Direct regulation or taxation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A per-dose vaccine tax is legally imposed on the federal operator. Counties also become liable in a variant.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Absent congressional consent, a state generally cannot impose a tax or regulation directly on the United States. Equal treatment of county operators does not cure a direct federal tax. Identify legal incidence, not who ultimately bears the economic cost.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 285–289&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="11358" width="400" height="300" as="geometry" /></mxCell><mxCell id="r122" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Federal officer prosecuted by a state&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal officer invokes federal duties after an arrest or use of force.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask whether federal law authorized the officer’s function and whether the conduct was necessary and proper in performing it. Examine the officer’s honest and objectively reasonable understanding and any excess beyond the federal duty.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 287–289&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="11358" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge129" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r121" target="r122" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="11508.0" /><mxPoint x="999" y="11488.0" /></Array></mxGeometry></mxCell><mxCell id="r123" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Discrimination against federal employees&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Dawson v. Steager&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;West Virginia exempted comparable state law-enforcement retirees while taxing a retired federal marshal.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Compare similarly situated federal and state personnel. Ask whether significant differences in job duties justify the tax distinction. A narrow exemption or a benign characterization does not answer the comparator question.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“significant differences between the two classes” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 290&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 289–294&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="11646" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge130" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r121" target="r123" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="11508.0" /><mxPoint x="999" y="11826.0" /></Array></mxGeometry></mxCell><mxCell id="edge131" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s15" target="r121" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="11433.0" /><mxPoint x="479" y="11508.0" /></Array></mxGeometry></mxCell><mxCell id="r124" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Express or implied displacement?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal labeling law and a state efficiency standard apply to the same mower.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify valid federal law, its coverage and purpose. Read express preemption and saving clauses precisely. In traditional state fields, consider the presumption against displacement as appropriate. Shared subject matter alone does not establish preemption.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 294–297&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="12034" width="400" height="280" as="geometry" /></mxCell><mxCell id="r125" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Field preemption&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Pacific Gas &amp;amp; Electric Co. v. State Energy Resources Conservation &amp;amp; Development Commission&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Federal law occupied nuclear safety regulation, while California conditioned nuclear plant construction on waste-disposal feasibility for economic reasons.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Define the occupied field at the right level of specificity. A state measure falling within it is displaced even without direct contradiction. Examine the actual rationale and the authority Congress left to states.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“we accept California’s avowed economic purpose” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 303&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 295–306&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="12034" width="400" height="400" as="geometry" /></mxCell><mxCell id="edge132" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r124" target="r125" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="12174.0" /><mxPoint x="999" y="12234.0" /></Array></mxGeometry></mxCell><mxCell id="r126" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Conflict · impossibility or obstacle?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Federal law requires at least time-and-a-half overtime. A city requires double time for covered workers.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Can a regulated person comply with both? Double time satisfies this federal minimum. Separately ask whether Congress intended a ceiling or the state rule frustrates a federal objective. Federal silence alone ordinarily does not confer a right to act free of state regulation.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 294–306&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="12462" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge133" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r124" target="r126" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="12174.0" /><mxPoint x="999" y="12612.0" /></Array></mxGeometry></mxCell><mxCell id="r127" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Savings clause or affirmative federal protection?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal statute exempts motor carriers from state price, route or service regulation. A state constitution purports to authorize conduct federal law forbids.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask whether Congress conferred a private right to operate free of specified regulation. Federal preemption may be worded as a limit on states. State permission can mean only absence of state punishment. If it purports to create immunity from federal prosecution, it yields to the extent of conflict.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 294–297, 304–307&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="12790" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge134" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r124" target="r127" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="12174.0" /><mxPoint x="999" y="12955.0" /></Array></mxGeometry></mxCell><mxCell id="r128" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State law applied in state court?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Doe v. Dynamic Physical Therapy, LLC&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state-law immunity is raised as a defense to a federal cause of action.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Article VI obliges state judges to give the federal rule controlling effect. Identify the particular state provision or application displaced and address remaining claims under their own law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a State has no power to confer immunity from federal causes of action” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 138&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 137–138, 294–297&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="13148" width="400" height="320" as="geometry" /></mxCell><mxCell id="edge135" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r124" target="r128" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="12174.0" /><mxPoint x="999" y="13308.0" /></Array></mxGeometry></mxCell><mxCell id="edge136" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s15" target="r124" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="11433.0" /><mxPoint x="479" y="12174.0" /></Array></mxGeometry></mxCell><mxCell id="s16" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Dormant Commerce Clause&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 17 · pp. 309–338&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Who imposed the measure? Is the state regulating a market, and who receives the economic advantage?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="11850" width="400" height="150" as="geometry" /></mxCell><object id="backs16" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="11800" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs16" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Congressional authorization? → market participant and downstream limit → discrimination or evenhanded burden → justification or undue burden.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="12014" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs16" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Discrimination Q1–7 · Concluding Dormant Commerce Clause Q1–6&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="12132" width="400" height="82" as="geometry" /></mxCell><object id="nexts16" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Interstate citizenship and judgments&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s17&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="4554" y="12228" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r129" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional action or authorization?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Congress bans specified interstate waste shipments. In a different problem a state imposes the restriction.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The dormant doctrine constrains state and local action. For Congress’s own rule, test affirmative federal power. Congress may authorize otherwise discriminatory state measures if its intention is unmistakably clear. Check the authorization’s scope.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 309–311, 337–338&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="11850" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge137" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s16" target="r129" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="11925.0" /><mxPoint x="4999" y="11980.0" /></Array></mxGeometry></mxCell><mxCell id="r130" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;State as buyer, seller or regulator?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Reeves, Inc. v. Stake&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;South Dakota owned a cement plant and prioritized local purchasers during a shortage.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A state participating in an existing market may ordinarily prefer residents in its own purchases or sales. Identify the product, the transaction and the participants. Selling business licenses exercises sovereign regulatory authority.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“between States as market participants and States as market regulators” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 334&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 332–338&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="12138" width="400" height="340" as="geometry" /></mxCell><mxCell id="r131" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Downstream restrictions&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;South-Central Timber Development, Inc. v. Wunnicke · plurality&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Alaska sold state-owned raw timber on condition that a specified share be processed in Alaska.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;(1) Alaska participated in the timber-sale market. (2) Its condition controlled later processing in a separate market. The exception ended at that boundary. The local-processing preference therefore faced discrimination review and failed.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“within the market in which it is a participant, but allows it to go no further” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 337&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 337–338&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="12138" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge138" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r130" target="r131" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="12308.0" /><mxPoint x="5519" y="12318.0" /></Array></mxGeometry></mxCell><mxCell id="r132" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Government services and outsider claims&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A county operates its own landfill or vaccination clinic and offers residents a better price.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify an existing market and distinguish a price for the government’s own service from a levy or mandate on private providers. Even if market participation resolves the commerce claim, analyze Article IV separately for a qualifying nonresident citizen.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 332–338, 345–351&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="12526" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge139" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r130" target="r132" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="12308.0" /><mxPoint x="5519" y="12671.0" /></Array></mxGeometry></mxCell><mxCell id="edge140" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s16" target="r130" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="11925.0" /><mxPoint x="4999" y="12308.0" /></Array></mxGeometry></mxCell><mxCell id="r133" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Discrimination by origin, purpose or effect?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Philadelphia v. New Jersey&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;New Jersey barred most out-of-state waste while permitting local waste of the same kind.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Compare similarly situated in-state and interstate interests. An origin-based barrier discriminates even if the underlying health or conservation objective is legitimate. Localities also cannot isolate themselves from interstate trade.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“some reason, apart from their origin, to treat them differently” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 314&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 311–328&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="12844" width="400" height="360" as="geometry" /></mxCell><mxCell id="r134" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Facially neutral preference&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Bacchus Imports, Ltd. v. Dias&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Hawaii exempted certain locally produced beverages from an otherwise applicable excise tax.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine discriminatory purpose and practical effect. A narrow product category can protect local industry without using residency language. Uneven effects alone are insufficient: identify the favored local competitor and the economic disadvantage.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“to subsidize nonexistent (pineapple wine) and financially troubled (okolehao) liquor industries peculiar to Hawaii” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 319&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 317–323&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="12844" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge141" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r133" target="r134" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="13024.0" /><mxPoint x="5519" y="13024.0" /></Array></mxGeometry></mxCell><mxCell id="r135" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Exceptionally justified discrimination?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state bars imported live baitfish because parasites cannot reliably be detected. A city instead insists that milk be pasteurized locally.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Require a legitimate nonprotectionist purpose that cannot adequately be served by reasonable nondiscriminatory alternatives. Compare inspection, testing or evenhanded quality rules. Some burden on local sellers does not cure discrimination against outsiders.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 314–317&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="13232" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge142" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r133" target="r135" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="13024.0" /><mxPoint x="5519" y="13382.0" /></Array></mxGeometry></mxCell><mxCell id="r136" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Government facility or private beneficiary?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;United Haulers Association v. Oneida-Herkimer Solid Waste Management Authority&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A flow-control ordinance directs all waste to a public facility and treats competing private haulers alike.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Preference for a public facility carrying out a traditional government function can fall outside discriminatory treatment where private enterprises receive equal treatment. Compare a privately favored processor. Continue to undue burdens when appropriate.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“treating all private companies exactly the same” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 325&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 323–328&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="13560" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge143" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r133" target="r136" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="13024.0" /><mxPoint x="5519" y="13750.0" /></Array></mxGeometry></mxCell><mxCell id="r137" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Disadvantage to firms or interstate commerce?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An evenhanded product ban mostly hurts out-of-state producers because few local firms sell the product. Or a tax exemption is drawn to protect a local substitute.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Compare the economic interests competing before and after enactment. Identify a local benefit at an interstate rival’s expense. Disproportionate business losses alone do not establish discrimination, but purpose or market effects may reveal protectionism.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 311–322, 328–330&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="13968" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge144" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r133" target="r137" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="13024.0" /><mxPoint x="5519" y="14123.0" /></Array></mxGeometry></mxCell><mxCell id="edge145" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s16" target="r133" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="11925.0" /><mxPoint x="4999" y="13024.0" /></Array></mxGeometry></mxCell><mxCell id="r138" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Evenhanded rule → undue burden&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Pike v. Bruce Church, Inc.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state imposes an unusual truck-length or equipment requirement. A fireworks ban applies to local and imported products.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify the specific burden on interstate trade and the putative local benefits. Invalidate if the burden is clearly excessive in relation to those benefits. Delays, rerouting, incompatible standards, exemptions and weak safety evidence matter. Out-of-state firms losing sales alone do not establish the burden.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“clearly excessive in relation to the putative local benefits” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 328&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 328–330&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5074" y="14306" width="400" height="380" as="geometry" /></mxCell><mxCell id="r139" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Direct extraterritorial control?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Compare rules governing pork sold in-state with a registration condition dictating benefits for employees working entirely outside the state.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Out-of-state production effects alone do not invalidate a rule for in-state transactions. Examine whether the state directly dictates wholly external transactions, discriminates, or imposes an undue interstate burden. Identify the local transaction and precise reach.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 330–332&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="5594" y="14306" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge146" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r138" target="r139" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="5519" y="14496.0" /><mxPoint x="5519" y="14446.0" /></Array></mxGeometry></mxCell><mxCell id="edge147" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s16" target="r138" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4999" y="11925.0" /><mxPoint x="4999" y="14496.0" /></Array></mxGeometry></mxCell><mxCell id="s17" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Interstate citizenship and judgments&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 18 · pp. 339–368&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Is the claimant visiting, newly resident, or seeking recognition of another state’s judgment?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="12528" width="400" height="150" as="geometry" /></mxCell><object id="backs17" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="12478" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs17" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Visitor, new citizen or sister-state judgment? → identify the protected interest → apply the corresponding test.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="12692" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs17" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Privileges and Immunities Q1–8&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="12810" width="400" height="82" as="geometry" /></mxCell><object id="nexts17" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;State action and incorporation&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s18&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="12906" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r140" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Article IV · visitor’s protected privilege&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Toomer v. Witsell&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;South Carolina charged nonresident commercial shrimpers a much higher license fee. Compare a paid hiking guide with recreational camping.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify an out-of-state natural-person citizen and discrimination concerning a privilege fundamental to interstate harmony, including earning a livelihood. Recreational access and political membership stand differently. Corporations cannot assert this personal Article IV protection.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“no substantial reason for the discrimination beyond the mere fact that they are citizens of other States” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 341&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 339–345&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="12528" width="400" height="380" as="geometry" /></mxCell><mxCell id="r141" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Substantial reason and fit&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state attributes higher conservation costs to nonresident commercial fishers.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;State must show a substantial reason beyond nonresidency and a substantial relationship between discrimination and the asserted problem. Ask whether outsiders are a peculiar source of the harm and whether less restrictive means would address it.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 340–345&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="12528" width="400" height="260" as="geometry" /></mxCell><mxCell id="edge148" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r140" target="r141" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="12718.0" /><mxPoint x="3259" y="12658.0" /></Array></mxGeometry></mxCell><mxCell id="r142" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;City ordinance or public construction&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;United Building &amp;amp; Construction Trades Council v. Mayor and Council of Camden&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Camden reserved jobs on city-funded construction for city residents, burdening both out-of-state citizens and some New Jersey residents.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Municipal action is state action for Article IV. Evaluate the opportunity to pursue a common calling and the city’s justification. Market participation supplies no categorical exception. Remand for justification did not establish automatic invalidity.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the pursuit of a common calling is one of the most fundamental of those privileges” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 348&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 345–352&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="12816" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge149" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r140" target="r142" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="12718.0" /><mxPoint x="3259" y="13006.0" /></Array></mxGeometry></mxCell><mxCell id="edge150" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s17" target="r140" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="12603.0" /><mxPoint x="2739" y="12718.0" /></Array></mxGeometry></mxCell><mxCell id="r143" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Fourteenth Amendment · new resident&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Saenz v. Roe&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;California limited a newly arrived resident’s welfare payment by the amount available in the former state.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish interstate movement, visitor treatment and equal citizenship after establishing residence. A bona fide new citizen generally receives the same rights as longer-term citizens. Budget savings alone do not justify a waiting-period penalty.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the right to be treated like other citizens of that State” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 356&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 352–361&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="13224" width="400" height="340" as="geometry" /></mxCell><mxCell id="r144" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Actual residence or duration requirement?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A state limits local services to current residents. A second program excludes otherwise eligible people for their first year of residence.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A bona fide residence requirement raises different concerns from a durational penalty. Consider portable benefits such as subsidized tuition and legitimate verification of residence. Identify who is excluded and why.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 343–345, 355–361&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="13224" width="400" height="310" as="geometry" /></mxCell><mxCell id="edge151" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r143" target="r144" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="13394.0" /><mxPoint x="3259" y="13379.0" /></Array></mxGeometry></mxCell><mxCell id="r145" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Residence, citizenship and political office&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A school district excludes nonresidents, then adds a citizenship requirement. Texas reserves elected office to residents. A benefits program disadvantages newly arrived residents.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Separate political membership, eligibility to use resident services, alienage and the right to migrate. Article IV protects citizens of other states. An alienage classification can raise an independent equal-protection question; a new resident can invoke equal state citizenship.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 339–345, 352–361&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="13562" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge152" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r143" target="r145" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="13394.0" /><mxPoint x="3259" y="13737.0" /></Array></mxGeometry></mxCell><mxCell id="edge153" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s17" target="r143" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="12603.0" /><mxPoint x="2739" y="13394.0" /></Array></mxGeometry></mxCell><mxCell id="r146" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Full Faith and Credit · final judgment&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;V. L. v. E. L.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Alabama refused to honor a Georgia adoption judgment because it disagreed with the rendering court’s application of adoption law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A final judgment rendered with jurisdiction generally merits recognition even if erroneous or offensive to forum policy. Distinguish lack of adjudicatory authority from a merits mistake. Do not convert every mandatory statutory rule into a jurisdictional limit.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the full faith and credit obligation is exacting” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 364&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 361–366&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="13940" width="400" height="340" as="geometry" /></mxCell><mxCell id="r147" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Sister-state substantive law&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A worker’s injury, employment contract and employer connect a dispute with different states.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish judgments from legislative acts. A state with a legitimate connection ordinarily may apply its own substantive law despite a conflicting sister-state rule. Identify the forum’s contacts and interest.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Full Faith and Credit shall be given in each State” · Art. IV, §1 · p. 25&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 362, 366–368&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="13940" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge154" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r146" target="r147" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="14110.0" /><mxPoint x="3259" y="14085.0" /></Array></mxGeometry></mxCell><mxCell id="edge155" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s17" target="r146" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="12603.0" /><mxPoint x="2739" y="14110.0" /></Array></mxGeometry></mxCell><mxCell id="s18" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;State action and incorporation&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 19 · pp. 369–388&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Does a constitutional restriction reach this defendant, and through which provision?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="13643" width="400" height="150" as="geometry" /></mxCell><object id="backs18" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="13593" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs18" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Identify the actor → attribute private conduct if necessary → locate an applicable guarantee → identify the route to the states.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="13807" width="400" height="106" as="geometry" /></mxCell><object id="nexts18" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Takings and compensation&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s19&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="14021" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r148" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Governmental conduct or attributable private action?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Manhattan Community Access Corp. v. Halleck&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A private nonprofit operating public-access cable channels excluded producers. The city had designated the operator.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Most constitutional rights constrain government. For private conduct test an exclusive public function, government compulsion or significant encouragement, and joint action. Licensing, public accessibility, subsidy or extensive regulation alone does not suffice.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the government must have traditionally and exclusively performed the function” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 373&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 369–377&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="13643" width="400" height="400" as="geometry" /></mxCell><mxCell id="r149" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Public function, coercion or joint participation?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A private operator hosts speech. Compare administration of an election, a company town, or a private decision compelled by government.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Define the exact function and ask whether government traditionally and exclusively performed it. Alternatively connect government to the specific act through coercion, encouragement, participation or enforcement. Government’s general relationship with the actor is insufficient.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 370–377&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="13643" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge156" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r148" target="r149" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="13843.0" /><mxPoint x="999" y="13808.0" /></Array></mxGeometry></mxCell><mxCell id="r150" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Independent regulation of private conduct&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An employer is private. The plaintiff invokes a federal civil-rights statute or the Thirteenth Amendment.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Distinguish a direct constitutional claim from a statutory entitlement Congress validly created. The Thirteenth Amendment reaches private slavery. For a statute, identify the power permitting Congress to regulate that private conduct.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 369–371, 195–197&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="14001" width="400" height="290" as="geometry" /></mxCell><mxCell id="edge157" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r148" target="r150" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="13843.0" /><mxPoint x="999" y="14146.0" /></Array></mxGeometry></mxCell><mxCell id="edge158" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s18" target="r148" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="13718.0" /><mxPoint x="479" y="13843.0" /></Array></mxGeometry></mxCell><mxCell id="r151" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Federal or state defendant?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Timbs v. Indiana&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A federal officer imposes a fine. In the second version a state seeks forfeiture of a vehicle after a conviction.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;The Bill of Rights originally bound the federal government. For a state or local defendant identify the particular guarantee and whether the Fourteenth Amendment’s Due Process Clause incorporates it. The Excessive Fines Clause applies to the states.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“fundamental to our scheme of ordered liberty” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 383&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 377–386&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="14319" width="400" height="320" as="geometry" /></mxCell><mxCell id="r152" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Selective incorporation and national citizenship&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A claimant relies on a Bill of Rights guarantee against a state or invokes the Fourteenth Amendment’s Privileges or Immunities Clause.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;For incorporation ask whether the right is fundamental to ordered liberty and deeply rooted in American history and tradition. Apply the incorporated guarantee to the state. Privileges or Immunities chiefly protects national citizenship, including interstate migration. Grand-jury indictment and civil jury trial are familiar unincorporated guarantees.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 378–388&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="14319" width="400" height="350" as="geometry" /></mxCell><mxCell id="edge159" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r151" target="r152" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="14479.0" /><mxPoint x="999" y="14494.0" /></Array></mxGeometry></mxCell><mxCell id="edge160" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s18" target="r151" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="13718.0" /><mxPoint x="479" y="14479.0" /></Array></mxGeometry></mxCell><mxCell id="s19" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Takings and compensation&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 20.A · pp. 389–426&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Identify the property interest and the government act. What was appropriated, restricted or demanded?&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="14455" width="400" height="150" as="geometry" /></mxCell><object id="backs19" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="14405" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs19" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Physical appropriation, use restriction or exaction? → apply that threshold → test public use → determine compensation.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="14619" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs19" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Identifying a Taking Q1–6 · Concluding Takings Q1–3&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="14737" width="400" height="82" as="geometry" /></mxCell><object id="nexts19" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Continue →&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Contracts, retroactivity and legislative punishment&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;s20&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2294" y="14833" width="400" height="60" as="geometry" /></mxCell></object><mxCell id="r153" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Physical appropriation or access right?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Cedar Point Nursery v. Hassid&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;California granted union organizers a recurring right to enter growers’ land. Compare an imposed public beach easement limited to daytime.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;A government appropriation of title, possession or the right to exclude is generally a per se taking, including access for third parties. Intermittent access can qualify. Identify the right taken even where the public use is legitimate.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“appropriates for the enjoyment of third parties the owners’ right to exclude” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 394&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 389–401&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="14455" width="400" height="360" as="geometry" /></mxCell><mxCell id="r154" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Occupation, incidental entry or regulation?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A company is authorized to install equipment inside homes. A variant requires each owner to buy and monitor a detector.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Third-party occupation of even a small space points to a physical taking. An owner-installation mandate alone does not grant outsiders possession. Distinguish isolated trespass, background access privileges and reasonable conditions attached to benefits.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 390–401&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="14455" width="400" height="330" as="geometry" /></mxCell><mxCell id="edge161" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r153" target="r154" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="14635.0" /><mxPoint x="3259" y="14620.0" /></Array></mxGeometry></mxCell><mxCell id="edge162" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s19" target="r153" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="14530.0" /><mxPoint x="2739" y="14635.0" /></Array></mxGeometry></mxCell><mxCell id="r155" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Total deprivation of land use?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Lucas v. South Carolina Coastal Council&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A coastal regulation barred building on Lucas’s lots. Compare a reduction from 100 possible homes to 95.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Determine whether the parcel as a whole has lost all economically beneficial use. If yes, compensation ordinarily follows unless preexisting background principles of state property or nuisance law already forbade the use. A large partial loss proceeds to balancing.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“all economically beneficial or productive use of land” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 404&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 401–410&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="14843" width="400" height="360" as="geometry" /></mxCell><mxCell id="r156" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Partial regulatory taking&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Penn Central Transportation Co. v. New York City&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A landmark restriction barred a tower above Grand Central Terminal while its existing use continued.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Consider economic impact, interference with distinct investment-backed expectations, and character of the government action. Determine the relevant parcel as a whole. No fixed percentage of lost value resolves the inquiry.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“essentially [an] ad hoc factual inquir[y]” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 408&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 403–410&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="14843" width="400" height="320" as="geometry" /></mxCell><mxCell id="edge163" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r155" target="r156" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="15023.0" /><mxPoint x="3259" y="15003.0" /></Array></mxGeometry></mxCell><mxCell id="r157" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Time, parcel and notice&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A temporary development moratorium restricts all building. A buyer acquired property after an existing restriction.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Do not isolate a temporal slice to establish total loss. Evaluate temporary use restrictions in context. A completed temporary taking can require compensation for its duration. Post-regulation acquisition is relevant to expectations but does not categorically bar the claim.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 408–410&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="15191" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge164" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r155" target="r157" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="15023.0" /><mxPoint x="3259" y="15341.0" /></Array></mxGeometry></mxCell><mxCell id="edge165" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s19" target="r155" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="14530.0" /><mxPoint x="2739" y="15023.0" /></Array></mxGeometry></mxCell><mxCell id="r158" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Permit condition · unconstitutional exaction?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Sheetz v. County of El Dorado&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A county required a legislatively prescribed traffic-impact fee for a building permit. A coastal agency asks for a public easement.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;First ask whether the demand would implicate a compensable taking if imposed directly. If so, require an essential nexus to a legitimate impact of the project and rough proportionality in nature and extent. Legislative enactment alone provides no exemption.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“does not distinguish between legislative and administrative permit conditions” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 413&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 410–418&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="15519" width="400" height="380" as="geometry" /></mxCell><mxCell id="r159" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Connection, scale and denial&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Dolan v. City of Tigard&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An easement for lateral beach access is justified by lost views. A separate project generates some traffic but the government demands extensive land or money.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Explain precisely how the demand addresses this project’s effects and whether its extent is supported. An unrelated public benefit fails nexus. A related but excessive demand can fail proportionality. Refusal of a permit for rejecting an improper demand can trigger scrutiny.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“degree of connection between the exactions and the projected impact of the proposed development” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 411&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 410–418&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="15519" width="400" height="400" as="geometry" /></mxCell><mxCell id="edge166" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r158" target="r159" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="15709.0" /><mxPoint x="3259" y="15719.0" /></Array></mxGeometry></mxCell><mxCell id="r160" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Nexus to the asserted regulatory interest&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Nollan v. California Coastal Commission&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Replacing a small house with a larger one allegedly obstructs the ocean view. The agency demands lateral passage along the beach.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Ask whether the concession addresses the same objective that would justify denying the proposed project. The lateral-access condition did not remedy a visual obstruction. Reaching proportionality requires an adequate nexus first.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“unless the permit condition serves the same governmental purpose as the development ban” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 410&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 410–411&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="15947" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge167" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r158" target="r160" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="15709.0" /><mxPoint x="3259" y="16137.0" /></Array></mxGeometry></mxCell><mxCell id="edge168" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s19" target="r158" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="14530.0" /><mxPoint x="2739" y="15709.0" /></Array></mxGeometry></mxCell><mxCell id="r161" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Public use and compensation&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Kelo v. City of New London&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;New London took land under an integrated economic-development plan, ultimately transferring property to private entities.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Once a taking is found, ask whether it serves a genuine public purpose. Deference to the plan permits private implementation. A pretext for conferring a private benefit is insufficient. Then determine compensation independently.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the mere pretext of a public purpose” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 422&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 418–426&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="2814" y="16355" width="400" height="340" as="geometry" /></mxCell><mxCell id="r162" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Valuation and remedy&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;United States v. Miller&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A county takes a hotel for public-health housing or acquires only an easement. An owner values the property above its market price.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Just compensation generally measures the fair market value of the interest taken at the time of taking. Identify the owner’s loss and the scope and duration of the interest. A valid public purpose does not remove the duty to pay.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the full and perfect equivalent in money of the property taken” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 418&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 418–419&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="16355" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge169" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r161" target="r162" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="16525.0" /><mxPoint x="3259" y="16535.0" /></Array></mxGeometry></mxCell><mxCell id="r163" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Public benefit or pretext?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A city acquires several parcels for private redevelopment under a comprehensive plan. Contrast a taking designed solely to favor an identifiable private recipient.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Test the genuine public purpose and evidence of pretext. Economic development can qualify under the federal Constitution. State law may impose a stricter public-use limit.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 419–427&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="3334" y="16743" width="400" height="280" as="geometry" /></mxCell><mxCell id="edge170" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r161" target="r163" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3259" y="16525.0" /><mxPoint x="3259" y="16883.0" /></Array></mxGeometry></mxCell><mxCell id="edge171" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s19" target="r161" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2739" y="14530.0" /><mxPoint x="2739" y="16525.0" /></Array></mxGeometry></mxCell><mxCell id="s20" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Contracts, retroactivity and legislative punishment&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Ch. 20.B–D · pp. 427–440&lt;/div&gt;&lt;div style=&quot;font:15px/1.3 Helvetica,Arial;margin-top:9px&quot;&gt;Identify the lawmaker, the date of the underlying conduct or contract, and the burden imposed.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="14844" width="400" height="150" as="geometry" /></mxCell><object id="backs20" label="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;↑  Course outline&lt;/div&gt;" link="data:action/json,{&quot;actions&quot;:[{&quot;scroll&quot;:{&quot;cells&quot;:[&quot;start&quot;]}}]}"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="14794" width="170" height="38" as="geometry" /></mxCell></object><mxCell id="seqs20" value="&lt;div style=&quot;font:15px/1.35 Helvetica;color:#d1e6e7&quot;&gt;Contract, retrospective penal law or legislative punishment? → identify actor and chronology → apply each relevant test.&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1c2629;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="15008" width="400" height="106" as="geometry" /></mxCell><mxCell id="pracs20" value="&lt;div style=&quot;text-align:center;font: bold 18px Helvetica,Arial&quot;&gt;Problem set&lt;/div&gt;&lt;div style=&quot;text-align:center;font:14px/1.3 Helvetica,Arial;margin-top:5px&quot;&gt;Contracts Clause Q1–5 · Ex Post Facto Q1–6&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#192226;strokeColor=#587579;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="34" y="15126" width="400" height="82" as="geometry" /></mxCell><mxCell id="r164" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Contracts Clause · existing obligation?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Nevada caps student-loan interest at 8%. Compare an agreement made before enactment with a loan made one month later.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Article I, §10 limits state and local laws impairing existing obligations. Identify contract formation and enactment dates. A federal cap requires a different constitutional theory. A later contract is made against the existing law.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“Law impairing the Obligation of Contracts” · Art. I, §10, cl. 1 · p. 22&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 427–430&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="14844" width="400" height="330" as="geometry" /></mxCell><mxCell id="r165" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Substantial impairment?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Allied Structural Steel Co. v. Spannaus&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;An existing loan promises 12%. A temporary eviction moratorium delays a remedy while rent remains owing.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Examine the bargain, reasonable expectations, magnitude and duration of the change and ability to protect or reinstate rights. If impairment is substantial, test justification. A change in remedies can matter even if the underlying debt survives.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a substantial impairment of a contractual relationship” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 428&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 427–429&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="14844" width="400" height="360" as="geometry" /></mxCell><mxCell id="r166" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Private-party contract&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Energy Reserves Group, Inc. v. Kansas Power &amp;amp; Light Co.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A city temporarily postpones evictions to prevent displacement and disease transmission.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Require a significant and legitimate public purpose and a reasonable, appropriate adjustment of contractual rights. Courts give substantial deference to policy choices affecting private agreements. Evaluate scope, duration and burdens.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a significant and legitimate public purpose behind the regulation” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 429&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 428–430&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1594" y="14844" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge172" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r165" target="r166" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1519" y="15024.0" /><mxPoint x="1519" y="15024.0" /></Array></mxGeometry></mxCell><mxCell id="r167" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Government’s own contract&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;United States Trust Co. v. New Jersey&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Cook County cancels a Wi-Fi contract and bars further payments after a revenue shortfall.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;When government impairs its own obligation, self-interest warrants closer scrutiny of reasonableness and necessity. Consider foreseeable risks, less drastic alternatives and actual fiscal need. Distinguish legislative impairment from an ordinary breach for which the contractual remedy remains available.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“the State’s self-interest is at stake” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 430&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 429–430&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1594" y="15232" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge173" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r165" target="r167" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1519" y="15024.0" /><mxPoint x="1519" y="15412.0" /></Array></mxGeometry></mxCell><mxCell id="edge174" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r164" target="r165" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="15009.0" /><mxPoint x="999" y="15024.0" /></Array></mxGeometry></mxCell><mxCell id="edge175" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s20" target="r164" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="14919.0" /><mxPoint x="479" y="15009.0" /></Array></mxGeometry></mxCell><mxCell id="r168" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Ex post facto · retrospective punishment?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A pharmacist dispenses a drug before a prohibition but possesses remaining stock after it takes effect.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Both federal and state legislatures are constrained. Identify the charged conduct and compare its date with the change. A later ban cannot criminalize earlier dispensing. Continuing possession after the effective date supplies a new factual basis.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“No Bill of Attainder or ex post facto Law shall be passed” · Art. I, §9, cl. 3 · p. 22&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 430–439&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="15620" width="400" height="330" as="geometry" /></mxCell><mxCell id="r169" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Type of disadvantage?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A later law aggravates the offense, increases punishment, lowers the quantum of evidence needed for conviction or eliminates a substantive defense.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Identify a retrospective penal change that disadvantages the accused in a prohibited way. Purely civil economic retroactivity and ordinary procedural changes do not automatically qualify. For nominally civil sanctions examine punitive purpose or effect.&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 430–432&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="15620" width="400" height="300" as="geometry" /></mxCell><mxCell id="edge176" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r168" target="r169" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="15785.0" /><mxPoint x="999" y="15770.0" /></Array></mxGeometry></mxCell><mxCell id="r170" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Higher sentencing range&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Peugh v. United States&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;Peugh was sentenced under a later, harsher advisory guideline range. The problem set moves a statutory range from 2–5 years to 5–10 years.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Apply the range in effect at the offense. A later framework posing a sufficient risk of increased punishment can violate the clause even if advisory or the sentence falls within both ranges. Show how the benchmark changed.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“a significant risk that he would receive a higher sentence” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 435&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 432–439&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="15948" width="400" height="360" as="geometry" /></mxCell><mxCell id="edge177" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r168" target="r170" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="15785.0" /><mxPoint x="999" y="16128.0" /></Array></mxGeometry></mxCell><mxCell id="r171" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Extending or reviving limitations?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Stogner v. California&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;The legislature enlarges the charging period before it expires, or revives a selfie prosecution after the original period elapsed.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Compare offense, original expiration, amendment and charging dates. Revival after the criminal limitations period expired violates the prohibition. The Court expressly reserved extension of a still-open period. On Q6, identify that distinction and explain why the revival holding no longer controls.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“after a certain time, no quantum of evidence is sufficient to convict” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 439&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 438–439&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="1074" y="16336" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge178" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="r168" target="r171" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="999" y="15785.0" /><mxPoint x="999" y="16526.0" /></Array></mxGeometry></mxCell><mxCell id="edge179" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s20" target="r168" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="14919.0" /><mxPoint x="479" y="15785.0" /></Array></mxGeometry></mxCell><mxCell id="r172" value="&lt;div style=&quot;text-align:left;font:15px/1.27 Helvetica,Arial,sans-serif;color:#f5f5f5&quot;&gt;&lt;div style=&quot;text-align:center;font-size:19px;line-height:1.2&quot;&gt;&lt;b&gt;&lt;u&gt;Bill of attainder?&lt;/u&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:16px;line-height:1.2;margin-top:4px&quot;&gt;&lt;i&gt;Nixon v. Administrator of General Services&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;border-top:1px solid #8a9093;margin:9px 0 0;padding-top:9px&quot;&gt;A legislature identifies a person or readily ascertainable group and imposes an adverse consequence without a judicial trial.&lt;/div&gt;&lt;div style=&quot;margin-top:8px&quot;&gt;Require legislative specificity, punishment and absence of judicial trial. Consider historical punishments, nonpunitive purposes reasonably served and evidence of punitive intent. Separate individualized legislative punishment from a generally applicable prospective qualification.&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-size:14px;color:#c9e1e3&quot;&gt;“whether the legislative record evinces a congressional intent to punish” &lt;span style=&quot;white-space:nowrap&quot;&gt;· p. 440&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:7px;font-size:12px;color:#b3b7ba&quot;&gt;Joondeph, pp. 439–440&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E0E3E3;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="554" y="16744" width="400" height="380" as="geometry" /></mxCell><mxCell id="edge180" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b4c3c6;strokeWidth=1.5;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;" edge="1" source="s20" target="r172" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="479" y="14919.0" /><mxPoint x="479" y="16934.0" /></Array></mxGeometry></mxCell><mxCell id="cond-r17" value="District court" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Helvetica;fontSize=10;fontColor=#CADBDC;labelBackgroundColor=#151719;" vertex="1" connectable="0" parent="edge24"><mxGeometry x="1" width="75" height="16" relative="1" as="geometry"><mxPoint x="-76" y="-18" as="offset" /></mxGeome