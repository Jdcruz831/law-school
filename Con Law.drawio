        <mxCell id="HdfO-nH2aJV_gOckw8U0-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;14th Amendment §5&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Equal protection, due process, and incorporated Bill of Rights protections&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;against state and local government action&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="1840" y="850" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-10" edge="1" parent="1" source="HdfO-nH2aJV_gOckw8U0-5" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HdfO-nH2aJV_gOckw8U0-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-12" connectable="0" parent="HdfO-nH2aJV_gOckw8U0-10" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=17;" value="&lt;i&gt;Callais&lt;/i&gt;" vertex="1">
