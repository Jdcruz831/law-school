        <mxCell id="nGnvCsMC4TkzJVelY6of-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Article I&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Legislative Branch&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="60" y="270" as="geometry" />
        </mxCell>
