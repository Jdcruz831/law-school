        <mxCell id="ltZLwBbUF2npR7WB0Q-s-53" connectable="0" parent="ltZLwBbUF2npR7WB0Q-s-37" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Discrimination&amp;nbsp;" vertex="1">
          <mxGeometry relative="1" x="-0.0865" y="-1" as="geometry">
            <mxPoint x="-1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-34" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Public vs. Private&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;United Haulers&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;a law&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;avoring a public provider&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;traditional governmental function&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;treating all private competitors equally&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;u&gt;is not discriminatory&lt;/u&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Counties required waste haulers to deliver garbage to publicly owned processing facilities. Private processors, local and out-of-state, received the same treatment&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="410" x="-520" y="760" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-39" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-32" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-38" value="">
          <mxGeometry relative="1" as="geometry">
