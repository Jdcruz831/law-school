        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Necessary &amp;amp; Proper&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;Article I, §8, clause 18&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Joondeph pp. 121–138; McCulloch, 17 U.S. at 421; NFIB, 567 U.S. at 559–560." id="congress-final-means">
