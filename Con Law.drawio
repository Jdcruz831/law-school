        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-20" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-11" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C0olnXspH3CQYHDvb34H-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-22" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-11" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;fillColor=#60a917;strokeColor=#2D7600;" target="9A686LOlzWrqTdymGBHn-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bypassing State Sovereign Immunity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. State Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Implicit Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. Appeals of State Court Judgments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. Congressional Abrogation&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="8470" y="810" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;State Consent &amp;amp; Waiver&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Statutory Waiver&lt;/b&gt; :&amp;nbsp;A state can waive immunity via a statute w/&amp;nbsp;&quot;unmistakably clear&quot; language&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Federal Spending Programs&lt;/b&gt;: Congress can condition the receipt of federal funds on a state&#39;s waiver of Eleventh Amendment immunity&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Litigation Conduct:&lt;/b&gt;&amp;nbsp;he state voluntarily chooses to remove the case to federal court, the state forfeits its Eleventh Amendment immunity&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="290" x="8050" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Implicit Consent&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the states implicitly surrendered their sovereign immunity to a narrow list of lawsuits:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought by sister states&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought by the federal government&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Claims arising in bankruptcy proceedings&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Eminent domain condemnation proceedings brought by private delegates&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought under federal statutes enacted under Congress&#39;s authority to build and maintain a national military&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="280" x="8395" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional Abrogation&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress has the power to pass statutes that strip states of their sovereign immunity, only if in section 5 powers.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="9050" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Appeals of State Court Judgments&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Cohens v. Virginia&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- does not bar the U.S. Supreme Court from exercising its appellate jurisdiction to review state court judgments on federal issues&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- only when state is defendant&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="8720" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-7" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-23" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-26" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-31" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Standing&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&amp;nbsp;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Injury in Fact&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Causation/ traceability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Redressability&amp;nbsp;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Notes:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Non-waivible&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Sue sponte requirement for federal courts to check for standing always&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Must persist throughout&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="320" x="4660" y="1813.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-5" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Multi-party &amp;amp; Provision&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Multiple plaintiffs&lt;/b&gt;: only one needs standing for a suit to be heard.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- however for relief each plaintiff &lt;/span&gt;must have standing for that relief sought&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Multiple Provisions&lt;/b&gt;: standing for one provisions, does not grant to another provision that does not affect them.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Standing on appeal: injury must be fairly trainable to the judgment from below.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="195" width="230" x="5030" y="1730" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-11" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-16" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-18" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Injury in Fact&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&amp;nbsp;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: medium; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Concrete (not abstract)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Particularized (individual effect)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Actual or Imminent (not hypothetical)&amp;nbsp;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Notes:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Non-waivible&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Sue sponte requirement for federal courts to check for standing always&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Must persist throughout&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="310" x="4450" y="2053.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-13" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-10" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Concreteness vs. Particularization&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Spokeo v. Robins (2016)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- Plaintiff&#39;s information being published was particularized because it was personal, but the concreteness of the harm was inadequate. &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Has to traditionally been recognized under American law.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="4160" y="2143.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&amp;nbsp;&quot;Injury in law is not injury in fact&quot;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;TransUnion LLC v. Ramirez (2021)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- Just because congress passes a statue giving a right of action does not automatically translate to injury in fact. &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="4090" y="2333.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Aesthetic injuries&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Summers v. Earth Island Institute (2009)&lt;/i&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Original individual had standing becuse of imminent plans to visit the ridge, however lost standing to challenge actual regulation after the issue with the ridge was settled&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- some day intentions is not enough.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Aesthetic is enough, but has to be imminent plans.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="250" x="4360" y="2283.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Other&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Organization has standing when&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) at least one member has standing in their own right&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) the lawsuit is germane to the organizations&lt;/span&gt; &lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;purpose.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- government has standing to prosecute crimes or civil enforcement due to it&#39;s sovereignty&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Third-party standing: Typically not allowed, but sometimes like in health care.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="335" x="4470" y="2473.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-22" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-20" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4833" y="2003.12" as="sourcePoint" />
            <mxPoint x="4887" y="2393.12" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Chain of Causation&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Allen v. Wright (1984)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Parents of Black public school children sued the IRS, alleging it failed to enforce its own rules denying tax-exempt status to racially discriminatory private schools [331, 333]. The parents claimed that this unlawful tax exemption subsidized &quot;white flight&quot; academies, which drew white students out of desegregating public schools&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Cognizable Injury, But No chain of causation&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="320" x="5030" y="2003.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-28" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-24" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-27" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Relief-Specific Standing&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Los Angeles v. Lyons (1983&lt;/i&gt;&lt;/span&gt;&lt;i&gt;)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;standing for each form of relief&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="4660" y="2243.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-27" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Relaxed Standard&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Relaxed if congress gives a right to a specific hearing.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="4760" y="2363.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-34" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-29" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-33" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-29" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Ripeness &amp;amp;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Mootness&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Ripeness -&lt;/b&gt; asks if a suit is brought too soon (standing does not yet exist because the injury is speculative or has not occurred)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Mootness -&lt;/b&gt; asks if a suit is brought too late (standing has disappeared because the injury has resolved or been cured)&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="5010" y="2243.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-33" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Pre-enforcement&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Susan B. Anthony List v. Driehaus&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Can&amp;nbsp;challenge criminal suit:&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;an intention to engage in a course of conduct arguably affected with a constitutional interest&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;hat conduct is proscribed by a statute&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;there exists a credible threat of prosecution under the statute&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="350" x="4890" y="2473.12" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-41" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-38" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-40" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-43" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-38" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-38" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;The Political Questions Doctrine&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Zivotofsky v. Clinton (2012)&lt;/i&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The federal judiciary is cannot hear matters that would impede on the other branches separation.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;These are constitutional disputes that are vested in the &quot;political&quot; branches exclusively and explicitly&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Two Prongs:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &lt;b&gt;Textual Commitment&lt;/b&gt;: Whether there is a textually demonstrable constitutional commitment of the issue to a coordinate political department&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;&lt;b&gt;Unmanageable Standards&lt;/b&gt;: Whether there is a lack of judicially discoverable and manageable standards for resolving the dispute&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="380" x="5610" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-40" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Constitutional vs merits&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Zivotofsky v. Clinton (2012)&lt;/i&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Case: Ruled court can hear because not asking the judiciary to make a decision on the merit&#39;s of the law, just if it&#39;s constitutional&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="116.25" width="400" x="5340" y="1673.75" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-42" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;The Political Questions Doctrine&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Rucho v. Common Cause (2019&lt;/i&gt;&lt;/span&gt;&lt;i&gt;)&lt;/i&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Plaintiffs challenged state electoral maps drawn by partisan majorities, arguing that &quot;packing&quot; and &quot;cracking&quot; voters to maximize party seats violated the First Amendment and the Equal Protection Clause&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;court said it&#39;s nonjusticiable political question for the political branches&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="390" x="5780" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-47" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-44" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-49" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-44" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-48" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-44" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Random Exceptions&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) The Political Questions Doctrine&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Adequate and Independent State Grounds (A.I.S.G.)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="6020" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-48" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Adequate and Independent State Grounds (A.I.S.G.)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Supreme Court may not review a state court judgment that rests on a state-law holding that is both&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Adequate: Sufficient, on its own, to support the final judgment (meaning that even if the federal-law issue is reversed, the outcome remains unchanged) [425, 426].&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Independent: Formulated entirely separate from federal-law interpretations, rather than relying on federal precedents&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="320" x="6040" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-54" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-51" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-53" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-3" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-51" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-7" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-51" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-11" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-51" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bpNmOR_SoLcWIGrnu4r9-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-24" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-51" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-23" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-51" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;§8&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Enumerated powers&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- 1. The Congress shall have Power To lay and collect Taxes, Duties, Imposts and Excises, to&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;pay the Debts and provide for the common Defence and general Welfare of the United States;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;but all Duties, Imposts and Excises shall be uniform throughout the United States;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. To borrow Money on the credit of the United States;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. To regulate Commerce with foreign Nations, and among the several States, and with the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Indian Tribes;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. To establish an uniform Rule of Naturalization, and uniform Laws on the subject of Bank-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ruptcies throughout the United States;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;5. To coin Money, regulate the Value thereof, and of foreign Coin, and fix the Standard of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Weights and Measures;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;6. To provide for the Punishment of counterfeiting the Securities and current Coin of the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;United States;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;7. To establish Post Offices and post Roads;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;8. To promote the Progress of Science and useful Arts, by securing for limited Times to Authors&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and Inventors the exclusive Right to their respective Writings and Discoveries;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;9. To constitute Tribunals inferior to the supreme Court;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;10. To define and punish Piracies and Felonies committed on the high Seas, and Of-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;fences against the Law of Nations;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;11. To declare War, grant Letters of Marque and Reprisal, and make Rules concerning Cap-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;tures on Land and Water;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;12. To raise and support Armies, but no Appropriation of Money to that Use shall be for a&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;longer Term than two Years;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;13. To provide and maintain a Navy;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;14. To make Rules for the Government and Regulation of the land and naval Forces;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;15. To provide for calling forth the Militia to execute the Laws of the Union, suppress Insur-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;rections and repel Invasions;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;16. To provide for organizing, arming, and disciplining, the Militia, and for governing such&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Part of them as may be employed in the Service of the United States, reserving to the States&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;respectively, the Appointment of the Officers, and the Authority of training the Militia accord-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ing to the discipline prescribed by Congress;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;17. To exercise exclusive Legislation in all Cases whatsoever, over such District (not exceed-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ing ten Miles square) as may, by Cession of particular States, and the Acceptance of Congress,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;become the Seat of the Government of the United States, and to exercise like Authority over&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;all Places purchased by the Consent of the Legislature of the State in which the Same shall&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;be, for the Erection of Forts, Magazines, Arsenals, dock-Yards, and other needful Buildings;—&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;And&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;18. To make all Laws which shall be necessary and proper for carrying into Execution the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;foregoing Powers, and all other Powers vested by this Constitution in the Government of the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;United States, or in any Department or Officer thereof.&lt;/p&gt;" vertex="1">
          <mxGeometry height="610" width="550" x="-3580" y="580" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-53" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Foundations of Congressional Power&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;McCulloch v. Maryland&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Issue 1: Does Congress have the power to charter a national bank?&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The Omission of &quot;Expressly&quot; in the Tenth Amendment, meaning Congress has the power to enforce the enumerated powers it was given.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Issue 2: Can Maryland tax the bank&#39;s operations?&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;The Supremacy Axiom: The Constitution and valid laws made in pursuance thereof are supreme over the states&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The Power to Destroy: &quot;The power to tax involves the power to destroy.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-when Maryland taxes the national bank, it taxes an entity created by the people of all states for the benefit of one states&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- federal immunity is what came from that.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="480" x="-3200" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="oQBPyLlifDMNVyRZqu1i-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Aggregate economic consequences&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Wickard v. Filburn&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Wheat case &lt;i&gt;:&lt;/i&gt;&lt;/b&gt;&amp;nbsp;Growing wheat for home consumption reduces the demand for wheat in the commercial market &amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Can be reached by Congress if the aggregate effect of everyone similarly situated nationwide has a substantial economic effect on interstate commerce &quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="460" x="-3840" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="oQBPyLlifDMNVyRZqu1i-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Commerce Clause Civil Rights&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Heart of Atlanta Motel v. United States:&lt;/i&gt;&amp;nbsp;on racial discrimination in public accommodations,&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Katzenbach v. McClung&lt;/i&gt; :&amp;nbsp;Ollie&#39;s Barbecue, a local family restaurant in Birmingham, Alabama [526]. Although the restaurant served only local customers, a substantial portion of the food it served ($70,000 of meat annually) had traveled in interstate commerce&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="460" x="-4905" y="1475" as="geometry" />
        </mxCell>
        <mxCell id="okMoveg5JXnLUUQTt713-15" edge="1" parent="1" source="okMoveg5JXnLUUQTt713-12" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="okMoveg5JXnLUUQTt713-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="okMoveg5JXnLUUQTt713-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000, #77bb41);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Amendment X&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;The powers not delegated to the United States by the Constitution, nor prohibited by it to the States, are reserved to the States respectively, or to the people.&quot;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="7700" y="270" as="geometry" />
        </mxCell>
        <mxCell id="okMoveg5JXnLUUQTt713-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Anti-Commandeering Doctrine&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i style=&quot;text-align: left;&quot;&gt;New York v. United States&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- The Commerce Clause authorizes Congress to regulate private interstate activity directly, but it **does not authorize Congress to regulate state governments&#39; regulation of interstate commerce&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Congress lacks the constitutional power to &quot;commandeer the legislative processes of the States by directly compelling them to enact and enforce a federal regulatory program&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="7700" y="460" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-5" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-1" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Taxing Clause&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8, Clause 1&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Congress shall have Power To lay and collect Taxes, Duties, Imposts and Excises&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="-4140" y="530" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-2" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-4" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bpNmOR_SoLcWIGrnu4r9-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;#1 Spending Clause&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8, Clause 1&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;to pay the Debts and provide for the common Defence and general Welfare of the United States; but all Duties, Imposts and Excises shall be uniform throughout the United States&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="-4110" y="100" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-5" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-6" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="c0eh9S0Abd1rjmFVfu8c-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&amp;nbsp;Commerce Clause&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8, Clause 3&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;To regulate Commerce with foreign Nations, and among the several States, and with the&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Indian Tribes&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="390" x="-4140" y="810" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-12" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-9" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-14" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-9" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-6" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-9" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="oQBPyLlifDMNVyRZqu1i-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-7" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-9" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="oQBPyLlifDMNVyRZqu1i-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-13" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-9" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bpNmOR_SoLcWIGrnu4r9-12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;The Current Framework&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&amp;nbsp;&lt;i&gt;United States v. Lopez&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Gun regulation case:&amp;nbsp;&lt;/b&gt;The government linked guns at school to crime, insurance costs, impaired education, and reduced national productivity. The constitutional problem was the absence of a meaningful stopping point:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Three&amp;nbsp;categories:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;Channels of interstate commerce: highways, telecommunications *&lt;i&gt;language&amp;nbsp;it&#39;s self does not establish&lt;/i&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Instrumentalities, persons, or things in interstate commerce:&amp;nbsp;Airplanes, trucks, interstate shipments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;Activities substantially affecting interstate commerce&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;Economic activity&lt;/i&gt;: Aggregation may establish substantial effects.&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;i&gt;Noneconomic activity&lt;/i&gt;: Aggregate economic consequences alone generally do not suffice under&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="615" x="-4445" y="980" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;LOCAL, NONCOMMERCIAL CONDUCT&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Gonzales v. Raich&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Locally grown weed case:&amp;nbsp;&lt;/b&gt;Congress may reach local, noncommercial instances when reasonably concluding that exempting them would undermine a valid broader regulation of an interstate market.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Relevant considerations:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Marijuana is a fungible commodity.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Locally grown marijuana can enter the interstate market.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Distinguishing local from interstate supplies creates enforcement difficulties.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Personal production can affect supply and demand.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="520" x="-4070" y="1710" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Compelling otherwise inactive individuals to enter commerce&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;NFIB v. Sebelius&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Mandatory Insurance:&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Commerce Clause:&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Could Congress require people to buy health insurance because remaining uninsured affects the interstate insurance market?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Answer: The commerce rationale failed. Congress’s power to regulate existing commerce does not include compelling otherwise inactive individuals to enter commerce by purchasing a product.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress may still control the commerce of insurance, but not force to buy.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Taxing power&lt;/b&gt;:&amp;nbsp;The payment survived as a tax because it could reasonably be understood as leaving a lawful choice to remain uninsured and pay.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Necessary &amp;amp; Proper clause&lt;/b&gt;:&amp;nbsp;Even if compelling insurance purchases was necessary to make the ACA’s reforms effective, Roberts concluded it was not proper because it compelled otherwise inactive people into commerce, creating the predicate for federal regulation.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="520" x="-5120" y="920" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-15" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-16" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-18" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-1" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="c0eh9S0Abd1rjmFVfu8c-16" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-4090" y="710" as="sourcePoint" />
            <mxPoint x="-4600" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-20" edge="1" parent="1" source="c0eh9S0Abd1rjmFVfu8c-16" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="c0eh9S0Abd1rjmFVfu8c-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-16" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;#1 Taxing Clause&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Tax vs. penalty&lt;/b&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;produce at least some government revenue&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) person lawfully make the underlying choice and satisfy the law by paying&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) consider together:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a) Financial burden: genuine choice or prohibitory punishment?&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b) &lt;/span&gt;Scienter: liability tied to knowing wrongdoing?&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(c) &lt;/span&gt;Administration: ordinary tax collection or punitive enforcement?&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(4) characterized as a tax&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="390" x="-4670" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c0eh9S0Abd1rjmFVfu8c-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Additional rules&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Labels do not control: Calling something a “penalty” does not prevent it from being a constitutional tax.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Behavioral purpose is permissible: Taxes may encourage or discourage conduct.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Breadth versus depth: Taxing reaches broadly across subjects, but does not authorize punishment of the taxed choice once the required tax is paid.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Inactivity: The Commerce Clause’s inactivity limit does not carry over to the taxing power.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Other limits remain: The export-tax prohibition, applicable apportionment requirements, and individual-rights protections.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Direct taxes: Generally include capitations and property taxes and require apportionment among states by population.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Income taxes: The Sixteenth Amendment permits them without apportionment.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Excises on transfers: Estate and gift taxes differ from taxes on ownership of the property itself.&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="530" x="-5470" y="470" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-4" edge="1" parent="1" source="bpNmOR_SoLcWIGrnu4r9-1" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bpNmOR_SoLcWIGrnu4r9-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-15" edge="1" parent="1" source="bpNmOR_SoLcWIGrnu4r9-1" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bpNmOR_SoLcWIGrnu4r9-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Five requirements for conditional enforcement of government contracts&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;South Dakota v. Dole&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) General welfare: Does the program serve a public purpose? Courts give Congress substantial deference.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Clear conditions: Can states knowingly understand the obligations attached to acceptance?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Germaneness: Is the condition sufficiently related to the federal program?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) No independent constitutional bar: Does the condition require unconstitutional conduct?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5)No coercion: Does the state retain a meaningful choice?&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="340" x="-4510" y="-50" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Contract expansion&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;NFIB: Medicaid expansion&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The ACA threatened existing Medicaid funding if states refused the expansion.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Result: Congress could offer expansion funds with conditions, but could not withdraw existing Medicaid funds merely because a state declined the expansion.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="340" x="-4980" y="-110" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-10" edge="1" parent="1" source="bpNmOR_SoLcWIGrnu4r9-8" style="curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="c0eh9S0Abd1rjmFVfu8c-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Necessary &amp;amp;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Proper&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8 Clause 18&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;All laws must also be Necessary &amp;amp; Proper&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Necessary ≠ indispensable: Useful or reasonably adapted to carrying out an enumerated power may suffice.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Proper ≠ useful: The means must also respect constitutional limits.&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="555" x="-4415" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;noneconomic conduct w/&amp;nbsp;economic consequences&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Morrison&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Gender-motivated violence:&amp;nbsp;&lt;/b&gt;Congress cannot regulate noneconomic violent conduct solely because its aggregate consequences substantially affect interstate commerce.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="390" x="-4480" y="1650" as="geometry" />
        </mxCell>
        <mxCell id="bpNmOR_SoLcWIGrnu4r9-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Not satisfied means unenforceable dons&#39;t negate entire program.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="310" x="-4980" y="200" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-10" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-5" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 1&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Election &amp;amp; Vice president&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="85" width="300" x="839.9999999999999" y="1761.25" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-12" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-7" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-22" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-7" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 2&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)Commander in Chief of the Army&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(a)Reprieves and Pardons&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Consent of the Senate:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a)&lt;/span&gt;&amp;nbsp;to make Treaties&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b)&amp;nbsp;shall appoint Ambassadors&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(c) shall appoint &lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Judges of the supreme Court&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(d) &lt;/span&gt;all other Officers of the United States&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(3) Congress may by Law vest the Appointment of such inferior Officers,&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(4) Power to fill up all Vacancies that may happen during the Recess&lt;br/&gt;of the Senate&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="440" x="1960" y="1753.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 1 Text&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Each State shall appoint, in such Manner as the Legislature thereof may direct, a Number&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of Electors, equal to the whole Number of Senators and Representatives to which the State&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;may be entitled in the Congress: but no Senator or Representative, or Person holding an Office&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of Trust or Profit under the United States, shall be appointed an Elector.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. The Electors shall meet in their respective States, and vote by Ballot for two Persons, of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;whom one at least shall not be an Inhabitant of the same State with themselves. And they&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;shall make a List of all the Persons voted for, and of the Number of Votes for each; which List&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;they shall sign and certify, and transmit sealed to the Seat of the Government of the United&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;States, directed to the President of the Senate. The President of the Senate shall, in the Pres-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ence of the Senate and House of Representatives, open all the Certificates, and the Votes shall&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;then be counted. The Person having the greatest Number of Votes shall be the President, if&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;such Number be a Majority of the whole Number of Electors appointed; and if there be more&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;than one who have such Majority, and have an equal Number of Votes, then the House of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Representatives shall immediately chuse by Ballot one of them for President; and if no Person&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;have a Majority, then from the five highest on the List the said House shall in like Man-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ner chuse the President. But in chusing the President, the Votes shall be taken by States, the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Representation from each State having one Vote; A quorum for this Purpose shall consist of a&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Member or Members from two thirds of the States, and a Majority of all the States shall be&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;necessary to a Choice. In every Case, after the Choice of the President, the Person having the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;greatest Number of Votes of the Electors shall be the Vice President. But if there should re-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;main two or more who have equal Votes, the Senate shall chuse from them by Ballot the Vice&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;President.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. The Congress may determine the Time of chusing the Electors, and the Day on which they&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;shall give their Votes; which Day shall be the same throughout the United States.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;5. No Person except a natural born Citizen, or a Citizen of the United States, at the time of the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Adoption of this Constitution, shall be eligible to the Office of President; neither shall any&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Person be eligible to that Office who shall not have attained to the Age of thirty five Years,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and been fourteen Years a Resident within the United States.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;6. In Case of the Removal of the President from Office, or of his Death, Resignation, or Inability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;to discharge the Powers and Duties of the said Office, the Same shall devolve on the Vice Pres-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ident, and the Congress may by Law provide for the Case of Removal, Death, Resignation or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Inability, both of the President and Vice President, declaring what Officer shall then act as&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;President, and such Officer shall act accordingly, until the Disability be removed, or a Presi-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;dent shall be elected.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;7. The President shall, at stated Times, receive for his Services, a Compensation, which shall&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;neither be encreased nor diminished during the Period for which he shall have been elected,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and he shall not receive within that Period any other Emolument from the United States, or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;any of them.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;8. Before he enter on the Execution of his Office, he shall take the following Oath or Affirma-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;tion:—&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;“I do solemnly swear (or affirm) that I will faithfully execute the Office of President of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the United States, and will to th&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="640" width="520" x="539.9999999999999" y="2023.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 2 Text&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. The President shall be Commander in Chief of the Army and Navy of the United States, and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of the Militia of the several States, when called into the actual Service of the United States; he&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;may require the Opinion, in writing, of the principal Officer in each of the executive Depart-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ments, upon any Subject relating to the Duties of their respective Offices, and he shall have&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Power to grant Reprieves and Pardons for Offences against the United States, except in Cases&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of Impeachment.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. He shall have Power, by and with the Advice and Consent of the Senate, to make Treaties,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;provided two thirds of the Senators present concur; and he shall nominate, and by and with&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the Advice and Consent of the Senate, shall appoint Ambassadors, other public Ministers and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;23&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Consuls, Judges of the supreme Court, and all other Officers of the United States, whose Ap-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;pointments are not herein otherwise provided for, and which shall be established by Law: but&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the Congress may by Law vest the Appointment of such inferior Officers, as they think proper,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;in the President alone, in the Courts of Law, or in the Heads of Departments.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. The President shall have Power to fill up all Vacancies that may happen during the Recess&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of the Senate, by granting Commissions which shall expire at the End of their next Session.&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="520" x="1290" y="1673.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-16" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-13" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-27" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-13" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 3&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;State of the Union&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) recognition of foreign sovereigns&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="3020" y="1803.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 3 text&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;He shall from time to time give to the Congress Information of the State of the Union, and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;recommend to their Consideration such Measures as he shall judge necessary and expedient;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;he may, on extraordinary Occasions, convene both Houses, or either of them, and in Case of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Disagreement between them, with Respect to the Time of Adjournment, he may adjourn them&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;to such Time as he shall think proper; he shall receive Ambassadors and other public Minis-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ters; he shall take Care that the Laws be faithfully executed, and shall Commission all the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Officers of the United States.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="530" x="2420" y="1733.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-20" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-17" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 4&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Impeachment&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="3830" y="1773.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 4&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The President, Vice President and all civil Officers of the United States, shall be removed from&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Office on Impeachment for, and Conviction of, Treason, Bribery, or other high Crimes and Mis-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;demeanors.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="3400" y="1763.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-21" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Authority Rests on F&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;ederal Statute or&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;Constitution Itself&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Youngstown&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Maximum authority: his own constitutional powers plus authority Congress gave&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- Zone of twilight: Congress neither authorizes nor prohibits the action.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- Lowest ebb: The action conflicts with Congress’s express or implied will, but&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&lt;/span&gt;President can prevail through an exclusive constitutional power&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Youngstown&lt;/i&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Seized steel mills during the Korean War, was within the &quot;raise and fund armed&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; forces&quot; night of congress, and not the &quot;commander in Chief of the army&quot; right of the president&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="510" x="2075" y="2123.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-25" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-23" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="Jr_ydECLnp-rl0KPYuwt-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Congressional&amp;nbsp;War powers&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Enumerated powers&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;11: Declare war&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;12:&amp;nbsp;Raise and fund armies&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;13:&amp;nbsp;Provide a navy&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;14:&amp;nbsp;Establish military rules&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="190" x="1720" y="2333.75" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-26" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;(2) recognition of foreign sovereigns&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Zivotofsky&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;he shall receive Ambassadors&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the President exclusively determines formal recognition of foreign sovereigns&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;This does not give the President exclusive control over all foreign affairs.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="350" x="2870" y="1963.75" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-21" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-34" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-22" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-32" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-32" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000, #77bb41);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;The Supremacy Clause&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Article VI, Clause 2&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;The powers not delegated to the United States by the Constitution, nor prohibited by it to the States, are reserved to the States respectively, or to the people.&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Federal Immunity clause&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Taxing and regulating: McCulloch&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Preemption:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Discrimination &amp;amp; undo burden&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="400" x="-1290" y="470" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-29" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-53" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-31" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-28" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="Jr_ydECLnp-rl0KPYuwt-30" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-28" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Federal Discrimination&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Dawson&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;West Virginia exempted certain state law enforcement pensions from taxation but denied the exemption to a retired federal marshal who had performed materially similar duties. That violated the nondiscrimination requirement reflected in 4 U.S.C. §111.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="-3010" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="Jr_ydECLnp-rl0KPYuwt-30" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Federal officers: Supremacy Clause immunity&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Generally, a federal officer is protected from state civil or criminal regulation when:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. Federal law authorizes the act; and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. The officer’s actions are necessary and proper to carrying out federal duties.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="-2890" y="1810" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-1" edge="1" parent="1" source="Jr_ydECLnp-rl0KPYuwt-32" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.986;entryY=0.42;entryDx=0;entryDy=0;entryPerimeter=0;" target="cJ5OH2NNq5MmNCnX_mFG-53">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-6" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-2" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-8" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-2" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-18" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-2" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-19" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-2" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Preemption&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Under the Supremacy Clause, &lt;u&gt;valid federal law displaces state law&lt;/u&gt; to the &lt;u&gt;extent Congress intended&lt;/u&gt; it to do so.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;*preemption does not need to be express&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Compare to commandeering&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="400" x="-1820" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-17" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-4" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Express&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The federal statute expressly displaces a category of state laws.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="85" width="220" x="-2100" y="1295" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-14" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-7" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Field&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress has occupied a regulatory field, leaving no room for state supplementation.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Is so comprehensive that it shows Congress intended to displace all state regulation in that field&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Ceiling &amp;amp; the floor not just one.&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="280" x="-1950" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-15" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-9" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-16" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-11" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Obstacle conflict&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;State law frustrates the purposes and objectives of federal law.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="-1370" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;PG&amp;amp;E v. State Energy Resources Conservation &amp;amp; Development Commission&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;California restricted new nuclear plant construction until an approved permanent waste-disposal method existed.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Court upheld the restriction because Congress had divided responsibility:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Federal authority&lt;/b&gt;:&amp;nbsp;Radiological safety and nuclear aspects of plant construction&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;state authority&lt;/b&gt;:&amp;nbsp;Economic feasibility, electricity needs, reliability, rates&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Other Arguments:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Field&lt;/i&gt;: Congress occupied nuclear safety, rather than every issue involving nuclear energy.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Impossibility&lt;/i&gt;: A federal license permitted construction; it did not require construction.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Obstacle&lt;/i&gt;: Congress promoted nuclear power while preserving state economic regulation. Promoting nuclear power was not an objective to be pursued at every cost.&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="570" x="-2240" y="1740" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Impossibility conflict&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Compliance with both federal and state requirements is impossible.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="85" width="270" x="-1640" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-24" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-20" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-23" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-33" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-20" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-32" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;State discrimination against interstate commerce&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;A state or local law that discriminates against interstate commerce is virtually per se invalid.&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;To get around it:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) A legitimate, nonprotectionist objective; and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The absence of practicable, nondiscriminatory alternatives.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Economic protectionism is invalid. (giving local private businesses an advantage over interstate competitors)&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="410" x="-600" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-27" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-23" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ltZLwBbUF2npR7WB0Q-s-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-29" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-23" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-31" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-23" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-30" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Geographic Origin&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Philadelphia v. New Jersey&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;New Jersey could not ban imported garbage while accepting materially identical local garbage. Environmental goals did not justify discriminatory means.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;(1) environmental counted as first prong.&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) &lt;b&gt;failed second prong because they could Limit the total amount of garbage dumped in New Jersey landfills&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="350" x="-740" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-25" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Prohibit Exporting&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Hughes v. Oklahoma&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Could not prohibit exporting locally caught minnows.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="85" width="320" x="-960" y="1670" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-28" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Self Harm&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Dean Milk v. Madison&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A city cannot escape scrutiny because its geographic restriction also hurts some in-state businesses&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;pasteurized and bottled at an approved plant within five miles of the city center.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="-1000" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-30" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Import Allowed&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Maine v. Taylor&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Importing live baitfish ban was allowed because:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) A legitimate, nonprotectionist objective; and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;legitimate environmental objective&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The absence of practicable, nondiscriminatory alternatives.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;no practicable nondiscriminatory alternative: the fish’s&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;small size and large shipment quantities made inspection for&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;mixed species impracticable&lt;/b&gt;,&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="370" x="-600" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-32" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Economic protectionism&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Bacchus Imports v. Dias&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Protecting struggling local businesses from outside competition is still economic protectionism.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A law can discriminate even if it favors only some local products.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Protectionist in the underlying purpose&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Hawaiian liquor&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="310" x="-80" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="ltZLwBbUF2npR7WB0Q-s-37" edge="1" parent="1" source="ltZLwBbUF2npR7WB0Q-s-38" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="ltZLwBbUF2npR7WB0Q-s-34" value="">
