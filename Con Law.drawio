        </mxCell>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;NFIB limit&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Commerce Clause&lt;/b&gt;: Can not Compel an otherwise inactive person to buy a product.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;b&gt;Taxing Power&lt;/b&gt;: (1) raise revenue (2) left choice (3) not a punishment&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;b&gt;Spending Power&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="NFIB, 567 U.S. at 548–558 (Roberts, C.J.); Joondeph pp. 160–163." id="congress-final-inactive">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="150" width="340" x="3280" y="4710" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-6" edge="1" parent="1" source="congress-final-grant" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-inactive" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-70" y="4739" as="sourcePoint" />
            <mxPoint x="4840" y="4796" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-8" edge="1" parent="1" source="congress-final-inactive" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="9QNgjwrJa7QWuSXyMYGu-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-10" edge="1" parent="1" source="congress-final-inactive" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="9QNgjwrJa7QWuSXyMYGu-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-12" edge="1" parent="1" source="congress-final-inactive" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="9QNgjwrJa7QWuSXyMYGu-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Commerce Clause&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Commerce Clause&lt;/b&gt;: Can not compel an otherwise inactive person to buy a product.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="NFIB, 567 U.S. at 548–558 (Roberts, C.J.); Joondeph pp. 160–163." id="9QNgjwrJa7QWuSXyMYGu-7">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="90" width="290" x="3030" y="4980" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Taxing Power&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A statue may be considered a tax under &lt;i&gt;NFIB &lt;/i&gt;when&lt;i&gt;:&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(1) It &lt;b&gt;raises revenue&lt;/b&gt;: specifically in tax return&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(2)&amp;nbsp;left a &lt;b&gt;real choice:&amp;nbsp;&lt;/b&gt;payment was far less expensive than insurance&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(3) &lt;b&gt;Not punishment&lt;/b&gt;: payment would be legal and not because of an illegal&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(4) &lt;b&gt;no scienter requirement&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;" tooltip="NFIB, 567 U.S. at 548–558 (Roberts, C.J.); Joondeph pp. 160–163." id="9QNgjwrJa7QWuSXyMYGu-9">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="180" width="340" x="3210" y="5150" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Spending Power&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;only if states have a genuine choice about expanding Medicaid.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Taking away existing funding if they don&#39;t comply with new version was&amp;nbsp;coercive&lt;/p&gt;" tooltip="NFIB, 567 U.S. at 548–558 (Roberts, C.J.); Joondeph pp. 160–163." id="9QNgjwrJa7QWuSXyMYGu-11">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="150" width="320" x="3520" y="4980" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;&lt;u&gt;State &amp;amp; local&lt;br&gt;governments&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Can this government act?&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), Chs. 16–20. " id="state-final-start">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#B5849C;strokeWidth=2.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1">
            <mxGeometry height="145" width="280" x="-1265" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;1. Collision with federal law?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Supremacy · immunity · preemption&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the state or local measure and the federal actor, operation or legal rule it affects.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Check &lt;b&gt;intergovernmental immunity&lt;/b&gt; and &lt;b&gt;preemption&lt;/b&gt; separately. A state police-power purpose does not defeat valid federal law.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 285–307. " id="state-final-federal">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="190" width="440" x="-500" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;2. Burden on interstate commerce?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Dormant Commerce Clause&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Does the measure favor local economic interests or burden commerce across state lines?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Check congressional authorization / market participation first; then distinguish &lt;b&gt;discrimination&lt;/b&gt; from an evenhanded burden.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 309–338. " id="state-final-commerce">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="190" width="440" x="2200" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;3. Outsiders, newcomers or judgments?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article IV + Fourteenth Amendment&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify a visiting citizen, a new bona fide resident, or a sister-state judgment.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;These have &lt;b&gt;different protections&lt;/b&gt;. A single residency preference can trigger both this gate and the commerce inquiry.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 339–367. " id="state-final-outsiders">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="190" width="440" x="4700" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;4. Taking private property?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Fifth Amendment, applied to states&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the owner, protected property interest, government act and property affected.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Classify &lt;b&gt;physical appropriation, use restriction or permit condition&lt;/b&gt;. If a taking exists, test public use and compensation.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 389–427. " id="state-final-property">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="190" width="440" x="7300" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;5. Impairing an existing contract?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article I, §10 · Contracts Clause&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Is a state / local &lt;b&gt;law&lt;/b&gt; changing an existing contractual obligation?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Ask whether the impairment is substantial; then distinguish private contracts from the government’s own obligations.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. " id="state-final-contract">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="190" width="440" x="9650" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;6. Other constitutional limits?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;State action · rights · retroactivity&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Apply every right implicated by the facts, including incorporated rights, due process and equal protection.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;For retroactive or targeted punishment, separately test &lt;b&gt;ex post facto&lt;/b&gt; and &lt;b&gt;bill of attainder&lt;/b&gt; prohibitions.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 369–388, 431–440. " id="state-final-rights">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="190" width="440" x="11650" y="9900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can the government act?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Authority + every applicable limit&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Yes only if:&lt;/b&gt; state-law authority exists and every triggered federal constitutional / statutory restriction is satisfied.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;If defective:&lt;/b&gt; identify the particular provision, application or condition that fails and the appropriate remedy.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Passing one branch does not establish overall validity.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), Chs. 16–20. " id="state-final-answer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="215" width="440" x="13200" y="9900" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-start-federal" edge="1" parent="1" source="state-final-start" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.6551724137931034;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="state-final-federal" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-federal-commerce" edge="1" parent="1" source="state-final-federal" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="state-final-commerce" value="Also test commerce">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-commerce-outsiders" edge="1" parent="1" source="state-final-commerce" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="state-final-outsiders" value="Also test unequal treatment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-outsiders-property" edge="1" parent="1" source="state-final-outsiders" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="state-final-property" value="Also test property">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-property-contract" edge="1" parent="1" source="state-final-property" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="state-final-contract" value="Also test existing obligations">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-contract-rights" edge="1" parent="1" source="state-final-contract" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="state-final-rights" value="Also test rights / punishment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-rights-answer" edge="1" parent="1" source="state-final-rights" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4418604651162791;entryDx=0;entryDy=0;" target="state-final-answer" value="After all triggered checks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Identify the actor and authority&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;States have general police powers&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;States need no Article I enumerated-power grant. Identify the relevant state constitutional / statutory authority and limits.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Cities and counties:&lt;/b&gt; check delegated or home-rule authority under state law. Do not assume independent sovereign power.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Identify the act, affected party and requested relief; run all fact-triggered gates.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 285–286; source chart starting point. " id="state-final-authority">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="-2150" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-start-authority" edge="1" parent="1" source="state-final-start" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-authority" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-1125" y="10180" />
              <mxPoint x="-1930" y="10180" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Federal government or instrumentality?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Intergovernmental immunity&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Absent a clear congressional waiver, states may not directly regulate or tax the United States, or discriminate against it or those with whom it deals.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Identify &lt;b&gt;legal incidence&lt;/b&gt;, the federal relationship and the comparator. An indirect economic burden alone is not enough.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 286–294. " id="state-final-immunity">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="-1500" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Valid federal law covers this issue?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Read text, scope and intended effect&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the federal statute / valid regulation and its constitutional basis. Use the Congress / executive sections if authority is disputed.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Read express preemption and savings clauses; identify the precise state rule and conduct allegedly displaced.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 294–307. " id="state-final-preemption">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="450" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-federal-immunity" edge="1" parent="1" source="state-final-federal" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-immunity" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-280" y="10200" />
              <mxPoint x="-1280" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-federal-preemption" edge="1" parent="1" source="state-final-federal" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-preemption" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-280" y="10200" />
              <mxPoint x="670" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Direct regulation or tax?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Who is legally bound or must pay?&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A state generally cannot impose licensing, control or a tax directly on federal operations without federal consent.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Distinguish a direct federal obligation from a generally applicable rule imposed on an employee / contractor. Federal association alone gives no blanket exemption.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 286–294. " id="state-final-direct">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="-1500" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Discrimination against federal interests?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Compare similarly situated parties&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Does the measure impose a heavier burden on the United States or those with whom it deals than on comparable state / private interests?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Ask whether significant differences justify the distinction and whether Congress &lt;b&gt;clearly authorized&lt;/b&gt; this differential treatment.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 289–294. Authority: https://www.law.cornell.edu/supremecourt/text/17-419" link="https://www.law.cornell.edu/supremecourt/text/17-419" id="state-final-discrim-fed">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="-850" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State liability for a federal officer?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Supremacy Clause immunity&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Was the act authorized by federal law and no more than necessary and proper to perform the federal duty?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Analyze authority, duty and the officer’s conduct. Federal employment alone does not immunize unrelated or excessive acts.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 287–288. Authority: https://www.law.cornell.edu/supremecourt/text/135/1" link="https://www.law.cornell.edu/supremecourt/text/135/1" id="state-final-officer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="-200" y="10650" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-immunity-direct" edge="1" parent="1" source="state-final-immunity" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-direct" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-1280" y="10580" />
              <mxPoint x="-1280" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-immunity-discrim-fed" edge="1" parent="1" source="state-final-immunity" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-discrim-fed" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-1280" y="10580" />
              <mxPoint x="-630" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-immunity-officer" edge="1" parent="1" source="state-final-immunity" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-officer" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-1280" y="10580" />
              <mxPoint x="20" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Comparable federal retiree could not lose&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Dawson v. Steager (2019)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;West Virginia exempted benefits of specified state law-enforcement retirees but taxed a former federal marshal’s pension.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;No significant differences separated his duties from those of the favored retirees. Comparing him with all other retirees missed the relevant discrimination.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 289–293. Authority: https://www.law.cornell.edu/supremecourt/text/17-419" link="https://www.law.cornell.edu/supremecourt/text/17-419" id="state-final-dawson">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="-850" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Federal contractors were singled out&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Washington (2022)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A workers’ compensation law specially favored workers at a federal nuclear-cleanup site, increasing burdens on federal contractors.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;That discriminatory treatment violated intergovernmental immunity; the asserted federal waiver did not clearly authorize it.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 293–294. Authority: https://www.law.cornell.edu/supremecourt/text/21-404" link="https://www.law.cornell.edu/supremecourt/text/21-404" id="state-final-washington">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="-850" y="11350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Authorized protection defeated state custody&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;In re Neagle (1890)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A deputy marshal killed an assailant while protecting Justice Field and was held on a state murder charge.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Federal habeas relief was proper because the protection was federally authorized and the marshal did no more than necessary and proper to perform that duty.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 287–288. Authority: https://www.law.cornell.edu/supremecourt/text/135/1" link="https://www.law.cornell.edu/supremecourt/text/135/1" id="state-final-neagle">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="-200" y="11000" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-discrim-fed-dawson" edge="1" parent="1" source="state-final-discrim-fed" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-dawson" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-discrim-fed-washington" edge="1" parent="1" source="state-final-discrim-fed" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-washington" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-950" y="10755" />
              <mxPoint x="-950" y="11270" />
              <mxPoint x="-630" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-officer-neagle" edge="1" parent="1" source="state-final-officer" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-neagle" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Which kind of preemption?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Express · field · conflict&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Express:&lt;/b&gt; apply the clause to the challenged measure. &lt;b&gt;Field:&lt;/b&gt; Congress left no room for state regulation of the occupied field.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;Conflict:&lt;/b&gt; compliance with both is impossible, or state law obstructs federal objectives. Ground the obstacle analysis in the actual federal scheme.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 294–307. Authority: https://www.law.cornell.edu/supremecourt/text/461/190" link="https://www.law.cornell.edu/supremecourt/text/461/190" id="state-final-types">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="450" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;How far does displacement extend?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Floor, ceiling, permission or command?&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify what federal law requires, forbids or deliberately leaves open. Federal permission is not invariably a command that states allow an activity.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Displace only the conflicting state rule / application. A savings clause informs scope but does not automatically erase every conflict.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 294–307. Authority: https://www.law.cornell.edu/supremecourt/text/461/190" link="https://www.law.cornell.edu/supremecourt/text/461/190" id="state-final-scope">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="450" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Economic purpose remained within state power&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Pacific Gas &amp; Electric v. State Energy (1983)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;California tied new nuclear-plant construction to a solution for waste disposal. The Court accepted the State’s economic rationale.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Federal law occupied nuclear-safety regulation, but preserved state authority over economic need. The challenged moratorium was not preempted on the grounds asserted.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 297–304. Authority: https://www.law.cornell.edu/supremecourt/text/461/190" link="https://www.law.cornell.edu/supremecourt/text/461/190" id="state-final-pge">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="450" y="11350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Preemption or commandeering?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Federal rule for private actors vs. command to states&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Valid federal regulation can displace contrary state law. Congress may not simply order a state legislature to enact / retain a rule or state officers to administer a federal program.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;States may decline assistance or repeal their own prohibitions; they may not nullify federal law or obstruct federal operations. Use the Congress branch.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 304–307; congressional anti-commandeering cross-reference. Authority: https://www.law.cornell.edu/supremecourt/text/16-476" link="https://www.law.cornell.edu/supremecourt/text/16-476" id="state-final-commandeer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="450" y="11700" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-preemption-types" edge="1" parent="1" source="state-final-preemption" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-types" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-types-scope" edge="1" parent="1" source="state-final-types" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-scope" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-scope-pge" edge="1" parent="1" source="state-final-scope" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-pge" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-scope-commandeer" edge="1" parent="1" source="state-final-scope" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-commandeer" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="11105" />
              <mxPoint x="350" y="11620" />
              <mxPoint x="670" y="11620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Authorization or market participation?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Check the boundaries of the exception&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Congress:&lt;/b&gt; unmistakably clear authorization can permit a dormant-Commerce-Clause burden; other constitutional limits remain.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Market participant:&lt;/b&gt; a state buying / selling may favor locals within that market. Regulation of a downstream market remains subject to review.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;If neither applies, classify the measure below.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 332–338. Authority: https://www.law.cornell.edu/supremecourt/text/467/82" link="https://www.law.cornell.edu/supremecourt/text/467/82" id="state-final-exception">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="1350" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Discrimination against interstate commerce?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Text, purpose or practical effect&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Compare similarly situated in-state and out-of-state economic interests. Look for protectionist burdens or benefits.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A burden on particular out-of-state firms, without unequal treatment of interstate commerce, does not itself prove discrimination.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;Yes → rigorous review. No → Pike.&lt;/b&gt;&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 310–332. " id="state-final-classify">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="2650" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-commerce-exception" edge="1" parent="1" source="state-final-commerce" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-exception" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2420" y="10200" />
              <mxPoint x="1570" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-commerce-classify" edge="1" parent="1" source="state-final-commerce" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-classify" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2420" y="10200" />
              <mxPoint x="2870" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State seller could favor resident buyers&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Reeves, Inc. v. Stake (1980)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;During a shortage, South Dakota limited sales from its state-owned cement plant to resident buyers.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The State participated in the cement market as a seller, so the dormant Commerce Clause did not prohibit this preference. Other constitutional claims remain separate.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 332–337. Authority: https://www.law.cornell.edu/supremecourt/text/447/429" link="https://www.law.cornell.edu/supremecourt/text/447/429" id="state-final-reeves">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="1350" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Seller could not control a later market&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;South-Central Timber v. Wunnicke (1984)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Alaska required buyers of state timber to process it within Alaska before export.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court rejected the restriction. The plurality treated the processing requirement as downstream regulation beyond the State’s timber-selling market; federal consent was also insufficient.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 337–338. Authority: https://www.law.cornell.edu/supremecourt/text/467/82" link="https://www.law.cornell.edu/supremecourt/text/467/82" id="state-final-timber">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="1350" y="11000" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-exception-reeves" edge="1" parent="1" source="state-final-exception" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-reeves" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-exception-timber" edge="1" parent="1" source="state-final-exception" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-timber" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1250" y="10412.5" />
              <mxPoint x="1250" y="10920" />
              <mxPoint x="1570" y="10920" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Discriminatory: can the state justify it?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Virtually per se invalid · demanding burden&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The state must show a legitimate nonprotectionist purpose that cannot adequately be served by practicable nondiscriminatory alternatives.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Identify the evidence and available alternatives. Protecting local businesses from competition is not a legitimate justification.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 311–320. Authority: https://www.law.cornell.edu/supremecourt/text/477/131" link="https://www.law.cornell.edu/supremecourt/text/477/131" id="state-final-strict">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="215" width="440" x="2000" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Evenhanded: excessive interstate burden?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Pike balancing&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify a real burden on interstate commerce and the putative local benefits.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Invalid only when the burden is &lt;b&gt;“clearly excessive”&lt;/b&gt; in relation to those benefits. Consider the nature of the interest and less burdensome means.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;This is not automatic strict scrutiny or a general policy veto.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 328–332. Authority: https://www.law.cornell.edu/supremecourt/text/397/137" link="https://www.law.cornell.edu/supremecourt/text/397/137" id="state-final-pike">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="2650" y="10650" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-classify-strict" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-strict" value="Yes">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2870" y="10580" />
              <mxPoint x="2220" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-classify-pike" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-pike" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State could not exclude outsiders’ waste&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Philadelphia v. New Jersey (1978)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;New Jersey barred most imported waste while allowing disposal of in-state waste.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Conserving landfill space did not justify treating identical waste differently because of origin. The measure impermissibly isolated the State from a shared problem.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 311–315. Authority: https://www.law.cornell.edu/supremecourt/text/437/617" link="https://www.law.cornell.edu/supremecourt/text/437/617" id="state-final-philly">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="2000" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Proven ecological risk justified the ban&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Maine v. Taylor (1986)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Maine barred imported live baitfish. Evidence showed parasite / ecological risks that workable inspection techniques could not adequately address.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The discriminatory ban survived because the State proved a legitimate local purpose and no adequate nondiscriminatory alternative.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 316. Authority: https://www.law.cornell.edu/supremecourt/text/477/131" link="https://www.law.cornell.edu/supremecourt/text/477/131" id="state-final-maine">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="2000" y="11350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Truck restriction imposed undue burdens&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Kassel v. Consolidated Freightways (1981)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Iowa’s truck-length limits forced costly changes or interstate detours, while exceptions weakened its asserted safety rationale.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court invalidated the restriction. The plurality found the commerce burdens unjustified by the safety benefits; the separate opinions differed in reasoning.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 328–329. Authority: https://www.law.cornell.edu/supremecourt/text/450/662" link="https://www.law.cornell.edu/supremecourt/text/450/662" id="state-final-kassel">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="2650" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Out-of-state effects were not enough&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;National Pork Producers Council v. Ross (2023)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;California restricted in-state pork sales based on production conditions, affecting producers elsewhere.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court rejected a sweeping per se rule against laws with extraterritorial effects and affirmed dismissal. The Justices divided on Pike analysis; the decision did not abolish Pike.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 330–332. Authority: https://www.law.cornell.edu/supremecourt/text/21-468" link="https://www.law.cornell.edu/supremecourt/text/21-468" id="state-final-pork">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="2650" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-strict-philly" edge="1" parent="1" source="state-final-strict" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-philly" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-strict-maine" edge="1" parent="1" source="state-final-strict" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-maine" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1900" y="10757.5" />
              <mxPoint x="1900" y="11270" />
              <mxPoint x="2220" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-pike-kassel" edge="1" parent="1" source="state-final-pike" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-kassel" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-pike-pork" edge="1" parent="1" source="state-final-pike" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-pork" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2550" y="10760" />
              <mxPoint x="2550" y="11270" />
              <mxPoint x="2870" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Favoring a public facility?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Compare all private competitors&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A traditional public function that favors a public entity while treating in-state and out-of-state private firms equally may be nondiscriminatory.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;This is &lt;b&gt;not a categorical Commerce Clause exemption&lt;/b&gt;: still consider Pike. A favored private local firm presents a different comparison.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 323–327. Authority: https://www.law.cornell.edu/supremecourt/text/05-1345" link="https://www.law.cornell.edu/supremecourt/text/05-1345" id="state-final-public">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="3300" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Public waste authority could be favored&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United Haulers v. Oneida-Herkimer (2007)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Flow-control ordinances required delivery to publicly owned facilities and treated all private firms alike.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court found no discrimination against interstate commerce and upheld the ordinances; the plurality also rejected the Pike challenge.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 323–327. Authority: https://www.law.cornell.edu/supremecourt/text/05-1345" link="https://www.law.cornell.edu/supremecourt/text/05-1345" id="state-final-haulers">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="3300" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State / local tax on interstate activity?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Complete Auto · all four requirements&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Substantial nexus with the taxing state. &lt;b&gt;2.&lt;/b&gt; Fair apportionment. &lt;b&gt;3.&lt;/b&gt; No discrimination against interstate commerce. &lt;b&gt;4.&lt;/b&gt; Fair relation to state-provided services.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Test practical operation, including multiple-tax burdens and origin-based charges. A “fee” label does not avoid the constitutional inquiry.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 314–315, 319–320; supplemental tax framework. Authority: https://www.law.cornell.edu/supremecourt/text/430/274" link="https://www.law.cornell.edu/supremecourt/text/430/274" id="state-final-tax">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="3300" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-classify-public" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-public" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2870" y="10580" />
              <mxPoint x="3520" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-public-haulers" edge="1" parent="1" source="state-final-public" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-haulers" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-classify-tax" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-tax" value="If a tax">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3820" y="10412.5" />
              <mxPoint x="3820" y="11270" />
              <mxPoint x="3520" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Citizen of another state treated worse?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article IV · Privileges AND Immunities&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Protects natural-person citizens of other states, not corporations. Cities’ residency preferences can also trigger it.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Is a privilege fundamental to interstate harmony affected—such as a common calling, professional practice, property ownership or access to courts?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Recreational hunting and political participation are different.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 339–352. " id="state-final-visitor">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="4200" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;New bona fide resident penalized?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Fourteenth Amendment · Privileges OR Immunities&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Distinguish a visitor from someone who has become a citizen of the destination state.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The right to travel protects entry / exit, treatment as a welcome visitor, and equal treatment after settling. Use the relevant component.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 352–362. Authority: https://supreme.justia.com/cases/federal/us/526/489/" link="https://supreme.justia.com/cases/federal/us/526/489/" id="state-final-newcomer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="4850" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Sister-state judgment or law?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article IV · Full Faith and Credit&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Final judgment:&lt;/b&gt; generally give it the recognition / preclusive effect it has in the rendering state if the court had jurisdiction.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;Another state’s law:&lt;/b&gt; no automatic requirement to apply it; forum-law choices require constitutionally sufficient contacts and fairness.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 362–367. Authority: https://www.law.cornell.edu/supremecourt/text/15-648" link="https://www.law.cornell.edu/supremecourt/text/15-648" id="state-final-judgment">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="5500" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-outsiders-visitor" edge="1" parent="1" source="state-final-outsiders" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-visitor" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4920" y="10200" />
              <mxPoint x="4420" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-outsiders-newcomer" edge="1" parent="1" source="state-final-outsiders" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-newcomer" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4920" y="10200" />
              <mxPoint x="5070" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-outsiders-judgment" edge="1" parent="1" source="state-final-outsiders" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-judgment" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4920" y="10200" />
              <mxPoint x="5720" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Protected privilege + unequal treatment?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;State must justify the distinction&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Yes:&lt;/b&gt; substantial reason for the difference + substantial relationship between the discrimination and that reason.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Are outsiders a peculiar source of the problem? Consider less restrictive alternatives.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;No:&lt;/b&gt; this clause does not bar the measure; commerce and other rights still may. No market-participant exemption here.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 339–352. Authority: https://www.law.cornell.edu/supremecourt/text/334/385" link="https://www.law.cornell.edu/supremecourt/text/334/385" id="state-final-art4-test">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="4200" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Nonresident fishing fee was excessive&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Toomer v. Witsell (1948)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;South Carolina charged out-of-state commercial shrimpers dramatically higher license fees.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Commercial fishing was a protected common calling. The State did not adequately relate the disparity to conservation burdens attributable to outsiders.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 339–352. Authority: https://www.law.cornell.edu/supremecourt/text/334/385" link="https://www.law.cornell.edu/supremecourt/text/334/385" id="state-final-toomer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="4200" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;City hiring preference required scrutiny&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United Building Trades Council v. Camden (1984)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Camden required a share of workers on city projects to be city residents. The local preference burdened nonresidents’ pursuit of a common calling.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Article IV applied despite municipal sponsorship and market participation. The Court &lt;b&gt;remanded for justification&lt;/b&gt;; it did not simply strike the preference down.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 339–352. Authority: https://www.law.cornell.edu/supremecourt/text/465/208" link="https://www.law.cornell.edu/supremecourt/text/465/208" id="state-final-camden">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="4200" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-visitor-art4-test" edge="1" parent="1" source="state-final-visitor" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-art4-test" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-art4-test-toomer" edge="1" parent="1" source="state-final-art4-test" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-toomer" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-art4-test-camden" edge="1" parent="1" source="state-final-art4-test" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-camden" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4100" y="10765" />
              <mxPoint x="4100" y="11270" />
              <mxPoint x="4420" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Durational penalty or genuine residency rule?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Identify the benefit and the burden on travel&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;New bona fide residents ordinarily receive the same welfare benefits as longer-term residents. A penalty on migration requires compelling justification and narrow tailoring.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Verifying genuine residence differs from penalizing its recent acquisition. Portable benefits, such as subsidized tuition, require their own analysis.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 352–362. Authority: https://supreme.justia.com/cases/federal/us/526/489/" link="https://supreme.justia.com/cases/federal/us/526/489/" id="state-final-residence">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="4850" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;New residents deserved equal welfare&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Saenz v. Roe (1999)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;California capped first-year residents’ welfare at the amount payable in their former state.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Fourteenth Amendment protected their right to equal treatment as new state citizens. Saving money did not justify the penalty, and Congress could not authorize the violation.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 352–362. Authority: https://supreme.justia.com/cases/federal/us/526/489/" link="https://supreme.justia.com/cases/federal/us/526/489/" id="state-final-saenz">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="4850" y="11000" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-newcomer-residence" edge="1" parent="1" source="state-final-newcomer" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-residence" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-residence-saenz" edge="1" parent="1" source="state-final-residence" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-saenz" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Jurisdiction, not a second merits decision&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;No general public-policy exception to judgments&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A forum may examine a genuine jurisdictional issue, subject to prior litigation / preclusion rules.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;It may not relabel disagreement with the issuing court’s merits as a lack of jurisdiction. Disapproval of another state’s policy does not itself permit nonrecognition.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 362–367. Authority: https://www.law.cornell.edu/supremecourt/text/15-648" link="https://www.law.cornell.edu/supremecourt/text/15-648" id="state-final-recognize">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="215" width="440" x="5500" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Adoption judgment had to be honored&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;V.L. v. E.L. (2016)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Alabama refused to recognize a Georgia adoption involving same-sex partners.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Georgia’s court had jurisdiction. Even a claimed error in applying adoption law would not justify retrying the merits or denying full faith and credit.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 362–367. Authority: https://www.law.cornell.edu/supremecourt/text/15-648" link="https://www.law.cornell.edu/supremecourt/text/15-648" id="state-final-vl">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="205" width="440" x="5500" y="11000" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-judgment-recognize" edge="1" parent="1" source="state-final-judgment" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-recognize" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-recognize-vl" edge="1" parent="1" source="state-final-recognize" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-vl" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Physical appropriation / occupation?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Taking of title, possession or right to exclude&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Government acquisition of property or authorization of physical occupation generally is a &lt;b&gt;per se taking&lt;/b&gt;; recurring access can count even when intermittent.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Distinguish isolated trespass, background access rights and ordinary health / safety inspections. A use restriction alone follows the regulatory track.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 390–401. Authority: https://www.law.cornell.edu/supremecourt/text/20-107" link="https://www.law.cornell.edu/supremecourt/text/20-107" id="state-final-physical">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="6400" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Restriction on property’s use?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Regulatory taking · choose the correct test&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Start with the protected property interest and the relevant parcel as a whole.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;All economically beneficial use of land lost?&lt;/b&gt; Apply Lucas. Otherwise apply Penn Central. A severe price decline alone is not automatically a taking.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 402–410. Authority: https://www.law.cornell.edu/supremecourt/text/505/1003" link="https://www.law.cornell.edu/supremecourt/text/505/1003" id="state-final-regulation">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="7050" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Permit conditioned on surrender of property?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Unconstitutional conditions · Nollan / Dolan&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the exact demanded dedication, easement or monetary obligation. Would imposing it directly require compensation?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Require an &lt;b&gt;essential nexus&lt;/b&gt; to a legitimate permit purpose and &lt;b&gt;rough proportionality&lt;/b&gt; to the proposed development’s effects.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 410–418. Authority: https://www.law.cornell.edu/supremecourt/text/11-1447" link="https://www.law.cornell.edu/supremecourt/text/11-1447" id="state-final-exaction">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="7700" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;If a taking: permissible public use?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Public purpose + just compensation&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Public use broadly includes a genuine public purpose; transfer to another private owner does not alone defeat it.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;A purely private taking or a pretext for conferring a private benefit fails. Compensation does not cure the absence of public use.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 418–427. Authority: https://www.law.cornell.edu/supremecourt/text/04-108" link="https://www.law.cornell.edu/supremecourt/text/04-108" id="state-final-public-use">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="8350" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-property-physical" edge="1" parent="1" source="state-final-property" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-physical" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="7520" y="10200" />
              <mxPoint x="6620" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-property-regulation" edge="1" parent="1" source="state-final-property" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-regulation" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="7520" y="10200" />
              <mxPoint x="7270" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-property-exaction" edge="1" parent="1" source="state-final-property" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-exaction" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="7520" y="10200" />
              <mxPoint x="7920" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-property-public-use" edge="1" parent="1" source="state-final-property" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-public-use" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="7520" y="10200" />
              <mxPoint x="8570" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Recurring union access took an easement&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Cedar Point Nursery v. Hassid (2021)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;California gave union organizers a right to enter agricultural employers’ property for specified periods.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Appropriating that right of access was a per se physical taking even though entry was intermittent. Duration affected compensation, not the initial classification.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 392–399. Authority: https://www.law.cornell.edu/supremecourt/text/20-107" link="https://www.law.cornell.edu/supremecourt/text/20-107" id="state-final-cedar">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="6400" y="10650" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-physical-cedar" edge="1" parent="1" source="state-final-physical" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-cedar" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Total deprivation of beneficial land use?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lucas categorical rule · narrow exception&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Yes:&lt;/b&gt; compensation ordinarily required unless existing background principles of state property / nuisance law already prohibited the use.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Calling a restriction “harm prevention” does not alone establish that exception.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;No total deprivation:&lt;/b&gt; apply Penn Central below.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 402–408. Authority: https://www.law.cornell.edu/supremecourt/text/505/1003" link="https://www.law.cornell.edu/supremecourt/text/505/1003" id="state-final-lucas-rule">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="7050" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Total loss required the background-law inquiry&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lucas v. South Carolina Coastal Council (1992)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A coastal construction ban rendered Lucas’s lots valueless on the state court’s findings.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Supreme Court rejected a free-floating harmful-use exception and remanded to determine whether background property / nuisance principles already barred the proposed use.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 402–408. Authority: https://www.law.cornell.edu/supremecourt/text/505/1003" link="https://www.law.cornell.edu/supremecourt/text/505/1003" id="state-final-lucas">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="7050" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;If no categorical taking: balance the factors&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Penn Central · contextual inquiry&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Economic impact&lt;/b&gt;; interference with &lt;b&gt;reasonable investment-backed expectations&lt;/b&gt;; and &lt;b&gt;character of the government action&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Assess the parcel as a whole. Do not isolate a single regulated interest or temporary period to manufacture total loss; no fixed percentage of lost value controls.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 408–410. Authority: https://www.law.cornell.edu/supremecourt/text/438/104" link="https://www.law.cornell.edu/supremecourt/text/438/104" id="state-final-penn-rule">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="7050" y="11350" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Landmark restriction was not a taking&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Penn Central v. New York City (1978)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;New York denied an office tower above Grand Central Terminal while allowing the existing terminal use; transferable development rights also mattered.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;On the whole parcel and the circumstances, the economic impact and expectations did not establish a compensable taking.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 408–409. Authority: https://www.law.cornell.edu/supremecourt/text/438/104" link="https://www.law.cornell.edu/supremecourt/text/438/104" id="state-final-penn">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="7050" y="11700" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-regulation-lucas-rule" edge="1" parent="1" source="state-final-regulation" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-lucas-rule" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-lucas-rule-lucas" edge="1" parent="1" source="state-final-lucas-rule" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-lucas" value="Total loss example">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-lucas-rule-penn-rule" edge="1" parent="1" source="state-final-lucas-rule" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-penn-rule" value="No total loss">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="6950" y="10760" />
              <mxPoint x="6950" y="11270" />
              <mxPoint x="7270" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-penn-rule-penn" edge="1" parent="1" source="state-final-penn-rule" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-penn" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Denial, money or legislative condition?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;No automatic escape from exactions review&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A permit denial for refusing a demand may trigger Nollan / Dolan; certain monetary exactions tied to property also qualify (&lt;b&gt;Koontz&lt;/b&gt;).&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Legislatively imposed conditions are not categorically exempt (&lt;b&gt;Sheetz&lt;/b&gt;). Identify the demand and applicable test; not every tax / fee is an exaction.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 410–418. Authority: https://www.law.cornell.edu/supremecourt/text/11-1447" link="https://www.law.cornell.edu/supremecourt/text/11-1447" id="state-final-exaction-scope">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="7700" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Denial and monetary demand still counted&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Koontz v. St. Johns River Water Management (2013)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A permit was denied after the owner rejected demands that included funding off-site improvements.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court rejected categorical exemptions for permit denials and monetary demands of this kind, then remanded. It did not itself determine the ultimate nexus / proportionality merits.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 410–413. Authority: https://www.law.cornell.edu/supremecourt/text/11-1447" link="https://www.law.cornell.edu/supremecourt/text/11-1447" id="state-final-koontz">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="7700" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Legislative origin did not exempt the fee&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Sheetz v. County of El Dorado (2024)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The county imposed a traffic-impact fee under a legislatively adopted schedule.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Takings Clause does not distinguish legislative from administrative permit conditions. The Court remanded and left other issues open, including how the test applies to classes of development.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 413–418. Authority: https://www.law.cornell.edu/supremecourt/text/22-1074" link="https://www.law.cornell.edu/supremecourt/text/22-1074" id="state-final-sheetz">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="7700" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-exaction-exaction-scope" edge="1" parent="1" source="state-final-exaction" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-exaction-scope" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-exaction-scope-koontz" edge="1" parent="1" source="state-final-exaction-scope" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-koontz" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-exaction-scope-sheetz" edge="1" parent="1" source="state-final-exaction-scope" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-sheetz" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="7600" y="10762.5" />
              <mxPoint x="7600" y="11270" />
              <mxPoint x="7920" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Integrated redevelopment served a public use&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Kelo v. City of New London (2005)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A comprehensive economic-development plan transferred condemned land to private parties.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court accepted the plan’s public purpose under the federal Constitution; it did not approve takings solely to confer private benefits. States may impose stronger restrictions.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 419–427. Authority: https://www.law.cornell.edu/supremecourt/text/04-108" link="https://www.law.cornell.edu/supremecourt/text/04-108" id="state-final-kelo">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="8350" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;What compensation and relief are due?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Value the property interest actually taken&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Ordinarily measure just compensation by fair market value of the taken interest. Scope and duration affect the amount.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Ending a taking does not necessarily eliminate compensation owed for the period it existed. Separate invalidation of a condition from compensation for property actually taken.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Return to the judicial section for forum, claim and remedy requirements.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 418–419; judicial section cross-reference. " id="state-final-compensation">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="8350" y="11000" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-public-use-kelo" edge="1" parent="1" source="state-final-public-use" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-kelo" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-public-use-compensation" edge="1" parent="1" source="state-final-public-use" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-compensation" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="8860" y="10405" />
              <mxPoint x="8860" y="10920" />
              <mxPoint x="8570" y="10920" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Existing contract substantially impaired?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Threshold inquiry · not every changed expectation&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the contract, obligation and later state / local law. A rule governing future contracts or an ordinary breach is not enough by itself.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Assess the extent of interference with the bargain, reasonable expectations and ability to safeguard or restore contractual rights.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;No substantial impairment →&lt;/b&gt; stop this clause’s inquiry; check other claims.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. Authority: https://www.law.cornell.edu/supremecourt/text/16-1432" link="https://www.law.cornell.edu/supremecourt/text/16-1432" id="state-final-impairment">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="235" width="440" x="9650" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-contract-impairment" edge="1" parent="1" source="state-final-contract" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-impairment" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Substantial impairment of private contracts?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Significant, legitimate public purpose&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Require a significant and legitimate public purpose, such as remedying a broad social or economic problem.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The adjustment must be reasonable and appropriate to that purpose. Courts generally defer to legislative judgment when the state is not a contracting party.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. Authority: https://www.law.cornell.edu/supremecourt/text/459/400" link="https://www.law.cornell.edu/supremecourt/text/459/400" id="state-final-private">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="215" width="440" x="9350" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State impairs its own obligation?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Closer review of self-interested changes&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A substantial impairment must be reasonable and necessary to serve an important public purpose.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Do not defer automatically to the State’s assessment of its own financial interests. Examine less drastic alternatives and whether the asserted circumstances were foreseeable.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. Authority: https://www.law.cornell.edu/supremecourt/text/431/1" link="https://www.law.cornell.edu/supremecourt/text/431/1" id="state-final-own">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="10000" y="10650" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-impairment-private" edge="1" parent="1" source="state-final-impairment" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-private" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9870" y="10580" />
              <mxPoint x="9570" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-impairment-own" edge="1" parent="1" source="state-final-impairment" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-own" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9870" y="10580" />
              <mxPoint x="10220" y="10580" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Regulated bargain did not support the claim&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Energy Reserves Group v. Kansas Power (1983)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Kansas limited contractual gas-price escalations in a heavily regulated industry.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The law did not substantially impair reasonable contractual expectations. The Court also found the measure served significant legitimate purposes through reasonable means.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. Authority: https://www.law.cornell.edu/supremecourt/text/459/400" link="https://www.law.cornell.edu/supremecourt/text/459/400" id="state-final-energy">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="9350" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;States could not simply repeal a bond promise&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States Trust Co. v. New Jersey (1977)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;New York and New Jersey retroactively repealed a covenant protecting revenues pledged to bondholders.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The repeal was neither reasonable nor necessary: less drastic alternatives existed, and the relevant policy concerns were foreseeable when the promise was made.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. Authority: https://www.law.cornell.edu/supremecourt/text/431/1" link="https://www.law.cornell.edu/supremecourt/text/431/1" id="state-final-trust">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="10000" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Reversible default did not substantially impair&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Sveen v. Melin (2018)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Minnesota’s divorce rule revoked an ex-spouse’s beneficiary designation on a pre-existing life-insurance policy.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The rule reflected presumed intent, did not defeat strong reliance interests, and could be reversed by restoring the designation. The threshold substantial-impairment test was not met.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 427–430. Authority: https://www.law.cornell.edu/supremecourt/text/16-1432" link="https://www.law.cornell.edu/supremecourt/text/16-1432" id="state-final-sveen">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="9350" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-private-energy" edge="1" parent="1" source="state-final-private" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-energy" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-own-trust" edge="1" parent="1" source="state-final-own" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-trust" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-impairment-sveen" edge="1" parent="1" source="state-final-impairment" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-sveen" value="Threshold example">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9240" y="10417.5" />
              <mxPoint x="9240" y="11270" />
              <mxPoint x="9570" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Governmental or attributable private conduct?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Match the actor to the particular right&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;State / local legislative, executive and judicial acts are governmental action.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;For private conduct, test government compulsion / significant encouragement, joint action, or a traditionally exclusive public function; other attribution doctrines may apply.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Funding, licensing or serving the public alone is insufficient.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 369–377. Authority: https://www.law.cornell.edu/supremecourt/text/17-1702" link="https://www.law.cornell.edu/supremecourt/text/17-1702" id="state-final-state-action">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="11000" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Retroactive criminal punishment?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article I, §10 · Ex Post Facto Clause&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the earlier act and later law. Does it retroactively criminalize conduct, aggravate an offense, increase punishment or reduce the evidence legally required to convict?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Ordinarily addresses punitive criminal measures; a civil label does not settle whether a measure is punishment. Mere procedural change is not automatically prohibited.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 431–439. Authority: https://www.law.cornell.edu/supremecourt/text/12-62" link="https://www.law.cornell.edu/supremecourt/text/12-62" id="state-final-retro">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="230" width="440" x="11650" y="10300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Legislative punishment of identified persons?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article I, §10 · Bill of Attainder Clause&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Ask whether a legislative act identifies persons / an ascertainable group, imposes punishment, and does so without judicial trial.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Evaluate historical punishment, whether the burden reasonably serves nonpunitive purposes, and legislative intent. A named burden alone is not enough.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 439–440. Authority: https://www.law.cornell.edu/supremecourt/text/328/303" link="https://www.law.cornell.edu/supremecourt/text/328/303" id="state-final-attainder">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="220" width="440" x="12300" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-rights-state-action" edge="1" parent="1" source="state-final-rights" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-state-action" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="11870" y="10200" />
              <mxPoint x="11220" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-rights-retro" edge="1" parent="1" source="state-final-rights" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-retro" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="11870" y="10200" />
              <mxPoint x="11870" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-rights-attainder" edge="1" parent="1" source="state-final-rights" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-attainder" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="11870" y="10200" />
              <mxPoint x="12520" y="10200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Private speech platform was not a state actor&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Manhattan Community Access v. Halleck (2019)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A private nonprofit operated public-access cable channels and suspended producers.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Hosting others’ speech was not a traditionally exclusive governmental function. Government designation and regulation did not turn the operator into a state actor on these facts.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 371–377. Authority: https://www.law.cornell.edu/supremecourt/text/17-1702" link="https://www.law.cornell.edu/supremecourt/text/17-1702" id="state-final-halleck">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="11000" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Identify the specific right and its test&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Fourteenth Amendment · selective incorporation&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Most Bill of Rights protections apply to states through due process. Identify whether this particular protection is incorporated, then apply its governing standard.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Separately examine due process and equal protection when triggered. The Thirteenth Amendment is an important exception to the general state-action requirement.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 369–388. Authority: https://www.law.cornell.edu/supremecourt/text/17-1091" link="https://www.law.cornell.edu/supremecourt/text/17-1091" id="state-final-incorporation">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="11000" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Excessive Fines Clause binds the states&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Timbs v. Indiana (2019)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Indiana sought civil forfeiture of a vehicle after a drug offense.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Court held that the Eighth Amendment’s excessive-fines protection applies to the states through the Fourteenth Amendment. It remanded rather than deciding that this particular forfeiture was excessive.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 382–388. Authority: https://www.law.cornell.edu/supremecourt/text/17-1091" link="https://www.law.cornell.edu/supremecourt/text/17-1091" id="state-final-timbs">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="11000" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-state-action-halleck" edge="1" parent="1" source="state-final-state-action" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-halleck" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-state-action-incorporation" edge="1" parent="1" source="state-final-state-action" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-incorporation" value="If state action / applicable right">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="10890" y="10415" />
              <mxPoint x="10890" y="10920" />
              <mxPoint x="11220" y="10920" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-incorporation-timbs" edge="1" parent="1" source="state-final-incorporation" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-timbs" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Does the change increase punishment risk?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Compare the old and new regimes in operation&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A later rule that creates a significant risk of increased punishment can violate the clause even when sentencing guidance is advisory.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Distinguish extending an unexpired limitations period from reviving a prosecution after the prior period has expired.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 431–439. Authority: https://www.law.cornell.edu/supremecourt/text/12-62" link="https://www.law.cornell.edu/supremecourt/text/12-62" id="state-final-risk">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="210" width="440" x="11650" y="10650" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Harsher advisory Guidelines were retroactive&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Peugh v. United States (2013)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The sentencing court used later Guidelines with a higher recommended range than the range in effect when the offenses occurred.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Their practical influence created a sufficient risk of greater punishment. Advisory status did not cure the violation. The federal clause illustrates the same ex post facto limit.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 432–439. Authority: https://www.law.cornell.edu/supremecourt/text/12-62" link="https://www.law.cornell.edu/supremecourt/text/12-62" id="state-final-peugh">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="11650" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Expired prosecution could not be revived&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Stogner v. California (2003)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;California reopened prosecutions after the previously applicable criminal limitations periods had run.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Applying the new law to revive those already time-barred offenses violated the Ex Post Facto Clause. Extending a period before it expires presents a different question.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 431–432. Authority: https://supreme.justia.com/cases/federal/us/539/607/" link="https://supreme.justia.com/cases/federal/us/539/607/" id="state-final-stogner">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="11650" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-retro-risk" edge="1" parent="1" source="state-final-retro" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-risk" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-risk-peugh" edge="1" parent="1" source="state-final-risk" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-peugh" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="state-edge-risk-stogner" edge="1" parent="1" source="state-final-risk" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-stogner" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="11540" y="10755" />
              <mxPoint x="11540" y="11270" />
              <mxPoint x="11870" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Legislature imposed employment punishment&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Lovett (1946)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress named three employees and barred payment for their government service, effectively excluding them from federal employment without trial.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;That legislative punishment was a bill of attainder. The federal example illustrates the parallel prohibition binding state legislatures.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 439–440. Authority: https://www.law.cornell.edu/supremecourt/text/328/303" link="https://www.law.cornell.edu/supremecourt/text/328/303" id="state-final-lovett">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="12300" y="10650" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-attainder-lovett" edge="1" parent="1" source="state-final-attainder" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-lovett" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can this plaintiff obtain this remedy?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Return to the judicial branch above&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Check jurisdiction, standing, timing, cause of action, proper defendant and requested relief.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Distinguish state sovereign immunity from municipal liability and individual-officer defenses. The answer depends on the claim, defendant and remedy.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;A procedural or remedial barrier does not establish that the challenged action is constitutional.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), Judicial section cross-reference; source chart final checks. " id="state-final-court">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="235" width="440" x="13200" y="10300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-answer-court" edge="1" parent="1" source="state-final-answer" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-court" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Direct control of wholly outside conduct?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Territorial limits on state authority&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Distinguish an in-state sale rule with outside effects from direct regulation of transactions by persons with no sufficient connection to the state.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Identify the territorial / jurisdictional link. The book treats this as a structural limit beyond ordinary commerce balancing; outside effects alone do not establish a violation.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 330–332. Authority: https://www.law.cornell.edu/supremecourt/text/21-468" link="https://www.law.cornell.edu/supremecourt/text/21-468" id="state-final-outside">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F4D6E4;fontColor=#151719;strokeColor=#B5849C;" vertex="1">
            <mxGeometry height="225" width="440" x="3300" y="11700" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-classify-outside" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-outside" value="Also check territorial reach">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3890" y="10412.5" />
              <mxPoint x="3890" y="11620" />
              <mxPoint x="3520" y="11620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Local-product tax exemption was protectionist&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Bacchus Imports v. Dias (1984)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Hawaii exempted favored locally produced alcoholic beverages from its liquor tax to encourage the local industry.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The exemption discriminated in purpose and effect. Limited market share did not cure the preference, and the Twenty-first Amendment did not save economic protectionism.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 317–320. Authority: https://www.law.cornell.edu/supremecourt/text/468/263" link="https://www.law.cornell.edu/supremecourt/text/468/263" id="state-final-bacchus">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="2000" y="11700" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Local processing rule had workable alternatives&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Dean Milk v. City of Madison (1951)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Madison limited sales to milk pasteurized within five miles of the city center, excluding an out-of-state supplier.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Reasonable nondiscriminatory inspection alternatives could protect health. The restriction failed even though it also excluded some in-state producers.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 316. Authority: https://www.law.cornell.edu/supremecourt/text/340/349" link="https://www.law.cornell.edu/supremecourt/text/340/349" id="state-final-dean">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="215" width="440" x="2000" y="12050" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-strict-bacchus" edge="1" parent="1" source="state-final-strict" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-bacchus" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1900" y="10757.5" />
              <mxPoint x="1900" y="11620" />
              <mxPoint x="2220" y="11620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-strict-dean" edge="1" parent="1" source="state-final-strict" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-dean" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1900" y="10757.5" />
              <mxPoint x="1900" y="11970" />
              <mxPoint x="2220" y="11970" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Disadvantaging certain firms was not enough&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Exxon Corp. v. Governor of Maryland (1978)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Maryland barred petroleum producers / refiners from operating retail stations. All producers / refiners were outside the state.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The rule did not block interstate goods, favor local refiners, or discriminate against out-of-state independent dealers. The Commerce Clause protects interstate trade, not a particular firm’s business model.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 321–323. Authority: https://www.law.cornell.edu/supremecourt/text/437/117" link="https://www.law.cornell.edu/supremecourt/text/437/117" id="state-final-exxon">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="230" width="440" x="2650" y="11700" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Neutral packaging rule survived review&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Minnesota v. Clover Leaf Creamery (1981)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Minnesota barred nonreturnable plastic milk containers but allowed paperboard, regardless of the milk’s origin.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The rule did not discriminate against interstate commerce merely because local pulpwood interests benefited. The relatively minor commerce burden was not clearly excessive under Pike.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 321–323. Authority: https://www.law.cornell.edu/supremecourt/text/449/456" link="https://www.law.cornell.edu/supremecourt/text/449/456" id="state-final-clover">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="2650" y="12050" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-classify-exxon" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-exxon" value="No discrimination example">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3180" y="10412.5" />
              <mxPoint x="3180" y="11620" />
              <mxPoint x="2870" y="11620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-classify-clover" edge="1" parent="1" source="state-final-classify" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-clover" value="Evenhanded example">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="3180" y="10412.5" />
              <mxPoint x="3180" y="11970" />
              <mxPoint x="2870" y="11970" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Even a small permanent occupation counted&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Loretto v. Teleprompter Manhattan CATV (1982)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;New York required landlords to permit cable-company equipment on their buildings.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The permanent physical occupation was a taking regardless of its small size or public benefits. Requiring an owner to install equipment for the owner’s own use presents a different issue.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 390–392. Authority: https://www.law.cornell.edu/supremecourt/text/458/419" link="https://www.law.cornell.edu/supremecourt/text/458/419" id="state-final-loretto">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="6400" y="11000" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Personal property receives physical-takings protection&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Horne v. Department of Agriculture (2015)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A federal raisin program required growers to surrender a portion of their crop for the government’s account.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The appropriation was a physical taking, just as appropriation of real property would be. A contingent interest in possible proceeds did not eliminate the taking.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 399–401. Authority: https://www.law.cornell.edu/supct/pdf/14-275.pdf" link="https://www.law.cornell.edu/supct/pdf/14-275.pdf" id="state-final-horne">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="230" width="440" x="6400" y="11350" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="state-edge-physical-loretto" edge="1" parent="1" source="state-final-physical" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-loretto" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="6300" y="10412.5" />
              <mxPoint x="6300" y="10920" />
              <mxPoint x="6620" y="10920" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="state-edge-physical-horne" edge="1" parent="1" source="state-final-physical" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="state-final-horne" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="6300" y="10412.5" />
              <mxPoint x="6300" y="11270" />
              <mxPoint x="6620" y="11270" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Demand lacked the required nexus&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Nollan v. California Coastal Commission (1987)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A home-rebuilding permit required an easement for public passage across the beachfront property.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The lateral-access demand did not serve the asserted interest in addressing the new house’s obstruction of views / perceived access. Without the nexus, compensation was required for the easement.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 410–411. Authority: https://www.law.cornell.edu/supremecourt/text/483/825" link="https://www.law.cornell.edu/supremecourt/text/483/825" id="state-final-nollan">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="220" width="440" x="7700" y="11700" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Nexus alone did not establish proportionality&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Dolan v. City of Tigard (1994)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A store-expansion permit required public floodplain and bicycle-path dedications.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The city had related flood-control / traffic interests but failed to justify the required dedication’s nature and extent in relation to this development. An individualized showing of rough proportionality was necessary.&lt;/p&gt;" tooltip="Guide: Can State or Local Government Act?; Joondeph (2026), 411–413. Authority: https://www.law.cornell.edu/supremecourt/text/512/374" link="https://www.law.cornell.edu/supremecourt/text/512/374" id="state-final-dolan">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="7700" y="12050" as="geometry" />
