              <mxPoint x="7520" y="7400" />
              <mxPoint x="8650" y="7400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-major-learning" edge="1" parent="1" source="executive-final-major" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-learning" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-delegation-whitman" edge="1" parent="1" source="executive-final-delegation" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-whitman" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-leg-veto-chadha" edge="1" parent="1" source="executive-final-leg-veto" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-chadha" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-line-veto-clintonny" edge="1" parent="1" source="executive-final-line-veto" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-clintonny" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-major-statutory-result" edge="1" parent="1" source="executive-final-major" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-statutory-result" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="6550" y="7667.5" />
              <mxPoint x="6550" y="8250" />
              <mxPoint x="6850" y="8250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-leg-veto-lawful-oversight" edge="1" parent="1" source="executive-final-leg-veto" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-lawful-oversight" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="7760" y="7667.5" />
              <mxPoint x="7760" y="8250" />
              <mxPoint x="8050" y="8250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Civil damages against the President?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Official versus private conduct&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Within the “outer perimeter” of official duties: &lt;b&gt;absolute damages immunity&lt;/b&gt;. Alleged wrongfulness does not itself make the act private.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Unofficial conduct has no comparable presidential immunity. Keep this separate from prospective relief.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 235–236. Authority: https://www.law.cornell.edu/supremecourt/text/457/731" link="https://www.law.cornell.edu/supremecourt/text/457/731" id="executive-final-civil">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="200" width="440" x="9100" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Criminal prosecution of a former President?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Classify the particular act · Trump v. U.S.&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Exclusive core power:&lt;/b&gt; absolute immunity.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Other official act:&lt;/b&gt; at least presumptive immunity; government must show prosecution poses no danger of intrusion on executive authority and functions.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;Unofficial act:&lt;/b&gt; no presidential immunity.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236–238. Authority: https://www.law.cornell.edu/supremecourt/text/23-939" link="https://www.law.cornell.edu/supremecourt/text/23-939" id="executive-final-criminal">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="220" width="440" x="9700" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Privileged communication or subpoena?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Confidentiality is qualified, not blanket&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the material, recipient, purpose and need. Presidential communications with close advisers differ from private financial records.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Assess confidentiality, military / diplomatic secrecy, evidentiary need, alternatives and burdens. Different proceedings require different tests.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236, 238. Authority: https://www.law.cornell.edu/supremecourt/text/418/683" link="https://www.law.cornell.edu/supremecourt/text/418/683" id="executive-final-privilege">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="210" width="440" x="10300" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Declaration or injunction?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Review of legality remains distinct&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Damages immunity does not make an unlawful policy immune from review.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Relief commonly runs against an implementing subordinate. Direct injunctions against the President raise distinct limits; do not assume the damages rule answers this question.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236. " id="executive-final-prospective">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="200" width="440" x="10900" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Official firing: damages immunity&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Nixon v. Fitzgerald (1982)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;An Air Force analyst alleged retaliatory discharge for congressional testimony.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The President had absolute damages immunity because the conduct lay within the outer perimeter of official responsibilities.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 235. Authority: https://www.law.cornell.edu/supremecourt/text/457/731" link="https://www.law.cornell.edu/supremecourt/text/457/731" id="executive-final-fitzgerald">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="175" width="440" x="9100" y="7920" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Pre-office private suit could proceed&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Clinton v. Jones (1997)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A federal civil suit concerned alleged private conduct before Clinton became President.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The Constitution did not require delaying the case until he left office. Courts could manage timing and burdens without creating presidential immunity.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 235–236. Authority: https://www.law.cornell.edu/supremecourt/text/520/681" link="https://www.law.cornell.edu/supremecourt/text/520/681" id="executive-final-clintonjones">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="185" width="440" x="9100" y="8280" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Official-act immunity requires classification&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Trump v. United States (2024)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;In the election-interference prosecution, the Court required act-by-act analysis and remanded unresolved classifications.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Discussions with Justice Department officials fell within protected exclusive executive authority. Not every alleged act was held immune.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The government cannot use evidence of immune official acts to prove liability for nonimmune conduct.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236–238. Authority: https://www.law.cornell.edu/supremecourt/text/23-939" link="https://www.law.cornell.edu/supremecourt/text/23-939" id="executive-final-trump-us">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="225" width="440" x="9700" y="8340" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;How to distinguish official from private?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Function, context and presidential responsibility&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Courts may not classify conduct by probing motive. Alleged illegality alone does not render an act unofficial.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Do not equate &lt;b&gt;official&lt;/b&gt; with &lt;b&gt;lawful&lt;/b&gt;, or treat the immunity ruling as an affirmative source of power.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 237–238. Authority: https://www.law.cornell.edu/supremecourt/text/23-939" link="https://www.law.cornell.edu/supremecourt/text/23-939" id="executive-final-classify-act">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="190" width="440" x="9700" y="7920" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Sitting President?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;DOJ position · not the Trump holding&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The Justice Department’s longstanding position bars indictment and criminal prosecution while the President is in office.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Distinguish this executive-branch view from a definitive Supreme Court holding. A subpoena is a separate question.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236. Authority: https://www.justice.gov/olc/opinion/sitting-president%E2%80%99s-amenability-indictment-and-criminal-prosecution" link="https://www.justice.gov/olc/opinion/sitting-president%E2%80%99s-amenability-indictment-and-criminal-prosecution" id="executive-final-sitting">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="185" width="440" x="9700" y="8700" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;General confidentiality yielded&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Nixon (1974)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A demonstrated, specific need for evidence in a criminal trial outweighed the generalized confidentiality claim over the Watergate tapes.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The privilege was qualified. The Court did not resolve every claim involving military / diplomatic secrets or congressional demands.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 238. Authority: https://www.law.cornell.edu/supremecourt/text/418/683" link="https://www.law.cornell.edu/supremecourt/text/418/683" id="executive-final-us-nixon">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="195" width="440" x="10300" y="7920" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Congress sought personal records&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Trump v. Mazars (2020)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;For legislative subpoenas of presidential personal records, courts must weigh separation-of-powers concerns:&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Other sources; a scope no broader than needed; evidence of the legislative purpose; and burdens on the President.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;No executive-privilege claim was at issue.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236. Authority: https://www.law.cornell.edu/supremecourt/text/19-715" link="https://www.law.cornell.edu/supremecourt/text/19-715" id="executive-final-mazars">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="440" x="10300" y="8300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State grand jury could subpoena records&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Trump v. Vance (2020)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The President had no categorical immunity from a state grand-jury subpoena for private financial records, and no heightened-need standard applied.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Ordinary objections and specific Article II burdens remained available. This did not decide whether a sitting President could be prosecuted.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236. Authority: https://www.law.cornell.edu/supremecourt/text/19-635" link="https://www.law.cornell.edu/supremecourt/text/19-635" id="executive-final-vance">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="205" width="440" x="10300" y="8700" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can this plaintiff obtain this relief?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Return to the judicial branch above&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Check jurisdiction, standing, timing, reviewability, cause of action and the proper defendant.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Match the remedy to the injury and violation. An adverse ruling may be appealed or stayed; disagreement does not itself cancel a binding unstayed order.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 236; judicial section cross-reference. " id="executive-final-court-check">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="195" width="440" x="10900" y="7920" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Independent rights and structural limits&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Run every fact-triggered constitutional check&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A valid source of executive power does not erase due process, equal protection or another applicable constitutional prohibition.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Identify who holds the right and whether the act violates it. Then keep &lt;b&gt;illegality, personal liability and available relief&lt;/b&gt; separate.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), Chs. 13–15; source chart final checks. " id="executive-final-rights">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="195" width="440" x="11900" y="7510" as="geometry" />
          </mxCell>
        </object>
