        <mxCell id="HdfO-nH2aJV_gOckw8U0-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;15th Amendment §2&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress may enforce the protection against voting discrimination based on race, color, or previous condition of servitude.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Reaches federal, state, and local government action.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="2260" y="840" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-18" edge="1" parent="1" source="HdfO-nH2aJV_gOckw8U0-7" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HdfO-nH2aJV_gOckw8U0-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;CONGRUENCE AND PROPORTIONALITY&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Does the statute target actual constitutional violations?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;→ If yes, the fit is straightforward.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;If it prohibits additional conduct:&lt;br/&gt;• Congruence: Does that prohibition help prevent or remedy the identified violations?&lt;br/&gt;• Proportionality: Is its breadth justified by the evidence and extent of those violations?&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="480" x="2050" y="1170" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-16" edge="1" parent="1" source="HdfO-nH2aJV_gOckw8U0-13" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HdfO-nH2aJV_gOckw8U0-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Rational determination&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Could Congress rationally determine that the targeted practice is a badge or incident of slavery and enact legislation to eliminate it?&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="1610" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="VivijYejFOa0upSHqsHI-2" edge="1" parent="1" source="HdfO-nH2aJV_gOckw8U0-15" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="VivijYejFOa0upSHqsHI-1" value="">
