            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-article2-war" edge="1" parent="1" source="executive-final-article2" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-war" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2820" y="7790" />
              <mxPoint x="2250" y="7790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-article2-recognition" edge="1" parent="1" source="executive-final-article2" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-recognition" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2820" y="7790" />
              <mxPoint x="2800" y="7790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-article2-pardon" edge="1" parent="1" source="executive-final-article2" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-pardon" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2820" y="7790" />
              <mxPoint x="3350" y="7790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-recognition-zivotofsky" edge="1" parent="1" source="executive-final-recognition" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-zivotofsky" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-pardon-garland" edge="1" parent="1" source="executive-final-pardon" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-garland" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Who may appoint this official?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article II, §2, cl. 2&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;First distinguish &lt;b&gt;officer / employee&lt;/b&gt;, then &lt;b&gt;principal / inferior&lt;/b&gt;, then check the appointer.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The office’s actual powers matter more than its title.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 239–257. Authority: https://www.law.cornell.edu/constitution/articleii" link="https://www.law.cornell.edu/constitution/articleii" id="executive-final-appointment">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="170" width="440" x="4000" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Officer or employee?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lucia · Buckley&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Officer:&lt;/b&gt; continuing position established by law + significant federal authority.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Employee:&lt;/b&gt; if that threshold is absent, ordinary statutory appointment rules govern.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Hearing discretion can qualify without final decisionmaking. Pure legislative research / reporting differs from executing federal law.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 239–244. Authority: https://www.law.cornell.edu/supremecourt/text/17-130" link="https://www.law.cornell.edu/supremecourt/text/17-130" id="executive-final-officer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="210" width="440" x="4000" y="7840" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;SEC adjudicators were officers&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lucia v. SEC (2018)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;ALJs held continuing statutory offices and exercised substantial discretion in hearings, evidence and decisions.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Staff selection was insufficient. They needed appointment through an Appointments Clause method.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 239–244. Authority: https://www.law.cornell.edu/supremecourt/text/17-130" link="https://www.law.cornell.edu/supremecourt/text/17-130" id="executive-final-lucia">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="185" width="400" x="4550" y="7840" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Principal or inferior?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Direction + supervision within the executive&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Who can direct the work, remove the officer, and review or block decisions?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;An inferior officer is supervised by a superior other than the President. Unreviewable final executive decisions point toward principal status.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Judicial review does not substitute for executive supervision.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 244–257. Authority: https://www.supremecourt.gov/opinions/24pdf/24-316_869d.pdf" link="https://www.supremecourt.gov/opinions/24pdf/24-316_869d.pdf" id="executive-final-rank">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="210" width="440" x="4000" y="8200" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Review and removal supplied supervision&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Kennedy v. Braidwood Management (2025)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The HHS Secretary could remove Task Force members at will and review / block recommendations before they took effect.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;They were inferior officers; appointment by the Secretary was valid. Statutory independence language did not eliminate that control.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 244–257. Authority: https://www.supremecourt.gov/opinions/24pdf/24-316_869d.pdf" link="https://www.supremecourt.gov/opinions/24pdf/24-316_869d.pdf" id="executive-final-braidwood">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="200" width="400" x="4550" y="8200" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Was the appointer authorized?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Principal and inferior routes&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Principal:&lt;/b&gt; presidential nomination + Senate confirmation.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Inferior:&lt;/b&gt; same default, or Congress may vest appointment by law in the President alone, courts of law, or heads of departments.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;A bureau chief is not necessarily a department head. Authorized selection by a subordinate with department-head approval may suffice. Congress cannot appoint executive officers.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 255–257. Authority: https://www.law.cornell.edu/constitution/articleii" link="https://www.law.cornell.edu/constitution/articleii" id="executive-final-appointer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="240" width="440" x="4000" y="8570" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Final decisions lacked executive review&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Arthrex (2021)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Patent judges could issue final decisions unreviewable by a presidentially appointed, Senate-confirmed superior.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;That authority was incompatible with their inferior-officer appointments. Allowing Director review cured the constitutional defect.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 255–256. Authority: https://www.law.cornell.edu/supremecourt/text/19-1434" link="https://www.law.cornell.edu/supremecourt/text/19-1434" id="executive-final-arthrex">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="190" width="400" x="4550" y="8570" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Congress cannot select law enforcers&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Buckley v. Valeo (1976)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congressional leaders selected voting FEC members with rulemaking and enforcement powers. That appointment method violated Article II.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Congress may appoint its own legislative staff for research and information gathering, but cannot give such appointees executive authority.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 243–244, 257. Authority: https://supreme.justia.com/cases/federal/us/424/1/" link="https://supreme.justia.com/cases/federal/us/424/1/" id="executive-final-buckley">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="185" width="440" x="4000" y="8940" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Who may remove whom?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Read the protection and every supervisory layer&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the official’s functions, the remover, the grounds required, and the chain of control.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Distinguish executive officers, legislative staff, inferior officers, employees and historically distinct offices.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; removal authorities linked below. " id="executive-final-removal">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="185" width="440" x="5550" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Does Congress retain removal control?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Bowsher · execution must remain executive&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress cannot reserve removal of an officer executing federal law, except through impeachment.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Assess actual control and functions; a legislative label does not cure executive duties. Legislative research staff raise a different question.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 220; summer supplement topic. Authority: https://supreme.justia.com/cases/federal/us/478/714/" link="https://supreme.justia.com/cases/federal/us/478/714/" id="executive-final-congress-control">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="190" width="400" x="5300" y="7840" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Congress-controlled officer executed law&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Bowsher v. Synar (1986)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The Comptroller General determined binding budget reductions while remaining subject to congressional removal.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Congress could not retain that control over execution of the law.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 220; summer supplement topic. Authority: https://supreme.justia.com/cases/federal/us/478/714/" link="https://supreme.justia.com/cases/federal/us/478/714/" id="executive-final-bowsher">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="170" width="400" x="5900" y="7840" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Principal executive officer protected?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Presidential removal · current rule&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The President generally must be able to remove principal officers exercising executive power.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;A multimember commission is no longer enough to sustain for-cause protection. Apply &lt;b&gt;Slaughter&lt;/b&gt;; do not reuse Humphrey’s Executor as a surviving general exception.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; updated primary authority, June 29, 2026. Authority: https://supreme.justia.com/cases/federal/us/609/25-332/" link="https://supreme.justia.com/cases/federal/us/609/25-332/" id="executive-final-president-control">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="200" width="400" x="5300" y="8200" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;FTC for-cause protection failed&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Trump v. Slaughter (2026)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The Court invalidated the FTC commissioners’ removal protection and &lt;b&gt;overruled Humphrey’s Executor&lt;/b&gt;. Their executive power required presidential accountability.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Its holding does not resolve every inferior-officer, employee or historically distinct office arrangement.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; updated primary authority, June 29, 2026. Authority: https://supreme.justia.com/cases/federal/us/609/25-332/" link="https://supreme.justia.com/cases/federal/us/609/25-332/" id="executive-final-slaughter">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="200" width="400" x="5900" y="8200" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Inferior officers / multiple layers?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Do not collapse all officials into one rule&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Examine duties, jurisdiction, tenure, supervision and interference with presidential execution.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Compare &lt;b&gt;Morrison’s&lt;/b&gt; limited inferior officer with &lt;b&gt;Free Enterprise Fund’s&lt;/b&gt; two protected layers. Ordinary employees require their own statutory and functional analysis.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; summer supplement topic. Authority: https://www.law.cornell.edu/supremecourt/text/487/654" link="https://www.law.cornell.edu/supremecourt/text/487/654" id="executive-final-inferior-removal">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="210" width="400" x="5300" y="8570" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Single director with broad power&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Seila Law v. CFPB (2020)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The CFPB’s single director exercised substantial executive power while protected from removal without cause. The restriction was unconstitutional and severable.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Read alongside Slaughter’s later rejection of the independent-commission exception.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; summer supplement topic. Authority: https://www.law.cornell.edu/supremecourt/text/19-7" link="https://www.law.cornell.edu/supremecourt/text/19-7" id="executive-final-seila">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="200" width="400" x="5900" y="8570" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Limited independent counsel protection&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Morrison v. Olson (1988)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Good-cause removal by the Attorney General survived for an inferior officer with limited duties, jurisdiction and tenure.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The restriction did not unduly impede presidential functions. This is not blanket permission to insulate all inferior officers.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 256–257; summer supplement topic. Authority: https://www.law.cornell.edu/supremecourt/text/487/654" link="https://www.law.cornell.edu/supremecourt/text/487/654" id="executive-final-morrison">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="190" width="400" x="5300" y="8950" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Two layers blocked accountability&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Free Enterprise Fund v. PCAOB (2010)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Board members were removable for cause by SEC commissioners themselves assumed protected from at-will presidential removal.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;That double insulation was invalid. The Court severed the Board’s removal restriction; it did not invalidate the entire agency.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; summer supplement topic. Authority: https://www.law.cornell.edu/supremecourt/text/08-861" link="https://www.law.cornell.edu/supremecourt/text/08-861" id="executive-final-free-enterprise">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="200" width="400" x="5900" y="8950" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Historically distinct offices?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Limits of Slaughter’s holding&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Slaughter preserved questions involving the Federal Reserve’s distinct historical tradition and tenure protections of non-Article III judges.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Identify the particular office and governing precedent; a generic claim of independence is insufficient.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 257; Slaughter majority, pp. 27–28. Authority: https://supreme.justia.com/cases/federal/us/609/25-332/" link="https://supreme.justia.com/cases/federal/us/609/25-332/" id="executive-final-distinct-offices">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="190" width="400" x="5900" y="9320" as="geometry" />
          </mxCell>
        </object>
