        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Commerce Clause&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Art. I, §8, cl. 3 · Lopez&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“To regulate Commerce with foreign Nations, among the several States, and with the Indian Tribes;”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Constitution, Art. I, §8, cl. 3 (verbatim). Joondeph pp. 139–163; Lopez, 514 U.S. at 558–559." link="https://www.archives.gov/founding-docs/constitution-transcript" linkTarget="_blank" id="congress-final-commerce">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="100" width="350" x="-1230" y="5220" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Channels&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lopez · category 1&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Routes used for interstate movement: highways, waterways, air routes and communications.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Congress may protect their use against harmful activity.&lt;/p&gt;" tooltip="Lopez, 514 U.S. at 558; Joondeph chapter 9." id="congress-final-channels">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="150" width="300" x="-1920" y="5520" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Instrumentalities / persons / things&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lopez · category 2&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Planes, trucks, trains, people or goods &lt;b&gt;in interstate commerce&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Congress may protect them even against a threat arising wholly within one State.&lt;/p&gt;" tooltip="Lopez, 514 U.S. at 558–559." id="congress-final-instrument">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="150" width="350" x="-1560" y="5520" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Substantial effects&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Lopez · category 3&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“activities that substantially affect interstate commerce”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Lopez, 514 U.S. at 559–567; Morrison, 529 U.S. at 610–617; Joondeph pp. 142–152." id="congress-final-effects">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="100" width="385" x="-1110" y="5540" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-commerce-channels" edge="1" parent="1" source="congress-final-commerce" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-channels" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-commerce-instrument" edge="1" parent="1" source="congress-final-commerce" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-instrument" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-commerce-effects" edge="1" parent="1" source="congress-final-commerce" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-effects" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Economic activity&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Production, distribution or consumption of commodities can be economic even without a sale.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Ask whether Congress had a &lt;b&gt;rational basis&lt;/b&gt; to find substantial effects from the class in the aggregate.&lt;/p&gt;" tooltip="Wickard, 317 U.S. at 127–129; Raich, 545 U.S. at 17–22." id="congress-final-economic">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="160" width="350" x="-1780" y="5753" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-4" edge="1" parent="1" source="congress-final-noneconomic" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-scheme">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Noneconomic conduct&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Do not aggregate the downstream costs of violence or gun possession into a general police power.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Identify a limiting principle and a genuine interstate nexus; avoid a chain of attenuated inferences.&lt;/p&gt;" tooltip="Lopez, 514 U.S. at 561–568; Morrison, 529 U.S. at 617–618." id="congress-final-noneconomic">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="130" width="425" x="-1020" y="5745" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-3" edge="1" parent="1" source="congress-final-scheme" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-raich">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9QNgjwrJa7QWuSXyMYGu-5" edge="1" parent="1" source="congress-final-scheme" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-economic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;Undermine a valid regulation of an interstate market&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;font-size: 19px;&quot;&gt;?&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Would exempting this local conduct undermine a comprehensive, valid regulation of an interstate market?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Local or noncommercial does &lt;b&gt;not&lt;/b&gt; automatically mean noneconomic. Explain the connection to the larger scheme.&lt;/p&gt;" tooltip="Raich, 545 U.S. at 17–26; Scalia concurrence at 33–38; Joondeph pp. 152–160." id="congress-final-scheme">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="170" width="400" x="-1490" y="5995" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-effects-economic" edge="1" parent="1" source="congress-final-effects" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="congress-final-economic" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-effects-noneconomic" edge="1" parent="1" source="congress-final-effects" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-noneconomic" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Homegrown wheat affects demand&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Wickard v. Filburn (1942)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Wheat grown for home use substitutes for purchases in the market.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;The farmer’s small contribution did not exempt him: similar production, taken together, affected market demand.&lt;/p&gt;" tooltip="317 U.S. 111, 127–129; Joondeph pp. 141–142." link="https://supreme.justia.com/cases/federal/us/317/111/" linkTarget="_blank" id="congress-final-wickard">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="150" width="350" x="-1970" y="6165" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Guns near schools: nexus too remote&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Lopez (1995)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The original school-zone gun law regulated possession, with no case-specific interstate-commerce element.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Crime costs → impaired education → lower productivity supplied no meaningful stopping point.&lt;/p&gt;" tooltip="514 U.S. 549, 561–568; Joondeph pp. 143–150." link="https://supreme.justia.com/cases/federal/us/514/549/" linkTarget="_blank" id="congress-final-lopez">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="160" width="400" x="-990" y="5980" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Violence is not an economic class&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Morrison (2000)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;VAWA’s civil remedy targeted gender-motivated violence.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Extensive findings about economic consequences could not justify aggregating this noneconomic conduct under Commerce.&lt;/p&gt;" tooltip="529 U.S. 598, 609–619; Joondeph pp. 150–152." link="https://supreme.justia.com/cases/federal/us/529/598/" linkTarget="_blank" id="congress-final-morrison">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="150" width="400" x="-825" y="6270" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Homegrown marijuana within the scheme&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Gonzales v. Raich (2005)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The CSA reached locally grown medical marijuana as part of regulating the interstate drug market.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Fungibility, diversion, supply-and-demand effects and difficulty separating local supplies gave Congress a rational basis.&lt;/p&gt;" tooltip="545 U.S. 1, 17–26; Joondeph pp. 152–160." link="https://supreme.justia.com/cases/federal/us/545/1/" linkTarget="_blank" id="congress-final-raich">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="170" width="400" x="-1400" y="6280" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-economic-wickard" edge="1" parent="1" source="congress-final-economic" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-wickard" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-noneconomic-lopez" edge="1" parent="1" source="congress-final-noneconomic" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-lopez" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-lopez-morrison" edge="1" parent="1" source="congress-final-lopez" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-morrison" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v5fdGlirQn1-idS4uWYH-1" edge="1" parent="1" source="congress-final-tax" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-tax-limits">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Taxing power&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;i style=&quot;font-size: 14px;&quot;&gt;Art. I, §8, cl. 1 -&amp;nbsp;&lt;/i&gt;&lt;span style=&quot;text-align: left; font-size: 14px;&quot;&gt;&lt;i&gt;NFIB&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Is the exaction reasonably understood as a tax?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Examine its operation, not merely its label or regulatory purpose.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;(1) Revenue: “it produces at least some revenue for the Government.”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;(2) Leaves a lawful choice to pay instead of doing the desired act.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;(3) Consider together: amount (choice or prohibitory punishment?), scienter (knowing wrongdoing?), and administration (ordinary tax collection or punitive enforcement?).&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Calling the payment a penalty is not conclusive.&lt;/p&gt;" tooltip="NFIB, 567 U.S. at 563–574; Joondeph pp. 165–174." id="congress-final-tax">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="260" width="385" x="-430" y="5210" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;b style=&quot;font-size: 19px;&quot;&gt;Tax&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;text-align: left; font-size: 19px;&quot;&gt;&lt;b&gt;apportionment&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Direct taxes generally require apportionment; aka if the tax is to a state it needs to be based on population&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Art. I, §8, cl. 1; §9, cl. 4; Amendment XVI; Joondeph chapter 10." link="https://www.archives.gov/founding-docs/constitution-transcript" linkTarget="_blank" id="congress-final-tax-limits">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="115" width="340" x="-340" y="5590" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Spending power&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Art. I, §8, cl. 1 · Dole&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress may spend for the general welfare even where it could not directly regulate.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="South Dakota v. Dole, 483 U.S. at 206–208; Joondeph pp. 175–184." id="congress-final-spend">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="115" width="370" x="320" y="5150" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Conditional grants to states&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Dole · requirements 1–4&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(1) &lt;b&gt;General welfare:&lt;/b&gt; substantial deference to Congress.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(2) &lt;b&gt;Clear notice:&lt;/b&gt; the State can knowingly accept the obligations.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(3) &lt;b&gt;Germaneness:&lt;/b&gt; sufficient relation to the federal interest in the program.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;(4) &lt;b&gt;No independent constitutional bar:&lt;/b&gt; the condition cannot induce the State to violate the Constitution. Lack of direct regulatory power is not itself such a bar.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;(5) No coercion: financial pressure must not become compulsion. &lt;i style=&quot;color: light-dark(rgb(21, 23, 25), rgb(211, 87, 254));&quot;&gt;NFIB&lt;/i&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Dole, 483 U.S. at 207–211; Joondeph pp. 175–182." id="congress-final-spend-conditions">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="240" width="400" x="210" y="5440" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Related highway condition upheld&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Dole&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Withholding 5% of specified highway funds encouraged a drinking age of 21.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Safer interstate travel supplied the relationship; the relatively small loss left a choice.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;The condition need not govern highway construction itself.&lt;/p&gt;" tooltip="483 U.S. 203, 208–212; Joondeph pp. 176–182." link="https://supreme.justia.com/cases/federal/us/483/203/" linkTarget="_blank" id="congress-final-dole">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="175" width="400" x="20" y="5805" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;b style=&quot;font-size: 19px;&quot;&gt;One invalid&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;clause does not discharge whole program&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;An invalid funding condition does not automatically invalidate the whole program.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;i style=&quot;color: light-dark(rgb(21, 23, 25), rgb(153, 51, 255));&quot;&gt;NFIB&lt;/i&gt; barred the threat to existing Medicaid funds; the expansion offer remained.&lt;/p&gt;" tooltip="NFIB, 567 U.S. at 585–588; existing Congress chart." id="congress-final-spend-remedy">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="140" width="380" x="450" y="5790" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-spend-spend-conditions" edge="1" parent="1" source="congress-final-spend" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-spend-conditions" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-spend-conditions-dole" edge="1" parent="1" source="congress-final-spend-conditions" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-dole" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-coercion-nfib-spend" edge="1" parent="1" source="congress-final-spend-conditions" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;" target="congress-final-spend-remedy" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="990" y="5680" as="sourcePoint" />
            <mxPoint x="710" y="5840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HIhWg0T9BdZQiPypQVWZ-9" edge="1" parent="1" source="congress-final-reconstruction" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-fourteen" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HIhWg0T9BdZQiPypQVWZ-17" edge="1" parent="1" source="congress-final-reconstruction" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="congress-final-limits" value="After the applicable amendment’s enforcement analysis">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Reconstruction Amendments&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Joondeph pp. 185–197; existing Congress chart, including Jones, Boerne and Callais." id="congress-final-reconstruction">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="70" width="315" x="-270" y="4300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Thirteenth Amendment §2&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Slavery and its badges or incidents&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Reaches &lt;b&gt;private and government conduct&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Congress may identify and eliminate badges and incidents of slavery, including qualifying racial discrimination.&lt;/p&gt;" tooltip="Amendment XIII; Jones, 392 U.S. at 438–443; Joondeph pp. 196–197." link="https://www.archives.gov/founding-docs/amendments-11-27" linkTarget="_blank" id="congress-final-thirteen">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="160" width="360" x="-1070" y="3840" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Rational determination&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Jones&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“rationally to determine what are the badges and the incidents of slavery”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Is the targeted practice a rationally identified badge or incident, and does the statute eliminate it?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Do not substitute Boerne’s §5 test for this inquiry.&lt;/p&gt;" tooltip="Jones, 392 U.S. at 440–443; Joondeph pp. 196–197." id="congress-final-thirteen-test">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="150" width="360" x="-1360" y="3470" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Private housing discrimination&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Jones v. Alfred H. Mayer Co. (1968)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Section 1982 validly reached a private seller’s race-based refusal to sell a home.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Congress could treat racial exclusion from property rights as a badge or incident of slavery.&lt;/p&gt;" tooltip="392 U.S. 409, 438–443; Joondeph pp. 196–197." link="https://supreme.justia.com/cases/federal/us/392/409/" linkTarget="_blank" id="congress-final-jones">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="155" width="360" x="-1600" y="3080" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="HIhWg0T9BdZQiPypQVWZ-7" edge="1" parent="1" source="congress-final-fourteen" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-fit" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HIhWg0T9BdZQiPypQVWZ-8" edge="1" parent="1" source="congress-final-fourteen" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-state-action" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Fourteenth Amendment §5&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;State and local government action&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Enforces equal protection, due process, privileges or immunities, and incorporated Bill of Rights guarantees.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;b&gt;Remedy or prevent violations&lt;/b&gt;; Congress cannot redefine the constitutional right.&lt;/p&gt;" tooltip="Amendment XIV; Boerne, 521 U.S. at 519–520; Joondeph pp. 185–196." link="https://www.archives.gov/founding-docs/amendments-11-27" linkTarget="_blank" id="congress-final-fourteen">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="170" width="400" x="-460" y="3740" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="HIhWg0T9BdZQiPypQVWZ-5" edge="1" parent="1" source="congress-final-fit" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-boerne" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Congruence &amp;amp; proportionality&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Boerne&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“congruence and proportionality between the injury to be prevented or remedied and the means adopted to that end.”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the right &lt;b&gt;as the Court defines it&lt;/b&gt;, the record of state violations, and the statutory remedy.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Congruence:&lt;/b&gt; does the rule prevent or remedy that injury?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Proportionality:&lt;/b&gt; does the evidence justify the remedy’s scope, duration and reach?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Prophylactic rules may reach some constitutional conduct; the fit must be justified.&lt;/p&gt;" tooltip="Boerne, 521 U.S. at 520 (verbatim excerpt), 530–536; Joondeph pp. 193–195." id="congress-final-fit">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="260" width="390" x="-775" y="3270" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="HIhWg0T9BdZQiPypQVWZ-6" edge="1" parent="1" source="congress-final-state-action" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-morrison-five" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State-action limit&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Morrison / Civil Rights Cases&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A remedy directly against private wrongdoers does not become valid §5 legislation merely because States underenforce the law.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Check Commerce or the Thirteenth Amendment instead, if the facts fit.&lt;/p&gt;" tooltip="Morrison, 529 U.S. at 619–627; Joondeph pp. 195–196." id="congress-final-state-action">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="180" width="350" x="-270" y="3270" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;RFRA went beyond enforcement&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;City of Boerne v. Flores (1997)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;RFRA imposed broad strict scrutiny on state and local laws burdening religion.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Its breadth was not matched to a record of constitutional violations. It exceeded §5 as applied to States; Congress cannot replace the Court’s constitutional rule.&lt;/p&gt;" tooltip="521 U.S. 507, 519–520, 530–536; Joondeph pp. 186–195." link="https://supreme.justia.com/cases/federal/us/521/507/" linkTarget="_blank" id="congress-final-boerne">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="180" width="390" x="-940" y="2830" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Private defendants: §5 also failed&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;United States v. Morrison (2000)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;VAWA’s civil remedy ran against private assailants, not the officials allegedly denying equal protection.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Evidence of discriminatory state enforcement did not cure that mismatch.&lt;/p&gt;" tooltip="529 U.S. 598, 619–627; Joondeph pp. 195–196." link="https://supreme.justia.com/cases/federal/us/529/598/" linkTarget="_blank" id="congress-final-morrison-five">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="160" width="350" x="-150" y="2770" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Fifteenth Amendment §2&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Race discrimination in voting&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Enforces the ban on denial or abridgment of citizens’ voting rights by the United States or any State because of race, color or previous servitude.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Identify the constitutional injury and justify the enforcement measure’s fit.&lt;/p&gt;" tooltip="Amendment XV; Louisiana v. Callais (2026), majority slip op. pp. 22–26. Joondeph p. 197 refers this topic to the summer supplement; Callais is named in the user’s Congress tab." link="https://www.archives.gov/founding-docs/amendments-11-27" linkTarget="_blank" id="congress-final-fifteen">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="175" width="400" x="70" y="3910" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Voting-rights enforcement must fit&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Louisiana v. Callais (2026)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The majority applied &lt;b&gt;congruence and proportionality&lt;/b&gt; to Fifteenth Amendment enforcement.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;For VRA §2 districting claims, it required circumstances supporting a &lt;b&gt;strong inference of intentional racial discrimination&lt;/b&gt;; disparate impact alone is insufficient.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;It did not require a direct finding of intent. The Louisiana map failed equal-protection review because §2 did not require the additional race-based district.&lt;/p&gt;" tooltip="Louisiana v. Callais, 608 U.S. ___ (Apr. 29, 2026), majority slip op. pp. 22–26, 35–37. Update expressly named in the existing Congress chart; constitutional-power focus, not a full redistricting checklist." link="https://www.supremecourt.gov/opinions/25pdf/24-109_new_jifl.pdf" linkTarget="_blank" id="congress-final-callais">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="230" width="400" x="330" y="3450" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Necessary&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“Let the end be legitimate”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Is the means of the statue reasonably attached enough to the goal identified in the enumerated powers.&amp;nbsp;&lt;/p&gt;" tooltip="McCulloch v. Maryland, 17 U.S. 316, 421 (verbatim excerpt), 413–423; Joondeph pp. 121–138." link="https://supreme.justia.com/cases/federal/us/17/316/" linkTarget="_blank" id="congress-final-necessary">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="130" width="380" x="4550" y="4970" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;A national bank as a means&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;McCulloch v. Maryland (1819)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A bank was an appropriate instrument for carrying out fiscal powers even though creating a bank was not expressly enumerated.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Maryland could not tax the federal instrument so as to control a valid federal operation.&lt;/p&gt;" tooltip="17 U.S. 316, 421–425, 436; Joondeph pp. 123–138." link="https://supreme.justia.com/cases/federal/us/17/316/" linkTarget="_blank" id="congress-final-mcculloch">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="170" width="400" x="4460" y="5180" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Proper&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The means must respect the “letter and spirit of the Constitution.”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Do not use an implied power to create a new, independent source of regulatory authority or to commandeer state government.&lt;/p&gt;" tooltip="McCulloch, 17 U.S. at 421; NFIB, 567 U.S. at 559–560; Printz, 521 U.S. at 923–924." id="congress-final-proper">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="130" width="350" x="5080" y="4990" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Useful did not make it proper&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;NFIB v. Sebelius (2012)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Roberts concluded that forced insurance purchases created expanded the commerce power and was not proper. Even if useful to the insurance reforms.&lt;/p&gt;" tooltip="567 U.S. 519, 559–560; Joondeph pp. 160–163." link="https://supreme.justia.com/cases/federal/us/567/519/" linkTarget="_blank" id="congress-final-nfib-proper">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="160" width="400" x="5150" y="5200" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-means-necessary" edge="1" parent="1" source="congress-final-means" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-necessary" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-necessary-mcculloch" edge="1" parent="1" source="congress-final-necessary" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-mcculloch" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-proper-nfib-proper" edge="1" parent="1" source="congress-final-proper" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-nfib-proper" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Anti-commandeering&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Amendment X&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress generally cannot make state legislatures or executive officers enact, retain, administer or enforce a federal regulatory program.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="New York; Printz; Murphy; Joondeph pp. 203–215." id="congress-final-commandeer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="110" width="400" x="6675" y="4820" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="v5fdGlirQn1-idS4uWYH-4" edge="1" parent="1" source="congress-final-own-activity" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-alternatives">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State as regulated participant&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Employer, owner or data supplier&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress may regulate the State’s own conduct under a valid federal power.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Garcia, 469 U.S. at 554–557; Reno v. Condon, 528 U.S. at 150–151." id="congress-final-own-activity">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="100" width="375" x="6175" y="5150" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="v5fdGlirQn1-idS4uWYH-3" edge="1" parent="1" source="congress-final-govern" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-murphy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v5fdGlirQn1-idS4uWYH-5" edge="1" parent="1" source="congress-final-govern" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="congress-final-alternatives">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State as Regulator&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Must the State enact or keep a law, administer a federal scheme, or regulate its residents for Congress?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;That is the &lt;b&gt;anti-commandeering problem&lt;/b&gt;. A choice between two forbidden commands does not cure it.&lt;/p&gt;" tooltip="New York, 505 U.S. at 175–177; Printz, 521 U.S. at 935; Murphy, 584 U.S. 453." id="congress-final-govern">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="170" width="400" x="6980" y="5100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State as employer&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Garcia v. SAMTA (1985)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Federal minimum-wage and overtime rules could apply to the municipal transit employer.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;The Court rejected immunity based on a traditional-government-function classification.&lt;/p&gt;" tooltip="469 U.S. 528, 546–557; Joondeph pp. 203–204." link="https://supreme.justia.com/cases/federal/us/469/528/" linkTarget="_blank" id="congress-final-garcia">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="155" width="340" x="6030" y="5345" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;State as database owner&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Reno v. Condon (2000)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Federal restrictions on disclosure of drivers’ data regulated the State’s own activity.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;They did not require it to regulate its citizens. The statute also reached private resellers.&lt;/p&gt;" tooltip="528 U.S. 141, 150–151; Joondeph pp. 212–213." link="https://supreme.justia.com/cases/federal/us/528/141/" linkTarget="_blank" id="congress-final-reno">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="155" width="340" x="6420" y="5345" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Regulate waste or take title&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;New York v. United States (1992)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress could not force States to regulate radioactive waste or take ownership and liability.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Both options were unconstitutional commands.&lt;/p&gt;" tooltip="505 U.S. 144, 174–177; Joondeph pp. 204–212." link="https://supreme.justia.com/cases/federal/us/505/144/" linkTarget="_blank" id="congress-final-new-york">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="155" width="350" x="6830" y="5345" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;No conscripting state officers&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Printz v. United States (1997)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress could not require local officers to perform interim handgun background checks.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Temporary duties and a modest burden did not save the command.&lt;/p&gt;" tooltip="521 U.S. 898, 933–935; Joondeph pp. 213–214." link="https://supreme.justia.com/cases/federal/us/521/898/" linkTarget="_blank" id="congress-final-printz">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="155" width="350" x="7280" y="5360" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;No forced retention of state law&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Murphy v. NCAA (2018)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress could not prohibit States from authorizing sports betting by repealing state prohibitions.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Ordering a legislature &lt;b&gt;not to repeal a law is also commandeering&lt;/b&gt;.&lt;/p&gt;" tooltip="584 U.S. 453, 473–480; Joondeph pp. 214–215." link="https://supreme.justia.com/cases/federal/us/584/16-476/" linkTarget="_blank" id="congress-final-murphy">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="160" width="400" x="7025" y="5530" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-limits-commandeer" edge="1" parent="1" source="congress-final-limits" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-commandeer" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-commandeer-own-activity" edge="1" parent="1" source="congress-final-commandeer" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-own-activity" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-commandeer-govern" edge="1" parent="1" source="congress-final-commandeer" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-govern" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-own-activity-garcia" edge="1" parent="1" source="congress-final-own-activity" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-garcia" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-own-activity-reno" edge="1" parent="1" source="congress-final-own-activity" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-reno" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-govern-new-york" edge="1" parent="1" source="congress-final-govern" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-new-york" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-govern-printz" edge="1" parent="1" source="congress-final-govern" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-printz" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Permissible alternatives&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(1) &lt;b&gt;Regulate private conduct directly&lt;/b&gt; under a valid power; conflicting state law can be preempted.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(2) Offer States a choice to administer a program &lt;b&gt;or federal officials will. &lt;/b&gt;Cooperative federalism&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(3) Offer &lt;b&gt;noncoercive, valid funding conditions&lt;/b&gt; under Dole / NFIB.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="New York, 505 U.S. at 166–169; Murphy, 584 U.S. at 477–480; Joondeph pp. 211–215." id="congress-final-alternatives">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="110" width="550" x="6510" y="5760" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Equal state sovereignty&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;If Congress singles out States’ governing authority, ask whether &lt;b&gt;current conditions&lt;/b&gt; justify the different treatment.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Does the geographic coverage sufficiently relate to the problem addressed?&lt;/p&gt;" tooltip="Shelby County, 570 U.S. at 542–557; Joondeph pp. 216–218." id="congress-final-equal">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="170" width="430" x="7670" y="4910" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Outdated coverage formula&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Shelby County v. Holder (2013)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“current burdens” must be justified by “current needs”&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;VRA §4(b)’s decades-old coverage formula failed. The Court did not strike down §5 itself or the entire Voting Rights Act.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Tie disparate geographic coverage to present evidence.&lt;/p&gt;" tooltip="570 U.S. 529, 542, 553–557; Joondeph pp. 216–218." link="https://supreme.justia.com/cases/federal/us/570/529/" linkTarget="_blank" id="congress-final-shelby">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="190" width="430" x="7730" y="5160" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can Congress authorize this suit?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Separate regulation from private enforcement&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Valid regulation does not automatically permit a private damages suit against a State.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;For Fourteenth Amendment abrogation: &lt;b&gt;clear intent&lt;/b&gt; + &lt;b&gt;valid §5 legislation&lt;/b&gt;. Commerce alone cannot generally abrogate immunity.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Use the judicial branch’s immunity exceptions above for waiver, prospective officer relief and plan-of-the-Convention cases.&lt;/p&gt;" tooltip="Fitzpatrick, 427 U.S. at 456; Seminole Tribe; Joondeph pp. 74–77, 215–216; judicial section already contains detailed exceptions." id="congress-final-immunity">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="220" width="430" x="8320" y="4810" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Valid §5 can lift immunity&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Fitzpatrick v. Bitzer (1976)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress could authorize a damages remedy against a State for sex discrimination in employment under Title VII.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;The Fourteenth Amendment altered the federal-state balance. Still test the statute’s validity under §5.&lt;/p&gt;" tooltip="427 U.S. 445, 456; Joondeph pp. 74–77, 215–216." link="https://supreme.justia.com/cases/federal/us/427/445/" linkTarget="_blank" id="congress-final-fitzpatrick">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="170" width="430" x="8320" y="5150" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Other independent prohibitions&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Rights + separation of powers&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Apply any implicated individual-rights guarantee or Article I, §9 prohibition.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;If Congress controls executive or judicial functions, apply the relevant separation-of-powers rule. A source of legislative power does not settle that question.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;For a suit, return to the judicial gates for jurisdiction, standing and relief.&lt;/p&gt;" tooltip="Joondeph pp. 121–122; chapters 13–15; cross-reference to existing judicial outline and executive tab." id="congress-final-remaining">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="195" width="430" x="8320" y="5440" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-edge-limits-equal" edge="1" parent="1" source="congress-final-limits" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-equal" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-equal-shelby" edge="1" parent="1" source="congress-final-equal" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-shelby" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-limits-immunity" edge="1" parent="1" source="congress-final-limits" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="congress-final-immunity" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-immunity-fitzpatrick" edge="1" parent="1" source="congress-final-immunity" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-fitzpatrick" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-edge-fitzpatrick-remaining" edge="1" parent="1" source="congress-final-fitzpatrick" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="congress-final-remaining" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v5fdGlirQn1-idS4uWYH-2" edge="1" parent="1" source="HIhWg0T9BdZQiPypQVWZ-11" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="HIhWg0T9BdZQiPypQVWZ-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Other Enumerated powers&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Bankruptcy&lt;/b&gt;; naturalization; &lt;b&gt;patents/copyrights&lt;/b&gt;; postal and military powers (Art. I, §8).&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Federal &lt;b&gt;elections&lt;/b&gt;: times, places and manner of congressional elections (Art. I, §4).&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Federal property / &lt;b&gt;territories&lt;/b&gt;: Art. IV, §3; D.C.: Art. I, §8, cl. 17.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Treaties&lt;/b&gt;: a valid treaty + Necessary and Proper may support implementing legislation.&lt;/p&gt;" tooltip="Joondeph pp. 197–200; added to complete the existing chart’s enumerated-power gate." id="HIhWg0T9BdZQiPypQVWZ-11">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="250" width="420" x="820" y="4920" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Implementing a valid treaty&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Missouri v. Holland (1920)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The migratory-bird statute implemented a valid treaty even though comparable legislation standing alone had been held beyond Congress’s power.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;Treaty implementation still must respect constitutional prohibitions; a treaty is not a general escape from the Constitution.&lt;/p&gt;" tooltip="252 U.S. 416, 432–435; Joondeph pp. 199–200 (also discussing Reid and Bond)." link="https://supreme.justia.com/cases/federal/us/252/416/" linkTarget="_blank" id="HIhWg0T9BdZQiPypQVWZ-13">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="180" width="400" x="860" y="5510" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="congress-route-reconstruction-thirteen" edge="1" parent="1" source="congress-final-reconstruction" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-thirteen" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-route-thirteen-test" edge="1" parent="1" source="congress-final-thirteen" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-thirteen-test" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-route-thirteen-jones" edge="1" parent="1" source="congress-final-thirteen-test" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-jones" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-route-reconstruction-fifteen" edge="1" parent="1" source="congress-final-reconstruction" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-fifteen" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="congress-route-fifteen-callais" edge="1" parent="1" source="congress-final-fifteen" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;labelPadding=0 4;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="congress-final-callais" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;&lt;u&gt;Executive branch&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Can the executive act?&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), Chs. 13–15. " id="executive-final-start">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#B58A63;strokeWidth=2.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" vertex="1">
            <mxGeometry height="115" width="280" x="-1265" y="7100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;1. Source of power?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Youngstown&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;An executive order supplies &lt;b&gt;no independent authority&lt;/b&gt;. Classify Congress’s position, then identify the statutory or Article II basis.&lt;br&gt;&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 220–232. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-power">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="115" width="350" x="-450" y="7130" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;2. Faithful execution?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Execution + independent Article II powers&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Is the President implementing valid law, exercising a distinct constitutional power, or changing the law?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Test &lt;b&gt;every relevant power and limit&lt;/b&gt; below. Necessity or a policy goal alone does not supply authority.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 220–235. Authority: https://www.law.cornell.edu/constitution/articleii" link="https://www.law.cornell.edu/constitution/articleii" id="executive-final-execute">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="175" width="440" x="2000" y="7100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;3. Proper appointment / removal?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Run both inquiries if the facts raise them&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the official’s actual duties, appointer, supervisor and removal protections.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;A valid appointment does not validate the policy. A removal defect is a separate question.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 239–257; removal supplement cross-check. " id="executive-final-personnel">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="175" width="440" x="4700" y="7100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;4. Valid use of delegated power?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Agency action + legislative process&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;For a delegated rule or decision, check statutory scope and the constitutional delegation.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;If Congress reverses a decision or the President cancels enacted law, test Article I’s required process.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 259–281. " id="executive-final-lawmaking">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="175" width="440" x="7300" y="7100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;5. Immunity, privilege or relief?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Only when liability / process is at issue&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify &lt;b&gt;civil damages, criminal prosecution, a subpoena, or prospective relief&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Presidential protections depend on the function and remedy; they do not automatically extend to every executive official.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 235–238. " id="executive-final-remedy">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="175" width="440" x="10000" y="7100" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can the executive act?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;State authority, limits and remedy separately&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Lawful act:&lt;/b&gt; sufficient statutory / constitutional authority + compliance with all triggered structural and rights limits.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Defect:&lt;/b&gt; name the precise act, provision or appointment that fails; consider severability and available relief.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Immunity may bar a remedy without making a policy lawful.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), Chs. 13–15. " id="executive-final-answer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="205" width="440" x="11900" y="7100" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="executive-edge-start-power" edge="1" parent="1" source="executive-final-start" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="executive-final-power" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-power-execute" edge="1" parent="1" source="executive-final-power" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="executive-final-execute" value="After classifying Congress’s position">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-execute-personnel" edge="1" parent="1" source="executive-final-execute" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="executive-final-personnel" value="Then test the actor, if implicated">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-personnel-lawmaking" edge="1" parent="1" source="executive-final-personnel" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="executive-final-lawmaking" value="Then test delegated action / process">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-lawmaking-remedy" edge="1" parent="1" source="executive-final-lawmaking" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="executive-final-remedy" value="Then match the claim and remedy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-remedy-answer" edge="1" parent="1" source="executive-final-remedy" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="executive-final-answer" value="After all triggered checks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Ebbs and Power&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify which zone a President is working in.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 229–232, 265–269. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-read-statute">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="90" width="340" x="-500" y="7500" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Maximum authority&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Express or implied authorization combines with presidential power&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“authority is at its maximum”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;Congress must be able:&lt;/b&gt; Congress must possess the power to confer it&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 230. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-cat1">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="140" width="410" x="-1900" y="7900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Twilight Zone&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“a zone of twilight”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress is silent&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The President must rely on &lt;b&gt;independent constitutional power&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 230–232. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-cat2">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="200" width="440" x="-950" y="7900" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="v5fdGlirQn1-idS4uWYH-6" edge="1" parent="1" source="executive-final-cat3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;labelPadding=0 4;" target="executive-final-practice">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;lowest ebb&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Action conflicts with Congress’s express or implied will.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“his power is at its lowest ebb”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The President needs an &lt;b&gt;exclusive constitutional power&lt;/b&gt; that prevents Congress from regulating this subject. Category 3 is not automatic defeat.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 230–232. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-cat3">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="200" width="440" y="7900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Could Congress confer this power?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Use the congressional branch above&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Test an enumerated power, permissible means and independent limits.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Even authorized enforcement fails if the statute being enforced is unconstitutional. Then check the executive-specific limits.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 230. " id="executive-final-valid-grant">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="170" width="440" x="-1900" y="8250" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align: center; margin: 4px 5px 0px;&quot;&gt;&lt;span style=&quot;font-size: 19px;&quot;&gt;&lt;b&gt;Independent Constitutional Powers&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;[1]&amp;nbsp;Pardons and commutations&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;[2] Recognition of foreign sovereigns&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;[3] Commander in Chief&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;[4] Execute and enforce federal law&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;[5] Nominate and appoint officers&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;[6]Supervise and remove executive officers&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 230–232. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-practice">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="170" width="440" x="-540" y="8280" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can Congress be excluded?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Identify the precise Article II function&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;If the power is not exclusive, the contrary statute controls.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Recognition and pardons illustrate potential exclusive powers. Do not treat all foreign affairs or all wartime action as exclusive.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 231–234. Authority: https://www.law.cornell.edu/supremecourt/text/13-628" link="https://www.law.cornell.edu/supremecourt/text/13-628" id="executive-final-exclusive">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="170" width="440" y="8250" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Steel seizure was unauthorized&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Youngstown Sheet &amp; Tube Co. v. Sawyer (1952)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Truman seized domestic steel mills during the Korean War without statutory authorization. Congress had rejected that method of resolving labor disputes.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Military command and faithful execution did not supply domestic lawmaking power. Jackson placed the seizure in &lt;b&gt;Category 3&lt;/b&gt;.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 222–232. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-youngstown">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="190" width="440" y="8580" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="executive-edge-power-read-statute" edge="1" parent="1" source="executive-final-power" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-read-statute" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-read-statute-cat1" edge="1" parent="1" source="executive-final-read-statute" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-cat1" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-280" y="7780" />
              <mxPoint x="-1680" y="7780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-read-statute-cat2" edge="1" parent="1" source="executive-final-read-statute" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-cat2" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-280" y="7780" />
              <mxPoint x="-730" y="7780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-read-statute-cat3" edge="1" parent="1" source="executive-final-read-statute" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-cat3" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-280" y="7780" />
              <mxPoint x="220" y="7780" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-cat1-valid-grant" edge="1" parent="1" source="executive-final-cat1" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-valid-grant" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-cat2-practice" edge="1" parent="1" source="executive-final-cat2" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-practice" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-cat3-exclusive" edge="1" parent="1" source="executive-final-cat3" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-exclusive" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-exclusive-youngstown" edge="1" parent="1" source="executive-final-exclusive" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-youngstown" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Execute the law, or rewrite it?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Article II, §3 · Take Care Clause&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;“he shall take Care that the Laws be faithfully executed”&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Implement a valid statute within the discretion it grants. A contrary new legal rule requires an exclusive Article II basis; policy disagreement is insufficient.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 220–232. Authority: https://www.law.cornell.edu/constitution/articleii" link="https://www.law.cornell.edu/constitution/articleii" id="executive-final-take-care">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="185" width="440" x="1250" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Nonenforcement discretion?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Priorities versus suspension of law&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Separate resource-based enforcement priorities and case-specific discretion from refusing to execute a mandatory duty.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Read the statute. An asserted constitutional objection must itself be tested; the assertion alone is not a license to disregard the law.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 220–232, 280–281. " id="executive-final-nonenforce">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="190" width="440" x="1250" y="7880" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Withholding required spending?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Impoundment · identify the statutory duty&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Does Congress require allotment / expenditure, or leave genuine timing and program discretion?&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;A policy preference to spend less does not override a mandatory instruction. Distinguish lawful administration from cancellation of enacted law.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 231, 280–281. Authority: https://supreme.justia.com/cases/federal/us/420/35/" link="https://supreme.justia.com/cases/federal/us/420/35/" id="executive-final-funding">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="190" width="440" x="1250" y="8240" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Mandatory allotment could not be cut&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Train v. City of New York (1975)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;The water-pollution statute required the authorized sums to be allotted. The Executive could not allot less merely because it preferred a smaller program.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;This was a &lt;b&gt;statutory holding&lt;/b&gt;; identify the actual spending command before asserting a general constitutional rule.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 231; supplemental illustration. Authority: https://supreme.justia.com/cases/federal/us/420/35/" link="https://supreme.justia.com/cases/federal/us/420/35/" id="executive-final-train">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="190" width="440" x="1250" y="8600" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Signing statement?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;An explanation does not amend the law&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;A signing statement cannot change enacted text.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;If the President claims a provision invades exclusive Article II power, test that claim under Youngstown and the substantive rule. Signing the bill does not settle the constitutional question.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 280–281. " id="executive-final-signing">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="185" width="440" x="1250" y="8960" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Independent constitutional power?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Identify its scope; then apply Congress’s posture&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;An Article II power can exist without a statute. But its scope and exclusivity must be established for &lt;b&gt;this act&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Use the relevant branch below; other constitutional prohibitions still apply.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 221, 232–235. Authority: https://www.law.cornell.edu/constitution/articleii" link="https://www.law.cornell.edu/constitution/articleii" id="executive-final-article2">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="185" width="440" x="2600" y="7510" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Command of armed forces?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Art. II, §2 · Congress’s Art. I powers&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;President commands; Congress declares war, raises and funds forces, and makes military rules.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Identify the function, authorization and applicable war-powers limits. Domestic seizure does not become military command because it assists a war.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Apply assigned war-powers rules and rights constraints.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 232; book refers further war doctrine to summer supplement. Authority: https://www.law.cornell.edu/supremecourt/text/343/579" link="https://www.law.cornell.edu/supremecourt/text/343/579" id="executive-final-war">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="220" width="400" x="2050" y="7900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Formal recognition?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Foreign sovereign / territorial sovereignty&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Recognition is an exclusive presidential power. Congress cannot compel an official contradiction of the recognition decision.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;&lt;b&gt;Other foreign policy:&lt;/b&gt; do not assume exclusivity; Congress retains commerce, funding and military powers.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 232–234. Authority: https://www.law.cornell.edu/supremecourt/text/13-628" link="https://www.law.cornell.edu/supremecourt/text/13-628" id="executive-final-recognition">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="200" width="400" x="2600" y="7900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Past federal crime?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Art. II, §2, cl. 1 · pardon power&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;May pardon after the offense but before charges or conviction; may commute punishment.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;b&gt;Outside the power:&lt;/b&gt; future crimes, state crimes, civil liability and impeachment.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;Congress cannot dictate the recipient. Self-pardons present a separate unsettled issue.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 234–235. Authority: https://www.law.cornell.edu/supremecourt/text/71/333" link="https://www.law.cornell.edu/supremecourt/text/71/333" id="executive-final-pardon">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#F7DCC2;fontColor=#151719;strokeColor=#B58A63;" vertex="1">
            <mxGeometry height="210" width="400" x="3150" y="7900" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Congress could not contradict recognition&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Zivotofsky v. Kerry (2015)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Congress required “Israel” on requested passports of Jerusalem-born citizens, contrary to the Executive’s recognition policy.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The requirement intruded on exclusive recognition power: a &lt;b&gt;Category 3 action could prevail&lt;/b&gt;. This was not a grant of exclusive control of all foreign affairs.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 232–234. Authority: https://www.law.cornell.edu/supremecourt/text/13-628" link="https://www.law.cornell.edu/supremecourt/text/13-628" id="executive-final-zivotofsky">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="400" x="2600" y="8300" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Pardon reaches completed offenses&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;i&gt;Ex parte Garland (1866 Term; decided 1867)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;Garland’s pardon removed the disqualification flowing from his participation in the rebellion; Congress could not defeat its effect through the loyalty oath.&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0px;&quot;&gt;The power may operate before prosecution or after conviction. It does not authorize future crimes.&lt;/p&gt;" tooltip="Guide: Can the Executive Act?; Joondeph (2026), 234. Authority: https://www.law.cornell.edu/supremecourt/text/71/333" link="https://www.law.cornell.edu/supremecourt/text/71/333" id="executive-final-garland">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#76608a;fontColor=#ffffff;strokeColor=#432D57;" vertex="1">
            <mxGeometry height="210" width="400" x="3150" y="8300" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="executive-edge-execute-take-care" edge="1" parent="1" source="executive-final-execute" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-take-care" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2220" y="7400" />
              <mxPoint x="1470" y="7400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-execute-article2" edge="1" parent="1" source="executive-final-execute" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-article2" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2220" y="7400" />
              <mxPoint x="2820" y="7400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="executive-edge-take-care-nonenforce" edge="1" parent="1" source="executive-final-take-care" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-nonenforce" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-nonenforce-funding" edge="1" parent="1" source="executive-final-nonenforce" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-funding" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-funding-train" edge="1" parent="1" source="executive-final-funding" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-train" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="executive-edge-nonenforce-signing" edge="1" parent="1" source="executive-final-nonenforce" style="edgeStyle=none;rounded=0;html=1;endArrow=classic;endFill=1;fontFamily=Helvetica;fontSize=12;strokeWidth=1.5;defaultLabelBackgroundColor=gap;labelPadding=0 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="executive-final-signing" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="7975" />
              <mxPoint x="1150" y="8870" />
