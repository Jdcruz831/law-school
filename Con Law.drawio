        <mxCell id="stop-forum" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#243338;strokeColor=#9ABDC0;strokeWidth=1.5;fontColor=#F5F5F5;fontFamily=Helvetica;align=left;verticalAlign=middle;spacingLeft=11;spacingRight=11;spacingTop=6;spacingBottom=6;" value="&lt;div style=&quot;text-align:center;font:bold 21px Helvetica;color:#ffffff&quot;&gt;&lt;u&gt;If jurisdiction or relief is barred&lt;/u&gt;&lt;/div&gt;&lt;div style=&quot;margin:10px 0 8px;border-top:1px solid #81a7aa&quot;&gt;&lt;/div&gt;&lt;div style=&quot;text-align:left;font:16px/1.3 Helvetica;color:#f3f7f7&quot;&gt;Dismiss the affected claim, deny barred relief, or address the forum defect. Analyze remaining claims and remedies separately.&lt;/div&gt;" vertex="1">
          <mxGeometry height="132" width="390" x="2620" y="-19550" as="geometry" />
        </mxCell>
        <mxCell id="path-forum-stop-forum" edge="1" parent="1" source="s3" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;strokeColor=#FFFFFF;strokeWidth=3.5;endSize=13;exitX=0.5;exitY=0;entryX=0;entryY=0.5;fontColor=#FFFFFF;fontSize=14;labelBackgroundColor=#141414;" target="stop-forum" value="Absent / barred">
