          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VivijYejFOa0upSHqsHI-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;as an employer, property owner, or other participant in regulated activity?&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;permissible if supported by a federal power.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="290" x="340" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-2" edge="1" parent="1" source="VivijYejFOa0upSHqsHI-3" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="gDnyKX3dXUXfb1rj6tRG-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-9" edge="1" parent="1" source="VivijYejFOa0upSHqsHI-3" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="gDnyKX3dXUXfb1rj6tRG-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-11" edge="1" parent="1" source="VivijYejFOa0upSHqsHI-3" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="gDnyKX3dXUXfb1rj6tRG-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VivijYejFOa0upSHqsHI-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Legislate, retain a regulatory prohibition, or enforce federal policy against residents&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Anti-commandeering concern.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="250" x="1040" y="2530" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Legislative commandeering&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i style=&quot;text-align: left;&quot;&gt;New York v. United States&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Legislative commandeering&lt;/b&gt;: Congress cannot require states to regulate radioactive waste or take ownership and liability. A choice between two unconstitutional commands is no valid choice.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;States had to regulate radioactive waste according to federal instructions or take ownership and liability.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="420" x="1230" y="2670" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;State as employer:&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Garcia&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress may apply federal wage-and-hour requirements to state and local employers. Regulates their employment practices; does not require them to govern residents..&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="320" x="-160" y="2720" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;State as database owner&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Reno&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress may regulate disclosure of drivers’ personal information. Regulates the state’s own activity rather than requiring it to regulate others..&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="290" x="210" y="2720" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-13" edge="1" parent="1" source="gDnyKX3dXUXfb1rj6tRG-8" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HG-kfVQ57Oy37fDg51bK-4" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="802.4509803921569" y="3220" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Executive commandeering&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Printz&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress cannot require state/local officers to perform handgun background checks for a federal law.&amp;nbsp;Congress could not conscript them to administer federal laws&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="290" x="640" y="2710" as="geometry" />
        </mxCell>
        <mxCell id="gDnyKX3dXUXfb1rj6tRG-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Forced retention of state law&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Murphy&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress cannot prevent states from repealing their sports-gambling prohibitions. Requiring states to keep regulating is also commandeering..&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="960" y="2705" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Declaring a Statute Unconstitutional&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Trump v. Casa&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- federal unconstitutional injunctions can only provide protection for actual plantifs not affected parties unless class action, because&amp;nbsp;law is unconstitutional not that it&#39;s void.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Only thing stopping executive branch from abusing the&amp;nbsp;party-specific injunction is the class wide actions providing actual universal relief.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="320" x="310" y="4430" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-19" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-2" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Defiance of federal Injunction&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Ex parte Young (1908)&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Judicial Contempt:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Which typically for States violate the 11th amendment, however the legal fiction that when a state officer attempts to enforce an unconstitutional law, they are acting outside the scope of their lawful state authority and are not &quot;the state&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Limits: Only future actions, not previous ones. (&lt;b&gt;Prospective v. retrospective&lt;/b&gt;)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="208.75" width="320" x="600" y="4060" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-11" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-3" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000, #77bb41);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Amendment XI&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Judicial power of the United States shall not be construed to extend to any suit in law or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;equity, commenced or prosecuted against one of the United States by Citizens of another State,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;or by Citizens or Subjects of any Foreign State.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="1180" y="3090" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-12" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-4" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-13" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-4" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;State Sovereignty Immunity: Blocks States from being Sued Federally&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;by Citizens of another State&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Citizens or Subjects of any Foreign State&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- their own state (&lt;i&gt;Hans v. Louisiana&lt;/i&gt; (1890))&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="430" x="620" y="3240" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Arms of the State&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Galette&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Consider:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Legal Separateness &amp;amp; Corporate Form: Corporate form is the&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;power to sue and be sued, hold property, and contract&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;-  Financial Liability: Would a judgment come out of the state coffers&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;State Control: like school boards&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;e.g. Municipal corporations &lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="420" x="280" y="3570" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-14" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-15" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-16" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-17" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-18" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HG-kfVQ57Oy37fDg51bK-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bypassing State Sovereign Immunity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. State Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Implicit Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. Appeals of State Court Judgments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. Congressional Abrogation&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="1030" y="3620" as="geometry" />
        </mxCell>
        <mxCell id="vA_hC0EoCeZEVq46xzTu-2" edge="1" parent="1" source="HG-kfVQ57Oy37fDg51bK-7" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vA_hC0EoCeZEVq46xzTu-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;State Consent &amp;amp; Waiver&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Statutory Waiver&lt;/b&gt; :&amp;nbsp;A state can waive immunity via a statute w/&amp;nbsp;&quot;unmistakably clear&quot; language&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Federal Spending Programs&lt;/b&gt;: Congress can condition the receipt of federal funds on a state&#39;s waiver of Eleventh Amendment immunity&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Litigation Conduct:&lt;/b&gt;&amp;nbsp;he state voluntarily chooses to remove the case to federal court, the state forfeits its Eleventh Amendment immunity&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="290" x="955" y="4130" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Implicit Consent&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the states implicitly surrendered their sovereign immunity to a narrow list of lawsuits:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought by sister states&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought by the federal government&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Claims arising in bankruptcy proceedings&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Eminent domain condemnation proceedings brought by private delegates&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought under federal statutes enacted under Congress&#39;s authority to build and maintain a national military&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="280" x="1300" y="4140" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional Abrogation&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Fitzpatrick v. Bitzer&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress has the power to pass statutes that strip states of their sovereign immunity, only if in 14th amendment § 5 powers.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Congress clearly states its intent to subject states to suit.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The legislation is valid under §5, including congruence and proportionality where applicable.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="365" x="1955" y="3980" as="geometry" />
        </mxCell>
        <mxCell id="HG-kfVQ57Oy37fDg51bK-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Appeals of State Court Judgments&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Cohens v. Virginia&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- does not bar the U.S. Supreme Court from exercising its appellate jurisdiction to review state court judgments on federal issues&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- only when state is defendant&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="1625" y="4140" as="geometry" />
        </mxCell>
        <mxCell id="vA_hC0EoCeZEVq46xzTu-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;EQUAL STATE SOVEREIGNTY&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Shelby County v. Holder&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Trigger: &lt;/b&gt;Congress imposes special burdens on the governing authority of selected states.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Ask:&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;• &lt;/b&gt;What current conditions justify the different treatment?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;• Is the law’s geographic coverage sufficiently related to the problem it targets?&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="430" x="670" y="5010" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="conlaw-all-cases" name="Important Cases">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="8075" pageHeight="12135" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;CON LAW · 54 IMPORTANT CASES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=34;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="7995" height="90" as="geometry" />
        </mxCell>
        <mxCell id="guide" value="Read each topic column from top to bottom. Every case has: background facts → plain-language rules → decision and reason → exam application. Click “Read the opinion” for the source. Case selection follows your notes; it is not a syllabus-based guarantee of course coverage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=22;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="7995" height="120" as="geometry" />
        </mxCell>
        <mxCell id="topic-0" value="&lt;b&gt;JUDICIAL REVIEW &amp;amp; JURISDICTION&lt;/b&gt;&lt;br&gt;8 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dfeaf8;strokeColor=#dfeaf8;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-0-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Marbury v. Madison (1803)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;President Adams appointed Marbury as a justice of the peace shortly before leaving office. His commission was signed and sealed but not delivered. The Jefferson administration withheld it. Marbury asked the Supreme Court itself to order Secretary of State Madison to deliver it, relying on §13 of the Judiciary Act of 1789.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A completed appointment can create an individual legal right.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Courts can enforce a specific legal duty owed to a person, although discretionary political decisions are different.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Before granting relief, the court must have jurisdiction. Congress cannot expand the Supreme Court&amp;#x27;s original jurisdiction beyond Article III.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; When a federal statute conflicts with the Constitution, the court applies the Constitution.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Marbury had a right and an appropriate type of remedy, but this Court could not issue it in an original action. The conflicting statutory grant failed.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Separate right, remedy, and jurisdiction. Judicial review does not mean every court can grant every remedy.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/5/137/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/5/137/">
          <mxGeometry x="40" y="475" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-0-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Fletcher v. Peck (1810)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Georgia&amp;#x27;s legislature sold a large tract of land through a transaction tainted by bribery. A later legislature tried to cancel the grant. The land had passed through later purchasers, and Fletcher sued Peck over promises that the title was valid. The dispute required a federal court to assess the state repeal&amp;#x27;s constitutionality.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A state land grant is an executed contract.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; A state cannot simply cancel vested contractual rights through a later statute when the Constitution&amp;#x27;s Contracts Clause forbids the impairment.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Courts may refuse to give effect to state legislation that conflicts with the federal Constitution.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The attempted cancellation could not defeat the protected grant and subsequent purchaser&amp;#x27;s title. The case illustrates federal judicial review of state statutes.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Marbury concerns federal legislation; Fletcher illustrates review of state legislation. The actual constitutional restriction here was the Contracts Clause.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/10/87/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/10/87/">
          <mxGeometry x="40" y="1380" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-0-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Martin v. Hunter’s Lessee (1816)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A Virginia land-title dispute involved property formerly owned by Lord Fairfax and inherited by a British subject. Federal treaties protected the claimed title. The Supreme Court reversed the Virginia judgment, but Virginia&amp;#x27;s highest court refused to follow the mandate, arguing that federal appellate review could not reach an independent state&amp;#x27;s courts.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Article III appellate power extends to federal-law cases, including those decided in state courts.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Congress may authorize Supreme Court review of the federal question in a state judgment.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Review promotes consistent federal law and protects federal rights against local interests.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court upheld §25 of the Judiciary Act and rejected Virginia&amp;#x27;s claim that its courts were beyond federal appellate review.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask whether the judgment involves a federal question. State-court origin does not prevent Supreme Court review; purely state-law issues are different.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/14/304/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/14/304/">
          <mxGeometry x="40" y="2285" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-0-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Cohens v. Virginia (1821)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Virginia convicted the Cohen brothers for selling lottery tickets without state authorization. They argued that a congressional law authorizing the District of Columbia lottery protected their sales. Virginia challenged Supreme Court review because it was a state-party criminal case and because Article III lists state-party cases within original jurisdiction.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; The Supreme Court may review federal questions in state criminal judgments.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The fact that a state is a party does not put every such case exclusively into original jurisdiction.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Reviewing a prosecution begun by the state is different from a private plaintiff starting a damages suit against the state.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court found appellate jurisdiction but affirmed the convictions: the federal lottery authorization did not authorize ticket sales in Virginia against its law.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Winning the jurisdiction issue does not mean winning the merits. Analyze federal appellate review separately from sovereign-immunity barriers to a new suit.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/19/264/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/19/264/">
          <mxGeometry x="40" y="3190" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-0-4" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Kline v. Burke Construction Co. (1922)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A paving contractor sued in federal court on diversity jurisdiction over work in Texarkana. The opposing parties brought a related state-court action on the same contract, seeking money and an accounting. After a federal mistrial, the contractor tried to stop the state case through a federal injunction.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Article III sets the available constitutional categories; Congress must confer jurisdiction on lower federal courts by statute.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Two personal-liability suits seeking money may proceed in state and federal court at the same time.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A different rule protects the first court&amp;#x27;s control over specific property when competing proceedings would interfere with that control.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The federal court could not enjoin this parallel state action merely because its own money-damages case had been filed first.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Course point: constitutional capacity is different from statutory permission. Actual case holding: parallel personal actions differ from competing control over property.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/260/226/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/260/226/">
          <mxGeometry x="40" y="4135" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-0-5" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Ex parte McCardle (1869)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;McCardle, a Mississippi newspaper editor, was detained by military authorities during Reconstruction over allegedly inflammatory publications. He sought habeas relief and appealed under an 1867 statute. While the Supreme Court appeal was pending, Congress repealed the provision authorizing that appellate route, overriding the President&amp;#x27;s veto.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Article III allows Congress to make exceptions to the Supreme Court&amp;#x27;s appellate jurisdiction.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; When Congress validly withdraws the route supporting a pending appeal, the Court cannot decide the merits through that route.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The repeal here did not eliminate previously available habeas jurisdiction under a different route.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The appeal was dismissed for lack of jurisdiction. The Court did not decide whether McCardle&amp;#x27;s detention or the Reconstruction measures were lawful.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Do not say Congress may strip every kind of jurisdiction without limits. This decision concerned a particular appellate route, with another route left intact.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/74/506/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/74/506/">
          <mxGeometry x="40" y="5040" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-0-6" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;United States v. Klein (1871)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A claim sought the proceeds of property seized during the Civil War. A presidential pardon helped establish the loyalty needed for recovery. Congress then directed courts to treat acceptance of certain pardons as proof of disloyalty and to dismiss affected claims for lack of jurisdiction.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may define jurisdiction, but cannot use that power to make courts participate in a constitutional violation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Here, the law dictated how a pardon must affect a pending claim and interfered with the President&amp;#x27;s pardon power.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Distinguish instructions about results under existing law from valid changes to substantive law that courts independently apply.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The law failed because it intruded on judicial and executive functions rather than merely making an ordinary jurisdictional exception.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A law affecting pending litigation is not automatically invalid. Ask whether Congress changes the governing law or commands an unconstitutional judicial result.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/80/128/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/80/128/">
          <mxGeometry x="40" y="5945" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-0-7" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Trump v. CASA, Inc. (2025)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Individuals, organizations, and states challenged an executive order restricting recognition of birthright citizenship. Three district courts issued preliminary injunctions preventing enforcement against anyone, including nonparties. The government asked the Supreme Court to stay the orders insofar as their protection extended beyond what the plaintiffs needed.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A federal court needs lawful authority for the remedy it orders.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The Court concluded that universal injunctions likely exceeded the equitable authority Congress had provided.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; An injunction may still be as broad as necessary to give complete relief to each plaintiff with standing.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; This ruling did not settle class-action remedies, APA remedies, or the citizenship merits.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court granted partial stays only to the extent the injunctions exceeded the scope needed for complete plaintiff relief.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Distinguish nationwide geographic reach from protection of every nonparty. A nationwide order can sometimes be necessary to protect an actual plaintiff fully.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://www.law.cornell.edu/supremecourt/text/24A884&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://www.law.cornell.edu/supremecourt/text/24A884">
          <mxGeometry x="40" y="6850" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="topic-1" value="&lt;b&gt;STANDING &amp;amp; JUSTICIABILITY&lt;/b&gt;&lt;br&gt;8 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f1eb;strokeColor=#e2f1eb;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="1045" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-1-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Spokeo, Inc. v. Robins (2016)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Spokeo operated an online people-search service used to gather personal information, including by potential employers. Robins alleged that his profile misstated details such as his education, family status, and wealth, violating federal credit-reporting law. The Ninth Circuit treated his individualized statutory rights as enough to establish injury.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Standing requires both particularization and concreteness.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Particularized means the injury affects this plaintiff personally. Concrete means a real harm, which can be intangible.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A bare procedural violation with no concrete harm may be insufficient; some statutory violations themselves do create concrete harm. History and Congress&amp;#x27;s judgment help assess intangible injuries.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Supreme Court vacated and remanded because the lower court had not separately analyzed concreteness. It did not finally decide that Robins lacked concrete injury.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Do not collapse &amp;#x27;the information was about me&amp;#x27; into &amp;#x27;I suffered a real injury.&amp;#x27; State each requirement separately.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/578/13-1339/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/578/13-1339/">
          <mxGeometry x="1045" y="475" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-1-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;TransUnion LLC v. Ramirez (2021)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A credit-reporting agency placed misleading alerts in consumers&amp;#x27; files suggesting possible matches to a federal list of terrorists and other prohibited persons. A class sought statutory damages. Reports for 1,853 members reached third-party businesses; the inaccurate files of 6,332 others were not disclosed during the relevant period.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A statutory cause of action does not itself establish Article III injury.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; A concrete intangible injury can resemble a traditionally recognized harm, such as defamation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Each class member seeking individual damages needs concrete harm.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; For damages, a mere future risk of disclosure did not suffice without realized harm or a separate harm caused by that risk.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The disclosed-report group had concrete reputational injury. The undisclosed-file group did not show concrete harm on that claim merely from the inaccurate internal files.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Match the injury to the claim and remedy. The analysis of imminent future harm for an injunction differs from damages for past injury.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/594/20-297/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/594/20-297/">
          <mxGeometry x="1045" y="1380" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-1-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Summers v. Earth Island Institute (2009)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Environmental groups challenged Forest Service rules allowing some projects to bypass notice, comment, and appeal. They initially identified the Burnt Ridge timber project, which threatened a member&amp;#x27;s recreational interests. After that project dispute settled, they continued attacking the rules using broader statements about members&amp;#x27; plans to visit forests.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; An organization relying on members&amp;#x27; injuries must identify a member with a concrete, imminent stake in the challenged action.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Aesthetic and recreational injuries count, but general future travel intentions are insufficient.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A procedural right does not dispense with the need for an affected concrete interest.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; A large membership alone does not establish that some unidentified member must be injured.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Once the specific project dispute disappeared, the remaining declarations did not establish standing to challenge the rules.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Identify who, which place or project, when the member expects to visit, and how the challenged rule threatens that interest.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/555/488/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/555/488/">
          <mxGeometry x="1045" y="2325" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-1-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Allen v. Wright (1984)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Parents of Black public-school children claimed that the IRS inadequately enforced its policy denying tax exemptions to racially discriminatory private schools. They argued that the exemptions subsidized segregated schools and encouraged white flight, harming integration in their children&amp;#x27;s public schools. They sought changes to IRS enforcement rather than admission to the private schools.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; An abstract interest in lawful government is not enough.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Stigmatic injury from discrimination supports standing when the plaintiff personally suffers unequal treatment, not simply awareness of discrimination against others.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; An injury must be fairly traceable to the defendant. Speculative choices by schools and parents can break the necessary causal connection.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The parents lacked standing. The claimed integration injury depended on an uncertain chain of independent decisions about taxes, school policies, and enrollment.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A serious social injury still needs defendant-specific causation. Trace each link between the requested government action and the plaintiff&amp;#x27;s injury.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/468/737/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/468/737/">
          <mxGeometry x="1045" y="3270" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="case-1-4" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;City of Los Angeles v. Lyons (1983)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Lyons alleged that Los Angeles officers stopped him for a traffic violation and, despite his lack of resistance, applied a chokehold that injured him. He requested damages for the incident and an injunction limiting future police chokeholds. His fear of another encounter rested mainly on the earlier event and the city&amp;#x27;s alleged practices.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Standing must exist for each kind of relief.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Damages address a completed injury; an injunction addresses threatened future injury.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A plaintiff seeking an injunction must show a real and immediate threat of being personally harmed again.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; A past incident alone does not establish that future threat.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court rejected standing for the prospective injunction; the past incident could still support a damages claim.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask &amp;#x27;Why is this plaintiff likely to be harmed again?&amp;#x27; Do not infer an injunction from a valid damages claim.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/461/95/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/461/95/">
          <mxGeometry x="1045" y="4235" width="960" height="840" as="geometry" />
        </mxCell>
        <mxCell id="case-1-5" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Susan B. Anthony List v. Driehaus (2014)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;An advocacy group accused a congressman of supporting taxpayer-funded abortion by voting for the ACA. He filed an Ohio false-campaign-statement complaint, and an elections panel found probable cause. After he lost reelection, the complaint ended, but the group planned similar speech. Another group said it had withheld similar statements for fear of enforcement.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A person need not violate a law and wait for prosecution to challenge it.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Identify intended conduct arguably protected by the Constitution.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Show that the statute arguably prohibits that conduct.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Show a credible enforcement threat, supported here by the earlier proceedings, similar planned speech, and the enforcement system.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The allegations established sufficiently imminent injury for pre-enforcement review; the Court did not decide the speech law&amp;#x27;s constitutionality.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A dismissed past complaint does not automatically eliminate a credible threat to planned future conduct.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/573/149/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/573/149/">
          <mxGeometry x="1045" y="5120" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-1-6" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Zivotofsky v. Clinton (2012)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Congress allowed Jerusalem-born U.S. citizens to request &amp;#x27;Israel&amp;#x27; as their passport birthplace. The State Department refused because its policy avoided recognizing sovereignty over Jerusalem. Zivotofsky&amp;#x27;s parents sought enforcement of the statute. Lower courts dismissed the dispute as a political question involving foreign affairs.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A politically sensitive subject is not automatically a political question.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Ask whether the Constitution assigns the specific issue exclusively to another branch or whether manageable legal standards are absent.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Interpreting a statute and deciding whether it conflicts with presidential constitutional power are ordinary judicial tasks.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The case could be heard. The Court sent it back for a merits decision instead of itself deciding who controlled the passport designation.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;This 2012 Clinton decision concerns justiciability. The 2015 Kerry decision resolves the recognition-power merits.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/566/189/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/566/189/">
          <mxGeometry x="1045" y="6065" width="960" height="840" as="geometry" />
        </mxCell>
        <mxCell id="case-1-7" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Rucho v. Common Cause (2019)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Voters challenged congressional maps in North Carolina and Maryland, alleging that Republican and Democratic officials respectively used district boundaries to entrench their parties. Lower courts found constitutional violations. The dispute required deciding how much partisan advantage in redistricting becomes constitutionally excessive.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Federal constitutional partisan-gerrymandering claims are nonjusticiable political questions.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The Court found no manageable, politically neutral constitutional standard for measuring excessive partisanship.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The Constitution does not guarantee parties seats proportional to statewide support.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; This holding does not make racial-gerrymandering or equal-population claims categorically nonjusticiable.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Federal courts could not resolve these partisan-fairness claims. State-law rules, state courts, commissions, and political processes remain distinct avenues.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Identify the claim precisely: partisan advantage is different from racial classification or unequal population.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/588/18-422/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/588/18-422/">
          <mxGeometry x="1045" y="6950" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="topic-2" value="&lt;b&gt;STATE IMMUNITY&lt;/b&gt;&lt;br&gt;4 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e7f4;strokeColor=#f3e7f4;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="2050" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-2-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Hans v. Louisiana (1890)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Hans held Louisiana state bonds and sought unpaid interest after the state changed its payment arrangements. He was a Louisiana citizen suing Louisiana itself in federal court, alleging an unconstitutional impairment of contract. The Eleventh Amendment&amp;#x27;s text mentions citizens of other states, so he argued that its wording did not bar his suit.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A state&amp;#x27;s immunity is broader than the Eleventh Amendment&amp;#x27;s literal list of plaintiffs.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; An unconsenting state generally cannot be sued by its own citizens in federal court merely because the claim raises federal law.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A constitutional claim does not itself remove immunity.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Check separate routes such as consent, valid congressional abrogation, or a qualifying prospective officer suit.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court rejected the suit against Louisiana despite the federal constitutional theory and Hans&amp;#x27;s in-state citizenship.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Separate subject-matter jurisdiction from immunity. A federal question may exist even though this defendant is immune from this suit.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/134/1/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/134/1/">
          <mxGeometry x="2050" y="475" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-2-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Ex parte Young (1908)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Minnesota imposed railroad rates backed by severe civil and criminal penalties. Railroad shareholders challenged the scheme in federal court. After that court restrained enforcement, Attorney General Young pursued enforcement anyway and was held in contempt. He sought release, arguing that the suit was effectively an impermissible suit against Minnesota.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A plaintiff may sue a responsible state officer for prospective relief against an ongoing violation of federal law.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; For that purpose, unconstitutional enforcement is treated as outside the officer&amp;#x27;s lawful state authority.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The officer needs a connection to enforcement.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; This route generally does not authorize retrospective compensation paid from the state treasury.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The federal injunction could operate against Young, and state immunity did not require his release from the contempt order.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The central distinction is prospective compliance versus retrospective state liability. Contempt explains the case&amp;#x27;s posture, not the whole doctrine.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/209/123/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/209/123/">
          <mxGeometry x="2050" y="1380" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-2-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Galette v. New Jersey Transit Corp. (2026)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;NJ Transit buses injured people in separate accidents in New York and Pennsylvania. The victims sued in their home-state courts. NJ Transit claimed New Jersey&amp;#x27;s sovereign immunity. The two states&amp;#x27; highest courts disagreed about whether the transit corporation was sufficiently part of New Jersey to share its immunity.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; State creation or public functions do not automatically make an entity an arm of the state.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Examine the legal entity created by state law, especially separate corporate identity, who is legally responsible for its debts, and state control.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Government appointment or funding alone does not settle the question.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; The issue here was immunity in another state&amp;#x27;s courts.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;NJ Transit was not entitled to New Jersey&amp;#x27;s interstate sovereign immunity. Its legal separateness and lack of state liability mattered despite substantial state influence.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask whether the defendant is the state itself or an independent public entity; do not assume that every government-related corporation is immune.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://www.supremecourt.gov/opinions/25pdf/24-1021_p860.pdf&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://www.supremecourt.gov/opinions/25pdf/24-1021_p860.pdf">
          <mxGeometry x="2050" y="2325" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-2-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Fitzpatrick v. Bitzer (1976)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Male Connecticut employees challenged sex discrimination in the state&amp;#x27;s retirement-benefit plan under Title VII. Congress had amended that statute to cover states as employers. The employees won prospective relief, but a lower court refused retroactive benefits because they would be paid from the state treasury.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress can remove state immunity through valid Fourteenth Amendment §5 enforcement legislation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Congress must clearly authorize suits against states.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The legislation must validly enforce the Amendment; later cases supply the congruence-and-proportionality inquiry when applicable.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; This congressional route is different from Young&amp;#x27;s prospective-officer exception and can permit monetary relief.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Eleventh Amendment did not bar the authorized backpay award. The Fourteenth Amendment limits state sovereignty and gives Congress power to enforce those limits.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Do not stop at &amp;#x27;money from the treasury.&amp;#x27; Ask whether Congress validly abrogated immunity under §5.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/427/445/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/427/445/">
          <mxGeometry x="2050" y="3270" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="topic-3" value="&lt;b&gt;CONGRESSIONAL POWERS&lt;/b&gt;&lt;br&gt;9 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d9;strokeColor=#fff0d9;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="3055" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-3-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;McCulloch v. Maryland (1819)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Congress chartered the Second Bank of the United States to assist federal fiscal operations. Maryland imposed a tax aimed at banks not chartered by the state. McCulloch, the federal bank&amp;#x27;s cashier in Baltimore, refused to pay. Maryland argued both that Congress lacked bank-chartering power and that the state could tax the bank.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; First identify a legitimate constitutional end, such as collecting taxes or borrowing.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Congress may choose useful means reasonably adapted to that end; &amp;#x27;necessary&amp;#x27; does not mean the only indispensable means.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The chosen means must also respect constitutional prohibitions and structure.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; A state cannot tax a federal instrumentality in a way that subjects federal operations to state control.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The bank was a valid implied means of exercising enumerated powers, and Maryland&amp;#x27;s tax on it was invalid.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Use two analyses: congressional authority to create the bank, then state interference with a valid federal institution.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/17/316/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/17/316/">
          <mxGeometry x="3055" y="475" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-3-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Wickard v. Filburn (1942)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Filburn, an Ohio farmer, grew more wheat than federal acreage quotas allowed. He intended some excess wheat for uses on his own farm rather than sale. He argued that wheat never sold across state lines fell outside federal commerce authority. The federal program sought to control national wheat supply and prices.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may regulate a class of local economic activity whose combined effect on interstate commerce is substantial.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Home production can replace purchases the producer would otherwise make.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; One farmer&amp;#x27;s small effect is assessed together with similar conduct by others.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Keeping a commodity for personal use does not automatically remove it from the economic class.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The wheat regulation applied to Filburn because widespread home production could frustrate the national supply-and-price program.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Identify the market substitution: growing your own wheat reduces demand for wheat bought elsewhere. Compare noneconomic conduct in Lopez and Morrison.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/317/111/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/317/111/">
          <mxGeometry x="3055" y="1420" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-3-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Heart of Atlanta Motel v. United States (1964)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A large Atlanta motel refused to rent rooms to Black guests. It advertised beyond Georgia and served many interstate travelers, who made up about three quarters of its clientele. The owner challenged Title II of the Civil Rights Act, arguing that Congress could not regulate its supposedly local lodging business.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may regulate interstate travel and local commercial practices that substantially burden it.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Discrimination in lodging can obstruct interstate movement by making travel more difficult.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A business&amp;#x27;s local physical location does not end the interstate-commerce inquiry.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Congress may address a moral wrong through commerce regulation when the required commercial connection exists.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The federal prohibition on racial discrimination was valid as applied to the motel.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Use concrete interstate links: travelers, advertising, highways, and the effect of discrimination on movement between states.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/379/241/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/379/241/">
          <mxGeometry x="3055" y="2325" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-3-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Katzenbach v. McClung (1964)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ollie&amp;#x27;s Barbecue in Birmingham served white customers inside but offered Black customers only takeout. Its clientele was largely local, yet a substantial portion of its food had moved through interstate commerce. The owners challenged Title II, contending that discrimination at this individual restaurant had no demonstrated interstate effect.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may regulate local restaurants as part of an economic class affecting interstate commerce.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Interstate food purchases provide a commercial connection.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Congress may consider the combined effects of restaurant discrimination on travel, purchasing, and economic participation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; It need not prove that this one restaurant independently changes the national economy.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court upheld federal regulation of the restaurant and rejected the insistence on a large restaurant-specific interstate effect.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare Heart of Atlanta: interstate customers were prominent there; interstate supplies and class-wide effects support McClung.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/379/294/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/379/294/">
          <mxGeometry x="3055" y="3270" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-3-4" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;United States v. Lopez (1995)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A high-school student carried a concealed handgun into a San Antonio school. Federal prosecutors charged him under the original Gun-Free School Zones Act. The statute did not require a case-specific connection to interstate commerce. The government defended it through the economic costs of crime, poorer education, and reduced national productivity.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may regulate: (1) interstate channels, (2) interstate instrumentalities and persons or things, and (3) activities substantially affecting interstate commerce.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; For the third category, ask whether the regulated activity is economic and how directly it connects to commerce.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Noneconomic gun possession plus a long chain of economic consequences was insufficient here.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The original school-zone possession law exceeded the commerce power. Accepting the government&amp;#x27;s chain would leave little meaningful limit on federal authority.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A jurisdictional element, findings, economic character, and degree of attenuation are relevant considerations, not four mechanically mandatory statutory ingredients.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/514/549/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/514/549/">
          <mxGeometry x="3055" y="4175" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="case-3-5" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;United States v. Morrison (2000)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A Virginia Tech student alleged that other students raped her. She sued under the Violence Against Women Act&amp;#x27;s federal civil remedy for gender-motivated violence. Congress had assembled extensive evidence about violence&amp;#x27;s effects on employment, spending, travel, and state justice systems. The defendants challenged Congress&amp;#x27;s constitutional authority.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Noneconomic violent conduct cannot be regulated under the substantial-effects theory solely by adding up its economic consequences.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Extensive findings do not erase the economic/noneconomic distinction and attenuation concerns.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Fourteenth Amendment §5 targets unconstitutional state action; this remedy directly imposed liability on private perpetrators rather than correcting identified state action.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The civil-remedy provision failed under both the Commerce Clause and §5. The decision did not invalidate every part of the Violence Against Women Act.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask what conduct the provision actually regulates. Economic consequences do not automatically turn private violence into economic activity.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/529/598/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/529/598/">
          <mxGeometry x="3055" y="5140" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-3-6" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Gonzales v. Raich (2005)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;California residents used doctor-recommended marijuana for serious medical conditions under state law. Federal agents destroyed one resident&amp;#x27;s homegrown plants. The residents sought an exemption from the federal Controlled Substances Act for locally grown marijuana used personally rather than sold, arguing that their conduct was outside interstate commerce.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may regulate local production within a broader economic class when it reasonably concludes that an exemption would undermine a comprehensive interstate-market scheme.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Marijuana is a fungible commodity; local supplies can affect demand or enter the wider market.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Courts assess the regulated class, not just these sympathetic individual users.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; State permission does not override valid federal law.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The federal scheme could reach their local medical cultivation and possession.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare Lopez and Morrison: Raich involved regulation of a commodity market through a comprehensive scheme, rather than an isolated prohibition on noneconomic conduct.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/545/1/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/545/1/">
          <mxGeometry x="3055" y="6085" width="960" height="960" as="geometry" />
        </mxCell>
        <mxCell id="case-3-7" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;NFIB v. Sebelius (2012)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The ACA required most individuals to maintain health insurance or make a payment. It also expanded Medicaid and threatened states declining expansion with loss of existing Medicaid funds. Challengers disputed the insurance provision and the funding condition, requiring separate analysis of commerce, necessary-and-proper, taxing, and spending powers.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Commerce: regulating existing activity did not justify forcing inactive people to buy insurance.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Necessary and Proper: Roberts considered forced market entry an improper expansion of federal power.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Tax: function matters more than the &amp;#x27;penalty&amp;#x27; label; the payment raised revenue, lacked a scienter requirement, and left a lawful choice to pay.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Spending: threatening existing Medicaid funds crossed from inducement into coercion.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The payment survived as a tax. Congress could offer expansion funds, but could not withdraw existing Medicaid funds merely because a state rejected expansion.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Analyze each power separately. The opinions were fractured; distinguish Roberts&amp;#x27;s reasoning from propositions adopted by a majority. Compare Dole&amp;#x27;s modest funding pressure.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/567/519/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/567/519/">
          <mxGeometry x="3055" y="7090" width="960" height="960" as="geometry" />
        </mxCell>
        <mxCell id="case-3-8" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;South Dakota v. Dole (1987)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Congress conditioned a small portion of federal highway funding on states setting a minimum drinking age of 21. South Dakota allowed some lower-alcohol beer purchases at 19 and objected to the condition. Congress connected a uniform drinking age to safer interstate travel by reducing incentives to cross borders to drink.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A spending condition should serve the general welfare.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Its terms must clearly tell states what accepting the money requires.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The condition must relate sufficiently to the federal program.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; It cannot require independently unconstitutional conduct.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;5.&lt;/b&gt; Financial pressure cannot become coercion that leaves no genuine choice.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The condition survived: the Court treated the threatened 5% loss as relatively mild encouragement and accepted the connection to highway safety.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Congress may sometimes encourage a state policy it could not directly command. Compare NFIB, where the threat reached existing program funds on a much larger scale.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/483/203/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/483/203/">
          <mxGeometry x="3055" y="8095" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="topic-4" value="&lt;b&gt;RECONSTRUCTION ENFORCEMENT&lt;/b&gt;&lt;br&gt;4 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6eafa;strokeColor=#e6eafa;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="4060" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-4-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Jones v. Alfred H. Mayer Co. (1968)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Joseph Lee Jones, a Black buyer, alleged that a private developer refused to sell him a home because of his race. He relied on 42 U.S.C. §1982, protecting equal property rights. Lower courts dismissed on the view that the statute reached state discrimination but not a private seller&amp;#x27;s refusal.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; The Thirteenth Amendment eliminates slavery and authorizes Congress to address its badges and incidents.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Congress may rationally identify practices that perpetuate those badges and incidents and legislate against them.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; That enforcement power can reach private conduct, without the state-action requirement governing Fourteenth Amendment claims.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Racial exclusion from equal property ownership falls within this authority.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Section 1982 reached private racial discrimination in property transactions, and the dismissal was reversed.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;First identify the Amendment. Do not import the Fourteenth Amendment&amp;#x27;s state-action restriction into Thirteenth Amendment enforcement.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/392/409/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/392/409/">
          <mxGeometry x="4060" y="475" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-4-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;City of Boerne v. Flores (1997)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A Catholic archbishop sought permission to enlarge a church in Boerne, Texas. Local officials denied the permit under a historic-preservation ordinance. He invoked RFRA, which imposed a demanding religious-exemption standard on government action. Congress had enacted RFRA in response to the Court&amp;#x27;s narrower constitutional free-exercise approach.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Fourteenth Amendment §5 lets Congress enforce constitutional rights, not change their meaning.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Prophylactic legislation can reach some conduct not itself unconstitutional, but needs congruence and proportionality.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Identify the constitutional wrong and supporting evidence.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Then ask whether the law&amp;#x27;s breadth, remedies, and reach reasonably fit that wrong.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;RFRA&amp;#x27;s sweeping application to states and localities exceeded §5 authority. The decision did not eliminate RFRA&amp;#x27;s operation against the federal government.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A statute can protect more conduct than the Constitution directly protects, but Congress must justify that extra protection as prevention or remedy.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/521/507/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/521/507/">
          <mxGeometry x="4060" y="1420" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-4-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Louisiana v. Callais (2026)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;After litigation over Louisiana&amp;#x27;s earlier congressional map, the state adopted SB8 with a second majority-Black district. Challengers argued that race improperly drove the new boundaries. Louisiana defended its use of race as necessary to satisfy Voting Rights Act §2. The Court examined the statute and Congress&amp;#x27;s Fifteenth Amendment enforcement power.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Race-based districting requires a sufficient constitutional justification.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Compliance with VRA §2, properly interpreted, can supply a compelling interest.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The Court construed §2 around equal electoral opportunity and circumstances strongly indicating intentional racial discrimination, rather than proportional racial representation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; It invoked congruence and proportionality to connect the statute to the Fifteenth Amendment&amp;#x27;s prohibition.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court concluded that §2 did not require Louisiana&amp;#x27;s additional majority-minority district, so the asserted justification failed and SB8 was an unconstitutional racial gerrymander.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Do not reduce Callais to &amp;#x27;Congress cannot protect voting rights.&amp;#x27; Separate the federal statute, its constitutional enforcement basis, and the state&amp;#x27;s use of race.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://www.supremecourt.gov/opinions/25pdf/24-109_new_jifl.pdf&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://www.supremecourt.gov/opinions/25pdf/24-109_new_jifl.pdf">
          <mxGeometry x="4060" y="2365" width="960" height="980" as="geometry" />
        </mxCell>
        <mxCell id="case-4-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Shelby County v. Holder (2013)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Voting Rights Act §5 required covered jurisdictions to obtain federal approval before changing voting rules. Section 4(b) selected jurisdictions through historical tests and turnout data from the 1960s and 1970s. Congress renewed the system in 2006 without replacing that old formula. Shelby County, Alabama, challenged the special coverage.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Geographic targeting is not absolutely forbidden.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Special burdens on selected states&amp;#x27; governing authority need justification grounded in current conditions.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The selection of places must sufficiently fit the problem Congress is targeting.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Exceptional conditions can justify different treatment; Congress may adopt a new coverage formula reflecting present needs.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;5.&lt;/b&gt; Past discrimination alone does not automatically justify keeping the same formula indefinitely.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court struck down §4(b)&amp;#x27;s outdated coverage formula, not §5&amp;#x27;s text or §2. The majority found the old criteria no longer justified the current state-by-state distinctions.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask two questions: What current evidence justifies special burdens? Why do the chosen geographic boundaries fit that evidence? Distinguish the coverage formula from the remedy.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://www.law.cornell.edu/supremecourt/text/12-96&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://www.law.cornell.edu/supremecourt/text/12-96">
          <mxGeometry x="4060" y="3390" width="960" height="980" as="geometry" />
        </mxCell>
        <mxCell id="topic-5" value="&lt;b&gt;FEDERALISM &amp;amp; EXECUTIVE POWER&lt;/b&gt;&lt;br&gt;7 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2eff1;strokeColor=#e2eff1;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="5065" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-5-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;New York v. United States (1992)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Congress addressed shortages of low-level radioactive-waste disposal sites through incentives for states. One provision required a state that failed to arrange disposal to take ownership of the waste and assume liability. New York challenged being forced either to regulate according to federal instructions or accept that ownership and liability.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress cannot order a state legislature to enact or administer a federal regulatory program.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; A choice between two unconstitutional commands is not a genuine constitutional alternative.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Congress may instead regulate private activity itself, use valid funding incentives, or offer a permissible choice between state regulation and federal preemption.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; State officials cannot waive the structural rule simply by agreeing politically.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The take-title provision failed. Other monetary and access incentives survived, and the Court did not invalidate the entire waste program.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Distinguish commanding the state as sovereign from directly regulating waste producers. A spending condition still requires its own Dole/NFIB analysis.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/505/144/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/505/144/">
          <mxGeometry x="5065" y="475" width="960" height="960" as="geometry" />
        </mxCell>
        <mxCell id="case-5-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Printz v. United States (1997)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Brady Act required local chief law-enforcement officers to perform handgun-purchaser background checks while a federal system was being developed. Sheriffs from Montana and Arizona challenged those temporary federal duties. The government emphasized their limited duration and administrative character rather than a demand that state legislatures pass new laws.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; The federal government generally cannot require state or local executive officers to administer federal regulation of private people.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The rule protects executive officials as well as legislatures.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Temporary or relatively small burdens do not create a balancing exception.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Congress may use federal personnel or seek voluntary state cooperation instead.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The compulsory local background-check duties were unconstitutional. The ruling concerned federal conscription of the officers, not a decision that all background-check regulation was invalid.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;New York concerns state legislatures; Printz concerns state/local executive personnel. Administrative convenience does not cure commandeering.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/521/898/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/521/898/">
          <mxGeometry x="5065" y="1480" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="case-5-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Murphy v. NCAA (2018)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A federal statute, PASPA, barred most states from authorizing sports gambling. New Jersey tried to repeal parts of its own betting prohibitions. Sports organizations sued, arguing that repeal unlawfully authorized gambling. The dispute tested whether Congress could require a state to retain its existing prohibition instead of ordering a new one.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress cannot dictate what laws a state legislature must enact or keep.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; A command not to repeal a prohibition is still control over state lawmaking.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Valid preemption must rest on federal constitutional authority and a federal rule governing private conduct or rights.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Calling a legislative command &amp;#x27;preemption&amp;#x27; does not make it valid.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The prohibition on state authorization violated anti-commandeering. The Court&amp;#x27;s severability analysis led it to invalidate the remaining PASPA provisions as well.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Congress may regulate betting directly within its powers; it may not simply order states to maintain their own bans.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/584/16-476/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/584/16-476/">
          <mxGeometry x="5065" y="2445" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-5-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Garcia v. San Antonio Metropolitan Transit Authority (1985)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;San Antonio&amp;#x27;s public transit authority claimed immunity from federal minimum-wage and overtime requirements because operating local transit was a traditional governmental function. An earlier case had protected some such functions. The dispute asked whether federal courts should sort state activities into protected traditional functions and unprotected activities.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; State ownership does not automatically exempt an employer from valid federal wage-and-hour regulation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The Court rejected an unworkable immunity test based on &amp;#x27;traditional governmental functions.&amp;#x27;&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Federal political structures help protect state interests.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Distinguish regulation of the state&amp;#x27;s own employment practices from an order to regulate its residents.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The federal wage-and-hour requirements could apply to the transit authority, and the earlier traditional-functions immunity approach was overruled.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Do not treat every federal obligation imposed on a state as commandeering. Ask whether the state is acting as employer or as a compelled regulator.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/469/528/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/469/528/">
          <mxGeometry x="5065" y="3390" width="960" height="940" as="geometry" />
        </mxCell>
        <mxCell id="case-5-4" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Reno v. Condon (2000)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;States collected personal information through driver&amp;#x27;s-license systems and sold it to insurers, marketers, and other businesses. The federal Driver&amp;#x27;s Privacy Protection Act restricted disclosure and resale. South Carolina challenged the law, arguing that Congress was forcing state agencies to implement a federal program and intruding on state sovereignty.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Congress may regulate a state&amp;#x27;s own commercial or data-handling activity within a valid federal power.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The personal information here moved through interstate business and could be regulated as commerce.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The law restricted states as database owners; it did not require them to regulate their citizens or enforce federal rules against private people.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Administrative compliance costs alone do not turn direct regulation into commandeering.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The disclosure restrictions survived the federalism challenge.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare Printz: officers there had to administer a federal program for private gun buyers. Here the state had to control its own handling of information.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/528/141/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/528/141/">
          <mxGeometry x="5065" y="4375" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-5-5" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Youngstown Sheet &amp;amp; Tube Co. v. Sawyer (1952)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;During the Korean War, President Truman feared that a nationwide steel strike would interrupt military supplies. He directed the Secretary of Commerce to seize and operate steel mills without a statute authorizing that step. Congress had supplied other labor-dispute procedures and had declined to give this general seizure authority.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Presidential action needs constitutional or statutory authority; urgency alone is insufficient.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Jackson&amp;#x27;s concurrence supplies three categories: authorized by Congress means maximum authority; congressional silence creates a zone of uncertainty; conflict with Congress puts power at its lowest ebb.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; In the last category, the President needs an exclusive constitutional power that Congress cannot limit.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The seizure failed. Domestic control of steel production was not authorized merely by invoking Commander in Chief or faithful execution.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Identify Congress&amp;#x27;s position before choosing a category. Jackson&amp;#x27;s influential framework is a concurrence, while the Court&amp;#x27;s judgment rejected this seizure.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/343/579/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/343/579/">
          <mxGeometry x="5065" y="5320" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-5-6" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Zivotofsky v. Kerry (2015)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;This was the later merits stage of the Jerusalem passport dispute. Congress required the State Department, on request, to record Israel as the birthplace of a Jerusalem-born U.S. citizen. The President&amp;#x27;s recognition policy did not recognize Israeli sovereignty over Jerusalem, and the Department declined to follow the statute.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Formal recognition of foreign sovereigns and their territorial claims is an exclusive presidential power.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Congress cannot require the Executive to contradict a recognition determination within that exclusive sphere.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Even when the President acts against Congress at Youngstown&amp;#x27;s lowest ebb, an exclusive constitutional power can prevail.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; This does not create exclusive presidential power over all foreign affairs.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The passport provision was unconstitutional because it forced an official statement inconsistent with the President&amp;#x27;s recognition decision.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;2012 Clinton: the courts can decide. 2015 Kerry: on the merits, this particular exclusive presidential power defeats the conflicting statute.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/576/1/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/576/1/">
          <mxGeometry x="5065" y="6265" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="topic-6" value="&lt;b&gt;SUPREMACY &amp;amp; PREEMPTION&lt;/b&gt;&lt;br&gt;2 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7e8e1;strokeColor=#f7e8e1;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="6070" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-6-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Dawson v. Steager (2019)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;James Dawson retired from the U.S. Marshals Service and lived in West Virginia. The state exempted pensions of specified state law-enforcement retirees from income tax but taxed his federal pension. A trial court found no significant difference between his job duties and those of the favored state officers.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Federal consent to state taxation of employee compensation under 4 U.S.C. §111 is conditioned on nondiscrimination based on its federal source.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Compare the federal retiree with the state retirees receiving the benefit.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Relevant job differences can matter; federal employment alone cannot justify worse treatment.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Unwritten alternative policy explanations do not cure the discriminatory distinction the statute actually draws.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;West Virginia&amp;#x27;s tax treatment violated §111; the state judgment was reversed.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare similarly situated workers, not the federal retiree with every state employee. Modern immunity permits neutral taxation rather than barring all state taxes on federal pay.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/586/17-419/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/586/17-419/">
          <mxGeometry x="6070" y="475" width="960" height="960" as="geometry" />
        </mxCell>
        <mxCell id="case-6-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Pacific Gas &amp;amp; Electric Co. v. State Energy Resources Conservation &amp;amp; Development Commission (1983)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;California halted certification of new nuclear plants until an approved permanent radioactive-waste disposal method existed. Utilities argued that federal nuclear regulation displaced this requirement. California defended the moratorium as an economic measure addressing costs and uncertainty from unresolved waste disposal, rather than an attempt to set radiation-safety standards.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Start with the field Congress actually occupied: nuclear safety, not every aspect of electricity generation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; State economic regulation remained within a preserved sphere.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Impossibility conflict was absent because federal licensing permitted construction but did not require it.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Obstacle conflict was absent because Congress&amp;#x27;s encouragement of nuclear power did not override all state economic choices.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The permanent-disposal moratorium survived preemption review on its accepted economic rationale. A separate challenge about interim-storage findings was not ripe.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Work through field and conflict preemption separately. A federal permission is not always a federal command or an unconditional right to proceed.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/461/190/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/461/190/">
          <mxGeometry x="6070" y="1480" width="960" height="960" as="geometry" />
        </mxCell>
        <mxCell id="topic-7" value="&lt;b&gt;DORMANT COMMERCE CLAUSE&lt;/b&gt;&lt;br&gt;12 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6eef0;strokeColor=#e6eef0;fontColor=#10283f;fontSize=24;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="7075" y="310" width="960" height="125" as="geometry" />
        </mxCell>
        <mxCell id="case-7-0" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;City of Philadelphia v. New Jersey (1978)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;New Jersey prohibited most waste originating or collected outside the state from entering its landfills, while continuing to accept local waste. Philadelphia and landfill interests challenged the restriction. New Jersey invoked landfill conservation and environmental protection, even though imported and local waste presented the same relevant disposal problems.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Waste disposal is interstate commerce even when the material itself has little or negative value.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; A law discriminating by geographic origin is ordinarily invalid.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A legitimate environmental goal does not excuse discriminatory means when adequate nondiscriminatory alternatives exist.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; A state generally cannot conserve shared disposal capacity by placing the whole burden on outsiders.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The imported-waste ban failed because origin, rather than a distinct harmful quality, determined which waste was excluded.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare a true quarantine based on a distinctive danger. Ask why identical local and imported materials receive different treatment.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/437/617/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/437/617/">
          <mxGeometry x="7075" y="475" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-7-1" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Hughes v. Oklahoma (1979)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Oklahoma prohibited exporting wild minnows taken from its waters for sale elsewhere. A Texas minnow dealer bought minnows from an Oklahoma dealer and was convicted for transporting them to Texas. Oklahoma defended the law as conservation and invoked the traditional idea that states own wildlife on behalf of their residents.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Wildlife is not categorically outside interstate commerce because of state &amp;#x27;ownership.&amp;#x27;&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Determine whether the law treats interstate trade worse on its face or in practical operation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; If discriminatory, the state must justify a legitimate local purpose and the lack of adequate nondiscriminatory alternatives.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Evenhanded catch or conservation limits must be considered instead of a border barrier.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The export ban failed. It chose discriminatory exclusion rather than an appropriately evenhanded conservation approach.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A state cannot reserve a natural resource for residents merely by declaring ownership of it. Distinguish conservation of the resource from protection of local buyers.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/441/322/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/441/322/">
          <mxGeometry x="7075" y="1380" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="case-7-2" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Dean Milk Co. v. Madison (1951)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Madison allowed pasteurized milk sales only if the milk had been processed and bottled at an approved plant within five miles of the city center. An Illinois distributor with more distant plants could not sell there despite satisfying relevant health standards. The city defended the radius as making inspection and health protection easier.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A locality cannot use health regulation to exclude interstate competitors when reasonable nondiscriminatory alternatives protect health adequately.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Consider inspection of distant plants at the distributor&amp;#x27;s expense or reliance on appropriate equivalent standards.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Discrimination does not disappear merely because some businesses elsewhere in the same state are excluded too.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The five-mile processing restriction violated the dormant Commerce Clause.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;A local-radius rule can discriminate against interstate commerce even though it also burdens businesses in the same state. Examine practical access to the market.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/340/349/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/340/349/">
          <mxGeometry x="7075" y="2345" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-7-3" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Maine v. Taylor (1986)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Maine banned importing live baitfish. A bait dealer imported fish anyway and was prosecuted under a federal law incorporating the state restriction. Maine presented evidence that imported fish could introduce parasites and nonnative species, and that inspection methods could not reliably identify the risks in shipments of small live fish.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A discriminatory law faces a demanding justification.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The state must establish a legitimate local objective unrelated to economic protectionism.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; It must also show that available nondiscriminatory alternatives cannot serve that objective adequately.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Supported factual findings about ecological risks and the inadequacy of inspection can satisfy that burden.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The import ban survived because protecting the ecosystem was legitimate and workable nondiscriminatory safeguards were unavailable on the record.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;This is the rare successful justification. Compare Philadelphia: Maine identified distinctive imported-fish risks rather than excluding materially identical goods solely because of origin.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/477/131/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/477/131/">
          <mxGeometry x="7075" y="3250" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-7-4" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Bacchus Imports, Ltd. v. Dias (1984)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Hawaii imposed a liquor excise tax but exempted selected beverages, including locally produced fruit wine and okolehao, to encourage local industries. Wholesalers challenged the advantage given to those products. Hawaii argued that the favored beverages were a small part of the market and that alcohol regulation enjoyed special constitutional protection.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; A tax exemption can discriminate just as a tax surcharge can.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Favoring local products through protectionist purpose and competitive effect violates the dormant Commerce Clause.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; A small favored industry does not make the discrimination harmless or noncommercial.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; The Twenty-first Amendment does not generally authorize protectionism for local liquor producers.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The selective exemptions were invalid. The Court did not decide every refund issue, which required further consideration.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Examine both purpose and competitive effect. Do not assume that taxation or alcohol regulation escapes ordinary antidiscrimination scrutiny.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/468/263/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/468/263/">
          <mxGeometry x="7075" y="4195" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-7-5" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;United Haulers Ass’n v. Oneida-Herkimer Solid Waste Management Authority (2007)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Two New York counties required private trash haulers to deliver waste to facilities run by a public waste-management authority. Haulers wanted cheaper alternatives. Unlike a rule favoring a private local processor, these ordinances treated every private competitor, whether local or out-of-state, equally and favored a public provider performing a traditional government function.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Favoring a public provider in this setting is different from protecting a local private competitor.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Public ownership, a traditional public function, and equal treatment of private firms supported a finding of no interstate discrimination.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Nondiscriminatory regulations still face the applicable undue-burden analysis.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Public ownership alone is not blanket immunity from every constitutional restriction.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The ordinances survived. The justices differed on portions of the burden analysis, so distinguish the majority&amp;#x27;s discrimination conclusion from the plurality&amp;#x27;s balancing discussion.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask who benefits and whether private competitors are treated equally. A public waste authority is not automatically equivalent to a favored private business.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/550/330/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/550/330/">
          <mxGeometry x="7075" y="5100" width="960" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="case-7-6" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Pike v. Bruce Church, Inc. (1970)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;An Arizona cantaloupe grower transported its crop to a nearby California facility for sorting and packing. An Arizona official required packing in a way that effectively forced the grower to build an unnecessary Arizona facility costing about $200,000. The asserted state interest was preserving the reputation of Arizona produce through origin identification.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; For an evenhanded law with incidental interstate effects, identify the legitimate local interest and the interstate burden.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; A burden clearly excessive relative to putative local benefits makes the law invalid.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Consider the nature of the interest and whether it can be served with less disruption to interstate activity.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Discriminatory laws require a different, more demanding analysis.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The packing requirement failed because the substantial forced investment outweighed the modest interest in identifying the crop&amp;#x27;s origin.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Do not apply ordinary Pike balancing before asking whether the law discriminates. Explain concrete burdens rather than merely stating that compliance costs money.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/397/137/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/397/137/">
          <mxGeometry x="7075" y="6165" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-7-7" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Kassel v. Consolidated Freightways Corp. (1981)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Iowa generally prohibited 65-foot double-trailer trucks even though surrounding states allowed them. Interstate carriers had to use shorter units, separate trailers for passage, or reroute around Iowa. The state invoked safety, but the trial record showed little safety advantage and exceptions favored certain local movements.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Highway-safety laws receive respect, but a safety label does not end constitutional review.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Examine evidence of the actual safety benefit alongside interstate transportation burdens.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Local exceptions can undermine the asserted rationale or reveal an effort to shift traffic elsewhere.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; The Powell plurality used burden-benefit analysis; concurring justices emphasized different grounds.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The Court affirmed invalidation of the truck restrictions, with no single majority rationale covering all the reasoning.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare genuine, evidenced safety regulation with a costly interstate obstacle supported by weak safety claims. Identify the plurality rather than overstating one unified test.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/450/662/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/450/662/">
          <mxGeometry x="7075" y="7110" width="960" height="920" as="geometry" />
        </mxCell>
        <mxCell id="case-7-8" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;National Pork Producers Council v. Ross (2023)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;California&amp;#x27;s Proposition 12 restricted in-state pork sales based on how breeding pigs were confined. California imports most of its pork, so producers argued that compliance would force expensive changes on farms in other states. They did not claim protectionist discrimination; they relied on out-of-state effects and undue burdens.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Out-of-state economic effects do not automatically make an in-state sales rule unconstitutional.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The Court rejected the proposed almost-per-se extraterritoriality theory.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The Pike claim also failed, but the justices divided over the analysis of burdens and benefits.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; The decision did not abolish Pike or grant states unlimited power over unrelated transactions outside their territory.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Dismissal of the producers&amp;#x27; pleaded challenge was affirmed.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;First distinguish discrimination from incidental effects. Explain the burden on interstate commerce itself; do not treat every producer expense as enough to invalidate a law.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://www.law.cornell.edu/supremecourt/text/21-468&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://www.law.cornell.edu/supremecourt/text/21-468">
          <mxGeometry x="7075" y="8075" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="case-7-9" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Reeves, Inc. v. Stake (1980)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;South Dakota had long sold cement from its state-owned plant to buyers inside and outside the state. During a shortage it gave resident buyers priority. Reeves, an out-of-state concrete business dependent on the plant, lost supplies and challenged the preference as discriminatory interference with interstate commerce.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Distinguish a state participating in a market from a state regulating private trade.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; As a seller of its own manufactured product, a state may generally favor residents under the dormant Commerce Clause.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; The exception concerns the market in which it participates; it does not create unrestricted regulatory authority over other markets.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Other constitutional constraints remain separate questions.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The resident preference in sales from the state-owned cement plant survived.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Ask what the state is buying or selling. Compare South-Central Timber when the contract tries to control what happens after the sale.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/447/429/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/447/429/">
          <mxGeometry x="7075" y="9020" width="960" height="860" as="geometry" />
        </mxCell>
        <mxCell id="case-7-10" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;South-Central Timber Development, Inc. v. Wunnicke (1984)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Alaska offered timber from state lands on condition that purchasers perform primary processing in Alaska before shipping it away. A timber buyer that normally exported unprocessed logs challenged the condition. Alaska relied on its role as seller and argued that similar federal timber policies implied congressional approval.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Market participation does not automatically protect downstream regulation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; The plurality distinguished Alaska&amp;#x27;s timber-sales market from the later processing market that its condition controlled.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; An unmistakably clear congressional authorization can remove a dormant Commerce Clause obstacle.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; A federal policy that merely resembles the state&amp;#x27;s rule does not establish that authorization.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The judgment upholding the condition was reversed. The Court rejected implied congressional authorization; the plurality also rejected extending the seller exception to downstream processing.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Separate what the state owns and sells from the later conduct it demands. Distinguish a contract term from a constitutionally protected market-participant choice.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/467/82/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/467/82/">
          <mxGeometry x="7075" y="9925" width="960" height="960" as="geometry" />
        </mxCell>
        <mxCell id="case-7-11" value="&lt;div style=&quot;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:25px;font-weight:bold;margin-bottom:22px;&quot;&gt;Prudential Insurance Co. v. Benjamin (1946)&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-bottom:8px;&quot;&gt;WHAT HAPPENED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;South Carolina imposed a tax on premiums earned by insurance companies from outside the state, without the same tax on local insurers. Prudential challenged the unequal treatment under the Commerce Clause. Congress had enacted the McCarran-Ferguson Act, affirmatively supporting state regulation and taxation of the insurance business.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;RULE · IN PLAIN ENGLISH&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; The dormant Commerce Clause is an implied restriction operating when Congress has not authorized the challenged state action.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;2.&lt;/b&gt; Congress&amp;#x27;s affirmative commerce power can permit state treatment that the dormant limitation would otherwise forbid.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;3.&lt;/b&gt; Identify authorization covering the challenged regulation or tax; ordinary congressional silence is different.&lt;/div&gt;&lt;div style=&quot;margin-bottom:10px;&quot;&gt;&lt;b&gt;4.&lt;/b&gt; Authorization removes this commerce objection, not every independent constitutional limit.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;WHAT THE COURT DECIDED&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;The state insurance tax survived the Commerce Clause challenge because Congress had authorized the relevant state taxation.&lt;/div&gt;&lt;div style=&quot;color:#466989;font-weight:bold;margin-top:16px;margin-bottom:8px;&quot;&gt;ON AN EXAM&lt;/div&gt;&lt;div style=&quot;margin-bottom:14px;&quot;&gt;Compare South-Central Timber: sufficiently clear authorization was present here; a merely similar federal policy was not enough there.&lt;/div&gt;&lt;div style=&quot;font-size:16px;margin-top:18px;&quot;&gt;&lt;a href=&quot;https://supreme.justia.com/cases/federal/us/328/408/&quot; target=&quot;_blank&quot;&gt;Read the opinion&lt;/a&gt; · Case source&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2d1df;fontColor=#10283f;fontSize=20;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1" link="https://supreme.justia.com/cases/federal/us/328/408/">
          <mxGeometry x="7075" y="10930" width="960" height="900" as="geometry" />
        </mxCell>
        <mxCell id="scope-note" value="&lt;b&gt;STUDY NOTE&lt;/b&gt;&lt;br&gt;These summaries explain the cited decisions and preserve distinctions among majority opinions, concurrences, and pluralities. For a problem, identify the actor, constitutional power, challenged conduct, and requested remedy before choosing a case analogy. Original course notes remain on your other five tabs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=22;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=26;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="11905" width="7995" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Can the Executive Act?" id="Executive-Power-Flowchart">
    <mxGraphModel dx="2400" dy="3556" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="3556" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" parent="1" vertex="1" value="Can the President / executive branch do ______?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17334D;fontSize=39;fontStyle=1;">
          <mxGeometry x="60" y="28" width="2280" height="54" as="geometry" />
        </mxCell>
        <mxCell id="subheading" parent="1" vertex="1" value="CHART 2  |  Follow the source-of-power spine, then every fact-triggered lane.  |  Joondeph, 2026 ed., Chapters 13-15" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#17334D;fontSize=21;fontStyle=1;">
          <mxGeometry x="60" y="88" width="2280" height="35" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;START: Pin down the act, actor, and challenged legal rule.&lt;/b&gt;&lt;br/&gt;Executive order, prosecution, agency rule, hiring/firing, withholding funds, pardon, or refusal to disclose? Separate &lt;b&gt;authority to act&lt;/b&gt;, &lt;b&gt;limits on the act&lt;/b&gt;, and &lt;b&gt;immunity / available relief&lt;/b&gt;. An executive order supplies no independent power.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DAE8FC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60" y="145" width="2280" height="92" as="geometry" />
        </mxCell>
        <mxCell id="posture" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;1. What has Congress authorized or forbidden?  [Youngstown / Justice Jackson]&lt;/b&gt;&lt;br/&gt;Read the actual statute, appropriation, and limits first. Explain competing constructions; do not infer authorization just from a broad policy goal. Classify the particular act, not the whole presidency.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF2CC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60" y="279" width="2280" height="92" as="geometry" />
        </mxCell>
        <mxCell id="cat0" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;CATEGORY 1: Congress authorizes&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Express or implied authorization → maximum authority.&lt;/b&gt;&lt;br/&gt;Still ask: Could Congress validly confer this power? Use your Congress chart. Then check rights and the structural rules below.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DDF1EB;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="439" width="733.3333333333334" height="147" as="geometry" />
        </mxCell>
        <mxCell id="cat1" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;CATEGORY 2: Congress is silent&lt;/b&gt;&lt;br/&gt;&lt;b&gt;No grant or prohibition → zone of twilight.&lt;/b&gt;&lt;br/&gt;Identify independent Article II authority. Weigh historical practice, acquiescence, and institutional responsibilities. Silence alone is not permission.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF2CC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="833.3333333333334" y="439" width="733.3333333333334" height="175" as="geometry" />
        </mxCell>
        <mxCell id="cat2" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;CATEGORY 3: Congress opposes&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Contrary to express or implied congressional will → lowest ebb.&lt;/b&gt;&lt;br/&gt;The President must establish an exclusive constitutional power that disables Congress from regulating this matter. Category 3 is not automatic defeat.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FBE4E2;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1606.6666666666667" y="439" width="733.3333333333334" height="175" as="geometry" />
        </mxCell>
        <mxCell id="router" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;2. Which additional issues do the facts trigger? Run every matching lane.&lt;/b&gt;&lt;br/&gt;A. Execution / inherent powers  |  B. Appointment / removal  |  C. Agency authority / lawmaking  |  D. Lawsuits / subpoenas / privilege&lt;br/&gt;A valid appointment does not validate the policy. Immunity from damages does not establish that the policy was lawful.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DDF1EB;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60" y="689" width="2280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l0" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A. EXECUTION &amp;amp; ARTICLE II&lt;/b&gt;&lt;br/&gt;Use for orders, enforcement decisions, funding, war, recognition, or pardons.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DAE8FC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="879" width="541.5" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l0n0" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A1. Execute law or create / change law?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Execution:&lt;/b&gt; implement the valid statute within its terms.&lt;br/&gt;&lt;b&gt;New rule contrary to statute:&lt;/b&gt; identify an exclusive Article II basis; otherwise executive power does not include lawmaking. Emergency or necessity alone does not cure the defect.&lt;br/&gt;&lt;i&gt;Youngstown: domestic steel-mill seizure failed.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="1041" width="541.5" height="258" as="geometry" />
        </mxCell>
        <mxCell id="l0n1" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A2. Nonenforcement or impoundment?&lt;/b&gt;&lt;br/&gt;Separate genuine enforcement prioritization under limited resources from suspending or rewriting a legal duty. Ask how much discretion the statute leaves.&lt;br/&gt;&lt;b&gt;Mandatory spending withheld for policy disagreement?&lt;/b&gt; Take Care / separation-of-powers problem.&lt;br/&gt;&lt;b&gt;Unconstitutional statute asserted?&lt;/b&gt; Test the constitutional objection; sincere belief alone is insufficient.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="1341" width="541.5" height="314" as="geometry" />
        </mxCell>
        <mxCell id="l0n2" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A3. War / national security?&lt;/b&gt;&lt;br/&gt;President commands armed forces; Congress declares war, raises and funds forces, and makes military rules. Identify the actual function and congressional posture.&lt;br/&gt;Domestic seizure is not military command merely because it helps a war. Apply any assigned war-powers statutes and rights constraints.&lt;br/&gt;&lt;b&gt;Book p. 232 sends further rules to the missing summer supplement.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF2CC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="1697" width="541.5" height="314" as="geometry" />
        </mxCell>
        <mxCell id="l0n3" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A4. Formal recognition?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Recognition of a foreign sovereign / territorial sovereignty?&lt;/b&gt; The President has exclusive recognition authority; Congress cannot compel an official contradiction.&lt;br/&gt;&lt;b&gt;Other foreign policy?&lt;/b&gt; Do not assume exclusivity. Congress retains substantial commerce, funding, and military powers.&lt;br/&gt;&lt;i&gt;Zivotofsky v. Kerry.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="2053" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l0n4" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A5. Pardon?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Past federal criminal offense?&lt;/b&gt; Pardon may precede charges or conviction; Congress cannot control whom the President pardons.&lt;br/&gt;&lt;b&gt;State offense, future crime, civil liability, or impeachment?&lt;/b&gt; Outside the pardon power.&lt;br/&gt;A family relationship alone does not give Congress authority to forbid the pardon. Self-pardons remain a separate unsettled issue.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="2381" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l0n5" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;A6. Result in this lane&lt;/b&gt;&lt;br/&gt;Identify the precise source and its scope. If no statutory authority and no sufficient Article II power → action unauthorized.&lt;br/&gt;If authority exists → continue through all other triggered lanes and the rights / court checks below.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DDF1EB;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60.0" y="2709" width="541.5" height="203" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B. APPOINTMENT &amp;amp; REMOVAL&lt;/b&gt;&lt;br/&gt;Hiring and firing are separate questions. Identify the official’s actual duties.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DAE8FC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="879" width="541.5" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l1n0" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B1. Officer or employee?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Continuing position established by law + significant federal authority?&lt;/b&gt; → officer; use Appointments Clause.&lt;br/&gt;&lt;b&gt;No?&lt;/b&gt; → employee; ordinary statutory employment rules apply.&lt;br/&gt;Discretion in hearings may be significant even without final decisionmaking. Pure research / reports assisting Congress can be legislative staff work.&lt;br/&gt;&lt;i&gt;Lucia; Buckley.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="1041" width="541.5" height="314" as="geometry" />
        </mxCell>
        <mxCell id="l1n1" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B2. Principal or inferior officer?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Supervised and directed by a superior other than the President?&lt;/b&gt; Examine power to review / block decisions, remove, and direct work.&lt;br/&gt;&lt;b&gt;Final executive decisions unreviewable by such a superior?&lt;/b&gt; Strong principal-officer indication.&lt;br/&gt;Courts’ judicial review does not substitute for executive supervision.&lt;br/&gt;&lt;i&gt;Braidwood; Arthrex.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="1397" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l1n2" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B3. Was the appointer proper?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Principal:&lt;/b&gt; presidential nomination + Senate confirmation.&lt;br/&gt;&lt;b&gt;Inferior:&lt;/b&gt; same default, or Congress may vest appointment in President alone, courts of law, or heads of departments.&lt;br/&gt;A bureau chief reporting to a secretary is not the department head. A subordinate’s selection may work with department-head approval and legal authorization.&lt;br/&gt;Congress / its leaders cannot appoint executive officers.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="1725" width="541.5" height="369" as="geometry" />
        </mxCell>
        <mxCell id="l1n3" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B4. Removal: who controls whom?&lt;/b&gt;&lt;br/&gt;First identify officer versus employee, executive versus legislative functions, statutory protection, who may remove, and every layer of supervision.&lt;br/&gt;Congress cannot retain removal control over an officer executing federal law, except impeachment. Legislative research staff present a different question.&lt;br/&gt;Indirect control through an at-will superior can matter.&lt;br/&gt;&lt;i&gt;Bowsher; Free Enterprise Fund.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="2136" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l1n4" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B5. 2026 removal update&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Trump v. Slaughter (June 29, 2026):&lt;/b&gt; FTC commissioners’ for-cause protection fails; Humphrey’s Executor no longer supplies the former independent-commission exception. A multi-member board alone does not save the restriction.&lt;br/&gt;The decision leaves some historically distinct offices / non-Article III courts unresolved. Do not mechanically extend its result to every employee or inferior-officer scheme.&lt;br/&gt;&lt;b&gt;Check your assigned summer supplement.&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFF2CC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="2464" width="541.5" height="341" as="geometry" />
        </mxCell>
        <mxCell id="l1n5" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;B6. Inferior officers / employees?&lt;/b&gt;&lt;br/&gt;For an inferior officer’s protection, analyze duties, scope, supervision, and interference with presidential execution; distinguish &lt;i&gt;Morrison v. Olson&lt;/i&gt;. Multiple layers of good-cause insulation raise &lt;i&gt;Free Enterprise Fund&lt;/i&gt; problems.&lt;br/&gt;Ordinary employees are not automatically subject to every officer rule. State the applicable statutory protection and the argument about presidential control; avoid a blanket answer.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="639.5" y="2847" width="541.5" height="314" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C. AGENCIES &amp;amp; LAWMAKING&lt;/b&gt;&lt;br/&gt;Use for a rule, delegated discretion, congressional veto, or canceled spending.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DAE8FC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="879" width="541.5" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l2n0" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C1. Does the statute authorize THIS action?&lt;/b&gt;&lt;br/&gt;Interpret text, context, conditions, and the actor to whom Congress granted power. Acting for a worthy statutory objective is insufficient if the particular means exceed the grant.&lt;br/&gt;&lt;b&gt;No authorization?&lt;/b&gt; Statutory defect; then test any independent Article II claim.&lt;br/&gt;&lt;b&gt;Yes?&lt;/b&gt; Check C2-C5 and rights.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="1041" width="541.5" height="258" as="geometry" />
        </mxCell>
        <mxCell id="l2n1" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C2. Major question?&lt;/b&gt;&lt;br/&gt;Is the executive asserting an extraordinary power of great economic / political significance through a vague or ancillary provision?&lt;br/&gt;&lt;b&gt;Yes → demand clear congressional authorization.&lt;/b&gt;&lt;br/&gt;This concerns the statute’s scope; distinguish C3’s constitutional limit on delegation.&lt;br/&gt;&lt;i&gt;Book Chapter 15: Learning Resources; related major-questions cases.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="1341" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l2n2" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C3. Excessive delegation?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Did Congress supply an intelligible principle?&lt;/b&gt; Identify its policy, boundaries, and standards in the statute.&lt;br/&gt;Broad discretion generally survives under &lt;i&gt;Whitman&lt;/i&gt;. The breadth of the delegated task affects how much guidance is needed.&lt;br/&gt;An agency cannot cure a standardless statute merely by promising self-restraint.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="1669" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l2n3" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C4. Congress reverses an executive decision?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Binding change to outside legal rights / duties?&lt;/b&gt; Congress ordinarily must use bicameral passage + presentment (or a proper veto override).&lt;br/&gt;One-house, committee, or two-house veto without presentment fails; a two-thirds vote alone is no cure.&lt;br/&gt;A report-and-wait requirement can survive if Congress must enact a new law to block the decision.&lt;br/&gt;&lt;i&gt;INS v. Chadha.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="1997" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l2n4" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C5. Line-item veto or lawful discretion?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Cancel part of an enacted law?&lt;/b&gt; President cannot amend / repeal it after signing, even under a statutory cancellation scheme.&lt;br/&gt;&lt;b&gt;Veto a separate whole bill?&lt;/b&gt; Ordinary Article I veto process.&lt;br/&gt;&lt;b&gt;Implement actual discretion Congress left?&lt;/b&gt; Distinguish from cancellation; read the grant.&lt;br/&gt;&lt;i&gt;Clinton v. New York.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="2325" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l2n5" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;C6. Signing statement / constitutional objection?&lt;/b&gt;&lt;br/&gt;A statement cannot alter enacted text. Distinguish policy disagreement from a real claim that a provision invades exclusive presidential authority.&lt;br/&gt;Test the objection using Youngstown and the substantive rule; signing a bill does not validate every provision, and a claimed objection does not itself excuse noncompliance.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1219.0" y="2653" width="541.5" height="258" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D. IMMUNITY &amp;amp; PRIVILEGE&lt;/b&gt;&lt;br/&gt;Use only when the facts ask about liability, prosecution, disclosure, or relief.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DAE8FC;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="879" width="541.5" height="120" as="geometry" />
        </mxCell>
        <mxCell id="l3n0" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D1. What claim / remedy is requested?&lt;/b&gt;&lt;br/&gt;Separate &lt;b&gt;civil damages&lt;/b&gt;, &lt;b&gt;criminal prosecution&lt;/b&gt;, &lt;b&gt;declaration / injunction&lt;/b&gt;, and &lt;b&gt;subpoena&lt;/b&gt;. Presidential rules do not automatically protect every executive official.&lt;br/&gt;First ask whether the challenged conduct is official or private; alleged illegality alone does not make it private.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="1041" width="541.5" height="258" as="geometry" />
        </mxCell>
        <mxCell id="l3n1" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D2. Civil damages against President?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Within outer perimeter of official duties?&lt;/b&gt; Absolute damages immunity, even if the alleged act was wrongful.&lt;br/&gt;&lt;b&gt;Unofficial conduct?&lt;/b&gt; No comparable presidential immunity; private / pre-office suit can proceed subject to case-management concerns.&lt;br/&gt;&lt;i&gt;Nixon v. Fitzgerald; Clinton v. Jones.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="1341" width="541.5" height="258" as="geometry" />
        </mxCell>
        <mxCell id="l3n2" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D3. Criminal prosecution?&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Sitting President:&lt;/b&gt; DOJ’s position bars prosecution while in office; distinguish this executive-branch view from a definitive Supreme Court holding.&lt;br/&gt;&lt;b&gt;Former President:&lt;/b&gt; core exclusive powers → absolute immunity; other official acts → at least presumptive immunity; unofficial acts → none.&lt;br/&gt;No motive inquiry to classify conduct; immune official-act evidence cannot be used to evade immunity.&lt;br/&gt;&lt;i&gt;Trump v. United States.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="1641" width="541.5" height="341" as="geometry" />
        </mxCell>
        <mxCell id="l3n3" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D4. Prospective relief / judicial order?&lt;/b&gt;&lt;br/&gt;Damages immunity does not preclude review of legality. A declaration may be available; relief often runs against an implementing subordinate.&lt;br/&gt;Direct injunctions against the President raise distinct unresolved limits.&lt;br/&gt;A binding unstayed order must be obeyed; disagreement is addressed through review / a stay. Disobedience can support contempt.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="2024" width="541.5" height="286" as="geometry" />
        </mxCell>
        <mxCell id="l3n4" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D5. Executive privilege / subpoena?&lt;/b&gt;&lt;br/&gt;Qualified confidentiality protection, not blanket immunity from process. Balance the specific need for evidence against confidentiality and separation of powers.&lt;br/&gt;Ask: President / close advisers? military or diplomatic secrets? alternative sources? scope? criminal, civil, legislative, or impeachment purpose?&lt;br/&gt;General confidentiality yielded to demonstrated criminal-trial need in &lt;i&gt;U.S. v. Nixon&lt;/i&gt;. Do not mechanically apply that result to every congressional demand.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#FFFFFF;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="2352" width="541.5" height="369" as="geometry" />
        </mxCell>
        <mxCell id="l3n5" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;D6. Keep conclusions separate&lt;/b&gt;&lt;br/&gt;A policy may be unlawful even when damages or prosecution are unavailable. A privilege may protect a communication without validating the underlying act.&lt;br/&gt;State who can obtain which remedy, against whom, and for what conduct.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DDF1EB;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="1798.5" y="2763" width="541.5" height="203" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="&lt;div style=&quot;text-align:left;font-family:Helvetica;font-size:21px;line-height:1.32&quot;&gt;&lt;b&gt;3. Final sweep: rights, federalism, and a usable remedy&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Rights:&lt;/b&gt; federal action is constrained directly by the Bill of Rights; apply takings, due process, or other assigned rights when triggered. A seizure may be authorized yet require public use and compensation (Chart 3, D). Federal legislation may also trigger ex post facto / attainder limits.&lt;br/&gt;&lt;b&gt;Federalism:&lt;/b&gt; executive commands to state lawmakers / officers require the anti-commandeering analysis; use your Congress chart. A statute cannot delegate a power Congress lacks.&lt;br/&gt;&lt;b&gt;Judicial challenge:&lt;/b&gt; use the shared court checklist in the companion guide. End with authority → violated limit, if any → defendant / remedy.&lt;/div&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#DDF1EB;strokeColor=#526678;fontColor=#17334D;fontSize=21;" vertex="1" parent="1">
          <mxGeometry x="60" y="3251" width="2280" height="175" as="geometry" />
        </mxCell>
