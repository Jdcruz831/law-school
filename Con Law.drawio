        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;3. Independent limits?&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(1) Anti-commandeering&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(2) Equal state sovereignty&lt;/p&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;(3) Immunity, individual rights and separation of powers&lt;/p&gt;&lt;p style=&quot;margin:0 8px 0;&quot;&gt;An enumerated power does not erase these limits.&lt;/p&gt;" tooltip="Joondeph chapter 12, pp. 203–218; separation of powers, chapters 13–15." id="congress-final-limits">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
            <mxGeometry height="165" width="400" x="7455" y="4400" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:19px;&quot;&gt;&lt;b&gt;Can Congress regulate?&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:4px 5px 0;font-size:14px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:7px 0;&quot;&gt;&lt;p style=&quot;margin:0 8px 7px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" tooltip="Synthesis of the existing Congress chart and Joondeph chapters 8–12." id="congress-final-answer">
          <mxCell parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontSize=12;fillColor=#CDEBDD;fontColor=#151719;strokeColor=#719D87;" vertex="1">
