        <mxCell id="Xi6R8VFtuRbqRZCLOG7g-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Can Congress regulate?&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;which enumerated power?&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="860" y="190" as="geometry" />
        </mxCell>
        <mxCell id="JmaqZS_z_HP7oz48ixAH-2" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-2" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="JmaqZS_z_HP7oz48ixAH-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yBkmQJfWIpP3PkYPqzID-2" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-2" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="yBkmQJfWIpP3PkYPqzID-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="B6Lnn4QgyuMP3YLCs58v-2" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-2" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="B6Lnn4QgyuMP3YLCs58v-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y0OPa0thbyV8DsBOdKr--2" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-2" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Y0OPa0thbyV8DsBOdKr--1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Xi6R8VFtuRbqRZCLOG7g-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Commerce Clause&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;U.S. v. Lopez&lt;/i&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Three categories:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Channels of interstate commerce: highways, telecommunications&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Instrumentalities, persons, or things in interstate commerce: Airplanes, trucks, interstate shipments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Activities substantially affecting interstate commerce&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Economic activity: Aggregation may establish substantial effects.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Noneconomic activity: Aggregate economic consequences alone generally do not suffice under&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="480" x="-270" y="600" as="geometry" />
        </mxCell>
        <mxCell id="p0A-5Rfh-Bb6nw7R3XpS-1" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-4" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="Y0OPa0thbyV8DsBOdKr--1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Xi6R8VFtuRbqRZCLOG7g-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Taxing Clause&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8, Clause 1&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Tax vs. penalty:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) produce at least some government revenue&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) person lawfully make the underlying choice and satisfy the law by paying&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) consider together:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;(a) Financial burden: genuine choice or prohibitory punishment?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;(b) Scienter: liability tied to knowing wrongdoing?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;(c) Administration: ordinary tax collection or punitive enforcement?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) characterized as a tax&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="390" x="380" y="600" as="geometry" />
        </mxCell>
        <mxCell id="-__zsblWwVjwTbuOe7No-1" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="Y0OPa0thbyV8DsBOdKr--1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iW443X8FPqfs6OEo9B83-2" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Z5oHqse6AIYGWPncMn8w-1" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1137.7777777777774" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Gnz2annpa-CYrGyf_cMR-2" edge="1" parent="1" source="Xi6R8VFtuRbqRZCLOG7g-6" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Gnz2annpa-CYrGyf_cMR-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Xi6R8VFtuRbqRZCLOG7g-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Spending clause&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8, Clause 1,&amp;nbsp;&lt;/i&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;South Dakota v. Dole&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Five requirements for conditional enforcement of government contracts:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) General welfare: Does the program serve a public purpose? Courts give Congress substantial deference.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Clear conditions: Can states knowingly understand the obligations attached to acceptance?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Germaneness: Is the condition sufficiently related to the federal program?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) No independent constitutional bar: Does the condition require unconstitutional conduct?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5)No coercion: Does the state retain a meaningful choice?&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="410" x="890" y="590" as="geometry" />
        </mxCell>
        <mxCell id="B0UYbIIFRmXer98yrGW8-2" edge="1" parent="1" source="B0UYbIIFRmXer98yrGW8-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="Xi6R8VFtuRbqRZCLOG7g-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="B0UYbIIFRmXer98yrGW8-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" value="Congress" vertex="1">
          <mxGeometry height="60" width="170" x="920" y="-140" as="geometry" />
        </mxCell>
        <mxCell id="JmaqZS_z_HP7oz48ixAH-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Economic Activity&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Wickard&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Wheat case : Growing wheat for home consumption reduces the demand for wheat in the commercial market &amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="340" x="-640" y="830" as="geometry" />
        </mxCell>
        <mxCell id="TKLQM6di_nTa3z7qgkxl-3" edge="1" parent="1" source="yBkmQJfWIpP3PkYPqzID-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="TKLQM6di_nTa3z7qgkxl-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yBkmQJfWIpP3PkYPqzID-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;noneconomic conduct w/ economic consequences&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Morrison&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Gender-motivated violence: Congress cannot regulate noneconomic violent conduct solely because its aggregate consequences substantially affect interstate commerce.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="340" x="-440" y="960" as="geometry" />
        </mxCell>
        <mxCell id="TKLQM6di_nTa3z7qgkxl-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Exception: &amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;undermine a valid broader regulation&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Gonzales v. Raich&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Locally grown weed case: Congress may reach local, noncommercial instances when reasonably concluding that exempting them would undermine a valid broader regulation of an interstate market.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Relevant considerations:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Marijuana is a fungible commodity.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Locally grown marijuana can enter the interstate market.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Distinguishing local from interstate supplies creates enforcement difficulties.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Personal production can affect supply and demand.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="480" x="-720" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="B6Lnn4QgyuMP3YLCs58v-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Commerce Clause&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;U.S. v. Lopez&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Gun regulation case: The government linked guns at school to crime, insurance costs, impaired education, and reduced national productivity. The constitutional problem was the absence of a meaningful stopping point:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="-70" y="910" as="geometry" />
        </mxCell>
        <mxCell id="-S5urOYjAlJwlQOTgcYA-2" edge="1" parent="1" source="Y0OPa0thbyV8DsBOdKr--1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="7EKf3X9Q68wv_vvjf3YD-1" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="442" y="1810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Y0OPa0thbyV8DsBOdKr--1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Compelling otherwise inactive individuals to enter commerce&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;NFIB&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Commerce Clause&lt;/b&gt;: Congress power to regulate existing commerce does not include compelling otherwise inactive individuals to enter commerce by purchasing a product.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Tax Power&lt;/b&gt;:&amp;nbsp;The payment survived as a tax because it could reasonably be understood as leaving a lawful choice to remain uninsured and pay.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;The Spending Clause&lt;/b&gt;: The ACA threatened existing Medicaid funding if states refused the expansion.&amp;nbsp;Congress could offer expansion funds with conditions, but could not withdraw existing Medicaid funds merely because a state declined the expansion.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="460" x="310" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="D-PfUDDaMhyuyHUpV2Kp-2" edge="1" parent="1" source="7EKf3X9Q68wv_vvjf3YD-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="D-PfUDDaMhyuyHUpV2Kp-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-17" edge="1" parent="1" source="7EKf3X9Q68wv_vvjf3YD-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="HdfO-nH2aJV_gOckw8U0-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7EKf3X9Q68wv_vvjf3YD-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Necessary &amp;amp;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Proper&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;§8 Clause 18&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;All laws must also be Necessary &amp;amp; Proper&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Necessary ≠ indispensable: Useful or reasonably adapted to carrying out an enumerated power may suffice.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Proper ≠ useful: The means must also respect constitutional limits.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="555" x="190" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="D-PfUDDaMhyuyHUpV2Kp-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Even if necessary, not proper.&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;NFIB&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Even if compelling insurance purchases was necessary to make the ACA’s reforms effective, Roberts concluded it was not proper because it compelled otherwise inactive people into commerce&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="250" x="-170" y="1680" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-2" edge="1" parent="1" source="r3XVL_BDQWlIjwIJfD-h-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HdfO-nH2aJV_gOckw8U0-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-4" edge="1" parent="1" source="r3XVL_BDQWlIjwIJfD-h-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HdfO-nH2aJV_gOckw8U0-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-6" edge="1" parent="1" source="r3XVL_BDQWlIjwIJfD-h-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HdfO-nH2aJV_gOckw8U0-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3XVL_BDQWlIjwIJfD-h-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;13th, 14th, or 15th Amendment&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;which enumerated power?&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="1900" y="510" as="geometry" />
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-14" edge="1" parent="1" source="HdfO-nH2aJV_gOckw8U0-1" style="edgeStyle=none;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="HdfO-nH2aJV_gOckw8U0-13" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;i&gt;Jones&lt;/i&gt;&lt;/font&gt;">
          <mxGeometry relative="1" x="-0.0006" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="HdfO-nH2aJV_gOckw8U0-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;13th Amendment §2&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress may address slavery and its badges and incidents, including racial discrimination&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Reach private and government conduct.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="320" x="1400" y="820" as="geometry" />
        </mxCell>
