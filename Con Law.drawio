          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-20" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-11" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C0olnXspH3CQYHDvb34H-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-22" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-11" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;fillColor=#60a917;strokeColor=#2D7600;" target="9A686LOlzWrqTdymGBHn-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bypassing State Sovereign Immunity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. State Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Implicit Consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. Appeals of State Court Judgments&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. Congressional Abrogation&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="2900" y="810" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;State Consent &amp;amp; Waiver&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Statutory Waiver&lt;/b&gt; :&amp;nbsp;A state can waive immunity via a statute w/&amp;nbsp;&quot;unmistakably clear&quot; language&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Federal Spending Programs&lt;/b&gt;: Congress can condition the receipt of federal funds on a state&#39;s waiver of Eleventh Amendment immunity&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Litigation Conduct:&lt;/b&gt;&amp;nbsp;he state voluntarily chooses to remove the case to federal court, the state forfeits its Eleventh Amendment immunity&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="290" x="2480" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Implicit Consent&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the states implicitly surrendered their sovereign immunity to a narrow list of lawsuits:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought by sister states&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought by the federal government&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Claims arising in bankruptcy proceedings&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Eminent domain condemnation proceedings brought by private delegates&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Actions brought under federal statutes enacted under Congress&#39;s authority to build and maintain a national military&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="280" x="2825" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Congressional Abrogation&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress has the power to pass statutes that strip states of their sovereign immunity, only if in section 5 powers.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="3480" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Appeals of State Court Judgments&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Cohens v. Virginia&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- does not bar the U.S. Supreme Court from exercising its appellate jurisdiction to review state court judgments on federal issues&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- only when state is defendant&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="3150" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-7" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-23" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-26" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-31" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Standing&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&amp;nbsp;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Injury in Fact&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Causation/ traceability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Redressability&amp;nbsp;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Notes:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Non-waivible&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Sue sponte requirement for federal courts to check for standing always&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Must persist throughout&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="320" x="650" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-5" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;innerLoopWaypoints=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Multi-party &amp;amp; Provision&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Multiple plaintiffs&lt;/b&gt;: only one needs standing for a suit to be heard.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- however for relief each plaintiff &lt;/span&gt;must have standing for that relief sought&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Multiple Provisions&lt;/b&gt;: standing for one provisions, does not grant to another provision that does not affect them.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Standing on appeal: injury must be fairly trainable to the judgment from below.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="195" width="230" x="1020" y="1146.88" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-11" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-16" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-18" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Injury in Fact&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&amp;nbsp;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: medium; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Concrete (not abstract)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Particularized (individual effect)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Actual or Imminent (not hypothetical)&amp;nbsp;&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Notes:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Non-waivible&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Sue sponte requirement for federal courts to check for standing always&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Must persist throughout&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="310" x="440" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-13" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-10" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Concreteness vs. Particularization&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Spokeo v. Robins (2016)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- Plaintiff&#39;s information being published was particularized because it was personal, but the concreteness of the harm was inadequate. &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="150" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&amp;nbsp;&quot;Injury in law is not injury in fact&quot;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;TransUnion LLC v. Ramirez (2021)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- Just because congress passes a statue giving a right of action does not automatically translate to injury in fact. &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="250" x="80" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Aesthetic injuries&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Summers v. Earth Island Institute (2009)&lt;/i&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Original individual had standing becuse of imminent plans to visit the ridge, however lost standing to challenge actual regulation after the issue with the ridge was settled&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- some day intentions is not enough.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Aesthetic is enough, but has to be imminent plans.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="250" x="350" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Other&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Organization has standing when&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) at least one member has standing in their own right&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) the lawsuit is germane to the organizations&lt;/span&gt; &lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;purpose.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- government has standing to prosecute crimes or civil enforcement due to it&#39;s sovereignty&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Third-party standing: Typically not allowed, but sometimes like in health care.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="335" x="460" y="1890" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-22" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-20" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="823" y="1420" as="sourcePoint" />
            <mxPoint x="877" y="1810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Chain of Causation&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Allen v. Wright (1984)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Parents of Black public school children sued the IRS, alleging it failed to enforce its own rules denying tax-exempt status to racially discriminatory private schools [331, 333]. The parents claimed that this unlawful tax exemption subsidized &quot;white flight&quot; academies, which drew white students out of desegregating public schools&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Cognizable Injury, But No chain of causation&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="320" x="1020" y="1420" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-28" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-24" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-27" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Relief-Specific Standing&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Los Angeles v. Lyons (1983&lt;/i&gt;&lt;/span&gt;&lt;i&gt;)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;standing for each form of relief&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="650" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-27" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Relaxed Standard&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Relaxed if congress gives a right to a specific hearing.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="230" x="750" y="1780" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-34" edge="1" parent="1" source="cJ5OH2NNq5MmNCnX_mFG-29" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-33" value="">
