        <mxCell id="nGnvCsMC4TkzJVelY6of-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Article III&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Judicial Branch&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="6545" y="260" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-9" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-6" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="nGnvCsMC4TkzJVelY6of-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;§ 1&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The judicial Power of the United States, shall be vested in one supreme Court, and in such&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;u&gt;inferior Courts as the Congress may from time to time ordain and establish&lt;/u&gt;. The Judges, both&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of the supreme and inferior Courts, shall hold their Offices during good Behaviour, and shall,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;at stated Times, receive for their Services, a Compensation, which shall not be diminished&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;during their Continuance in Office.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="330" x="6040" y="490" as="geometry" />
        </mxCell>
        <mxCell id="peGvv96QtA3MUCdrGQaP-3" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fillColor=#6a00ff;strokeColor=#3700CC;" target="peGvv96QtA3MUCdrGQaP-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Inferior Courts as the Congress may from time to time ordain and establish.&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Kline v. Burke&lt;/i&gt;&lt;/span&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&quot;Capacity&quot; vs. &quot;Conferral&quot; - outline of maximum power is not the right to use all power&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;The &quot;Greater Includes the Lesser&quot; Power - congress can&#39;t grant more than the constitution&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;The Power to Give is the Power to Take Away- Granting is not permanent&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="5720" y="880" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-13" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-10" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="nGnvCsMC4TkzJVelY6of-12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-15" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-10" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="nGnvCsMC4TkzJVelY6of-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-17" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-10" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="nGnvCsMC4TkzJVelY6of-16" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;§&lt;/u&gt;&amp;nbsp;2&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Clause 1: Appellate jurisdiction&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Clause 2: Original Jurisdiction&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Clause 3: Trial of Crimes&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="230" x="6615" y="540" as="geometry" />
        </mxCell>
        <mxCell id="hE_Ytp25PcyCGzYX4cIT-2" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-12" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hE_Ytp25PcyCGzYX4cIT-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-4" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-12" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cJ5OH2NNq5MmNCnX_mFG-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-46" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-12" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="cJ5OH2NNq5MmNCnX_mFG-44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Clause 1: Appellate jurisdiction&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The judicial Power shall extend to all Cases, in Law and Equity, arising under this Consti-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;tution, the Laws of the United States, and Treaties made, or which shall be made, under their&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Authority;—to all Cases affecting Ambassadors, other public Ministers and Consuls;—to all&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Cases of admiralty and maritime Jurisdiction;—to Controversies to which the United States&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;shall be a Party;—to Controversies between two or more States;—between a State and Citi-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;zens of another State;—between Citizens of different States, —between Citizens of the same&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;State claiming Lands under Grants of different States, and between a State, or the Citizens&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;thereof, and foreign States, Citizens or Subjects.&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="335" x="6205" y="830" as="geometry" />
        </mxCell>
        <mxCell id="5-4MZBhWgrtnccdSxQM8-2" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-14" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="5-4MZBhWgrtnccdSxQM8-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="18EV3NXly3eGwHwJ9PCQ-5" edge="1" parent="1" source="nGnvCsMC4TkzJVelY6of-14" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="18EV3NXly3eGwHwJ9PCQ-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&amp;nbsp;Clause 2: Original Jurisdiction&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;In all Cases affecting Ambassadors, other public Ministers and Consuls, and those in which&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;a State shall be Party, the supreme Court shall have&amp;nbsp;&lt;u&gt;Original Jurisdiction&lt;/u&gt;. In all the other&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Cases before mentioned, the supreme Court shall have appellate Jurisdiction, both as to Law&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and Fact, with such&amp;nbsp;&lt;u&gt;Exceptions, and under such Regulations as the Congress shall make&lt;/u&gt;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="320" x="6615" y="850" as="geometry" />
        </mxCell>
        <mxCell id="nGnvCsMC4TkzJVelY6of-16" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Clause 3: Trial of Crimes&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Trial of all Crimes, except in Cases of Impeachment, shall be by Jury; and such Trial&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;shall be held in the State where the said Crimes shall have been committed; but when not&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;committed within any State, the Trial shall be at such Place or Places as the Congress may by&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Law have directed.&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="6990" y="840" as="geometry" />
        </mxCell>
        <mxCell id="cJ5OH2NNq5MmNCnX_mFG-37" edge="1" parent="1" source="hE_Ytp25PcyCGzYX4cIT-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="peGvv96QtA3MUCdrGQaP-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hE_Ytp25PcyCGzYX4cIT-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Constitution Level Restraints&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;cases&quot; and &quot;controversies&quot; aka &quot;Limited Jurisdiction&quot;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- arising under constitution&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- The United States shall be a Party&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- between Citizens of different States&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- State and Foreigns&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- between Citizens of the same state claiming Lands&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&lt;/span&gt;under Grants of different States&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- Controversies between two or more States&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- between a State and Citizens of another State&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="335" x="6370" y="1232.5" as="geometry" />
        </mxCell>
        <mxCell id="KJExrowZUuuFt-tTXspJ-4" edge="1" parent="1" source="peGvv96QtA3MUCdrGQaP-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="KJExrowZUuuFt-tTXspJ-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="COWE_IKI9RGzQCRLrS6F-2" edge="1" parent="1" source="peGvv96QtA3MUCdrGQaP-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="COWE_IKI9RGzQCRLrS6F-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qmnBMAegnWpMgDC_wxlf-2" edge="1" parent="1" source="peGvv96QtA3MUCdrGQaP-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;fillColor=#6a00ff;strokeColor=#3700CC;" target="qmnBMAegnWpMgDC_wxlf-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="peGvv96QtA3MUCdrGQaP-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Statutory Authorization&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Congress must affirmatively confer that jurisdiction on the federal courts by statute:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;- The Judiciary Act of 1789&lt;/p&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;  - 28 U.S.C. § 1331 for federal questions&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;  - &lt;/span&gt;28 U.S.C. § 1332 for diversity&lt;/span&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="335" x="6230" y="1748.75" as="geometry" />
        </mxCell>
        <mxCell id="KJExrowZUuuFt-tTXspJ-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Section 25 of the Judiciary Act&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Martin v. Hunter&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;SCOTUS may review a state supreme court judgment involving federal law.&lt;/blockquote&gt;&lt;div&gt;&lt;br&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;land title case in Virginia&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Virginia Court of Appeals refused to obey the Supreme Court&#39;s mandate, arguing that because the state was an independent sovereign, its state court judgments were completely unreviewable by any federal court&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Justice Story&amp;nbsp;upheld the constitutionality of Section 25, ruling that Article III&#39;s grant of federal appellate power and the necessity for national uniformity&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Because:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Structure of the Constitution: without appellate review Supreme Court would be limited to original jurisdiction and rendered weak.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Uniformity of federal law throughout the states&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Safeguarding Federal Rights, States only take local interests into account. &amp;nbsp;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="370" x="5820" y="1943.75" as="geometry" />
        </mxCell>
        <mxCell id="KJExrowZUuuFt-tTXspJ-2" edge="1" parent="1" source="KJExrowZUuuFt-tTXspJ-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="KJExrowZUuuFt-tTXspJ-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="KJExrowZUuuFt-tTXspJ-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;State statute&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Fletcher&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&amp;nbsp;v. Peck&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Federal courts may declare a state statute unconstitutional in a case originating in federal court.&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="350" x="5395" y="2233.12" as="geometry" />
        </mxCell>
        <mxCell id="COWE_IKI9RGzQCRLrS6F-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Appellete level review for cases where a state is a party&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Cohens v. Virginia&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Even thought jurisdiction came through &quot;arising under&quot; jurisdiction Virginia argued that because the state was a party SCOTUS only had original jurisdiction.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;SCOTUS overruled and said they still have Appellate level of review.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="350" x="6190" y="2323.75" as="geometry" />
        </mxCell>
        <mxCell id="qmnBMAegnWpMgDC_wxlf-3" edge="1" parent="1" source="5-4MZBhWgrtnccdSxQM8-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;fillColor=#6a00ff;strokeColor=#3700CC;" target="qmnBMAegnWpMgDC_wxlf-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5-4MZBhWgrtnccdSxQM8-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Original Jurisdiction (SCOTUS)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;All cases under:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- ambassadors&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;public ministers &lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;and consuls&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;a State is a party;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="260" x="6935" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="b2Do-PMVe7Rs2Q0arLrr-2" edge="1" parent="1" source="qmnBMAegnWpMgDC_wxlf-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="9A686LOlzWrqTdymGBHn-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qmnBMAegnWpMgDC_wxlf-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Section 13 of the Judiciary Act&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Marbury v. Madison&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Did Marbury have a right to his commission?&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Because President Adams had signed the commission and Marshall had fixed the seal the appointment was fixed, delivery was not important.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Did the law afford him a remedy?&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Yes, Distinguishing between political discretionary acts, and ministerial duties, a writ of mandamus was the appropriate remedy&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Could the Supreme Court issue this remedy?&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;No, because the original jurisdiction of A3 §2 was contradictory to Section 13 of the Judiciary act, and the constitution was the supreme law of the land. Thus Section 13 of JA was struck down&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Basically, the Supreme Court was weak at the time and would have lost a direct battle so this was a light slap on the wrist without claiming any actual power.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="323.75" width="400" x="6800" y="1693.75" as="geometry" />
        </mxCell>
        <mxCell id="9A686LOlzWrqTdymGBHn-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Declaring a Statute Unconstitutional&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Trump v. Casa&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- federal unconstitutional injunctions can only provide protection for actual plantifs not affected parties unless class action, because&amp;nbsp;law is unconstitutional not that it&#39;s void.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Only thing stopping executive branch from abusing the&amp;nbsp;party-specific injunction is the class wide actions providing actual universal relief.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="177.5" width="320" x="7470" y="1823.75" as="geometry" />
        </mxCell>
        <mxCell id="b2Do-PMVe7Rs2Q0arLrr-3" edge="1" parent="1" source="9A686LOlzWrqTdymGBHn-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" target="9A686LOlzWrqTdymGBHn-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9A686LOlzWrqTdymGBHn-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Defiance of federal Injunction&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Ex parte Young (1908)&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Judicial Contempt:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Which typically for States violate the 11th amendment, however the legal fiction that when a state officer attempts to enforce an unconstitutional law, they are acting outside the scope of their lawful state authority and are not &quot;the state&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Limits: Only future actions, not previous ones. (&lt;b&gt;Prospective v. retrospective&lt;/b&gt;)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="208.75" width="320" x="7695" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-2" edge="1" parent="1" source="18EV3NXly3eGwHwJ9PCQ-4" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C0olnXspH3CQYHDvb34H-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-23" edge="1" parent="1" source="18EV3NXly3eGwHwJ9PCQ-4" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;fillColor=#60a917;strokeColor=#2D7600;" target="peGvv96QtA3MUCdrGQaP-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="18EV3NXly3eGwHwJ9PCQ-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;Exceptions Clause&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Ex parte McCardle (1869)&lt;/i&gt;&lt;b&gt;&amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;SCOTUS has appellate jurisdictions with exceptions made by congress:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Repeal Act of (1868): a take back of the Habeas&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Corpus Act of 1867, which gave SCOTUS the jurisdiction&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;over lower federal court habeas denials. &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;-  However this revoking of Repeal Act of 1868 was&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;only allowed because it was &quot;constitutional&quot;. It was only&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;constitutional because there was another avenue for a writ&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;of Habeus corpus under Judiciary Act of 1789. &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;This leaves open the idea that the Exceptions Clause could be stoped&lt;/span&gt;&amp;nbsp;if a block of jurisdiction would be a violation of a constitutional right, probably &quot;Due process&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;When Congress affirmatively describes the Court&#39;s appellate jurisdiction in a statute, that description implicitly negates and withdraws any appellate jurisdiction not explicitly mentioned in the statute under the Exceptions clause, hence the Statutory requirement&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Underlying political moves doesn&#39;t matter!&lt;/p&gt;" vertex="1">
          <mxGeometry height="340" width="400" x="7080" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;No &quot;Rules of Decision&quot;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;United States v. Klein&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Court ruled that Congress cannot prescribe a &quot;rule of decision&quot; for the judiciary in pending cases or dictate that the court find for a particular party&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Strict!!!&lt;/b&gt;:&amp;nbsp;The Power to Limit Lower Federal Courts is Near-Absolute&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="270" x="7390" y="1490" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-6" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C0olnXspH3CQYHDvb34H-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000, #77bb41);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Amendment XI&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Judicial power of the United States shall not be construed to extend to any suit in law or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;equity, commenced or prosecuted against one of the United States by Citizens of another State,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;or by Citizens or Subjects of any Foreign State.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="8300" y="270" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-9" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-5" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="C0olnXspH3CQYHDvb34H-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-12" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-5" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C0olnXspH3CQYHDvb34H-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Blocks States from being Sued Federally&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;by Citizens of another State&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Citizens or Subjects of any Foreign State&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- their own state (&lt;i&gt;Hans v. Louisiana&lt;/i&gt; (1890))&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="8280" y="460" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Arms of the State&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Galette v. New Jersey Transit Corp&lt;/i&gt;&lt;b style=&quot;text-decoration-line: underline;&quot;&gt;.&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Consider:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Legal Separateness &amp;amp; Corporate Form: Corporate form is the&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;power to sue and be sued, hold property, and contract&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;-  Financial Liability: Would a judgment come out of the state coffers&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;State Control: like school boards&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;e.g. Municipal corporations &lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="420" x="7880" y="790" as="geometry" />
        </mxCell>
        <mxCell id="C0olnXspH3CQYHDvb34H-14" edge="1" parent="1" source="C0olnXspH3CQYHDvb34H-11" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C0olnXspH3CQYHDvb34H-13" value="">
