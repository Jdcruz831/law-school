        <mxCell id="FAZBmKYACPC_W3faKcOI-9" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center;&quot;&gt;&lt;b&gt;&lt;u&gt;Additional terms:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center;&quot;&gt;&lt;i&gt;§2-207 (1)&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A definite expression of acceptance within a reasonable time operates as an acceptance even if new terms are stated or are different from the original.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="1600" y="-40" as="geometry" />
        </mxCell>
