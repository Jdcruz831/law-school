          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-106" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Express Condition&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;&lt;u&gt;RS&amp;nbsp;&lt;/u&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;u&gt;§ 224&lt;/u&gt;&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Condition = (1) &lt;b&gt;event not certain to occur that must occur&lt;/b&gt;, unless excused, (2) &lt;b&gt;before performance becomes due&lt;/b&gt; expressly outlined in the contract requires (3)&amp;nbsp;STRICT COMPLIANCE &amp;amp; (4) Interpret &lt;b&gt;ambiguous language&lt;/b&gt; as a promise, not a condition&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="125" width="420" x="17130" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-107" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Waiver, estoppel, and election&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;b&gt;Waiver&lt;/b&gt; = intentional relinquishment of a known right&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Estoppel&lt;/b&gt; = waiver + justifiable reliance = inability to retract waiver&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Election&lt;/b&gt; = choice between two inconsistent courses of action (waive or not)&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="315" x="17940" y="-345" as="geometry" />
        </mxCell>
        <mxCell id="zvsWtHzKlkj4BcIBgDAy-4" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-108" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="zvsWtHzKlkj4BcIBgDAy-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zvsWtHzKlkj4BcIBgDAy-6" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-108" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="zvsWtHzKlkj4BcIBgDAy-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-108" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Constructive&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Condition&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;RS(2d) § 224&lt;/i&gt;&lt;b style=&quot;text-decoration-line: underline;&quot;&gt;&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(1) event not certain to occur that must occur, unless excused, (2) before performance becomes due expressly outlined in the contract requires (3) SUBSTANTIAL PERFORMANCE&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;To decide precedent&amp;nbsp;or concurrent : (1) Contract language (2) Nature of transaction (3) Common sense&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of exchange&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="165" width="400" x="17875" y="125" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-109" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Material breach&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 241-242&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;The failure of performance substantially deprives the injured party of the benefit of the bargain&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;i&gt;Influencing factors:&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) deprived of the benefit (cobweb on sign case)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) can be adequately compensated&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) forfeiture&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Likelihood that the breaching party will cure&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5) good faith and fair dealing&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;If MBreach:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Can suspend own performance, &lt;b&gt;but if not &lt;/b&gt;material must&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;continue his own performance and sue for partial breach. &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(6) &lt;b&gt;If terminate&lt;/b&gt;, must be able to prove would have been able to continue&lt;/span&gt;&amp;nbsp;own performance&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="455" x="17940" y="680" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-2" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-112" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="J9gZFKQ0_lW_FBS2xIa0-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-4" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-112" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="J9gZFKQ0_lW_FBS2xIa0-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-6" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-112" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="J9gZFKQ0_lW_FBS2xIa0-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-112" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Impracticability&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;UCC § 2-615&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Performance of a contract becomes impractical when&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;Nonoccurrence of the event was a basic assumption&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Party seeking discharge is not at fault&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) &amp;nbsp;party seeking discharge has not assumed the risk&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Notify the other party&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;thus the party is relived of duty&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Other party&lt;/b&gt; is also relived if material &amp;amp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Constructive Condition&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Concurrent&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Existing impracticability additional&lt;br&gt;requirements&lt;/b&gt;: (5) No reason to know &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="257.5" width="380" x="16830" y="61.25" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-113" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Frustration of purpose RS&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;§ 265&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) an event occurs that &lt;b&gt;substantially frustrates &lt;/b&gt;one party&#39;s&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;principal purpose in entering into the contract&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;a basic assumption&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) not at fault&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4)&amp;nbsp;has not assumed the risk&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A transaction becoming unprofitable due to unforeseen is not is not enough to be discharged&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Restitution&lt;/b&gt; can be granted for benefits already received!&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="355" x="16660" y="365" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-9" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-114" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C_fFaDVBlLx5BYsrHWKI-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-114" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Expectation&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;RS(2d) § 347&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;FORMULA&lt;/i&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Expectation = loss in value + other loss - cost avoided - loss avoided&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="102.5" width="380" x="20860" y="-102.5" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-115" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Restitution&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;RS(2d) §§ 371&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;The Algernon Blair Rule&lt;/b&gt;:&amp;nbsp;Recovery is &lt;b&gt;based on the market value&lt;/b&gt; of the benefit conferred (what it would have cost the breaching party to buy that performance from a third party), not the contract price&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Except: contract price when performance finished&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="445" x="20480" y="310" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-116" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Limitations on Damages&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Avoid-ability&amp;nbsp;as a Limitation on Damages (Mitigation) &amp;nbsp;§ 350&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;ex:&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;1. &lt;/span&gt;Injured party continues to perform following repudiation&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;2. &lt;/span&gt;Injured party fails to make substitute arrangements&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&amp;nbsp; &lt;b&gt;Foreseeability&amp;nbsp;UCC § 2-715(2)(a) &amp;amp; 351&lt;/b&gt;: Damages cannot be recovered for loss that the breaching &amp;nbsp; &amp;nbsp; party did not have reason to foresee as a probable result of breach when the&lt;/div&gt;&lt;div&gt;&amp;nbsp; contract was made&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;ex:&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;1. &lt;/span&gt;In the ordinary course of events&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;2. &lt;/span&gt;As a result of special circumstances that the breaching party had reason to&lt;br&gt;  know&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;  &lt;b&gt;Certainty&amp;nbsp;§ 352&lt;/b&gt;: cannot recover damages for loss beyond an amount that&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;evidence establishes with reasonable certainty&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;ex: &lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;1. lost profits of new business&lt;/span&gt; &lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;2. &quot;public whim&quot;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;  &lt;b&gt;Emotional distress&amp;nbsp;§ 353&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;white-space: pre;&quot;&gt;:&lt;/b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; Not recoverable UNLESS: bodily harm or sever emotional harm was&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; particularly l&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;ikely to result&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;  NO Assurances rights under common law&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;  &lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="380" width="540" x="21720" y="-140" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-117" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Punitive and Liquidated&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;damages clause&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;RS § 356&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Punitive damage clauses are not allowed liquidated damage displace actual damages&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Want to encourage efficient breaches&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- large liquidated damages are consider punitive&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;To determine:&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;1. &lt;/span&gt;Anticipated loss&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;2. Di&lt;/span&gt;fficulties of proof of loss&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="355" x="21290" y="-165" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-118" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Interpretation&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Rs § 201&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-If parties attach different meanings to a term:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;the court adopts the meaning of the party who did not know (or have reason to know) of the other’s meaning if the other party did know (or had reason to know).&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;If neither is at fault, the contract may fail for lack of mutual assent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;the party asserting the narrower meaning bears the burden of proving that meaning&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="400" x="12810" y="-240" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-119" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Hierarchy of Terms &amp;amp; Gap fillers:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;UCC § 1-303&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Interpretive supplement&lt;/b&gt; : Used to understand and give meaning to terms :&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Express terms &amp;gt; Course of Performance &amp;gt; Course of Dealing &amp;gt; Trade Usage&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&amp;nbsp; &lt;b&gt;Statutory gap fillers&lt;/b&gt;:&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;UCC default rules like &lt;b&gt;2-305&lt;/b&gt; can supply a &quot;reasonable price&amp;nbsp;at the time for delivery&quot;&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Implied-in-fact term&lt;/b&gt;: parties did not include, so use context: &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;What unstated term is fairly part of this contract?&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="455" x="13210" y="-40" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-122" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Identification&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;2-501&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Examples:&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Goods identified by buyer when pointed at (painting) &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&#x9;&#x9;- Goods identified, when seller picks one from wear house&lt;/span&gt; &lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- crops to be harvested within 12 months or next normal harvest:&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;identification when planted.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="500" x="15980" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-133" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Consequential damages exclusion&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;UCC § 2-719&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;can exclude unless unconscionable:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Consumer personal injury = prima facie unconscionable&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Commercial loss = not prima facie unconscionable&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="340" x="20840" y="90" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-134" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Injunction&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;u&gt;&lt;i&gt;Walgreen Co. v. Sara Creek Property&lt;/i&gt;&lt;br&gt;&lt;/u&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The loss is difficult to prove with reasonable certainty, the goods are unique (like land), or the future loss is too speculative or expensive to project&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="350" x="20450" y="60" as="geometry" />
        </mxCell>
        <mxCell id="7JR-Kf3DFgIWmuQxfMb8-135" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;Extra&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Deduction of Damages From the Price UCC § 2-717-&lt;/b&gt; The buyer on notifying the seller of his intention to do so may deduct all or any part of the damages resulting from any breach of the contract from any part of the price still due under the same contract.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Liquidated Damages vs. Penalty Clauses&amp;nbsp;UCC § 2-718&lt;/b&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) Anticipated or Actual Loss - accurate appraisal at contract&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;formation&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) Difficulties of Proof - more difficult to prove makes more liquid&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="182.5" width="410" x="21120" y="897.5" as="geometry" />
        </mxCell>
        <mxCell id="FVZ4G-h6ewI_RDV9Xo5a-4" edge="1" parent="1" source="iGNOkIDzuvFj-mu_oFkp-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="iGNOkIDzuvFj-mu_oFkp-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;u style=&quot;font-weight: bold;&quot;&gt;Implied Fitness&lt;/u&gt;&amp;nbsp;(§ 2-315)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Arises when seller has reason to know:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Any particular purpose for&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;which the goods are required; and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Buyer is relying on Seller’s skill or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;judgment to select or furnish suitable goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;DISCLAIMER&lt;/b&gt;: §2-316&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(1) Must be in writing&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(2) Must be conspicuous - &amp;nbsp;Conspicuous = totality of circumstances; court decides&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="320" x="13560" y="870" as="geometry" />
        </mxCell>
        <mxCell id="FVZ4G-h6ewI_RDV9Xo5a-3" edge="1" parent="1" source="iGNOkIDzuvFj-mu_oFkp-4" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="iGNOkIDzuvFj-mu_oFkp-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Implied Merchantability&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;(§ 2-314)&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;must be a merchant with respect to goods of the kind in the transaction&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Seller warrants that the goods shall be “merchantable&quot; aka&amp;nbsp;fit for their ordinary purpose&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;DISCLAIMER:&amp;nbsp;§2-316&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(1) Must mention merchantability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(2) If in writing, must be conspicuous&amp;nbsp;Conspicuous = totality of circumstances; court decides&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="295" x="13130" y="897.5" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Exceptions&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;2-316(2)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;“As is,” “with all faults”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Buyer examines or refuses to examine the goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Exclusion or modification by trade usage, course of dealing, or course of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;performance&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="240" x="13380" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-22" edge="1" parent="1" source="iGNOkIDzuvFj-mu_oFkp-10" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="iGNOkIDzuvFj-mu_oFkp-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="BqSC1j90w5Mb0CNk9_By-6" edge="1" parent="1" source="iGNOkIDzuvFj-mu_oFkp-10" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" target="7JR-Kf3DFgIWmuQxfMb8-95">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Warranty of title&amp;nbsp;§ 2-312(1)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;Title conveyed to Buyer is good and its transfer rightful&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The goods are delivered free from any security interest or lien that Buyer doesn’t know about at the time of contracting.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="12300" y="705" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Disclaimers for title warranty&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;2-312 (2)&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(1) Specific language&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Circumstances that give the buyer &lt;u&gt;reason to know&lt;/u&gt;&amp;nbsp;that the person selling does not claim title.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Third party: &amp;nbsp;not a disclaimer&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="12010" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="BqSC1j90w5Mb0CNk9_By-3" edge="1" parent="1" source="iGNOkIDzuvFj-mu_oFkp-14" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="BqSC1j90w5Mb0CNk9_By-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="iGNOkIDzuvFj-mu_oFkp-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Express Warranties §2-313&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Created by&lt;/i&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) any affirmation of fact or promise made by the seller (or)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) any description of good&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(2.1) and must be a basis of the bargain, aka made during bargain. &lt;u&gt;Information said before bargain started does not count&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) sample or model . . .&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;that becomes part of the basis of the bargain&lt;/i&gt; &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;NOT Puffing -&amp;nbsp;&lt;/b&gt;&lt;i&gt;Statements of opinion or value (&quot;puffing&quot;) do not create warranties&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;§2-316 Can&#39;t disclaim because:&lt;/b&gt;&amp;nbsp;have to pick which statement is more valuable; the created warranty or the disclaimer. And disclaimers can be hidden - note Parol evidence rule&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="370" x="12640" y="875" as="geometry" />
        </mxCell>
        <mxCell id="FVZ4G-h6ewI_RDV9Xo5a-5" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-25" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.008;entryY=0.648;entryDx=0;entryDy=0;entryPerimeter=0;" target="7JR-Kf3DFgIWmuQxfMb8-104">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T7WLJLTZuM2nBXpYzLt7-1" edge="1" parent="1" source="T7WLJLTZuM2nBXpYzLt7-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="T7WLJLTZuM2nBXpYzLt7-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T7WLJLTZuM2nBXpYzLt7-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Risk of loss | Under UCC § 2-509&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Risk of loss passes according to the type of delivery unless the parties agree otherwise.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;i&gt;&lt;b&gt;Shipment contract&lt;/b&gt;&lt;/i&gt;, risk passes to the buyer when the seller duly delivers the goods to the carrier.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Destination contract&lt;/b&gt;, risk passes when the seller duly tenders the goods at the destination.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;i&gt;Non - carrier rule&lt;/i&gt;&lt;/b&gt;: &amp;nbsp;Merchant: upon receval of goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;i&gt;Non - merchant&lt;/i&gt;&lt;/b&gt;: upon making available for buyer&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="510" x="16850" y="840" as="geometry" />
        </mxCell>
        <mxCell id="T7WLJLTZuM2nBXpYzLt7-6" edge="1" parent="1" source="T7WLJLTZuM2nBXpYzLt7-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="7JR-Kf3DFgIWmuQxfMb8-122">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="T7WLJLTZuM2nBXpYzLt7-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Nonconforming Goods § 2-510&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;Nonconforming Goods § 2-510&lt;/b&gt;: seller keeps the risk of loss until the seller cures or the buyer accepts the goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Buyer Repudiation § 2-510&lt;/b&gt;: If conforming goods are (1) &lt;b&gt;identified to the contract&lt;/b&gt; and the (2) &lt;b&gt;buyer repudiates or breaches&lt;/b&gt; before risk has passed, the (3) &lt;b&gt;seller may treat the risk of loss as resting on the buyer for a commercially reasonable time&lt;/b&gt;, but only to the (4) &lt;b&gt;extent the seller’s insurance is deficient&lt;/b&gt;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="510" x="16390" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="T7WLJLTZuM2nBXpYzLt7-5" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-35" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.608;entryY=0.011;entryDx=0;entryDy=0;entryPerimeter=0;" target="T7WLJLTZuM2nBXpYzLt7-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-1" edge="1" parent="1" source="7cHDHR_CkJ2BRDtAyXQ2-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="7cHDHR_CkJ2BRDtAyXQ2-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-5" edge="1" parent="1" source="7cHDHR_CkJ2BRDtAyXQ2-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="7cHDHR_CkJ2BRDtAyXQ2-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-8" edge="1" parent="1" source="7cHDHR_CkJ2BRDtAyXQ2-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="7cHDHR_CkJ2BRDtAyXQ2-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Anticipatory repudiation&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2 - 610 | &amp;nbsp;§ 250-254&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;Anticipatory repudiation occurs when, (1) &lt;b&gt;before performance&lt;/b&gt; is due, a party (2) &lt;b&gt;unequivocally indicates&lt;/b&gt; by words or conduct that it cannot or will not perform a material contractual duty (Common law) or &lt;b&gt;substantially impairs value&lt;/b&gt; (UCC § 2 - 610) . The injured party may treat the repudiation as final, suspend its own performance, and sue immediately for total breach, but (2) must prove it would have been able to perform its own obligations absent the repudiation.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="17410" y="880" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Adequate Assurance, UCC § 2-609&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;When a party has (1) &lt;b&gt;reasonable grounds for insecurity&lt;/b&gt; about the other party’s performance, it may (2)&amp;nbsp;&lt;b&gt;demand adequate assurance in writing&lt;/b&gt; and, if commercially reasonable, (3)&amp;nbsp;&lt;b&gt;suspend its own performance while waiting&lt;/b&gt;. (4) Failure to provide adequate assurance within a reasonable time, not exceeding 30 days, &lt;b&gt;is treated as repudiation.&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="470" x="17000" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&quot;One-Sided Performance&quot; exception&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;u&gt;&lt;i&gt;RS(2d) § 243(3)&lt;/i&gt;&lt;br&gt;&lt;/u&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;(1)&amp;nbsp;cannot treat the repudiation as a final total breach and sue for all future payments immediately&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;wait until each individual installment payment comes due&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="17640" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-6" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-35" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.339;entryY=-0.001;entryDx=0;entryDy=0;entryPerimeter=0;" target="7cHDHR_CkJ2BRDtAyXQ2-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7cHDHR_CkJ2BRDtAyXQ2-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Warning of Estoppel for urgent of retraction&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;An injured party should not suggest to the repudiator that they are willing to wait for a retraction indefinitely. Doing so could potentially prevent the injured party from later claiming a total breach if the repudiator relies on that suggestion.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="17280" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Temporary impracticability&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Performance is suspended while the impracticability&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; exist&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;UNLESS: materially more burdensome after delay&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;and then may cancel&lt;/span&gt;&amp;nbsp;whole contract&lt;b style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="300" x="16230" y="205" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Partial impracticability &amp;amp;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Dispersement&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Partial impracticability &lt;/b&gt;- the affected party must&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;still perform the rest of his duties&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Dispersement:&lt;/b&gt; if only partially effected, must disperse evenly&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;among customers.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="117.5" width="370" x="16320" y="-280" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Force Majeure Clauses&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Codified an importability by a: Force Majeure Clauses for specific event&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Ejusdem Generis point: Catch all for a Force Majeure&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Clauses includes relevant points not everything&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="112.5" width="380" x="16160" y="-51.25" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-7" edge="1" parent="1" source="J9gZFKQ0_lW_FBS2xIa0-5" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="J9gZFKQ0_lW_FBS2xIa0-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="J9gZFKQ0_lW_FBS2xIa0-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Satisfaction conditions&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Objective Value: must be Reasonable&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(commercial value or quality, operative fitness, or mechanical utility)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Subjective Value: must be in good faith&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;(matters of fancy, taste, or judgment)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="16840" y="-340" as="geometry" />
        </mxCell>
        <mxCell id="uR4FXN-hg0MJ604o3_Rc-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Perfect Tender&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 2-601&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;&amp;nbsp;If the goods or the tender of delivery fail &quot;in any respect&quot; to conform to the contract, the buyer has the right to reject the whole, accept the whole, or accept any commercial units and reject the rest&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="480" x="17680" y="-30" as="geometry" />
        </mxCell>
        <mxCell id="uR4FXN-hg0MJ604o3_Rc-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Avoidance of Forfeiture&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;interpretive preference is used specifically to avoid &lt;b&gt;forfeiture&lt;/b&gt;, which occurs when &lt;b&gt;one party loses their right&lt;/b&gt; to the agreed exchange after they have &lt;b&gt;already relied substantially&lt;/b&gt; on the contract through preparation or performance&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="125" width="420" x="17340" y="-350" as="geometry" />
        </mxCell>
        <mxCell id="zvsWtHzKlkj4BcIBgDAy-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Installment Contracts (§ 2-612)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;A buyer may reject a defective installment only if the nonconformity (1) substantially impairs the value of that installment and (2) cannot be cured.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;If the seller gives adequate assurance that the defect will be cured, the buyer must accept the installment.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A defect in one or more installments becomes a breach of the whole contract only when it substantially impairs the value of the entire contract.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the aggrieved party reinstates the contract if they accept a defective installment without timely canceling, sue only for past installments, or &lt;u&gt;demand future performance&lt;/u&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="400" x="17840" y="340" as="geometry" />
        </mxCell>
        <mxCell id="zvsWtHzKlkj4BcIBgDAy-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Constructive Condition Concurrent&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;UCC Codes (§ 2-507 and § 2-511)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;These exist when both parties are required to perform at the same time. Each party&#39;s duty is conditioned on the other&#39;s tender of performance.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="430" x="18820" y="-260" as="geometry" />
        </mxCell>
        <mxCell id="zvsWtHzKlkj4BcIBgDAy-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Constructive&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Condition&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Precedent&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Stewart v. Newbury&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(1) event not certain to occur that must occur, unless excused, (2) before performance becomes due expressly outlined in the contract requires (3) SUBSTANTIAL PERFORMANCE&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Common Law Rule:&lt;/b&gt; In contracts where performance takes time (like construction), the contractor’s entire performance is a constructive condition precedent to the duty of payment.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Effect: &lt;/b&gt;If the first party fails to substantially perform, the other party’s duty is discharged or suspended.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Authority:&lt;/b&gt; Established in cases like Stewart v. Newbury, where the court held that without an agreement for progress payments, the work must be finished before payment is due.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="440" x="18320" y="-370" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-1" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-2" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="20700" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies: Accepted Goods, UCC § 2-714&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;When the buyer accepts (1) &lt;b&gt;nonconforming goods&lt;/b&gt; and gives (2) &lt;b&gt;proper notice of breach&lt;/b&gt;, the buyer may recover damages under UCC § 2-714. The ordinary measure is the difference, (3) at the time and place of acceptance, between the value of the goods accepted and the value the goods would have had as warranted, (4) unless special circumstances show proximate damages of a different amount.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="20340" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-5" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-10" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="21055" y="1440" />
              <mxPoint x="20740" y="1440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-6" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-11" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="21055" y="1550" />
              <mxPoint x="20870" y="1550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-7" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-12" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="21055" y="1430" />
              <mxPoint x="21470" y="1430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-8" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies: No Goods, UCC § 2-711&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;When the seller fails to deliver, repudiates, or the buyer rightfully rejects or revokes acceptance, the buyer may (1) &lt;b&gt;cancel the contract&lt;/b&gt;, recover any price paid, and &lt;b&gt;seek damages through cover under § 2-712&lt;/b&gt; or &lt;b&gt;market damages&lt;/b&gt; under § 2-713. Include damages under 2-715 for Incidental and Consequential Damages. The buyer may also seek s&lt;b&gt;pecific recovery of goods&lt;/b&gt; under § 2-716 when appropriate.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="20850" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cover, UCC § 2-712&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;After a seller’s breach, the buyer may cover by making a (1)&lt;b&gt; good-faith, reasonable purchase of substitute goods (2) without unreasonable delay&lt;/b&gt;. (3) Cover damages equal the cover price minus the contract price, plus incidental or consequential damages, minus expenses saved.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="20460" y="1517.5" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Market Damages, UCC § 2-713&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;If the buyer does not cover, the buyer may recover market damages measured by the market price at the time the (1) buyer &lt;b&gt;learned of the breach&lt;/b&gt; minus the contract price, plus incidental and consequential damages, minus expenses saved.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="20650" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Specific Recovery, UCC § 2-716&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;A buyer may obtain specific performance or replevin when the goods are unique or in other proper circumstances, including where cover is unavailable or inadequate.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Replevin: legal remedy if (1) identified (2)&amp;nbsp;unable to effect cover for such goods or (3) other circumstances&amp;nbsp;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="152.5" width="400" x="21330" y="1517.5" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-715: Buyer’s Incidental and Consequential Damages &amp;amp; foreseeability&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp; Under UCC § 2-715, a buyer may recover incidental damages and consequential damages caused by the seller’s breach. Incidental damages cover (1) &lt;b&gt;reasonable expenses&lt;/b&gt; connected to dealing with the breach, while (2) &lt;b&gt;consequential damages&lt;/b&gt; cover foreseeable losses the seller had (3) &lt;b&gt;reason to know about &lt;/b&gt;and that the (4) &lt;b&gt;buyer could not reasonably prevent.&lt;/b&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="21050" y="1692.5" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-14" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-19" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="21995" y="1140" />
              <mxPoint x="21810" y="1140" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-15" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-16" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-23" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="21995" y="1210" />
              <mxPoint x="22200" y="1210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-17" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-24" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="21995" y="1240" />
              <mxPoint x="22590" y="1240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;sellers Remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="21890" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Resale Damages, UCC § 2-706&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;After the buyer’s breach, the seller may (1) r&lt;b&gt;esell the goods in good faith &lt;/b&gt;and in a (2) &lt;b&gt;commercially reasonable manner&lt;/b&gt; and recover :&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Contract Price – Resale Price + Incidental Damages – Expenses Saved&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;For a private resale, the seller must give the buyer reasonable (3) &lt;b&gt;notice of the intent&lt;/b&gt; to resell.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="21470" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-20" edge="1" parent="1" source="riopGMi0O9TPRKgeOYIp-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="riopGMi0O9TPRKgeOYIp-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-21" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Market Damages, UCC § 2-708(1)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;If the seller does not resell under § 2-706, or if § 2-706 does not apply, the seller may recover market damages measured by:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Unpaid Contract Price – Market Price + Incidental Damages – Expenses Saved&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="21775" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lost Volume / Profit Damages, UCC § 2-708(2)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;If § 2-708(1) d&lt;b&gt;oes not put seller in as good as a position&lt;/b&gt; as performance would have they &lt;b&gt;may still seek lost profits&lt;/b&gt; as a lost volume seller, meaning both the sale and resale would have happened anyway and thus the resale is not a valid cover.&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="21760" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Action for the Price, UCC § 2-709&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;A seller may recover the contract price when the buyer (1) &lt;b&gt;accepted the goods&lt;/b&gt;, when conforming (2) &lt;b&gt;goods are lost or damaged after risk of loss passed to the buyer&lt;/b&gt;, or (3) when &lt;b&gt;goods identified to the contract cannot reasonably be resold.&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="340" x="22090" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Incidental Damages, UCC § 2-710&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;A seller may recover incidental damages for (1) &lt;b&gt;commercially reasonable charges &lt;/b&gt;after the buyer’s breach. However,&amp;nbsp;consequential damages are generally unavailable unless another law, such as supplemental common law under § 1-103, applies.&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="22470" y="1327.5" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-26" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-46" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.668;entryY=0.111;entryDx=0;entryDy=0;entryPerimeter=0;" target="riopGMi0O9TPRKgeOYIp-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="riopGMi0O9TPRKgeOYIp-27" edge="1" parent="1" source="7JR-Kf3DFgIWmuQxfMb8-46" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.176;entryY=0.093;entryDx=0;entryDy=0;entryPerimeter=0;" target="riopGMi0O9TPRKgeOYIp-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gi31ppJ4iFo96U6Jjeup-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cure Within Contract Time (§ 2-508(1)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;If the buyer rejects a non-conforming delivery but the time for performance has not yet expired, the seller may notify the buyer of their intention to cure. The seller then has the right to make a conforming delivery within the original contract timeframe&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="21900" y="690" as="geometry" />
        </mxCell>
        <mxCell id="gi31ppJ4iFo96U6Jjeup-7" edge="1" parent="1" source="gi31ppJ4iFo96U6Jjeup-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" target="gi31ppJ4iFo96U6Jjeup-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gi31ppJ4iFo96U6Jjeup-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cure After Contract Time (§ 2-508(2)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;If the time for performance has passed, the seller may still have a further &quot;reasonable time&quot; to substitute a conforming tender if:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) The buyer rejects a non-conforming tender that the seller &lt;b&gt;had reasonable grounds to believe would be acceptable.&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The seller seasonably notifies the buyer of the intent to cure&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="460" x="22070" y="840" as="geometry" />
        </mxCell>
        <mxCell id="gi31ppJ4iFo96U6Jjeup-3" edge="1" parent="1" source="gi31ppJ4iFo96U6Jjeup-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.415;entryY=-0.023;entryDx=0;entryDy=0;entryPerimeter=0;" target="gi31ppJ4iFo96U6Jjeup-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gi31ppJ4iFo96U6Jjeup-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&quot;Shaken Faith&quot; Doctrine&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;A seller cannot simply &quot;patch up&quot; a major failure if the buyer&#39;s faith in the goods is &quot;shaken.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- needs major failure and can use&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;major failure later.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="22570" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="BqSC1j90w5Mb0CNk9_By-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Privity&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-318&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The &quot;priority&quot; or breadth of who can sue depends on which alternative is in effect:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Highest Priority: The Buyer (Direct Privity) The buyer who purchased the goods directly from the retailer always has the right to sue that retailer for breach of warranty.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Tier 1: Alternative A (Narrowest/Most Restrictive) (Eliminates horizontal privity barriers) &amp;nbsp;This alternative extends the seller&#39;s warranty only to a limited group: natural persons who are in the family or household of the buyer or who are a guest in the home.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Tier 2: Alternative B (Broader) (Eliminate both horizontal and vertical privity barriers) This alternative extends the warranty to any natural person who may reasonably be expected to use, consume, or be affected by the goods. This expands the &quot;priority&quot; to include people like the mailman in Problem 45, who used a calculator to do work but was not a guest or family member.&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="510" x="12730" y="1550" as="geometry" />
        </mxCell>
        <mxCell id="BqSC1j90w5Mb0CNk9_By-5" edge="1" parent="1" source="iGNOkIDzuvFj-mu_oFkp-5" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.685;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" target="BqSC1j90w5Mb0CNk9_By-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-1" edge="1" parent="1" source="C_fFaDVBlLx5BYsrHWKI-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="C_fFaDVBlLx5BYsrHWKI-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-2" edge="1" parent="1" source="C_fFaDVBlLx5BYsrHWKI-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C_fFaDVBlLx5BYsrHWKI-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Assignment of Rights §&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;2-210 / RS(2d) § 317&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Mechanics&lt;/b&gt;: The party who originally held the right is the assignor, the party who now holds the right is the assignee, and the party who owes the performance is the obligor.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Is&amp;nbsp;Alienable except&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Contract does not exist yet&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Materially changes Obligor’s duty&lt;/i&gt; (materially increases his burden or risk; materially impairs his chance of receiving return performance)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Assignment is forbidden by law or violates public policy&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Contract bars assignment&lt;/i&gt; ( This clause does not include: a right to damages for breach of the whole contract; or a right arising after assignor fully performed.)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Defenses RS(2d) § 309&lt;/b&gt;: The assignee takes the right subject to all defenses that the obligor could have raised against the assignor. For example, if an assignor lured an obligor into a contract through fraud, the obligor can assert that fraud as a defense against the assignee’s claim for payment. Additionally, if an obligor pays the assignor without knowledge that the right has been assigned, that payment is generally a valid defense against the assignee.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Article 9 Caveat&lt;/b&gt;: Many contract rights are subject to UCC Article 9, which often makes them freely alienable regardless of contractual restrictions.&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="500" x="24790" y="185" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-4" edge="1" parent="1" source="C_fFaDVBlLx5BYsrHWKI-5" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="C_fFaDVBlLx5BYsrHWKI-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Delegation of Duties&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-210 / RS § 318&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Delegation occurs when a person who owes a contract duty (the &lt;u&gt;delegor&lt;/u&gt;) manifests the intent to give another (the &lt;u&gt;delegate&lt;/u&gt;) the power to perform that duty&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Continuing Liability:&lt;/b&gt; Unlike an assignment of rights, a delegation of duties &lt;i&gt;&lt;u&gt;does not relieve the delegor of liability&lt;/u&gt;&lt;/i&gt;. If the delegate fails to perform, the original obligee can still demand performance from the delegor.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Novation&lt;/b&gt;: The only way a delegor is fully released from their obligation is through a novation, which is a three-way agreement where the obligee agrees to release the delegor and look only to the delegate for performance.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Assumption of Duty&lt;/b&gt;: A delegate can simply be authorized to perform, or they can promise to perform, thereby &quot;assuming&quot; the duty. If the delegate assumes the duty, they become liable to both the delegor and the original obligee (as a third-party beneficiary)&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="545" x="24790" y="760" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Limits and Prohibitions&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-210(2)&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Material Change Test &amp;nbsp;:&lt;/b&gt;&amp;nbsp;cannot be assigned if the substitution would materially change the obligor’s duty, increase their burden or risk, or materially reduce the value of the contract to them&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Personal Interest&lt;/b&gt;:&amp;nbsp;A delegation is improper if the obligee has a &lt;u&gt;substantial interest&lt;/u&gt; in having the original obligor perform&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Sally Beauty Rule&lt;/b&gt;: the court held that a duty to use &quot;best efforts&quot; to market a product could not be delegated to a direct competitor (or its subsidiary) without consent, as the obligee has a substantial interest in not having a competitor control their distribution&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A term barring the assignment of &quot;the contract&quot; is generally interpreted to bar only the delegation of duties, not the assignment of rights&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="545" x="25550" y="590" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Third-Party Beneficiaries&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;RS(2d) § 302&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Intended vs. Incidental Beneficiaries : &lt;/b&gt;Only intended beneficiaries—those whom the parties intended to benefit to effectuate the contract’s purpose—have standing to sue for breach. Incidental beneficiaries, who benefit from a contract only as a side effect, have no legal rights to enforce it&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Creditor Beneficiaries:&lt;/b&gt; A common example of an intended beneficiary is a creditor beneficiary, where the promisor&#39;s performance will satisfy an existing obligation the promisee owes to the third party. This was established in Lawrence v. Fox, where a party who was promised payment by a third party (on behalf of a debtor) was granted the right to sue for that payment&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Public Contracts:&lt;/b&gt; In the context of government contracts, private citizens are presumed to be incidental beneficiaries. To sue for breach of a public contract, a citizen must show the contract expressly indicated an intent to directly benefit them&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Vesting of Rights RS(2d) § 311&lt;/b&gt;: Once an intended beneficiary’s rights vest—by (1) relying on the promise, (2) suing on it, or (3) manifesting assent—the original parties can no longer discharge or modify the duty without the beneficiary’s consent&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="510" x="25610" y="10" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Construction Measure of Value&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;RS(2d) § 348&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;When a breach results in defective or unfinished construction, the court chooses between two measures:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Diminution in Value&lt;/b&gt;: The decrease in the market price of the property caused by the breach&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;or &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Cost of Repair/Completion:&lt;/b&gt;&amp;nbsp; &lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;The reasonable cost to fix the defect or finish the work&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="520" x="20840" y="-440" as="geometry" />
        </mxCell>
        <mxCell id="C_fFaDVBlLx5BYsrHWKI-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Good faith and fair dealing&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Every contract imposes a duty of good faith and fair dealing in its performance and enforcement. Under the CL, this duty is articulated in Restatement 205, and under the UCC 2-304. The latter requires honesty in fact and, for merchants, adherence to reasonable commercial standards of fair dealing.&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="335" x="16410" y="750" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
