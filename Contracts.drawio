          <mxGeometry height="60" width="120" x="-160" y="110" as="geometry" />
        </mxCell>
        <mxCell id="Y1JraqscTa-Nb5BWw37o-2" edge="1" parent="1" source="0SQIl4ASEBhIBjbtqRzV-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" target="Y1JraqscTa-Nb5BWw37o-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0SQIl4ASEBhIBjbtqRzV-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Right to Cure&amp;nbsp;" vertex="1">
          <mxGeometry height="60" width="120" x="-220" y="830" as="geometry" />
        </mxCell>
        <mxCell id="kKKlSZzPHTWNIDgkSl4t-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="UCC" vertex="1">
          <mxGeometry height="60" width="120" x="520" y="20" as="geometry" />
        </mxCell>
        <mxCell id="kKKlSZzPHTWNIDgkSl4t-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Common Law" vertex="1">
          <mxGeometry height="60" width="120" x="1800" y="-30" as="geometry" />
        </mxCell>
        <mxCell id="_ImUIn2h_ptulprNGJeh-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Perfect Tender&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 2-601&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;&amp;nbsp;If the goods or the tender of delivery fail &quot;in any respect&quot; to conform to the contract, the buyer has the right to reject the whole, accept the whole, or accept any commercial units and reject the rest&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="480" x="360" y="120" as="geometry" />
        </mxCell>
        <mxCell id="gal2r1D1JOwq_iiBkwat-2" edge="1" parent="1" source="zFyXI4WshF5120rILjfy-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="gal2r1D1JOwq_iiBkwat-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zFyXI4WshF5120rILjfy-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Anticipatory repudiation&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2 - 610 | &amp;nbsp;§ 250-254&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;Anticipatory repudiation occurs when, (1) &lt;b&gt;before performance&lt;/b&gt; is due, a party (2) &lt;b&gt;unequivocally indicates&lt;/b&gt; by words or conduct that it cannot or will not perform a material contractual duty (Common law) or &lt;b&gt;substantially impairs value&lt;/b&gt; (UCC § 2 - 610) . The injured party may treat the repudiation as final, suspend its own performance, and sue immediately for total breach, but (2) must prove it would have been able to perform its own obligations absent the repudiation.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="990" y="100" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-5" edge="1" parent="1" source="zxeb-FFwvV3fTkivHA05-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="qnY4Q2QPzVl7I-S0H7D0-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="zxeb-FFwvV3fTkivHA05-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Material breach § 241-242&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;A breach is material when the failure of performance substantially deprives the injured party of the benefit of the bargain. In determining materiality, courts consider the (1) &lt;b&gt;extent of deprivation&lt;/b&gt;, (2) &lt;b&gt;adequacy of compensation&lt;/b&gt;, (3) &lt;b&gt;risk of forfeiture&lt;/b&gt;, (4)&lt;b&gt;likelihood of cure&lt;/b&gt;, and (5) &lt;b&gt;whether the breaching party acted in good faith&lt;/b&gt;.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="1650" y="100" as="geometry" />
        </mxCell>
        <mxCell id="6CPY8y007oSDrwIRlzx4-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cure Within Contract Time (§ 2-508(1)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;If the buyer rejects a non-conforming delivery but the time for performance has not yet expired, the seller may notify the buyer of their intention to cure. The seller then has the right to make a conforming delivery within the original contract timeframe&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="330" y="710" as="geometry" />
        </mxCell>
        <mxCell id="6CPY8y007oSDrwIRlzx4-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cure After Contract Time (§ 2-508(2)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;If the time for performance has passed, the seller may still have a further &quot;reasonable time&quot; to substitute a conforming tender if:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) The buyer rejects a non-conforming tender that the seller &lt;b&gt;had reasonable grounds to believe would be acceptable.&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The seller seasonably notifies the buyer of the intent to cure&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="460" x="430" y="870" as="geometry" />
        </mxCell>
        <mxCell id="6CPY8y007oSDrwIRlzx4-3" edge="1" parent="1" source="6CPY8y007oSDrwIRlzx4-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.415;entryY=-0.023;entryDx=0;entryDy=0;entryPerimeter=0;" target="6CPY8y007oSDrwIRlzx4-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ue9bVcTmrHECxTArJd4i-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Installment Contracts (§ 2-612)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;A buyer may reject a defective installment only if the nonconformity (1) substantially impairs the value of that installment and (2) cannot be cured.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;If the seller gives adequate assurance that the defect will be cured, the buyer must accept the installment.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A defect in one or more installments becomes a breach of the whole contract only when it substantially impairs the value of the entire contract.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the aggrieved party reinstates the contract if they accept a defective installment without timely canceling, sue only for past installments, or &lt;u&gt;demand future performance&lt;/u&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="400" x="940" y="720" as="geometry" />
        </mxCell>
        <mxCell id="ue9bVcTmrHECxTArJd4i-2" edge="1" parent="1" source="6CPY8y007oSDrwIRlzx4-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.017;entryY=0.33;entryDx=0;entryDy=0;entryPerimeter=0;" target="ue9bVcTmrHECxTArJd4i-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="-wbRrCgh9DrCczyCak5d-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&quot;Shaken Faith&quot; Doctrine&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;A seller cannot simply &quot;patch up&quot; a major failure if the buyer&#39;s faith in the goods is &quot;shaken.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- needs major failure and can use&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;major failure later.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="290" x="70" y="900" as="geometry" />
        </mxCell>
        <mxCell id="-wbRrCgh9DrCczyCak5d-2" edge="1" parent="1" source="6CPY8y007oSDrwIRlzx4-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.014;entryY=0.427;entryDx=0;entryDy=0;entryPerimeter=0;" target="-wbRrCgh9DrCczyCak5d-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-6" edge="1" parent="1" source="qnY4Q2QPzVl7I-S0H7D0-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="qnY4Q2QPzVl7I-S0H7D0-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Avoidability as a Limitation on Damages (Mitigation)&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;§ 350&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;Damages are not recoverable for loss that the injured party could have avoided without undue risk, burden, or humiliation. But the injured party is not barred from recovery if they made reasonable but unsuccessful efforts to avoid the loss.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="480" x="1710" y="270" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-7" edge="1" parent="1" source="qnY4Q2QPzVl7I-S0H7D0-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="qnY4Q2QPzVl7I-S0H7D0-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Foreseeability UCC § 2-715(2)(a) &amp;amp; 351&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;A buyer may recover consequential damages for losses resulting from the seller’s breach only if the seller, at the time of contracting, had reason to know of the buyer’s general or particular requirements and the loss could not reasonably be prevented by cover or otherwise.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="480" x="1950" y="410" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-8" edge="1" parent="1" source="qnY4Q2QPzVl7I-S0H7D0-3" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="qnY4Q2QPzVl7I-S0H7D0-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Certainty Restatement &amp;nbsp;§ 352&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;Damages are not recoverable for loss beyond an amount the evidence permits to be established with reasonable certainty.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="370" x="2125" y="540" as="geometry" />
        </mxCell>
        <mxCell id="0lxO2O0vkVQ7jTB4k_nQ-2" edge="1" parent="1" source="qnY4Q2QPzVl7I-S0H7D0-4" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0lxO2O0vkVQ7jTB4k_nQ-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qnY4Q2QPzVl7I-S0H7D0-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Emotional distress | § 353&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;Emotional disturbance damages are not recoverable unless the breach also caused bodily harm or the contract/breach was of such a kind that serious emotional disturbance was a particularly likely result.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="400" x="2290" y="650" as="geometry" />
        </mxCell>
        <mxCell id="Y1JraqscTa-Nb5BWw37o-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Damages" vertex="1">
          <mxGeometry height="60" width="120" x="-1240" y="1465" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-1" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-2" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="-400" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies: Accepted Goods, UCC § 2-714&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;When the buyer accepts (1) &lt;b&gt;nonconforming goods&lt;/b&gt; and gives (2) &lt;b&gt;proper notice of breach&lt;/b&gt;, the buyer may recover damages under UCC § 2-714. The ordinary measure is the difference, (3) at the time and place of acceptance, between the value of the goods accepted and the value the goods would have had as warranted, (4) unless special circumstances show proximate damages of a different amount.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="-760" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-5" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-10" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-45" y="1620" />
              <mxPoint x="-360" y="1620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-6" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-11" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-45" y="1730" />
              <mxPoint x="-230" y="1730" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-7" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-12" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-45" y="1610" />
              <mxPoint x="370" y="1610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-8" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies: No Goods, UCC § 2-711&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;When the seller fails to deliver, repudiates, or the buyer rightfully rejects or revokes acceptance, the buyer may (1) &lt;b&gt;cancel the contract&lt;/b&gt;, recover any price paid, and &lt;b&gt;seek damages through cover under § 2-712&lt;/b&gt; or &lt;b&gt;market damages&lt;/b&gt; under § 2-713. Include damages under 2-715 for Incidental and Consequential Damages. The buyer may also seek s&lt;b&gt;pecific recovery of goods&lt;/b&gt; under § 2-716 when appropriate.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="-250" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cover, UCC § 2-712&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;After a seller’s breach, the buyer may cover by making a (1)&lt;b&gt; good-faith, reasonable purchase of substitute goods (2) without unreasonable delay&lt;/b&gt;. (3) Cover damages equal the cover price minus the contract price, plus incidental or consequential damages, minus expenses saved.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="-640" y="1697.5" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Market Damages, UCC § 2-713&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;If the buyer does not cover, the buyer may recover market damages measured by the market price at the time the (1) buyer &lt;b&gt;learned of the breach&lt;/b&gt; minus the contract price, plus incidental and consequential damages, minus expenses saved.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="-450" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Specific Recovery, UCC § 2-716&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;A buyer may obtain specific performance or replevin when the goods are unique or in other proper circumstances, including where cover is unavailable or inadequate.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Replevin: legal remedy if (1) identified (2)&amp;nbsp;unable to effect cover for such goods or (3) other circumstances&amp;nbsp;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="152.5" width="400" x="230" y="1697.5" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-715: Buyer’s Incidental and Consequential Damages &amp;amp; foreseeability&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp; Under UCC § 2-715, a buyer may recover incidental damages and consequential damages caused by the seller’s breach. Incidental damages cover (1) &lt;b&gt;reasonable expenses&lt;/b&gt; connected to dealing with the breach, while (2) &lt;b&gt;consequential damages&lt;/b&gt; cover foreseeable losses the seller had (3) &lt;b&gt;reason to know about &lt;/b&gt;and that the (4) &lt;b&gt;buyer could not reasonably prevent.&lt;/b&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="-50" y="1872.5" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-14" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-19" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="895" y="1320" />
              <mxPoint x="710" y="1320" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-15" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-16" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-23" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="895" y="1390" />
              <mxPoint x="1100" y="1390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-17" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-24" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="895" y="1420" />
              <mxPoint x="1490" y="1420" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;sellers Remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="790" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Resale Damages, UCC § 2-706&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;After the buyer’s breach, the seller may (1) r&lt;b&gt;esell the goods in good faith &lt;/b&gt;and in a (2) &lt;b&gt;commercially reasonable manner&lt;/b&gt; and recover :&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Contract Price – Resale Price + Incidental Damages – Expenses Saved&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;For a private resale, the seller must give the buyer reasonable (3) &lt;b&gt;notice of the intent&lt;/b&gt; to resell.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="370" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-20" edge="1" parent="1" source="rPibDujVkVHQeOi-8m7z-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rPibDujVkVHQeOi-8m7z-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-21" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Market Damages, UCC § 2-708(1)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;If the seller does not resell under § 2-706, or if § 2-706 does not apply, the seller may recover market damages measured by:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Unpaid Contract Price – Market Price + Incidental Damages – Expenses Saved&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="675" y="1610" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lost Volume / Profit Damages, UCC § 2-708(2)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;If § 2-708(1) d&lt;b&gt;oes not put seller in as good as a position&lt;/b&gt; as performance would have they &lt;b&gt;may still seek lost profits&lt;/b&gt; as a lost volume seller, meaning both the sale and resale would have happened anyway and thus the resale is not a valid cover.&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="660" y="1820" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Action for the Price, UCC § 2-709&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;A seller may recover the contract price when the buyer (1) &lt;b&gt;accepted the goods&lt;/b&gt;, when conforming (2) &lt;b&gt;goods are lost or damaged after risk of loss passed to the buyer&lt;/b&gt;, or (3) when &lt;b&gt;goods identified to the contract cannot reasonably be resold.&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="340" x="990" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="rPibDujVkVHQeOi-8m7z-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Incidental Damages, UCC § 2-710&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;A seller may recover incidental damages for (1) &lt;b&gt;commercially reasonable charges &lt;/b&gt;after the buyer’s breach. However,&amp;nbsp;consequential damages are generally unavailable unless another law, such as supplemental common law under § 1-103, applies.&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="1370" y="1507.5" as="geometry" />
        </mxCell>
        <mxCell id="gal2r1D1JOwq_iiBkwat-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Adequate Assurance, UCC § 2-609&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;When a party has (1) &lt;b&gt;reasonable grounds for insecurity&lt;/b&gt; about the other party’s performance, it may (2)&amp;nbsp;&lt;b&gt;demand adequate assurance in writing&lt;/b&gt; and, if commercially reasonable, (3)&amp;nbsp;&lt;b&gt;suspend its own performance while waiting&lt;/b&gt;. (4) Failure to provide adequate assurance within a reasonable time, not exceeding 30 days, &lt;b&gt;is treated as repudiation.&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="470" x="1030" y="300" as="geometry" />
        </mxCell>
        <mxCell id="xaa_iy9qyWJgRCMcFMOb-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Deduction of Damages From the Price&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-717&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- The buyer on notifying the seller of his intention to do so may deduct all or any part of the damages resulting from any breach of the contract from any part of the price still due under the same contract.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="235" x="70" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="1t3B7giRBWY6UqoJjQ6x-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Expectation&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;FORMULA&lt;/i&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Expectation = loss in value + other loss - cost avoided - loss avoided&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;For construction:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- damages include diminution in the market price of the property&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;or &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Reasonable cost of repair or completion, if that cost is not clearly&lt;br&gt;disproportionate to the probable loss in value to him&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="395" x="1927" y="1330" as="geometry" />
        </mxCell>
        <mxCell id="TL76IATd-N8JKGphYct_-1" edge="1" parent="1" source="TL76IATd-N8JKGphYct_-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" target="TL76IATd-N8JKGphYct_-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="TL76IATd-N8JKGphYct_-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;u style=&quot;font-weight: bold;&quot;&gt;Implied Fitness&lt;/u&gt;&amp;nbsp;(§ 2-315)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Arises when seller has reason to know:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Any particular purpose for&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;which the goods are required; and&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Buyer is relying on Seller’s skill or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;judgment to select or furnish suitable goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;DISCLAIMER&lt;/b&gt;: §2-316&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(1) Must be in writing&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(2) Must be conspicuous - &amp;nbsp;Conspicuous = totality of circumstances; court decides&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="320" x="4970" as="geometry" />
        </mxCell>
        <mxCell id="TL76IATd-N8JKGphYct_-3" edge="1" parent="1" source="TL76IATd-N8JKGphYct_-4" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" target="TL76IATd-N8JKGphYct_-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="TL76IATd-N8JKGphYct_-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Implied Merchantability&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;(§ 2-314)&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;must be a merchant with respect to goods of the kind in the transaction&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Seller warrants that the goods shall be “merchantable&quot; aka&amp;nbsp;fit for their ordinary purpose&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;DISCLAIMER:&amp;nbsp;§2-316&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(1) Must mention merchantability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(2) If in writing, must be conspicuous&amp;nbsp;Conspicuous = totality of circumstances; court decides&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="295" x="4600" as="geometry" />
        </mxCell>
        <mxCell id="TL76IATd-N8JKGphYct_-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Exceptions&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;2-316(2)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;“As is,” “with all faults”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Buyer examines or refuses to examine the goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Exclusion or modification by trade usage, course of dealing, or course of&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;performance&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="240" x="4840" y="320" as="geometry" />
        </mxCell>
        <mxCell id="TL76IATd-N8JKGphYct_-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Waranties &amp;amp; Discliamers&amp;nbsp;" vertex="1">
          <mxGeometry height="60" width="120" x="3300" y="50" as="geometry" />
        </mxCell>
        <mxCell id="4a-2oC6kf7ndwSr0QPF9-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Express Warranties §2-313&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Created by&lt;/i&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) any affirmation of fact or promise made by the seller (or)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) any description of good&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(2.1) and must be a basis of the bargain, aka made during bargain. &lt;u&gt;Information said before bargain started does not count&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) sample or model . . .&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;that becomes part of the basis of the bargain&lt;/i&gt; &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;NOT Puffing -&amp;nbsp;&lt;/b&gt;&lt;i&gt;Statements of opinion or value (&quot;puffing&quot;) do not create warranties&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;§2-316 Can&#39;t disclaim because:&lt;/b&gt;&amp;nbsp;have to pick which statement is more valuable; the created warranty or the disclaimer. And disclaimers can be hidden - note Parol evidence rule&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="370" x="4060" as="geometry" />
        </mxCell>
        <mxCell id="JSeBj11M_F6MmE2dgNHh-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Warranty of title&amp;nbsp;§ 2-312(1)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;Title conveyed to Buyer is good and its transfer rightful&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The goods are delivered free from any security interest or lien that Buyer doesn’t know about at the time of contracting.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="280" x="3695" as="geometry" />
        </mxCell>
        <mxCell id="aKrAeR67yG7uHyHXdTRk-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;Disclaimers for title warranty&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;2-312 (2)&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(1) Specific language&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Circumstances that give the buyer &lt;u&gt;reason to know&lt;/u&gt;&amp;nbsp;that the person selling does not claim title.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Third party: &amp;nbsp;not a disclaimer&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="230" x="3720" y="390" as="geometry" />
        </mxCell>
        <mxCell id="0lxO2O0vkVQ7jTB4k_nQ-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;No right to assurances&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&amp;nbsp;Common law has no right to assurances&amp;nbsp;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="400" x="2440" y="790" as="geometry" />
        </mxCell>
        <mxCell id="9V4pXdgtiOYJ34Zg0yHe-1" edge="1" parent="1" source="9V4pXdgtiOYJ34Zg0yHe-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="9V4pXdgtiOYJ34Zg0yHe-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="9V4pXdgtiOYJ34Zg0yHe-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Risk of loss | Under UCC § 2-509&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Risk of loss passes according to the type of delivery unless the parties agree otherwise.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;i&gt;&lt;b&gt;Shipment contract&lt;/b&gt;&lt;/i&gt;, risk passes to the buyer when the seller duly delivers the goods to the carrier.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Destination contract&lt;/b&gt;, risk passes when the seller duly tenders the goods at the destination.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;i&gt;Non - carrier rule&lt;/i&gt;&lt;/b&gt;: &amp;nbsp;Merchant: upon receval of goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;i&gt;Non - merchant&lt;/i&gt;&lt;/b&gt;: upon making available for buyer&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="510" x="60" y="270" as="geometry" />
        </mxCell>
        <mxCell id="9V4pXdgtiOYJ34Zg0yHe-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Nonconforming Goods § 2-510&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;Nonconforming Goods § 2-510&lt;/b&gt;: seller keeps the risk of loss until the seller cures or the buyer accepts the goods&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Buyer Repudiation § 2-510&lt;/b&gt;: If conforming goods are identified to the contract and the buyer repudiates or breaches before risk has passed, the seller may treat the risk of loss as resting on the buyer for a commercially reasonable time, but only to the extent the seller’s insurance is deficient.&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="510" x="300" y="490" as="geometry" />
        </mxCell>
        <mxCell id="zWpJMwk9dVFirmV3Y0kM-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="Third Party&amp;nbsp;" vertex="1">
          <mxGeometry height="70" width="150" x="5730" y="70" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-1" edge="1" parent="1" source="QJbnxM-7OuZLpezEQIQ0-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" target="QJbnxM-7OuZLpezEQIQ0-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-2" edge="1" parent="1" source="QJbnxM-7OuZLpezEQIQ0-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="QJbnxM-7OuZLpezEQIQ0-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Assignment of Rights §&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;2-210 / RS(2d) § 317&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Mechanics&lt;/b&gt;: The party who originally held the right is the assignor, the party who now holds the right is the assignee, and the party who owes the performance is the obligor.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Is&amp;nbsp;Alienable except&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Contract does not exist yet&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Materially changes Obligor’s duty&lt;/i&gt; (materially increases his burden or risk; materially impairs his chance of receiving return performance)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Assignment is forbidden by law or violates public policy&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;- Contract bars assignment&lt;/i&gt; ( This clause does not include: a right to damages for breach of the whole contract; or a right arising after assignor fully performed.)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Defenses RS(2d) § 309&lt;/b&gt;: The assignee takes the right subject to all defenses that the obligor could have raised against the assignor. For example, if an assignor lured an obligor into a contract through fraud, the obligor can assert that fraud as a defense against the assignee’s claim for payment. Additionally, if an obligor pays the assignor without knowledge that the right has been assigned, that payment is generally a valid defense against the assignee.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Article 9 Caveat&lt;/b&gt;: Many contract rights are subject to UCC Article 9, which often makes them freely alienable regardless of contractual restrictions.&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="500" x="6170" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-4" edge="1" parent="1" source="QJbnxM-7OuZLpezEQIQ0-5" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="QJbnxM-7OuZLpezEQIQ0-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Delegation of Duties&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-210 / RS § 318&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Delegation occurs when a person who owes a contract duty (the &lt;u&gt;delegor&lt;/u&gt;) manifests the intent to give another (the &lt;u&gt;delegate&lt;/u&gt;) the power to perform that duty&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Continuing Liability:&lt;/b&gt; Unlike an assignment of rights, a delegation of duties &lt;i&gt;&lt;u&gt;does not relieve the delegor of liability&lt;/u&gt;&lt;/i&gt;. If the delegate fails to perform, the original obligee can still demand performance from the delegor.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Novation&lt;/b&gt;: The only way a delegor is fully released from their obligation is through a novation, which is a three-way agreement where the obligee agrees to release the delegor and look only to the delegate for performance.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Assumption of Duty&lt;/b&gt;: A delegate can simply be authorized to perform, or they can promise to perform, thereby &quot;assuming&quot; the duty. If the delegate assumes the duty, they become liable to both the delegor and the original obligee (as a third-party beneficiary)&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="545" x="6100" y="360" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Limits and Prohibitions&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-210(2)&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Material Change Test &amp;nbsp;:&lt;/b&gt;&amp;nbsp;cannot be assigned if the substitution would materially change the obligor’s duty, increase their burden or risk, or materially reduce the value of the contract to them&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Personal Interest&lt;/b&gt;:&amp;nbsp;A delegation is improper if the obligee has a &lt;u&gt;substantial interest&lt;/u&gt; in having the original obligor perform&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Sally Beauty Rule&lt;/b&gt;: the court held that a duty to use &quot;best efforts&quot; to market a product could not be delegated to a direct competitor (or its subsidiary) without consent, as the obligee has a substantial interest in not having a competitor control their distribution&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A term barring the assignment of &quot;the contract&quot; is generally interpreted to bar only the delegation of duties, not the assignment of rights&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="545" x="6825" y="240" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Third-Party Beneficiaries&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;RS(2d) § 302&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Intended vs. Incidental Beneficiaries : &lt;/b&gt;Only intended beneficiaries—those whom the parties intended to benefit to effectuate the contract’s purpose—have standing to sue for breach. Incidental beneficiaries, who benefit from a contract only as a side effect, have no legal rights to enforce it&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Creditor Beneficiaries:&lt;/b&gt; A common example of an intended beneficiary is a creditor beneficiary, where the promisor&#39;s performance will satisfy an existing obligation the promisee owes to the third party. This was established in Lawrence v. Fox, where a party who was promised payment by a third party (on behalf of a debtor) was granted the right to sue for that payment&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Public Contracts:&lt;/b&gt; In the context of government contracts, private citizens are presumed to be incidental beneficiaries. To sue for breach of a public contract, a citizen must show the contract expressly indicated an intent to directly benefit them&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Vesting of Rights RS(2d) § 311&lt;/b&gt;: Once an intended beneficiary’s rights vest—by (1) relying on the promise, (2) suing on it, or (3) manifesting assent—the original parties can no longer discharge or modify the duty without the beneficiary’s consent&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="510" x="6840" y="-220" as="geometry" />
        </mxCell>
        <mxCell id="QJbnxM-7OuZLpezEQIQ0-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Privity&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-318&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The &quot;priority&quot; or breadth of who can sue depends on which alternative is in effect:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Highest Priority: The Buyer (Direct Privity) The buyer who purchased the goods directly from the retailer always has the right to sue that retailer for breach of warranty.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Tier 1: Alternative A (Narrowest/Most Restrictive) (Eliminates horizontal privity barriers) &amp;nbsp;This alternative extends the seller&#39;s warranty only to a limited group: natural persons who are in the family or household of the buyer or who are a guest in the home.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Tier 2: Alternative B (Broader) (Eliminate both horizontal and vertical privity barriers) This alternative extends the warranty to any natural person who may reasonably be expected to use, consume, or be affected by the goods. This expands the &quot;priority&quot; to include people like the mailman in Problem 45, who used a calculator to do work but was not a guest or family member.&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="510" x="4240" y="740" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uXhrDkK4u8K0fcvsQc4k" name="Question Prep">
    <mxGraphModel dx="2508" dy="828" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-3" edge="1" parent="1" source="IUbmBJfF_DaLm-xOUC-N-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="IUbmBJfF_DaLm-xOUC-N-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-5" edge="1" parent="1" source="IUbmBJfF_DaLm-xOUC-N-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="IUbmBJfF_DaLm-xOUC-N-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Anticipatory&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Repudiation&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;-&amp;nbsp;One party&amp;nbsp;unequivocally indicates to the other that he &lt;u&gt;cannot&lt;/u&gt; or &lt;u&gt;will not&lt;/u&gt; perform&amp;nbsp;&lt;/i&gt;&lt;i&gt;his obligations under the contract&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Threatened breach must be material&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Option #1:&amp;nbsp;treat repudiation as final, suspend own performance, sue for total breach&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&#x9;(1) prove potential ability to preform&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;UCC specification: (2.5) repudiated performance substantially&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; impairs the value of the contract&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;Option #2&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;Offer to wait for &lt;/span&gt;retraction&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&#x9;*Can only wait for a reasonable period of time&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;Option #3 &lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;Urge repudiating party to &lt;/span&gt;retract&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b style=&quot;white-space: pre;&quot;&gt;No anticipatory repudiation for money only&lt;/b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;: Party can not use words&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; to accelerate a suit and sue for all damages under&amp;nbsp;anticipatory repudiation.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Must wait until money is due to sue. (example rent payments and refusal to pay)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Repudiating party retracts:&lt;/b&gt; &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Contract survives, maybe delay damages. &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;UCC specifications: can not retract if: &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Has cancelled the contract (including substantially impairs)&lt;br&gt;&#x9;&#x9;- Has materially changed his position&lt;br&gt;&#x9;&#x9;- Otherwise indicated that he considers the repudiation final&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="410" width="440" x="70" y="180" as="geometry" />
        </mxCell>
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;For Treating repudiation as final:&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;&#x9;&lt;/i&gt;(1) Prove potential ability to preform&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) repudiated performance must substantially impair value of contract. &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="430" x="-260" y="740" as="geometry" />
        </mxCell>
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-7" edge="1" parent="1" source="IUbmBJfF_DaLm-xOUC-N-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="IUbmBJfF_DaLm-xOUC-N-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Common Law&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;For Treating repudiation as final:&amp;nbsp;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(1) Prove potential&lt;/span&gt; &lt;span style=&quot;white-space: pre;&quot;&gt;ability to preform&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(2) Threatened breach must be material&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="420" x="300" y="740" as="geometry" />
        </mxCell>
        <mxCell id="IUbmBJfF_DaLm-xOUC-N-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Material Breach&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;Surprise or&amp;nbsp;Hardship&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="160" x="800" y="810" as="geometry" />
        </mxCell>
        <mxCell id="qXUIiS6MN9WkPMb9grSW-3" edge="1" parent="1" source="qXUIiS6MN9WkPMb9grSW-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="qXUIiS6MN9WkPMb9grSW-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qXUIiS6MN9WkPMb9grSW-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Express Warranties&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Created by&lt;/i&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) any affirmation of fact or promise made by the seller (or)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) any description of good&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(2.1) and must be a basis of the bargain, aka made during bargain. &lt;u&gt;Information said before bargain started does not count&lt;/u&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;or&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) sample or model . . .&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;that becomes part of the basis of the bargain&lt;/i&gt; &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;NOT Puffing -&amp;nbsp;&lt;/b&gt;&lt;i&gt;Statements of opinion or value (&quot;puffing&quot;) do not create warranties&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Can&#39;t disclaim because:&lt;/b&gt;&amp;nbsp;have to pick which statement is more valuable; the created warranty or the disclaimer. And disclaimers can be hidden&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="370" x="1100" y="200" as="geometry" />
        </mxCell>
        <mxCell id="qXUIiS6MN9WkPMb9grSW-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Parol evidence rule&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Can&#39;t&amp;nbsp;disclaim, but also can&#39;t introduce other agreements or additions to final say&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="370" x="1140" y="560" as="geometry" />
        </mxCell>
        <mxCell id="gu3dH3FnKw1yW-hBqOnj-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Good faith and fair dealing&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;is not fine:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Moving operations to another location to reduce rent due&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Substituting cheaper materials in construction to boost profits&lt;br/&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Preventing a contract partner from performing her duties&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="370" x="1660" y="230" as="geometry" />
        </mxCell>
        <mxCell id="gu3dH3FnKw1yW-hBqOnj-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Warranty of M&lt;/u&gt;&lt;/b&gt;&lt;b&gt;&lt;u&gt;erchantability&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;liable even if:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- even if it handled the glass with reasonable care,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;however could use evidence of reusable&lt;/span&gt; &lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="370" x="620" y="210" as="geometry" />
        </mxCell>
        <mxCell id="gu3dH3FnKw1yW-hBqOnj-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;After termination:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Can new grounds be asserted:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- if fixed with proper notice, the answer is no.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- if new grounds could not have been fixed, maybe yes&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="370" x="2070" y="210" as="geometry" />
        </mxCell>
        <mxCell id="nAAzeYvQzwvDQkD2Kk08-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;After termination:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;§ 2-609 gives a party the right to&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;demand adequate assurances of due performance when he has reasonable grounds for&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;insecurity.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="370" x="2520" y="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
