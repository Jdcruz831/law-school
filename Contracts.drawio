        <mxCell id="BmSybklRlt3U18dhTpSe-6" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Option #1&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- &amp;nbsp;Terminate the contract, and sue the other party for total breach and collect damages based on all remaining rights&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;to performance under the contract.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="230" x="1080" y="-1173.75" as="geometry" />
        </mxCell>
        <mxCell id="BmSybklRlt3U18dhTpSe-9" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Option #3&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- &amp;nbsp;Elect to continue his own performance, Sue the other party for partial breach and collect damages based on part of the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;remaining rights to performance under the contract.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="132.5" width="235" x="1370" y="-1186.25" as="geometry" />
