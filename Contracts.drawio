          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pbd7cU_TBwBD68bYpr3c-5" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Waiver, estoppel, and election&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;b&gt;Waiver&lt;/b&gt; = intentional relinquishment of a known right&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Estoppel&lt;/b&gt; = waiver + justifiable reliance = inability to retract waiver&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Election&lt;/b&gt; = choice between two inconsistent courses of action (waive or not)&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="310" x="350" y="-1040" as="geometry" />
        </mxCell>
        <mxCell id="pbd7cU_TBwBD68bYpr3c-10" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="pbd7cU_TBwBD68bYpr3c-7" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="pbd7cU_TBwBD68bYpr3c-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pbd7cU_TBwBD68bYpr3c-7" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Waiver&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;b&gt;Waiver&lt;/b&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ex: a person knows the other party in a contract has a requirement, but they waive the requirement. &amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="130" y="-770" as="geometry" />
        </mxCell>
        <mxCell id="pbd7cU_TBwBD68bYpr3c-9" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Estoppel&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;b&gt;Estoppel&lt;/b&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ex: If a person waives a requirement but then goes back on the waiver then:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Person waiving, must give other party more time to satisfy requirement, at a minimum&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;However, if other party can not complete requirement due to the waiver, then they are discharged of that duty.&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="300" x="160" y="-580" as="geometry" />
        </mxCell>
        <mxCell id="pbd7cU_TBwBD68bYpr3c-11" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Election&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;there is no prior waiver, but the individual may choose to enforce requirement or not&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Majority rule: If he chooses to not enforce then he can not go back and then choose to reinstate at a later time.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="135" width="310" x="510" y="-795" as="geometry" />
        </mxCell>
