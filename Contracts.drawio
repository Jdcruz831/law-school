        <mxCell id="jknl4GV_5Kp7UUgPtqsj-36" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;No oral modification clause:&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;“Modifications of this contract are effective only if in writing and signed by both parties.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Common Law:&amp;nbsp;ineffective&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;UCC: may be effective if it&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;appears in a signed writing or signed record. However, if the clause appears on a form that a merchant supplies, the other party must sign it&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;separately—unless he/she is also a merchant. 2-209(2)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
