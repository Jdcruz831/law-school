          <mxGeometry height="110" width="230" x="2060" y="-2067.5" as="geometry" />
        </mxCell>
        <mxCell id="f2pItZlCYMWsu16OAMZf-19" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;Option #1&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;- Injured party can terminate the contract. He is discharged&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;from his remaining duties of performance and can bring an immediate&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;action for total breach of the contract&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&lt;i&gt;&amp;nbsp;&lt;/i&gt;To recover damages, he must prove he would have had the ability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;to perform had there been no repudiation.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) if injured party terminates, than repudiating party can not retract&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Article two Specifications&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;repudiated performance substantially impairs the value of the contract&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="237.5" width="440" x="2240" y="-1947.5" as="geometry" />
        </mxCell>
        <mxCell id="f2pItZlCYMWsu16OAMZf-21" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="f2pItZlCYMWsu16OAMZf-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.012;entryY=0.91;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=light-dark(#000000,#009900);" target="f2pItZlCYMWsu16OAMZf-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2pItZlCYMWsu16OAMZf-26" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="f2pItZlCYMWsu16OAMZf-23" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="f2pItZlCYMWsu16OAMZf-25" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f2pItZlCYMWsu16OAMZf-23" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Option #2&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;-&amp;nbsp;Injured party can urge the repudiating party to retract the&amp;nbsp;&lt;/i&gt;&lt;i&gt;repudiation&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Threatened breach must be material&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="230" x="1730" y="-1760" as="geometry" />
        </mxCell>
        <mxCell id="f2pItZlCYMWsu16OAMZf-25" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Repudiating party retracts&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;If the repudiating party retracts, the contract survives&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;-&amp;nbsp;only a claim for damages due to delay (if any)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Article two Specifications&lt;/b&gt;:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Can not retract if&amp;nbsp;aggrieved party:&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Has cancelled the contract (including substantially impairs)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Has materially changed his position&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- O&lt;/span&gt;therwise indicated that he considers the repudiation fina&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="163.75" width="400" x="2050" y="-1523.75" as="geometry" />
        </mxCell>
        <mxCell id="f2pItZlCYMWsu16OAMZf-29" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Semi Option #3&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;-&amp;nbsp;Injured party should be careful not to suggest to the&amp;nbsp;&lt;/i&gt;&lt;i&gt;repudiating party that he is willing to wait for retraction indefinitely&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Can only wait for a reasonable time, he cannot recover damages for losses he could have avoided&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="255" x="2160" y="-1700" as="geometry" />
        </mxCell>
        <mxCell id="lX12ZARgjOtYVHDq9FKV-3" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="lX12ZARgjOtYVHDq9FKV-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="lX12ZARgjOtYVHDq9FKV-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lX12ZARgjOtYVHDq9FKV-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;liquidated damages&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- not allowed to write a punishment into a contract.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- can compensate for actual loss, not just to make them hurt.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-fair anticipation for anticipated loss when damages can be intangible.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- deterrent rather than estimate of harm&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Case Dave Gustafson &amp;amp; Co. v. State : makes steal powder, at least minimum sale to make up for expensive&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;&quot;the damages in the event of a breach will be incapable or very&lt;br&gt;difficult of accurate estimation, that there was a reasonable endeavor by&lt;br&gt;the parties as stated to fix fair compensation, and that the amount&lt;br&gt;stipulated bears a reasonable relation to probable damages and not&lt;br&gt;disproportionate to any damages reasonably to be anticipated.&quot;&quot;&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Penalties actively discourage efficient breaches&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Cambel soup: buy a specific carrot, price tripled, farmers breached contract.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;virtually impossible to obtain&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Chantenay carrots in the open market.&quot; - non fungible&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Specific performance, equitable remedy- clean hands, contract was super strict and unfair&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="430" width="900" x="1520" y="-3290" as="geometry" />
        </mxCell>
        <mxCell id="lX12ZARgjOtYVHDq9FKV-2" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;liquidated damages&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;- compensate parties with loss, not to punish&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- law of economics, economic efficiency&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="420" width="590" x="2610" y="-2990" as="geometry" />
        </mxCell>
        <mxCell id="PWaTtH8k5J-k0iPZ89QR-3" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="PWaTtH8k5J-k0iPZ89QR-0" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="PWaTtH8k5J-k0iPZ89QR-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PWaTtH8k5J-k0iPZ89QR-5" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="PWaTtH8k5J-k0iPZ89QR-0" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="PWaTtH8k5J-k0iPZ89QR-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PWaTtH8k5J-k0iPZ89QR-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="190" x="2700" y="-2420" as="geometry" />
        </mxCell>
        <mxCell id="g_wZPqREscicbtYoxzUl-1" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="PWaTtH8k5J-k0iPZ89QR-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_wZPqREscicbtYoxzUl-0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PWaTtH8k5J-k0iPZ89QR-2" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Seller’s remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;2-706 (resale) :&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Can sue &lt;b&gt;&lt;i&gt;for Price&lt;/i&gt;&lt;/b&gt; if:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;- Buyer accepts goods&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9; - lost or damaged within a commercially reasonable&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;time after risk of loss passed to him&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9; - &lt;/span&gt;goods identified to the contract if seller cannot&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;resell them at a reasonable price&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;i&gt;Resale&lt;/i&gt;&lt;/b&gt;:&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Seller allowed to make himself whole&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) in good faith&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) &lt;/span&gt;&lt;/span&gt;commercially reasonable manner (public or private as long as every aspect&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; reasonable, method manner ect.) &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Damages = Contract price – Resale price + Incidental damages - Expenses saved&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;If Private resale: &lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3) &lt;/span&gt;&lt;/span&gt;give Buyer reasonable notice of intention&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;2-708 &lt;/b&gt;(is alternative) : &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Hypothetical resale at market price &lt;/span&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Damages = Unpaid Contract price - Market price (at time and place for tender) + Incidental damages – Expenses saved&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;Paradime case - sub part two handle with care. &lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;i&gt;Prioritize what will make the seller whole&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;i&gt;Sellers do not get consequential damages (interest) &lt;/i&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- maybe under common law since common law supplements&lt;/span&gt; &lt;i style=&quot;white-space: pre; font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="447.5" width="730" x="2850" y="-2057.5" as="geometry" />
        </mxCell>
        <mxCell id="PWaTtH8k5J-k0iPZ89QR-4" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;’s remedies&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;u&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/u&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;2- 607:&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;“The buyer must pay at the contract rate for any goods accepted.”&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&quot;&lt;/span&gt;&lt;/i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;Acceptance of goods by the buyer precludes rejection of the goods accepted&quot;&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;“[A]cceptance does not of itself impair any other remedy provided by this Article for non-conformity.”&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;“[T]he buyer must within a reasonable time after he discovers or should have discovered any&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;i&gt;breach notify the seller of breach or be barred from any remedy . . . .”&lt;/i&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;2-714:&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;he may recover as damages for any non-conformity of tender . . . in any manner which is reasonable.&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Catch all? : Read 2-714(2), final clause: “Unless special circumstances show proximate damages of a&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;different amount.” - aka can vary&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;2-715&lt;br&gt;&lt;/p&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Can do Incidental damages (inspection costs, receipt costs, transportation)&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;To do &lt;/span&gt;Consequential Damages:&lt;/span&gt;&lt;/div&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) seller had reason to know&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) could not reasonably &lt;/span&gt;be prevented&lt;/div&gt;&lt;div&gt;or&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3) personal injury &lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="400" width="565" x="3635" y="-2240" as="geometry" />
        </mxCell>
        <mxCell id="g_wZPqREscicbtYoxzUl-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Remedies&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;If buyer rejects, repudiates, or otherwise does not fulfill a contract then a seller is entitled to remedies under 2-706 &amp;amp; 2-708:&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;For price if buyer accepts goods&lt;/i&gt;: &lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="447.5" width="730" x="3180" y="-1540" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-2" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="eny379BJW-85_DMhlnvJ-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="eny379BJW-85_DMhlnvJ-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-4" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="eny379BJW-85_DMhlnvJ-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="eny379BJW-85_DMhlnvJ-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="8010" y="-2900" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-1" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies: Accepted Goods, UCC § 2-714&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;When the buyer accepts (1) &lt;b&gt;nonconforming goods&lt;/b&gt; and gives (2) &lt;b&gt;proper notice of breach&lt;/b&gt;, the buyer may recover damages under UCC § 2-714. The ordinary measure is the difference, (3) at the time and place of acceptance, between the value of the goods accepted and the value the goods would have had as warranted, (4) unless special circumstances show proximate damages of a different amount.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="430" x="7650" y="-2710" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-6" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="eny379BJW-85_DMhlnvJ-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="eny379BJW-85_DMhlnvJ-5" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="8365" y="-2520" />
              <mxPoint x="8050" y="-2520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-8" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="eny379BJW-85_DMhlnvJ-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="eny379BJW-85_DMhlnvJ-7" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="8365" y="-2410" />
              <mxPoint x="8180" y="-2410" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-10" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="eny379BJW-85_DMhlnvJ-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="eny379BJW-85_DMhlnvJ-9" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="8365" y="-2530" />
              <mxPoint x="8780" y="-2530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="A6MOBAQHXEQSD9cnUajY-1" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="eny379BJW-85_DMhlnvJ-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="A6MOBAQHXEQSD9cnUajY-0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-3" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies: No Goods, UCC § 2-711&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;When the seller fails to deliver, repudiates, or the buyer rightfully rejects or revokes acceptance, the buyer may (1) &lt;b&gt;cancel the contract&lt;/b&gt;, recover any price paid, and &lt;b&gt;seek damages through cover under § 2-712&lt;/b&gt; or &lt;b&gt;market damages&lt;/b&gt; under § 2-713. Include damages under 2-715 for Incidental and Consequential Damages. The buyer may also seek s&lt;b&gt;pecific recovery of goods&lt;/b&gt; under § 2-716 when appropriate.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="8160" y="-2710" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-5" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Cover, UCC § 2-712&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;After a seller’s breach, the buyer may cover by making a (1)&lt;b&gt; good-faith, reasonable purchase of substitute goods (2) without unreasonable delay&lt;/b&gt;. (3) Cover damages equal the cover price minus the contract price, plus incidental or consequential damages, minus expenses saved.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="380" x="7770" y="-2442.5" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-7" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Market Damages, UCC § 2-713&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;If the buyer does not cover, the buyer may recover market damages measured by the market price at the time the (1) buyer &lt;b&gt;learned of the breach&lt;/b&gt; minus the contract price, plus incidental and consequential damages, minus expenses saved.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="380" x="7960" y="-2240" as="geometry" />
        </mxCell>
        <mxCell id="eny379BJW-85_DMhlnvJ-9" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Specific Recovery, UCC § 2-716&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&amp;nbsp;A buyer may obtain specific performance or replevin when the goods are unique or in other proper circumstances, including where cover is unavailable or inadequate.&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="95" width="400" x="8640" y="-2442.5" as="geometry" />
        </mxCell>
        <mxCell id="A6MOBAQHXEQSD9cnUajY-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;UCC § 2-715: Buyer’s Incidental and Consequential Damages &amp;amp; foreseeability&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp; Under UCC § 2-715, a buyer may recover incidental damages and consequential damages caused by the seller’s breach. Incidental damages cover (1) &lt;b&gt;reasonable expenses&lt;/b&gt; connected to dealing with the breach, while (2) &lt;b&gt;consequential damages&lt;/b&gt; cover foreseeable losses the seller had (3) &lt;b&gt;reason to know about &lt;/b&gt;and that the (4) &lt;b&gt;buyer could not reasonably prevent.&lt;/b&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="410" x="8360" y="-2267.5" as="geometry" />
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-2" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="IjaGl-K92cHHSABcBz_x-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="IjaGl-K92cHHSABcBz_x-1" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9905" y="-2760" />
              <mxPoint x="9720" y="-2760" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-4" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="IjaGl-K92cHHSABcBz_x-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="IjaGl-K92cHHSABcBz_x-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bovoKspK0JROnNjPOQ1I-1" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="IjaGl-K92cHHSABcBz_x-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bovoKspK0JROnNjPOQ1I-0" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9905" y="-2690" />
              <mxPoint x="10110" y="-2690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="bovoKspK0JROnNjPOQ1I-3" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="IjaGl-K92cHHSABcBz_x-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="bovoKspK0JROnNjPOQ1I-2" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="9905" y="-2660" />
              <mxPoint x="10500" y="-2660" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Buyer’s Remedies&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="210" x="9800" y="-2870" as="geometry" />
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-1" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Resale Damages, UCC § 2-706&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;After the buyer’s breach, the seller may (1) r&lt;b&gt;esell the goods in good faith &lt;/b&gt;and in a (2) &lt;b&gt;commercially reasonable manner&lt;/b&gt; and recover :&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Contract Price – Resale Price + Incidental Damages – Expenses Saved&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;For a private resale, the seller must give the buyer reasonable (3) &lt;b&gt;notice of the intent&lt;/b&gt; to resell.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="480" x="9380" y="-2670" as="geometry" />
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-6" edge="1" parent="HMSoyMslVgJfamAm2t2m-1" source="IjaGl-K92cHHSABcBz_x-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="IjaGl-K92cHHSABcBz_x-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-3" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Market Damages, UCC § 2-708(1)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;If the seller does not resell under § 2-706, or if § 2-706 does not apply, the seller may recover market damages measured by:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Unpaid Contract Price – Market Price + Incidental Damages – Expenses Saved&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="9685" y="-2470" as="geometry" />
        </mxCell>
        <mxCell id="IjaGl-K92cHHSABcBz_x-5" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lost Volume / Profit Damages, UCC § 2-708(2)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;If § 2-708(1) does not put seller in as good as a position as performance would have they may still seek lost profits as a lost volume seller, meaning both the sale and resale would have happened anyway and thus the resale is not a valid cover.&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="440" x="9670" y="-2260" as="geometry" />
        </mxCell>
        <mxCell id="bovoKspK0JROnNjPOQ1I-0" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Action for the Price, UCC § 2-709&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;A seller may recover the contract price when the buyer (1) &lt;b&gt;accepted the goods&lt;/b&gt;, when conforming (2) &lt;b&gt;goods are lost or damaged after risk of loss passed to the buyer&lt;/b&gt;, or (3) when &lt;b&gt;goods identified to the contract cannot reasonably be resold.&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="340" x="10000" y="-2630" as="geometry" />
        </mxCell>
        <mxCell id="bovoKspK0JROnNjPOQ1I-2" parent="HMSoyMslVgJfamAm2t2m-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Incidental Damages, UCC § 2-710&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;A seller may recover incidental damages for (1) &lt;b&gt;commercially reasonable charges &lt;/b&gt;after the buyer’s breach. However,&amp;nbsp;consequential damages are generally unavailable unless another law, such as supplemental common law under § 1-103, applies.&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="10380" y="-2572.5" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
