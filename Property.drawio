        <mxCell id="3UPOx2UyDuRtQL01_ttE-37" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;The Four Unities (PITT)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Possession&lt;/b&gt;:&amp;nbsp;an undivided right to possess the whole&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Interest&lt;/b&gt;: Each tenant must hold the same legal interest&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Equal shares is relaxed&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Intent&lt;/b&gt;: manifest a clear intent&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Time&lt;/b&gt;: be acquired or vest at the same time&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Title&lt;/b&gt;: acquire title by the same instrument&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="135" width="380" x="3600" y="497.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-43" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-39" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Severance&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Happens when:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) one of PIITT is destroyed&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;b&gt;Common&lt;/b&gt;: &lt;/span&gt;Alienation&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;Exception&lt;/b&gt;: executing a mortgage,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;does not sever the joint tenancy&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="220" x="3990" y="170" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-41" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.012;entryY=0.625;entryDx=0;entryDy=0;entryPerimeter=0;" target="3UPOx2UyDuRtQL01_ttE-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-45" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-42" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-44" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-42" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Ouster and Damages&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &quot;unequivocal demand&quot; to use the land and the covenant in possession refuses to accommodate them&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Damages are calculated as the fair rental value multiplied by&amp;nbsp;proportionate interest&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="220" x="4040" y="387.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-47" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-46" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-44" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Offsets&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Can offset these ouster damages&amp;nbsp;for necessary repairs and improvements&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="82.5" width="220" x="4040" y="587.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-46" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Partition&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Damages typically determined during partition&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Physical divide of land: &quot; in kind&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Monetary divided : &quot;partition by sale&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="240" x="4040" y="710" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-51" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-50" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-53" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-52" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-55" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-54" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-57" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-56" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-48" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Lease Types&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="65" width="250" x="5190" y="212.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-50" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Term of Years&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A lease for a fixed period of time with a specific, certain end date.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="65" width="250" x="4960" y="372.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-52" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Periodic Tenancy&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A lease that automatically rolls over for successive periods (e.g., month-to-month or year-to-year). Notice is required to terminate; at common law, a year-to-year lease required six months’ notice, while month-to-month requires one full month&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="5010" y="507.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-54" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Tenancy at Will&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A lease with no fixed duration that can be terminated by either party at any time. While the common law allowed termination with no notice, most modern jurisdictions now require it&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="95" width="280" x="5330" y="532.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-56" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Tenancy at Sufferance&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Created when a tenant wrongfully holds over after a valid lease expires. It lasts until the landlord either evicts the tenant or elects to hold them to another term (often converting it to a periodic tenancy if rent is accepted)&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="5440" y="327.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-58" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Possession&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Duty to deliver possession:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- even including past tenants&lt;/span&gt; &lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Squatter or holdover tenant:&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;&lt;b&gt;English Rule&lt;/b&gt;: The landlord is responsible&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;&lt;b&gt;American Rule&lt;/b&gt;: The tenant is responsible&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="5470" y="70" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-63" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-62" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-65" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-64" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-67" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-60" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-66" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-60" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Conditions and Warranties&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="280" x="5850" y="220" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-62" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Quiet Enjoyment&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;An implicit promise in every lease that the landlord will not interfere with the tenant&#39;s possession. A minor encroachment by the landlord is considered a &quot;partial eviction,&quot; which at common law excused all rent payments while the encroachment remained&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="290" x="5620" y="450" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-64" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Constructive Eviction&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Occurs when a landlord’s substantial interference (or failure to act when they have a duty to do so) renders the premises &quot;unfit for the purpose for which they were leased&quot;. To claim this, the tenant must abandon the premises within a reasonable time. Examples include failure to provide heat/water or failing to control foreseeable noise from a neighboring unit the landlord also owns (Blackett v. Olanoff)&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="320" x="5770" y="600" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-66" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Implied Warranty of Habitability&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;In the State of Charney, this applies to residential leases (Javins). It requires the landlord to maintain the premises according to local housing codes. Importantly, this warranty is generally not implied in commercial leases, where the rule of caveat lessee still dominates&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="117.5" width="320" x="6020" y="402.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-71" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-70" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-72" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-70" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-74" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-68" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="3UPOx2UyDuRtQL01_ttE-73" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="6805" y="-122.5" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-68" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Lease Transfers&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Leases are fully transferable by default, but may be restricted.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Ban on &quot;subleases&quot; does not technically prohibit &quot;assignments&quot;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="107.5" width="310" x="6500" y="-340" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-79" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="3UPOx2UyDuRtQL01_ttE-77">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-70" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Assignment:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;transfer of the entire remaining interest in the lease&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="57.5" width="300" x="6330" y="-127.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-82" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-73" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="3UPOx2UyDuRtQL01_ttE-80">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-73" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Sublease&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;less than the full remaining interest (the original tenant retains a reversion, even if only for one day). The subtenant deals with the &quot;prime tenant&quot; (who acts as a sub-landlord), not the original landlord.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="107.5" width="310" x="6660" y="-152.5" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-78" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-77" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-81" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-75" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="3UPOx2UyDuRtQL01_ttE-80" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-75" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Privity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Source of obligation&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Privity of Contract:&amp;nbsp;Derived from the bilateral contract itself&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Privity of Estate:&amp;nbsp;&quot;touch and concern&quot; the land&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="6010" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-77" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Assignment &amp;amp; Privity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Privity of estate&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="125" x="6440" y="-20" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-80" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Sublease &amp;amp;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;Privity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;no privity of estate or contract&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="180" x="6670" y="30" as="geometry" />
        </mxCell>
        <mxCell id="-ida4aKDG8hj1l_bAbe2-2" edge="1" parent="1" source="3UPOx2UyDuRtQL01_ttE-83" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="-ida4aKDG8hj1l_bAbe2-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3UPOx2UyDuRtQL01_ttE-83" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Tenant Breach&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Three options:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;Do nothing - then sue for rent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Re-let for the tenant’s benefit - look for new party&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;Accept the surrender&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="320" x="5810" y="-410" as="geometry" />
        </mxCell>
        <mxCell id="-ida4aKDG8hj1l_bAbe2-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Duty to&amp;nbsp;mitigate&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;residential tenants - Yes&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;commercial tenants - No&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="320" x="5760" y="-570" as="geometry" />
        </mxCell>
        <mxCell id="-ida4aKDG8hj1l_bAbe2-6" edge="1" parent="1" source="-ida4aKDG8hj1l_bAbe2-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="-ida4aKDG8hj1l_bAbe2-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="-ida4aKDG8hj1l_bAbe2-7" connectable="0" parent="-ida4aKDG8hj1l_bAbe2-6" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Solution" vertex="1">
          <mxGeometry relative="1" x="-0.0383" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="-ida4aKDG8hj1l_bAbe2-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Nemo Dat&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&quot;one cannot give that which one does not have&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;first in time, first in right&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Issue:&amp;nbsp;&amp;nbsp;&quot;market for lemons&quot; where buyers discount the price they are willing to pay because they cannot be certain of the seller&#39;s title&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="7180" y="237.5" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-12" edge="1" parent="1" source="-ida4aKDG8hj1l_bAbe2-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-14" edge="1" parent="1" source="-ida4aKDG8hj1l_bAbe2-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-16" edge="1" parent="1" source="-ida4aKDG8hj1l_bAbe2-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-19" edge="1" parent="1" source="-ida4aKDG8hj1l_bAbe2-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="-ida4aKDG8hj1l_bAbe2-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Recording Acts&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;to provide conditions where a later purchaser can deviate from this baseline and prevail over an earlier one&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;are statutes that allow a subsequent purchaser to &quot;beat&quot; an earlier one, provided they are a Good Faith Purchaser for Value (GFPV)&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="7040" y="540" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Void vs. Voidable Title&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Void Title :&amp;nbsp;Theft and Fraud in the Factum, fraud includes document misrepresentation&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Voidable Title:&amp;nbsp;Fraud in the Inducement:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;voluntarily transfers title&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="7410" y="430" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Equitable Conversion&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;risk of loss between the execution of a real estate contract and the actual &quot;closing&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Default Rule:&amp;nbsp;the buyer is holder of equitable title, thus bears risk of loss.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Risk Allocation:&amp;nbsp;buyer bears the risk of loss if the property is damaged and enjoys the benefit if it increases in value during this &quot;gap&quot; period&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Death of a Party: If a seller dies after signing the contract but before closing, the property is treated as personal property (the right to the money)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;is default rule in the State of Charney, but parties can contractually agree to different terms&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="350" x="7870" y="437.5" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-8" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-10" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Security Interests: Mortgages&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A security interest is a relationship between a debt and an asset (collateral) that gives a lender specific rights if the borrower defaults.&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="7990" y="-45" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Two Key Documents&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Promissory Note: The buyer’s personal promise to repay the loan&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Mortgage: The document granting the lender a lien on the real property as collateral&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="7700" y="177.5" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Two Primary Rights of the Lender&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Property Right: The right to take and sell the asset to satisfy the debt upon default (foreclosure)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Priority Right: Determines the lender&#39;s place in the &quot;repayment queue&quot; if the borrower goes bankrupt&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Equity of Redemption allows a borrower to discharge the security interest and keep their home if they pay the full debt at any time prior to foreclosure: non-waivable&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="165" width="340" x="8070" y="215" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Race Statute:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;The person who records their deed first wins, regardless of whether they knew about an earlier unrecorded sale. These are rare&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="210" x="6730" y="800" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Notice Statute&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;A subsequent purchaser wins if they had no notice (actual, record, or inquiry) of the prior sale at the time they paid value. They do not necessarily have to record first to win, though it is encouraged&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="6960" y="840" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Race-Notice Statute&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;subsequent purchaser wins only if they both had no notice and won the race to record&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="180" x="7200" y="860" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;The Shelter Rule:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Once a GFPV has successfully beaten an earlier claimant under a recording act, they can transfer that &quot;winning&quot; title to anyone else (even someone with notice or a gift recipient), who will then also beat the earlier claimant&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="260" x="7430" y="730" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-23" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-25" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-27" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-29" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Easements&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;a property right that acts as a waiver of the owner’s right to exclude. It gives the holder a non-exclusive right to use the property of another (the servient estate) for a specified purpose&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;does not grant exclusive possession&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="8980" y="237.5" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Appurtenant&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Belongs&quot; to a specific parcel of land (the dominant tract); it runs with the land, benefiting the dominant tract and burdening the servient tract regardless of ownership&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="8585" y="507.5" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;In Gross&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Belongs to a particular grantee (e.g., a utility company) rather than a parcel of land. In the U.S., commercial easements in gross are fully alienable&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="230" x="8870" y="680" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-26" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Affirmative vs. Negative&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Affirmative easements allow the holder to do something on the servient land (e.g., cross a driveway). Negative easements allow the holder to prevent the servient owner from doing something (e.g., blocking a view); these are narrow and rare&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="9150" y="560" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-28" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Creation &amp;amp; Termination&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Creation: grant (deed), reservation, necessity (landlocked parcels), implication (prior use), prescription (similar to adverse possession), or estoppel (irrevocable license)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Termination:&amp;nbsp;Ends via deed, merger (one person owns both tracts), adverse possession, or abandonment&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="9390" y="327.5" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-33" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-32" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-35" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-34" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-30" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Covenants&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Covenants are &quot;promises respecting the use of land&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Whether a covenant &quot;runs with the land&quot;&amp;nbsp;depends on the theory of enforcement used:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="9740" y="-250" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-32" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Real Covenant Theory&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Used when the plaintiff seeks money damages&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Requirements for the BURDEN to run: 1. Horizontal privity (original parties had a simultaneous interest or the covenant was in the deed), 2. Strict vertical privity (successor holds the entire interest), 3. Intent, and 4. Touch and Concern (the promise relates to the land)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Requirements for the BENEFIT to run: Requires intent, touch and concern, and relaxed vertical privity (no horizontal privity required)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="205" width="350" x="9420" y="-15" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-34" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Equitable Servitude Theory&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Used when the plaintiff seeks an injunction&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Requirements: Intent, touch and concern, and notice to the burdened party. Privity is NOT required for an equitable servitude&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="9810" y="-15" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-39" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-36" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-38" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-36" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Reciprocal Negative Easements&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;arises when a common owner sells lots in a development scheme&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Principle: If a developer sells one lot with a restriction (like &quot;residential use only&quot;) that benefits the retained land, the restriction becomes mutual. The developer (and later purchasers of retained lots with notice) cannot do anything forbidden to the first purchaser&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="340" x="9140" y="-530" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-38" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Limitations&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;It requires a common owner and a common development plan. It is not retroactive; it does not apply to lots sold before the restriction was established&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="340" x="9020" y="-770" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-43" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-45" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-40" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-44" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-40" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Zoning:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Zoning is a comprehensive system of land-use regulation where the state delegates its &quot;police power&quot; to local governments&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="8800" y="-300" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-42" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Police Power&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The inherent sovereign power to make laws to preserve public security, health, order, and morality&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="8800" y="-120" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-47" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-44" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-46" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-44" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Euclidean Zoning&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A system of cumulative zoning that establishes a hierarchy of uses. &quot;Higher&quot; uses (like homes) are permitted in &quot;lower&quot; zones (like industrial), but not vice versa&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="8440" y="-300" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-46" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Exceptions&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Variances: Discretionary deviations granted for undue hardship.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Special Exceptions: Nondiscretionary deviations allowed if specific conditions in the ordinance are met.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Nonconforming Uses: Pre-existing uses that are &quot;grandfathered&quot; in&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="320" x="8390" y="-510" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-51" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-50" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-53" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-52" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-55" edge="1" parent="1" source="13QLrLIOA4XkUV_-EPCf-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="13QLrLIOA4XkUV_-EPCf-54" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-48" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Eminent Domain&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The government has the sovereign power to take private property for public use, provided it pays just compensation&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="9590" y="-550" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-50" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Public use&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The U.S. Supreme Court construes this broadly to mean &quot;public advantage or benefit&quot;. While controversial, this can include economic development aimed at job preservation&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="9680" y="-750" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-52" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Fair Market Value (FMV)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;would be worth in a voluntary sale at the time of the taking&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;based on the &quot;highest and best use&quot; excludes government additions&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;does not compensate for the owner’s subjective attachment&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="290" x="10030" y="-570" as="geometry" />
        </mxCell>
        <mxCell id="13QLrLIOA4XkUV_-EPCf-54" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Regulatory Takings?&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="290" x="9690" y="-410" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mOb7QFiskIuLxn66i-ot" name="Rules redone">
    <mxGraphModel dx="-2400" dy="4956" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Cu2xMsc4gobcbpk_UVLG-10" edge="1" parent="1" source="Cu2xMsc4gobcbpk_UVLG-7" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Cu2xMsc4gobcbpk_UVLG-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Cu2xMsc4gobcbpk_UVLG-12" edge="1" parent="1" source="Cu2xMsc4gobcbpk_UVLG-7" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Cu2xMsc4gobcbpk_UVLG-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Cu2xMsc4gobcbpk_UVLG-14" edge="1" parent="1" source="Cu2xMsc4gobcbpk_UVLG-7" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Cu2xMsc4gobcbpk_UVLG-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Cu2xMsc4gobcbpk_UVLG-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Life Estate Waste&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Brokaw v. Fairchild&amp;nbsp;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp;A life tenant may NOT use land in a manner that causes permanent injury to the inheritance&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;passes to remaindermen as nearly as practicable unimpaired in its nature, character, and improvements.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="260" x="8810" y="2450" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Abandoned Property&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Haslem v. Lockwood&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;General Rule&lt;/b&gt;: Possession exists only as long as you retain actual possession OR remove it to another place. Leaving it where it was = losing your claim.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Exception (the Haslem rule):&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(1) Occupy unowned/abandoned property, AND&lt;br/&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) &lt;/span&gt;Add value through labor and expense, THEN&lt;br/&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3) &lt;/span&gt;You do not lose title by leaving it temporarily to procure means&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;of removal, so long as you return within a reasonable time&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="400" x="5900" y="-1878.12" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-4" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-9" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-5" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-9" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-6" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-9" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-7" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-9" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-26" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-8" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-9" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-65" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Intentional Trespass&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The willful, (1) unauthorized entry onto another person&#39;s real property, (2) causing an invasion of their possessory interest.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Clean hands&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="8710" y="-1590" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Punitive&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;damages&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Jacque v. Sternberg&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) nominal damages can support punitive damages for&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) intentional trespass&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) because society values the right to exclude regardless of physical or economic harm&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) &amp;nbsp;only awarding nominal damages would incentivize &quot;self-help&quot; building walls, guns, to keep others out, and society wants to avoid that. &amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="390" x="9150" y="-1740" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Ad Coelum Airspace&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Hinman&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;In Hinman,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &amp;nbsp; rejected a literal reading of the ad coelum doctrine,&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) &amp;nbsp;a landowner owns only as much airspace as they use and occupy .&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Overflight is not a trespass unless it causes actual and substantial interference with that use.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;JJ: applying ad coelum literally would open the door to endless litigation any time a plane crossed over private property, an outcome both impractical and contrary to the doctrine&#39;s original purpose.&quot;&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="330" x="8840" y="-1380" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-12" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-13" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Private Nuisance&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A person’s property use &lt;b&gt;unreasonably and substantially&lt;/b&gt; interferes with a neighbor’s right to use and enjoy their own land&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="10270" y="-1730" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Unreasonable&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Hendriks v. Stalnaker&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The court balances the social utility of the competing uses.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;If Equal&lt;/b&gt;: &amp;nbsp;- claim fails&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;However, spite&lt;/b&gt;:&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;spite with no legitimate benefit to  himself, as that could tip the&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;unreasonableness finding&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="350" x="10580" y="-1520" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-15" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-19" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-16" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-19" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-17" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-19" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-18" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-19" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;injunction&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A plaintiff may seek an injunctive relief for trespass when&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the legal remedy of monetary damages is inadequate&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Threat of irreparable harm &amp;nbsp;i.e. (non-fungible)&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Threat of repeated trespass&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;Damages intangible and incapable of measurement&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="330" x="8780" y="-1780" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Irreparable harm (non-fungible)&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Pardee v. Camden Lumber Co.&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Under Pardee, a plaintiff may seek an injunctive relief for trespass when (1) the legal remedy of monetary damages is inadequate i.e. non-fungible&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;JJ: if the court refuses to force an injunction against party may resort to self help to protect non-fungible goods.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="320" x="8600" y="-2020" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-21" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-22" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-23" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Threat of Repeated&amp;nbsp;trespass/ Intangible damages&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Baker v. Howard County Hunt&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Threat of repeated trespass&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;Damages intangible and incapable of measurement&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="320" x="8980" y="-2010" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Dog&#39;s&amp;nbsp;&lt;br&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Reputable dog gets one freebie; pack of hounds does not&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="320" x="9070" y="-2200" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-24" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-26" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-27" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-25" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-26" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-28" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-26" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Encroachment&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;an unauthorized physical intrusion by a property owner onto a neighbor’s land, such as a fence, driveway, or tree branches.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="8340" y="-1670" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-27" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Absolute right to removal&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Pile v. Pedrick&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The plaintiff has an unqualified right to removal regardless of cost or hardship&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="270" x="7960" y="-1820" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-28" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Equity&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;exemption&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Golden Press, Inc. v. Rylands&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) The encroachment is unintentional (and non-negligent)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The encroachment is slight&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) The plaintiff&#39;s use is not affected&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) damages are small and fairly compensable in money&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5) The cost of removal is so great as to cause grave hardship or make removal unconscionable&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="360" x="7930" y="-1600" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-29" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-35" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-30" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-37" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDtN5-gdxOVuKQ8rQCBY-64" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-33" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="Oa994hctVbpJbJxt5RuI-38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDtN5-gdxOVuKQ8rQCBY-67" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-33" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="Oa994hctVbpJbJxt5RuI-44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-33" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Principle of Accession&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;O&lt;i&gt;wnership of one thing is assigned to owner of another&amp;nbsp;&lt;/i&gt;&lt;i&gt;“thing”&lt;/i&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Crops and vegetation -&amp;nbsp;&lt;i&gt;Perennial vs. Annual vegetation&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Ad coelum (caves) - you own every cave, even if not accessible&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Combinations - good faith transformation of objects&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Fixtures - permanency of the annexation or inferable use of real property &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Accretion -&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Avulsion - not tech nicely accession&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="410" x="12620" y="-1700" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-34" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=light-dark(#000000,#00FF00);" target="Oa994hctVbpJbJxt5RuI-36" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-35" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Crops and Vegetation&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Perennial vegetation (&lt;i&gt;fructus naturales&lt;/i&gt;) → rejuvenates from year to year without replanting → deemed to belong to the &lt;u&gt;owner&lt;/u&gt; of the soil on which it grows&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Annual vegetation (fructus industriales) → must be replanted on an annual or other periodic basis → deemed to belong to the party in &lt;u&gt;possession&lt;/u&gt; of the soil on which it grows&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="370" x="12500" y="-1990" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-36" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Extra Doctrines&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;b&gt;Doctrine of emblements:&lt;/b&gt;&amp;nbsp;protects tenant farmers when lease is “tenancy at will”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Doctrine of increase&lt;/b&gt;: Offspring of domestic animal belongs to owner of the mother&lt;br&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="12350" y="-2270" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-37" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Ad coelum (Caves)&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Edwards v. Sims&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Ad coelum applies to caves, regardless of the location of the entrance(s)&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="280" x="12080" y="-1590" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-38" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Doctrine of&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Accession&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Wetherbee v. Green&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;if D takes P’s &lt;u&gt;tangible personal property&lt;/u&gt; and makes something new, D may be permitted to keep the new item and compensate P for the pre-improvement value of the property D took&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &lt;b&gt;Good faith&lt;/b&gt; (that is, D must show s/he made an honest mistake in taking P’s property&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;&lt;b&gt;Fundamental transformation&lt;/b&gt;, which is satisfied by EITHER&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a) Change of species/chemical transformation&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;or &lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b) &lt;/span&gt;&lt;/span&gt;A significant increase in value&amp;nbsp;(Weatehrbee)(2x value typically)&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;+ some physical transformation&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="220" width="430" x="12130" y="-1420" as="geometry" />
        </mxCell>
