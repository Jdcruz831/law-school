          <mxGeometry height="70" width="240" x="9160" y="2370" as="geometry" />
        </mxCell>
        <mxCell id="Cu2xMsc4gobcbpk_UVLG-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Passive/Permissive Waste&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Unreasonable failure to act causing damage&lt;br&gt;&lt;/p&gt;" vertex="1">
