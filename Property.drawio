        <mxCell id="8odRuSoYHQrNrBwNU2-b-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;gradientColor=none;strokeColor=light-dark(#000000,#66B2FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Fair Housing Act-- § 3604&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Protected categories&lt;/i&gt;:&amp;nbsp;Race, color, religion, sex, familial status, or national origin&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Duties&lt;/i&gt;:&amp;nbsp;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(a) Availability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(b) Terms and conditions&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(c) Advertising&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(d) Lying about availability&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(e) [“blockbusting”]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(f) Availability and terms and conditions&lt;/p&gt;&lt;/blockquote&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
