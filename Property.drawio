        <mxCell id="hG0AK3BNLwp5SH-vvWAi-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#66B2FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Future Interests&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. Reversion&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. Possiblity of reverter&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. Right of entry (power of termination)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. Remainder&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;5. Executory Interest&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="250" x="8900" y="970" as="geometry" />
        </mxCell>
        <mxCell id="hG0AK3BNLwp5SH-vvWAi-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Grantors&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. &lt;b&gt;Reversion&lt;/b&gt; - reverts back after life estate&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. &lt;b&gt;Possibility of reverter &lt;/b&gt;- automatic interest after determinable happens&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. &lt;b&gt;Right of entry (power of termination)&lt;/b&gt; - nonautomatic interest after determinable happens&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="510" x="8520" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="hG0AK3BNLwp5SH-vvWAi-7" edge="1" parent="1" source="hG0AK3BNLwp5SH-vvWAi-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="hG0AK3BNLwp5SH-vvWAi-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hG0AK3BNLwp5SH-vvWAi-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Grantees&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4.&lt;b&gt; Remainder&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;5. &lt;b&gt;Executory Interest&lt;/b&gt; - failed conditional intrest&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="9170" y="1147.97" as="geometry" />
        </mxCell>
        <mxCell id="hG0AK3BNLwp5SH-vvWAi-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Remainder&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. Remainder&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border: medium; padding: 0px;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;a.&amp;nbsp;&lt;b&gt;Indefeasibly vested &lt;/b&gt;- nothing else is needed besides the&amp;nbsp;natural termination of the preceding interest&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;b.&amp;nbsp;&lt;b&gt;Contingent&lt;/b&gt; - additional conditional on top of&amp;nbsp;termination of the preceding interest (still has a reversion is conditional not met) (person may take possession after life estate, but may be stripped if conditional not met)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;c.&amp;nbsp;&lt;b&gt;Vested subject to complete divestment -&lt;/b&gt;&amp;nbsp;like the contingent, but with third party remainder if conditional is not met (no possibility of reversion)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;d.&amp;nbsp;&lt;b&gt;Vested subject to partial divestment (or subject to open) -&lt;/b&gt; complete fee but open to possibly more partial divestment (aka more kids being born)&amp;nbsp;&lt;/p&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="190" width="480" x="9220" y="1290" as="geometry" />
        </mxCell>
        <mxCell id="cM22u7yP_w4kU0iDP5lB-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;gradientColor=none;strokeColor=light-dark(#000000,#FFFFFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;If Successful&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Take the current possessors&#39;s rights.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- if life estate then take life estate and when original owner dies, timer starts anew&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="94.06" width="370" x="5420" y="1135.94" as="geometry" />
        </mxCell>
