        <mxCell id="kOK5TxT01gIIPjXd8n4C-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Facts&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;This case involves master recordings made by musician &quot;Professor Longhair&quot; in the 1970s&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Bearsville Records (the defendant&#39;s predecessor) had physical custody of the tapes since the 1970s&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;In 1986, Bearsville licensed the recordings to another company, resulting in a 1987 album release&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;In 1995, Songbyrd (the musician&#39;s successor) sued for monetary damages and a declaration of rights, alleging conversion&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Under New York law, the three-year statute of limitations for conversion begins to run at the time the conversion occurs, even if the owner is unaware of it&lt;/p&gt;" vertex="1">
          <mxGeometry height="215" width="600" x="10070" y="195" as="geometry" />
        </mxCell>
