          <mxGeometry height="110" width="230" x="1210" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="_CKNJFoMzXsLgvQAXU5i-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;CA exception:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) negative easement on SF bay View&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="230" x="980" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="_CKNJFoMzXsLgvQAXU5i-21" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Spite fence:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Fontainebleau&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) A structure built solely out of spite with &lt;b&gt;zero useful purpose can be enjoined&lt;/b&gt; (2)&amp;nbsp;if it serves any &lt;b&gt;useful/beneficial purpose&lt;/b&gt; — even mixed motive — &lt;b&gt;no injunction&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="230" x="1230" y="1410" as="geometry" />
        </mxCell>
        <mxCell id="_CKNJFoMzXsLgvQAXU5i-26" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Conservation Easements&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;(allowed by statues)&lt;/i&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) they restrict the land owner from developing their land, and the enforcement right goes to a charity or government (not a neighboring landowner)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="230" x="730" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="_CKNJFoMzXsLgvQAXU5i-28" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Termination&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] Termination — four methods:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[2] Release by deed from holder to servient owner&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3] Merger — dominant and servient tracts come under common ownership&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[4] Adverse possession of the servient estate&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[5] Abandonment — requires affirmative act of intent to abandon; mere non-use alone is never enough&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="440" x="190" y="1730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Covenants " id="0Pt_cAZ4d8PciAckIUe_">
    <mxGraphModel dx="-2544" dy="1966" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="b_5Vyli1u-a0vprJ2jxQ-0" />
        <mxCell id="b_5Vyli1u-a0vprJ2jxQ-1" parent="b_5Vyli1u-a0vprJ2jxQ-0" />
        <mxCell id="wbMthrpyru6KVFuQDRWG-0" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;COVENANTS&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Promises respecting the use of land. [Statute of Frauds — must be in writing]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;If A sues B (original parties only):&lt;/b&gt; treat as ordinary contract — NO running analysis needed.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;If either party is a SUCCESSOR:&lt;/b&gt; must analyze whether covenant runs with the land.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Relief sought determines which theory applies:&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="420" x="5100" y="-100" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-1" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-3" value="$$ Money Damages">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-2" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-14" value="Injunction">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-3" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;REAL COVENANT THEORY ($$$)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Used when plaintiff seeks MONEY DAMAGES.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Different requirements for BURDEN vs. BENEFIT to run.&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="360" x="4510" y="200" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-4" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-6" value="BURDEN runs?">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-5" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-7" value="BENEFIT runs?">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-6" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;BURDEN to Run — Real Covenant&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4 Requirements:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. &lt;b&gt;Horizontal Privity&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. &lt;b&gt;Strict Vertical Privity&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. &lt;b&gt;Intent&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;4. &lt;b&gt;Touch and Concern&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;NOTE: Notice is NOT a requirement under real covenant theory.&lt;/p&gt;" vertex="1">
          <mxGeometry height="185" width="320" x="4370" y="420" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-7" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;BENEFIT to Run — Real Covenant&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3 Requirements (easier than burden):&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. &lt;b&gt;Relaxed Vertical Privity&lt;/b&gt; (no horiz. privity needed)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. &lt;b&gt;Intent&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. &lt;b&gt;Touch and Concern&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="145" width="320" x="4730" y="420" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-8" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-9" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Horizontal Privity&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Relationship between ORIGINAL parties to the covenant. Two ways to satisfy:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;(1) Mutual Privity:&lt;/b&gt; Parties had simultaneous interests in the same land (e.g., landlord &amp;amp; tenant).&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;(2) Instantaneous Privity:&lt;/b&gt; Covenant included in a deed from one party to the other (developer → buyer).&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Simple contract between neighbors does NOT satisfy — even if recorded.&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="300" x="4330" y="730" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-10" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-11" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Strict Vertical Privity&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Successor must hold the ENTIRE interest of the original covenanter (same duration).&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;FSA → FSA: ✓&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;FSA → Life Estate: ✗ (shorter duration)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Prime Lease → Assignment: ✓&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Prime Lease → Sublease: ✗ (ends before prime lease)&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="290" x="4670" y="730" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-12" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-13" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Touch and Concern&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Covenant must substantially affect the owner&#39;s legal interest in the land.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Almost always ✓:&lt;/b&gt; any promise NOT to do something on the land (build, operate commercially, subdivide, etc.).&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Affirmative/pay covenants ✓ if:&lt;/b&gt; money dedicated to maintenance/repair/improvement of land. [Charney Rule: assume met if upkeep of land.]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Does NOT T&amp;amp;C ✗:&lt;/b&gt; pay money with no restriction on use; charitable donation with no land nexus.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Analysis is IDENTICAL under both real covenant and equitable servitude theory.&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="320" x="5000" y="730" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-14" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;EQUITABLE SERVITUDE THEORY&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Used when plaintiff seeks an INJUNCTION.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;PRIVITY IS NOT REQUIRED — easier to satisfy than real covenant.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Different requirements for BURDEN vs. BENEFIT to run.&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="5660" y="200" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-15" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-17" value="BURDEN runs?">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-16" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" target="wbMthrpyru6KVFuQDRWG-18" value="BENEFIT runs?">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-17" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;BURDEN to Run — Equitable Servitude&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3 Requirements:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. &lt;b&gt;Notice&lt;/b&gt; (actual, constructive, or inquiry)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. &lt;b&gt;Intent&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;3. &lt;b&gt;Touch and Concern&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;No privity required.&lt;/p&gt;" vertex="1">
          <mxGeometry height="165" width="320" x="5510" y="440" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-18" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;BENEFIT to Run — Equitable Servitude&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2 Requirements:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;1. &lt;b&gt;Intent&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;2. &lt;b&gt;Touch and Concern&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;No notice needed for beneficiary. No privity needed.&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="300" x="5880" y="440" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-19" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="wbMthrpyru6KVFuQDRWG-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-20" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Notice — 3 Types&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Actual:&lt;/b&gt; Successor literally knew of the covenant.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Constructive (Record):&lt;/b&gt; Covenant was recorded — successor is deemed to know what a title search would reveal.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Inquiry:&lt;/b&gt; Facts on the ground would prompt a reasonable buyer to investigate further (uniform neighborhood character, tenant in possession, etc.).&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Key timing rule:&lt;/b&gt; Notice is assessed at the moment title passes — not when breach is contemplated.&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="340" x="5490" y="730" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-21" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#82b366;" target="wbMthrpyru6KVFuQDRWG-22" value="Key Case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-22" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Tulk v. Moxhay&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; Tulk sold Leicester Square garden to Elms with a covenant to maintain it and build no houses. Land passed to Moxhay, whose deed lacked the covenant — but he knew of it. Moxhay wanted to build on the garden.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; Injunction granted. A successor who purchases with NOTICE of a restrictive covenant is bound by it — it would be inequitable to let him buy encumbered land at a lower price and then ignore the restriction.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; Where a successor has notice, and the covenant was intended to run and touches and concerns the land, equity will enforce it — foundational equitable servitude case.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Exam use:&lt;/b&gt; Cited for touch and concern (negative/use restriction) and the rationale for binding successors with notice. Also supports intent — lower price paid implies covenant was known and priced in.&lt;/p&gt;" vertex="1">
          <mxGeometry height="290" width="340" x="5830" y="690" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-23" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;" target="wbMthrpyru6KVFuQDRWG-24" value="Key Case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-24" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Neponsit Property Owners&#39; Assoc. v. Emigrant Industrial Savings Bank&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; Developer subdivided land. Deeds contained covenant requiring buyers and successors to pay annual HOA fee to maintain roads, parks, sewers (common areas over which owners had easements appurtenant). Emigrant bought at judicial sale, refused to pay fee.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; Covenant runs. Touch and concern ✓ — covenant to pay money for maintenance of land over which owner has easements appurtenant substantially affects ownership interests. HOA has standing (privity satisfied &quot;in substance if not in form&quot;).&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; Affirmative covenant to pay money touches and concerns the land if the money is dedicated to the upkeep of land in which the payer has a property interest (easement appurtenant). [Charney: assume T&amp;amp;C met if money goes to land upkeep.]&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Note:&lt;/b&gt; Horizontal privity ✓ (instantaneous — covenant in deed). Distinguishable from Mullendore (no land-use restriction on money).&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="350" x="5100" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-25" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;" target="wbMthrpyru6KVFuQDRWG-26" value="Contrast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-26" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Eagle Enterprises, Inc. v. Gross&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; Developer sold property with covenant requiring buyer and successors to purchase water seasonally from developer&#39;s well for $35/year. Covenant said it &quot;runs with the land.&quot; Gross (successor) dug his own well and refused to pay. Eagle (successor to developer) sued for money damages.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; Covenant does NOT run. Touch and concern ✗ — where a property owner gets his water does not substantially affect his ownership rights in the land itself. Saying &quot;runs with the land&quot; in a deed is not enough; must meet legal requirements.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; A covenant touches and concerns the land only if it &lt;i&gt;substantially affects&lt;/i&gt; the owner&#39;s legal interest in the property. Also: no sunset clause weighed against T&amp;amp;C.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Exam use:&lt;/b&gt; Main T&amp;amp;C failure example. Note horiz. privity (instantaneous — covenant in deed) and strict vert. privity were both met — failed only on T&amp;amp;C.&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="350" x="4715" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-27" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;" target="wbMthrpyru6KVFuQDRWG-28" value="Contrast">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-28" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Mullendore Theatres v. Growth Realty Investors&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; A covenant runs with the land only if it touches and concerns the land.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A promise to pay money that places NO restriction on how that money is used does NOT touch and concern the land.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Exam use:&lt;/b&gt; Key contrast to Neponsit. Neponsit ✓ because money was tied to land upkeep. Mullendore ✗ because no restriction on how money was used — no land nexus.&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="320" x="4350" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-29" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-38" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#d6b656;" target="wbMthrpyru6KVFuQDRWG-30" value="Key Case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-30" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Sanborn v. McLean&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; McLaughlins sold lots in 1892–93 with restrictions to residential use. McLeans bought their lot in 1910–11 through a chain tracing back to McLaughlins — their deed had NO restriction. McLeans tried to build a gas station. Neighbors (Sanborn) sought injunction.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; Injunction granted. Reciprocal negative easement applies. When a common owner sells one lot with a restriction that benefits retained lots, the restriction becomes mutual — it applies to all retained lots too, even without explicit language in their deeds.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Notice:&lt;/b&gt; McLeans had inquiry notice — uniform residential neighborhood + chain of title traced to common grantor. Should have searched other deeds.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule (State of Charney):&lt;/b&gt; Lots dedicated to the same use (all residential, all retail) are &quot;so situated as to bear the relation.&quot; Must start with common owner; cannot arise retroactively.&lt;/p&gt;" vertex="1">
          <mxGeometry height="310" width="350" x="6380" y="700" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-31" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#6c8ebf;" target="wbMthrpyru6KVFuQDRWG-32" value="Key Case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-32" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bolotin v. Rindge&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; Residential deed restriction challenged on grounds that allowing a commercial building would not depreciate market value of neighboring properties.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; Restriction enforceable. Lack of adverse market value impact is NOT the test for unenforceability. A court may declare restrictions unenforceable due to changed conditions only if enforcement would be &lt;i&gt;inequitable and oppressive&lt;/i&gt; and would harass the plaintiff without benefiting adjoining owners.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; Changed conditions defense requires that the restriction&#39;s original purpose is obsolete AND enforcement would harass burdened party without benefiting neighbors. High bar. Touch and concern ✓ for residential use restrictions.&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="330" x="6270" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-33" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#6c8ebf;" target="wbMthrpyru6KVFuQDRWG-34" value="Key Case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-34" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Peckham v. Milroy&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; Spokane Terrace Addition covenant prohibited home businesses. ~4 businesses violated it out of ~1600 lots. Milroy&#39;s family operated a daycare. Peckham sued to enjoin it.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; Injunction granted. Covenant enforceable. A few violations do not constitute abandonment. Also: no laches (Peckham didn&#39;t unreasonably delay), no estoppel.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; Abandonment requires &lt;i&gt;habitual and substantial&lt;/i&gt; violations — not just a few isolated ones. Touch and concern ✓ for restriction on use of land (home business ban). Residential covenants generally enforceable.&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="330" x="5910" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-35" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#6c8ebf;" target="wbMthrpyru6KVFuQDRWG-36" value="Key Case">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-36" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Shelley v. Kraemer&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts:&lt;/b&gt; Neighborhood had covenant restricting occupancy to white residents. Shelleys (Black family) purchased a home. Kraemer sued to enforce the covenant and divest title.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Holding:&lt;/b&gt; State court enforcement of a racially restrictive covenant = state action = violates Equal Protection Clause of 14th Amendment. Injunction reversed.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule:&lt;/b&gt; Private parties may voluntarily abide by racially restrictive covenants (14th Am. doesn&#39;t reach purely private conduct). But a court using the &quot;full coercive power of government&quot; to enforce such a covenant IS state action and violates Equal Protection. Racially restrictive covenants are unenforceable.&lt;/p&gt;" vertex="1">
          <mxGeometry height="270" width="330" x="5410" y="1490" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-37" edge="1" parent="b_5Vyli1u-a0vprJ2jxQ-1" source="wbMthrpyru6KVFuQDRWG-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;dashed=1;" target="wbMthrpyru6KVFuQDRWG-38" value="Special Doctrine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-38" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Reciprocal Negative Easements (Implied Covenants)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;When it arises:&lt;/b&gt; Common owner sells one lot with a restriction that benefits retained lots → restriction becomes MUTUAL and applies to all retained lots, even without explicit language in their deeds.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Charney Rule:&lt;/b&gt; Lots dedicated to same purpose (all residential, all retail) are &quot;so situated as to bear the relation.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Must start with a common owner&lt;/b&gt; — cannot arise retroactively or from neighbors conforming to a plan without common grantor.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Can ONLY be enforced as equitable servitude&lt;/b&gt; — no explicit covenant in successor&#39;s chain of title, so real covenant theory unavailable.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Burden still must run:&lt;/b&gt; Intent ✓ + Touch &amp;amp; Concern ✓ + Notice (often inquiry notice from neighborhood character).&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="360" x="6270" y="140" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-39" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Defenses / Limits on Enforcement&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Changed Conditions (Bolotin):&lt;/b&gt; Covenant unenforceable if neighborhood changed so fundamentally that restriction is obsolete AND enforcement would harass burdened owner without benefiting neighbors.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Abandonment (Peckham):&lt;/b&gt; Covenant abandoned only if &lt;i&gt;habitually and substantially&lt;/i&gt; violated — a few violations are not enough.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Unconstitutional (Shelley):&lt;/b&gt; State court enforcement of racially restrictive covenants = Equal Protection violation.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;No T&amp;amp;C (Eagle/Mullendore):&lt;/b&gt; Covenant doesn&#39;t touch and concern → will not run at all.&lt;/p&gt;" vertex="1">
          <mxGeometry height="255" width="360" x="5630" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="wbMthrpyru6KVFuQDRWG-40" parent="b_5Vyli1u-a0vprJ2jxQ-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;p style=&quot;text-align:center;margin:4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Quick Comparison — All Four Combinations&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:11px;&quot;&gt;&lt;tr style=&quot;background:#ddd;&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Element&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;RC Burden&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;RC Benefit&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;ES Burden&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:3px;&quot;&gt;ES Benefit&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Horiz. Privity&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓ REQ&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Vert. Privity&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;STRICT&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;RELAXED&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Intent&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Touch &amp;amp; Concern&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;&quot;&gt;Notice&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✓ REQ&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:3px;text-align:center;&quot;&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="220" width="480" x="5070" y="1820" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="TPbPcXyben1WQ1fSv4if" name="Estates">
    <mxGraphModel dx="2250" dy="2780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="HUB" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#66B2FF);" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Estates&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;&lt;b&gt;Fee Simple Absolute&lt;/b&gt; — infinite; no future interest&lt;br&gt;&lt;b&gt;Life Estate&lt;/b&gt; — ends at death; always needs a future interest&lt;br&gt;&lt;b&gt;Fee Simple Determinable&lt;/b&gt; — ends automatically on event&lt;br&gt;&lt;b&gt;Fee Simple Subject to Condition Subsequent&lt;/b&gt; — does not end automatically&lt;br&gt;&lt;b&gt;Fee Simple Subject to Executory Limitation&lt;/b&gt; — ends automatically; future interest to third party&lt;br&gt;&lt;br&gt;Rule: What O grants + what O retains must = FSA (conservation of estates)&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="560" x="1800" y="200" as="geometry" />
        </mxCell>
        <mxCell id="e-fsa" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#00FF00);" target="FSA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FSA" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Fee Simple Absolute&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Words: &quot;to A&quot; or &quot;to A and her heirs&quot;&lt;br&gt;— Infinite duration&lt;br&gt;— No future interest possible&lt;br&gt;— All other estates are carved from this&lt;br&gt;&lt;br&gt;&lt;b&gt;Future Interest: NONE&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="300" x="900" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e-le" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.28;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#3399FF);" target="LE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LE" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Life Estate&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Words: &quot;for life&quot; (or pur autre vie — &quot;for the life of X&quot;)&lt;br&gt;— Ends at death of named person&lt;br&gt;— Subject to waste doctrine (Brokaw)&lt;br&gt;— Must always be followed by a future interest&lt;br&gt;— Two options: Reversion (grantor) or Remainder (grantee)&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="360" x="1270" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e-le-waste" edge="1" parent="1" source="LE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="WASTE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WASTE" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Waste Doctrine&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:0;&quot;&gt;&lt;i&gt;Brokaw v. Fairchild&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;&lt;b&gt;Affirmative:&lt;/b&gt; active acts causing excess damage&lt;br&gt;&lt;b&gt;Permissive:&lt;/b&gt; unreasonable failure to act&lt;br&gt;&lt;b&gt;Ameliorative:&lt;/b&gt; increases market value but substantially changes character — generally prohibited&lt;br&gt;&lt;i&gt;Pabst carve-out:&lt;/i&gt; allowed if surroundings changed so drastically property lost most of its value&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="1680" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e-le-fi" edge="1" parent="1" source="LE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="LE-FI">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="LE-FI" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#66B2FF);" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Future Interests After Life Estate&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;If O keeps it → &lt;b&gt;Reversion&lt;/b&gt;&lt;br&gt;If O names a third party → &lt;b&gt;Remainder&lt;/b&gt; (4 sub-types)&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="340" x="1230" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e-rev" edge="1" parent="1" source="LE-FI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.2;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#00FF00);" target="REV">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="REV" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Reversion (Grantor)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Arises when O conveys less than FSA without naming a remainder holder&lt;br&gt;— Implied automatically — no words needed&lt;br&gt;— Becomes possessory when life estate ends&lt;br&gt;— &lt;b&gt;NOT subject to RAP&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="300" x="1020" y="860" as="geometry" />
        </mxCell>
        <mxCell id="e-rem-hub" edge="1" parent="1" source="LE-FI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#3399FF);" target="REM-HUB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="REM-HUB" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#66B2FF);" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Remainder (Grantee)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Follows a life estate; waits patiently&lt;br&gt;— Cannot divest a prior estate while still running&lt;br&gt;— Five sub-types below&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="300" x="1380" y="860" as="geometry" />
        </mxCell>
        <mxCell id="e-iv" edge="1" parent="1" source="REM-HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;" target="IV">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IV" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Indefeasibly Vested&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Certain to become possessory; no conditions remain&lt;br&gt;— Nothing can take it away&lt;br&gt;— E.g., &quot;to A for life, then to B&quot;&lt;br&gt;— &lt;b&gt;NOT subject to RAP&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="1060" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="e-cont" edge="1" parent="1" source="REM-HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.37;exitY=1;exitDx=0;exitDy=0;" target="CONT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CONT" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Contingent&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Condition precedent not yet met, OR taker unascertained&lt;br&gt;— Cannot possess until condition is met&lt;br&gt;— If condition never met → implied reversion in O&lt;br&gt;— E.g., &quot;to A for life, then to B if B survives A&quot;&lt;br&gt;— &lt;b&gt;SUBJECT TO RAP&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="290" x="1350" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="e-vscd" edge="1" parent="1" source="REM-HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.65;exitY=1;exitDx=0;exitDy=0;" target="VSCD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VSCD" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Vested Subject to Complete Divestment&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Vested but a condition subsequent can strip it away&lt;br&gt;— If divested, goes to a third party (not O)&lt;br&gt;— Grantee CAN take possession immediately when life estate ends&lt;br&gt;— E.g., &quot;to A for life, then to B; but if B fails to graduate, then to C&quot;&lt;br&gt;— The remainder itself: &lt;b&gt;NOT subject to RAP&lt;/b&gt;&lt;br&gt;— The cutting executory interest (C): &lt;b&gt;subject to RAP&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="360" x="2040" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="e-vso" edge="1" parent="1" source="REM-HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.82;exitY=1;exitDx=0;exitDy=0;" target="VSO">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VSO" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;4d. Vested Subject to Open (Partial Divestment)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Class gift; at least one member qualifies but more may join&lt;br&gt;— New members dilute existing shares&lt;br&gt;— Class closes by rule of convenience&lt;br&gt;— E.g., &quot;to A for life, then to A&#39;s children&quot; (A has kids now, may have more)&lt;br&gt;— &lt;b&gt;SUBJECT TO RAP&lt;/b&gt; (for the unborn/unascertained class members)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="1680" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="e-vscs" edge="1" parent="1" source="REM-HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=1;exitDx=0;exitDy=0;" target="VSCS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="VSCS" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;4e. Vested Subject to Condition Subsequent&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Vested but a condition subsequent can strip it away&lt;br&gt;— If divested, goes &lt;b&gt;back to O&lt;/b&gt; (the grantor) — NOT a third party&lt;br&gt;— Future interest: O retains a &lt;b&gt;Right of Entry&lt;/b&gt; on the remainder&lt;br&gt;— Same logic as FSSCS but one level down, applied to the remainder itself&lt;br&gt;— Does NOT end automatically; O must act to retake&lt;br&gt;— &lt;b&gt;NOT subject to RAP&lt;/b&gt; (grantor&#39;s right of entry deemed vested at creation)&lt;br&gt;&lt;br&gt;E.g., &quot;to A for life, then to B; but if B smokes, then back to O&quot;&lt;br&gt;&lt;span style=&quot;white-space:pre;&quot;&gt;  &lt;/span&gt;→ B: vested remainder subject to condition subsequent&lt;br&gt;&lt;span style=&quot;white-space:pre;&quot;&gt;  &lt;/span&gt;→ O: right of entry on that remainder&lt;br&gt;&lt;br&gt;Contrast with 4c: &quot;then to &lt;b&gt;C&lt;/b&gt;&quot; → executory interest in grantee (RAP applies)&lt;br&gt;Here: &quot;then back to &lt;b&gt;O&lt;/b&gt;&quot; → right of entry in grantor (no RAP)&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="400" x="2450" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="e-fsd" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#FF33FF);" target="FSD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FSD" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Fee Simple Determinable (FSD)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Words: &quot;so long as,&quot; &quot;while,&quot; &quot;until,&quot; &quot;during&quot;&lt;br&gt;— Ends &lt;b&gt;automatically&lt;/b&gt; when condition is violated&lt;br&gt;— No action by grantor needed&lt;br&gt;— AP clock starts the moment condition is violated&lt;br&gt;&lt;br&gt;&lt;b&gt;Future Interest (Grantor only):&lt;/b&gt;&lt;br&gt;Possibility of Reverter ↓&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="320" x="2140" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e-por" edge="1" parent="1" source="FSD" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="POR">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="POR" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Possibility of Reverter&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Held by grantor (or grantor&#39;s successors)&lt;br&gt;— Returns &lt;i&gt;automatically&lt;/i&gt; upon violation — no action needed&lt;br&gt;— Deemed vested at creation → &lt;b&gt;NOT subject to RAP&lt;/b&gt;&lt;br&gt;— E.g., &quot;to School so long as used for education&quot; → if school closes, back to O automatically&lt;/p&gt;" vertex="1">
          <mxGeometry height="120" width="340" x="2040" y="730" as="geometry" />
        </mxCell>
        <mxCell id="e-fsscs" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.72;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#CC0000);" target="FSSCS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FSSCS" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Fee Simple Subject to Condition Subsequent (FSSCS)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Words: &quot;but if,&quot; &quot;provided that,&quot; &quot;on condition that,&quot; &quot;if…then O may reenter&quot;&lt;br&gt;— Does &lt;b&gt;NOT end automatically&lt;/b&gt; — grantor must affirmatively exercise right to retake&lt;br&gt;— AP clock does NOT start until grantor exercises right of entry&lt;br&gt;&lt;br&gt;&lt;b&gt;Future Interest (Grantor only):&lt;/b&gt;&lt;br&gt;Right of Entry / Power of Termination ↓&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="350" x="3020" y="457.5" as="geometry" />
        </mxCell>
        <mxCell id="e-roe" edge="1" parent="1" source="FSSCS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="ROE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ROE" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Right of Entry / Power of Termination&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Held by grantor (or grantor&#39;s successors)&lt;br&gt;— Does &lt;b&gt;NOT&lt;/b&gt; return automatically; grantor must act to retake&lt;br&gt;— Deemed vested at creation → &lt;b&gt;NOT subject to RAP&lt;/b&gt;&lt;br&gt;— Key practical difference from PoR: grantor can choose to forgive the violation&lt;br&gt;— E.g., &quot;to A; but if marijuana is consumed, O may reenter&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="370" x="3250" y="710" as="geometry" />
        </mxCell>
        <mxCell id="e-fssel" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.9;exitY=1;exitDx=0;exitDy=0;strokeColor=light-dark(#000000,#FF33FF);" target="FSSEL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="FSSEL" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Fee Simple Subject to Executory Limitation (FSSEL)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Words: &quot;as long as…and then to B&quot; or &quot;but if…then to B&quot;&lt;br&gt;— Ends &lt;b&gt;automatically&lt;/b&gt; on named event (like FSD)&lt;br&gt;— BUT future interest goes to a &lt;b&gt;third party&lt;/b&gt;, NOT the grantor&lt;br&gt;— Can use either durational or conditional language&lt;br&gt;&lt;br&gt;&lt;b&gt;Future Interest (Grantee only):&lt;/b&gt;&lt;br&gt;Executory Interest ↓&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="360" x="2570" y="470" as="geometry" />
        </mxCell>
        <mxCell id="e-ei" edge="1" parent="1" source="FSSEL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="EI">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="EI" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Executory Interest&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;— Held by a &lt;b&gt;third-party grantee&lt;/b&gt; (never the grantor)&lt;br&gt;— Unlike a remainder, it CAN cut short a prior estate while still running&lt;br&gt;&lt;br&gt;&lt;b&gt;Springing:&lt;/b&gt; cuts off grantor&#39;s own estate&lt;br&gt;&lt;span style=&quot;white-space:pre;&quot;&gt;  &lt;/span&gt;E.g., &quot;to A when A passes the bar&quot;&lt;br&gt;&lt;b&gt;Shifting:&lt;/b&gt; cuts off another grantee&#39;s estate&lt;br&gt;&lt;span style=&quot;white-space:pre;&quot;&gt;  &lt;/span&gt;E.g., &quot;to A, but if X happens, then to B&quot;&lt;br&gt;&lt;br&gt;— &lt;b&gt;SUBJECT TO RAP&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="360" x="2700" y="690" as="geometry" />
        </mxCell>
        <mxCell id="e-spring" edge="1" parent="1" source="EI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;" target="SPRING">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SPRING" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Springing Executory Interest&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Springs out of the grantor&#39;s estate upon condition.&lt;br&gt;E.g., &quot;to A if and when A marries&quot; — O holds until then.&lt;/p&gt;" vertex="1">
          <mxGeometry height="90" width="290" x="2530" y="910" as="geometry" />
        </mxCell>
        <mxCell id="e-shift" edge="1" parent="1" source="EI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;" target="SHIFT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SHIFT" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Shifting Executory Interest&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;Shifts out of a prior grantee&#39;s estate upon condition.&lt;br&gt;E.g., &quot;to A, but if A smokes, then to B&quot;&lt;br&gt;A has FSSEL; B has shifting executory interest.&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="290" x="2940" y="920" as="geometry" />
        </mxCell>
        <mxCell id="e-rap" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" target="RAP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RAP" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Rule Against Perpetuities (RAP)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align:center;margin:0;&quot;&gt;&lt;i&gt;Symphony Space v. Pergola Properties&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;No interest valid unless it must &lt;b&gt;vest or terminate within 21 years after the death&lt;/b&gt; of a life in being at creation.&lt;br&gt;Validity determined at moment of creation — what &lt;i&gt;could&lt;/i&gt; happen, not what does.&lt;br&gt;&lt;br&gt;&lt;b&gt;Subject to RAP:&lt;/b&gt; Contingent remainders · Vested subject to open · Executory interests · Options to purchase&lt;br&gt;&lt;br&gt;&lt;b&gt;NOT subject to RAP:&lt;/b&gt; Possibility of reverter · Right of entry · Indefeasibly vested remainders · Vested subject to complete divestment (the remainder itself)&lt;br&gt;&lt;br&gt;&lt;b&gt;Charney Rules:&lt;/b&gt;&lt;br&gt;— Organizations cannot be measuring lives&lt;br&gt;— &quot;Wait and see&quot; rejected (void ab initio)&lt;br&gt;— Charity-to-charity exception (both interests in charities → exempt)&lt;br&gt;— Right of first refusal exempt&lt;br&gt;— Option appurtenant to lease exempt&lt;br&gt;&lt;br&gt;&lt;b&gt;RAP Remedy&lt;/b&gt; (City of Klamath Falls v. Bell):&lt;br&gt;Step 1: Strike void interest&lt;br&gt;Step 2: Read what remains&lt;br&gt;Step 3: Remaining language determines the estate and its implied future interest&lt;/p&gt;" vertex="1">
          <mxGeometry height="410" width="400" x="3370" as="geometry" />
        </mxCell>
        <mxCell id="e-rules" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="RULES">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="RULES" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Key Charney Rules&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0 0 0 8px;&quot;&gt;&lt;b&gt;Conservation of Estates&lt;/b&gt; (Williams):&lt;br&gt;Grants + retained interest = FSA.&lt;br&gt;No remainder specified → O retains implied reversion.&lt;br&gt;&lt;br&gt;&lt;b&gt;Numerus Clausus&lt;/b&gt; (Charles v. Barzey):&lt;br&gt;Menu of property forms is fixed and closed.&lt;br&gt;Interest not repugnant if law can accommodate it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Restraints on Alienation&lt;/b&gt;:&lt;br&gt;Use restriction → VALID (Mountain Brow)&lt;br&gt;Direct transfer restraint → VOID (Morse v. Blood)&lt;br&gt;&lt;br&gt;&lt;b&gt;AP &amp;amp; Defeasible Fees:&lt;/b&gt;&lt;br&gt;FSD: clock starts on violation&lt;br&gt;FSSCS: clock starts only when grantor acts&lt;br&gt;&lt;br&gt;&lt;b&gt;Words of Purchase vs. Limitation:&lt;/b&gt;&lt;br&gt;Purchase = who takes it&lt;br&gt;Limitation = how long it lasts&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="360" x="940" y="90" as="geometry" />
        </mxCell>
        <mxCell id="e-table" edge="1" parent="1" source="HUB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="TABLE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="TABLE" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align:center;margin:4px 0 0;&quot;&gt;&lt;b&gt;&lt;u&gt;Present Interest → Future Interest — Charney Quick Reference&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:13px;&quot;&gt;&lt;tr style=&quot;background:#ddd;&quot;&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Present Interest&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Trigger Words&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Future Interest in Grantor&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Future Interest in Grantee&lt;/th&gt;&lt;th style=&quot;border:1px solid #999;padding:4px;&quot;&gt;RAP?&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Fee Simple Absolute&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;&quot;to A&quot; / &quot;to A and her heirs&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;None&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;None&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;N/A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Life Estate&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;&quot;for life&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Reversion (implied if no remainder)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Remainder (4 types)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Contingent + subject-to-open: YES; vested subject to condition subsequent: NO&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;└ Remainder: Vested Subject to Condition Subsequent&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;&quot;then to B; but if X, back to O&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Right of Entry (on the remainder)&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Fee Simple Determinable&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;&quot;so long as,&quot; &quot;while,&quot; &quot;until,&quot; &quot;during&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Possibility of Reverter&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Fee Simple Subject to Condition Subsequent&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;&quot;but if,&quot; &quot;provided that,&quot; &quot;on condition&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Right of Entry / Power of Termination&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Fee Simple Subject to Executory Limitation&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;&quot;as long as…then to B&quot; / &quot;but if…then to B&quot;&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;—&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Executory Interest&lt;/td&gt;&lt;td style=&quot;border:1px solid #999;padding:4px;&quot;&gt;Yes&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="280" width="1620" x="1310" y="-200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
