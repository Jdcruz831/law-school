        <mxCell id="WdCGRrIDrznSsFxXrDV3-21" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-53" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-20" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-23" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-53" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-22" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="JGdcAE9lbHhbZdBGjv53-2" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-53" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="Oa994hctVbpJbJxt5RuI-57">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-53" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Establishing ownership:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] Body parts - &lt;i&gt;Moore&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;[2]&amp;nbsp;&lt;/b&gt;Malicious Interference - &lt;i&gt;Keeble&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3] Quasi property in News - &lt;i&gt;INS V AP&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[4] Public/ voice - &lt;i&gt;Midler&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[5] Person beyond name &amp;amp; Voice - &lt;i&gt;White&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[6] Wild animals (industry standard) - &lt;i&gt;Ghen&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[7] Wild Animals (Manucatpure) - &lt;i&gt;Perison&amp;nbsp;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[8] Abandoned Property - &lt;i&gt;Haslem&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="400" x="6410" y="-1580" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-54" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Wild Animals:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Pierson v. Post&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] &lt;b&gt;Actual bodily seizure&lt;/b&gt;, OR&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[2] &lt;b&gt;Mortal wounding + continued pursuit&lt;/b&gt; (not abandoning), OR&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3] &lt;b&gt;Trapping/circumventing in a way that deprives the animal of liberty&lt;/b&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="123.75" width="350" x="5480" y="-1536.87" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-55" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Wild Animals (industry standard):&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Ghen v. Rich&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Industry custom can define what counts as possession when:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Reasonable and sensible to the industry&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Limited to that industry (won&#39;t bleed into others)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Necessary — rejecting it would destroy the industry&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;JJ&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] Rejecting the custom would&amp;nbsp;destroys the industry&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[2]&amp;nbsp;Late-comers can easily free-ride&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3]&amp;nbsp;Large upfront investment is required&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="5460" y="-1330" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-56" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Malicious Interference&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Keeble v. Hickeringill&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Competition vs. Interference:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Key Elements to establish liability:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Use of property for profit&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Interference was malicious (intent to harm)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Interference was purely wasteful — no benefit to defendant&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) No need to prove actual possession of the birds or count how many were lost — the harm is the disturbance itself&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;JJ&lt;/b&gt;:&amp;nbsp;regulating the race for resources - yet needs to benefit society&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="380" x="7040" y="-1840" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-57" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Quasi-property rights&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;International News Service v. Associated Press&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A right exists in gathered news as against direct competitors only (Hot News Test):&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Plaintiff generates/gathers information at a cost&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Information is time-sensitive&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Defendant&#39;s use = free riding on plaintiff&#39;s efforts&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Defendant is in direct competition with plaintiff&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5) Free-riding would substantially threaten the existence or quality of the product&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="450" x="7020" y="-1560" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-58" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-61" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-62" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-59" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-61" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-63" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-60" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-61" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Oa994hctVbpJbJxt5RuI-64" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-61" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Sequential Possession&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Finder vs. Converter&lt;/i&gt; - Finder wins&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;First Finder vs. Second Finder&lt;/i&gt; -&amp;nbsp;&amp;nbsp;Finder 1&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Converter 1 vs. Converter 2 -&amp;nbsp;Converter 1&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Abandoned&lt;/b&gt; = owner intentionally relinquished all rights.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Lost&lt;/b&gt; = owner unintentionally and involuntarily parted&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Mislaid&lt;/b&gt; = owner intentionally placed it somewhere and forgot to retrieve it&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="410" x="6410" y="220" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-62" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Finder vs. Converter&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Armory v. Dalamirie&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule&lt;/b&gt;: A finder of lost property has an ownership interest superior to everyone except the true owner.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Jus Tertii Defense (Armory isn&#39;t the true owner, so he can&#39;t sue me) — and its rejection:&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;JJ&lt;/b&gt;: &lt;/span&gt;&lt;br&gt;[1] &lt;i&gt;Protecting peaceful possession&lt;/i&gt; — finders should be able to hold&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;property without interference from anyone but the true owner&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br/&gt;[2] &lt;i&gt;Procedural efficiency&lt;/i&gt; — true owner isn&#39;t in the suit; no reason to let a&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;wrongdoer benefit from that absence&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="410" x="5930" y="330" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-63" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;First Finder vs. Second Finder&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Clark v. Maloney&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule:&lt;/b&gt; The first finder has title superior to the second finder — even if the first finder temporarily lost physical possession.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Key points:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Loss of property ≠ abandonment&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Finder never abandoned — Clark tied them up intending to return; no intent to relinquish&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="390" x="6320" y="580" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-64" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Converter 1 vs. Converter 2&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Anderson v. Gouldberg&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule&lt;/b&gt;: First converter has title superior to all subsequent converters — possession is title against anyone who is a stranger to the property.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;JJ:&amp;nbsp;Without this rule you get an endless cycle of theft → theft → theft with no resolution. &lt;b&gt;First possession, even wrongful, stops the cycle&lt;/b&gt;.&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="310" x="6820" y="510" as="geometry" />
        </mxCell>
        <mxCell id="Oa994hctVbpJbJxt5RuI-65" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Ad Coelum Underground:&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Edwards v. Sims&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule&lt;/b&gt;:&amp;nbsp;Cave ownership follows surface ownership regardless of where the entrance is.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Dissent&lt;/b&gt; (Logan) :&amp;nbsp;Property rights should be limited to what the surface owner can actually acquire and put to use&amp;nbsp;Driven by Lockean/labor theory&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="330" x="8350" y="-1360" as="geometry" />
        </mxCell>
        <mxCell id="WDtN5-gdxOVuKQ8rQCBY-65" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#E6D0DE);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Manner of Physical Attachment — &quot;nailed-to-the-wall&quot; test&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b style=&quot;text-align: center;&quot;&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: center;&quot;&gt;&lt;i&gt;Strain v. Green&lt;/i&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;b&gt;&amp;nbsp;Test: &lt;/b&gt;can it be removed without damaging the realty?&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Decisive for the two nailed mirrors → removing them pulled plaster and exposed different paint = fixture&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Bathroom mirror hung on a hook = no damage on removal = NOT a fixture&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="380" x="12280" y="-1060" as="geometry" />
        </mxCell>
        <mxCell id="WDtN5-gdxOVuKQ8rQCBY-68" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-44" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.005;entryY=0.414;entryDx=0;entryDy=0;entryPerimeter=0;" target="Oa994hctVbpJbJxt5RuI-45">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WDtN5-gdxOVuKQ8rQCBY-69" edge="1" parent="1" source="Oa994hctVbpJbJxt5RuI-44" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.015;entryY=0.394;entryDx=0;entryDy=0;entryPerimeter=0;" target="Oa994hctVbpJbJxt5RuI-46">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-5" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-7" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-9" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-11" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-3" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Adverse Possession&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Elements — OCEANS&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;O — Open and notorious&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;C — Continuous&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;E — Exclusive&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A — Actual&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;N — Nonpermissive&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;S — Statutory period&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="260" x="10605" y="470" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Adverse Possession&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Scott v. Anderson-Tully Co.&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Elements — OCEANS&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;O — Open and notorious -&amp;nbsp;&lt;i&gt;Blue paint&lt;/i&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;C — Continuous -&amp;nbsp;&lt;i&gt;based on land usage (swamp)&lt;/i&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;E —&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A — Actual -&amp;nbsp;&lt;i&gt;issuing hunting licenses&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;N —&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;S —&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="340" x="10100" y="360" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;N — Nonpermissive - Good Faith/ Bad Faith&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Carpenter v. Ruperto&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Iowa Rule (Carpenter)&lt;/b&gt;: Good faith required. Knowledge that you have no legal basis for claiming = bad faith = AP fails.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;&amp;nbsp;measured at moment of entry — if you find out later it&#39;s someone else&#39;s land, that doesn&#39;t defeat good faith already established.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;California Rule (majority rule):&lt;/b&gt; No state of mind requirement. &quot;Claim of right&quot; = intent to possess as one&#39;s own + nonpermissive. Bad faith doesn&#39;t bar AP.&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="430" x="10360" y="780" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;C — Continuous&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Howard v. Kunto&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Continuity :(1)&amp;nbsp;&lt;b&gt;norms of property&lt;/b&gt; &lt;b&gt;usage&lt;/b&gt; for that particular type of property&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Tacking: (1) may add their periods together (2)&amp;nbsp;&amp;nbsp;only if they are in &lt;b&gt;privity&lt;/b&gt; with each other&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Privity = written conveyance&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="260" x="10050" y="620" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;S — Statutory period&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Songbyrd v. Estate of Grossman&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Songbyrd Rule&lt;/b&gt; (default): SOL starts :&amp;nbsp;moment of conversion&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Guggenheim Rule&lt;/b&gt; (GFPV) (Replevin, not damages) (exception):&amp;nbsp;true owner makes demand for return AND the possessor refuses&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="330" x="11000" y="580" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Body Parts&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Moore v. Regents of the University of CA&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Informed Consent / Breach of Fiduciary Duty: WINS&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Rule: Plaintiff must have an ownership or possessory right in the property. Once cells leave the body, Moore has no property right in them.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;JJ&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] Patient autonomy can be protected by informed consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[2]&amp;nbsp;Conversion is strict liability - protect downstream buyers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3]&amp;nbsp;Institutional choice - should be legislators&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Dissent:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Broussard&lt;/b&gt;: Before cells are removed, patient has the right to determine how they&#39;ll be used after removal.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Mosk&lt;/b&gt;: Person has a property right in bodily tissues including uses to which they&#39;re put. &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Unjust for Moore to get nothing from a product that couldn&#39;t exist without him.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="300" width="470" x="6470" y="-2040" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-18" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-16" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" target="Oa994hctVbpJbJxt5RuI-54">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-19" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-16" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="Oa994hctVbpJbJxt5RuI-55">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-16" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Rule of Capture&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(1) to establish first possession&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) tangible personal property&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) typically unowned&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="220" x="6090" y="-1460" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-25" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-20" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Right of Publicity / Voice&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Midler v. Ford Motor Company&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule: &lt;/b&gt;A party may not deliberately imitate the distinctive voice of a widely-known professional singer to sell a product. Such imitation = misappropriation of identity.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Voice is distinctive — recognizable, uniquely associated with the plaintiff&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Voice is widely known — plaintiff must be sufficiently famous&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Imitation was deliberate — not accidental resemblance&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Used for commercial purpose — to sell a product&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(5) Use was (likely) deceptive — audiences actually thought it was Midler&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Important&lt;/b&gt; &lt;b&gt;note&lt;/b&gt; — copyright ≠ right of publicity&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Ford had permission from the song&#39;s copyright owner — but that only&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;covers the musical composition, not Midler&#39;s identity&lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="450" x="6850" y="-1310" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-26" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-22" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="WdCGRrIDrznSsFxXrDV3-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Identity/Persona (beyond name, voice, and likeness)&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;White v. Samsung&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule (Majority)&lt;/b&gt;: The common-law right of publicity protects a celebrity&#39;s identity from unauthorized commercial exploitation&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Defendant used plaintiff&#39;s identity&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) To defendant&#39;s advantage&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Plaintiff did not consent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) Plaintiff was injured&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="400" x="6060" y="-1230" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;§ 3344 v. Common law&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;§ 3344 (statute): &lt;/b&gt;covers name, voice, signature, photograph, likeness — narrowly defined&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Common law&lt;/b&gt;: covers identity broadly — things closely associated with the celebrity in the public mind (a robot, a racecar, a phrase like &quot;Here&#39;s Johnny&quot;)&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="240" x="6530" y="-1220" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-33" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-29" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" target="WdCGRrIDrznSsFxXrDV3-30">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-34" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-29" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" target="WdCGRrIDrznSsFxXrDV3-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-36" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-29" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-35" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-42" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-29" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-41" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-45" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-29" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" target="WdCGRrIDrznSsFxXrDV3-43">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-29" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Limits on the Right to Exclude:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] Fair Housing act&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[2] Necessity&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3] Public Accommodations&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[4] Social interests &amp;amp; Health rights&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[5] Racially Restrictive Covenants:&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="12600" y="840" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-30" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Necessity&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Ploof v. Putnam&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Elements:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Time sensitivity — no opportunity to find an alternative&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Circumstances outside the actor&#39;s control — act of God, natural disaster, animals, blocked roads&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Life &amp;gt; Property — especially when human life is threatened&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="370" x="13030" y="760" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-31" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Social interests &amp;amp; Health rights&amp;nbsp;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;State v. Shack&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Core Rule: The ownership of real property does not include the right to bar access to governmental services available to migrant workers housed on the property.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Property rights are not absolute&lt;/b&gt; — they must be balanced against conflicting individual and social interests.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="370" x="12290" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-38" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-35" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-37" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-40" edge="1" parent="1" source="WdCGRrIDrznSsFxXrDV3-35" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WdCGRrIDrznSsFxXrDV3-39" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-35" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Public Accommodations:&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Uston v. Resorts International Hotel&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Core Rule (New Jersey / &quot;Uston&quot; Rule&lt;/b&gt;): The owner of a (1) &lt;b&gt;commercial establishment&lt;/b&gt; open to the public may not (2)&amp;nbsp;&lt;b&gt;unreasonably exclude a patron&lt;/b&gt;. If property is devoted to the general public for commercial gain, the right to exclude is limited to reasonable exclusions.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Card counting = not disruptive, not illegal&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="410" x="12840" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-37" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Traditional Common Law Rule&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Applies only to :&amp;nbsp;&lt;/b&gt;inns and common carriers (hotels, trains, planes, stagecoaches, buses, boats)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Duties:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(a) accept all customers first-come, first-served so long as there is capacity&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(b) charge reasonable prices = dons&#39;t have to be same, just&amp;nbsp;price gouging&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="470" x="12410" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-39" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Civil Rights Act of 1964:&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Applies to:&amp;nbsp;&lt;/b&gt;inns, restaurants, and entertainment venues&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Duties:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;no discrimination based on race, color, religion, or national origin only&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="13045" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-41" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;Racially Restrictive Covenants&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Shelley v. Kraemer&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) A private racially restrictive covenant is not unconstitutional per se&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;But judicial enforcement of that covenant = state action = violates the Equal Protection Clause of the 14th Amendment&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="350" x="12160" y="510" as="geometry" />
        </mxCell>
        <mxCell id="WdCGRrIDrznSsFxXrDV3-43" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Fair Housing Act&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;b&gt;&lt;u&gt;:&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Fair Housing Council v. Roommate.com&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Prevents private acts of discrimination in the sale or rental of housing, regardless of state action.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;[1] Availability — refusing to sell/rent&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;[2] Terms and conditions — different terms based on protected class&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;[3] Advertising — discriminatory ads (this is what Shelley doesn&#39;t cover but FHA does)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;[4] Lying about availability — telling a Black applicant the unit is taken when it isn&#39;t&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;[5] Disability accommodations&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Protected Categories (§ 3604) — know these:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) Race, (2) color, (3) religion, (4) sex, (5) familial status, (5) national origin, and (7) disabilities&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Exceptions:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;[1] do not apply to the selection of roommates.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;The FHA &quot;stops at the front door.&quot;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;[2] Owner-occupied small buildings: 4 or fewer units and sells/rents another unit&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;[3] &lt;/span&gt;Private club housing — housing operated by private clubs not open to the public&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;for members only&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;[4] &lt;/span&gt;Religious organizations - may give preference to members of the same religion&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;JJ:&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;&lt;/b&gt;&lt;/span&gt;Statutory Interpretation of &quot;dwelling&quot; FHA covers discrimination in the sale or rental of a &quot;dwelling&quot;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;— defined as a building designed for occupancy as a residence&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;-&amp;nbsp;&lt;/span&gt;&lt;/span&gt;freedom to enter into intimate or private relationships as a fundamental liberty under the Bill of Rights&#x9;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="390" width="600" x="12620" y="280" as="geometry" />
        </mxCell>
        <mxCell id="0Qf92DNTVQ62a5tsdVHd-3" edge="1" parent="1" source="0Qf92DNTVQ62a5tsdVHd-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0Qf92DNTVQ62a5tsdVHd-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0Qf92DNTVQ62a5tsdVHd-4" edge="1" parent="1" source="0Qf92DNTVQ62a5tsdVHd-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="0Qf92DNTVQ62a5tsdVHd-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0Qf92DNTVQ62a5tsdVHd-7" edge="1" parent="1" source="0Qf92DNTVQ62a5tsdVHd-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;" target="0Qf92DNTVQ62a5tsdVHd-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="118jmz3u4k4BpBVVt9sL-3" edge="1" parent="1" source="0Qf92DNTVQ62a5tsdVHd-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="118jmz3u4k4BpBVVt9sL-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0Qf92DNTVQ62a5tsdVHd-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#007FFF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Bailments&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(1) temporary transfer of possession&amp;nbsp;of tangible personal property. (2) Once that purpose is achieved, the property must be returned to the bailor (3) Not legal title&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Consequence of bailment&lt;/b&gt;:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;If property is lost, damaged, or stolen while in the bailee&#39;s possession → &lt;b&gt;rebuttable presumption&lt;/b&gt; of negligence against the bailee. Burden shifts to bailee to rebut.&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="370" x="6390" y="2740" as="geometry" />
        </mxCell>
        <mxCell id="0Qf92DNTVQ62a5tsdVHd-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Creation&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Allen v. Hyatt Regency-Nashville Hotel&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;b&gt;Core Definition&lt;/b&gt;: A bailment arises when the (1) &lt;b&gt;owner of property (the bailor) temporarily transfers&lt;/b&gt; custody of the property to another (the bailee). (2) Requires: &lt;b&gt;delivery&lt;/b&gt; + &lt;b&gt;acceptance&lt;/b&gt; of control by the bailee.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A bailment for hire can be implied (focuses on structural control)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Factors creating implied bailment (Allen):&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[1] Facility is enclosed&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[2] Ticket required to exit — attendant controls the exit&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[3] Security personnel patrol the premises&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="440" x="6180" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="0Qf92DNTVQ62a5tsdVHd-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Involuntary Bailment&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Cowen v. Pressprich&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;An involuntary bailee:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) assumes the duties of a voluntary bailee&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) only if they commit some overt act of interference with the goods.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Immediately and reasonably attempting to return the item to the rightful party = NOT an overt act.&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="340" x="6700" y="2430" as="geometry" />
        </mxCell>
        <mxCell id="118jmz3u4k4BpBVVt9sL-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;&amp;nbsp;Bailee&#39;s Right to Sue Third-Party Wrongdoers&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;The Winkfield&lt;/i&gt;&lt;/span&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;A bailee can recover (1)&lt;b&gt; full value against a wrongdoer&lt;/b&gt; for loss of or damage to bailed items, (2) &lt;b&gt;even if the bailee would not be liable to the bailor for that loss&lt;/b&gt;.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;&lt;i&gt;Possession = title against wrongdoers&amp;nbsp;&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="340" x="6860" y="2740" as="geometry" />
        </mxCell>
