        </mxCell>
        <mxCell id="ja6g78uvpJ1PElv6JSj0-20" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Hunt v. Washington State Apple Advert. Comm&#39;n, 432 U.S. 333, 342 (1977)&lt;/u&gt;&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(c)&amp;nbsp;neither the claim asserted nor the relief requested requires the participation of individual members in the lawsuit.&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="360" x="1230" y="-1090" as="geometry" />
        </mxCell>
        <mxCell id="00ZWyV1_3jQzV19ejG-5-3" edge="1" parent="hZvGdWm9dUrXAthSrBff-1" source="00ZWyV1_3jQzV19ejG-5-0" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="00ZWyV1_3jQzV19ejG-5-2" value="">
