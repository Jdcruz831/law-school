        <mxCell id="00ZWyV1_3jQzV19ejG-5-7" edge="1" parent="hZvGdWm9dUrXAthSrBff-1" source="00ZWyV1_3jQzV19ejG-5-0" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="00ZWyV1_3jQzV19ejG-5-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="028UrlmJrJneQdrqf-a3-1" edge="1" parent="hZvGdWm9dUrXAthSrBff-1" source="00ZWyV1_3jQzV19ejG-5-0" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="028UrlmJrJneQdrqf-a3-0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3H19bF7bejNYLiliI3L-1" edge="1" parent="hZvGdWm9dUrXAthSrBff-1" source="00ZWyV1_3jQzV19ejG-5-0" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="r3H19bF7bejNYLiliI3L-0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3H19bF7bejNYLiliI3L-3" edge="1" parent="hZvGdWm9dUrXAthSrBff-1" source="00ZWyV1_3jQzV19ejG-5-0" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="r3H19bF7bejNYLiliI3L-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="00ZWyV1_3jQzV19ejG-5-0" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lujan v. Defs. of Wildlife, 504 U.S. 555, 560 (1992)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Minimum of standing contains three elements&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;First, the plaintiff must have suffered an “injury in fact”—an invasion of a legally protected interest which is&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(a) concrete and particularized and&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(b) “actual or imminent, not ‘conjectural’ or ‘hypothetical,’&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Second, there must be a causal connection between the injury and the conduct complained of—the injury has to be “fairly ... trace[able] to the challenged action of the defendant, and not ... th[e] result [of] the independent action of some third party not before the court.”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;Third, it must be “likely,” as opposed to merely “speculative,” that the injury will be “redressed by a favorable decision.&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="170" y="-890" as="geometry" />
        </mxCell>
        <mxCell id="00ZWyV1_3jQzV19ejG-5-2" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lujan v. Defs. of Wildlife, 504 U.S. 555, 560 (1992)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;legal standard&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;The party invoking federal jurisdiction bears the burden of establishing these elements.&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;In response to a summary judgment motion, however, the plaintiff can no longer rest on such “mere allegations,” but must “set forth” by affidavit or other evidence “specific facts,”&lt;/p&gt;" vertex="1">
          <mxGeometry height="130" width="520" x="-530" y="-900" as="geometry" />
        </mxCell>
        <mxCell id="00ZWyV1_3jQzV19ejG-5-4" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lujan v. Defs. of Wildlife, 504 U.S. 555, 560 (1992)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;When the suit is one challenging the legality of government action or inaction:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) Causation becomes more of an issue must show your injury is fairly traceable to the&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;government, not to independent choices of others.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3)  &lt;/span&gt;You must show a court order would likely fix your injury. &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&quot;&lt;/span&gt;&lt;br&gt;Thus, when the plaintiff is not himself the object of the government action or inaction he&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;challenges, standing is not precluded, but it is ordinarily “substantially more difficult” to establish&quot;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="-940" y="-720" as="geometry" />
        </mxCell>
        <mxCell id="00ZWyV1_3jQzV19ejG-5-6" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#FF66FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Lujan v. Defs. of Wildlife, 504 U.S. 555, 560 (1992)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Minimum of standing contains three elements&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) &quot;Of course, the desire to use or observe an animal species, even for purely esthetic purposes, is undeniably a cognizable interest for purpose of *563 standing.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&quot;But the ‘injury in fact’ test requires more than an injury to a cognizable interest.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;It requires that the party seeking review be himself among the injured.”&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&quot; Past exposure to illegal conduct does not in itself show a present case or&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;controversy regarding injunctive relief ... if unaccompanied by any continuing, present adverse effects.’ ”&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Past exposure does not create a current injury.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&quot;It is clear that the person who observes or works with a particular animal threatened by a federal decision is facing&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; perceptible harm, since the very subject of his interest will no longer exist.&quot;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="350" width="700" x="-1150" y="-370" as="geometry" />
        </mxCell>
        <mxCell id="dqx4MBR1-dXH0JbydHFk-0" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#B266FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Hunt v. Washington State Apple Advert. Comm&#39;n, 432 U.S. 333, 342 (1977)&lt;/u&gt;&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;“(W)hether an association has standing to invoke the court&#39;s remedial powers on behalf of its members depends in substantial measure on the nature of the relief sought. If in a proper case the association seeks a declaration, injunction, or some other form of prospective relief, it can reasonably be supposed that the remedy, if granted, will inure to the benefit of those members of the association actually injured. Indeed, in all cases in which we have expressly recognized standing in associations to represent their members, the relief sought has been of this kind.”&lt;/p&gt;" vertex="1">
          <mxGeometry height="180" width="360" x="1700" y="-970" as="geometry" />
        </mxCell>
        <mxCell id="028UrlmJrJneQdrqf-a3-0" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#00CC00);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;CEC v. FERC&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;Married couple&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Minimum of standing contains three elements&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a) Has relationship memories with wife and viewing delta smelt &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b) Plan to return for the Summer 2026 CEC meet-up where I hope to again spot the Delta&lt;br&gt;Smelt in its natural environment in the Sacramento River.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;i&gt;(Cite: Lujan&lt;/i&gt;) &lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) The creation of the Dam would threaten the fish &quot;Because of the fish’s short lifespan and reliance on the specific conditions of its delta habitat, it is particularly susceptible to threats from habitat change. The Delta Smelt is a “keystone” species in the delta, meaning the health of the species is an overall indicator of the ecosystem health of the Delta. Its decline would have ripple effects causing harm to other species. Once abundant in the Delta, the Delta Smelt’s declining populations prompted the Fish &amp;amp; Wildlife Service to list it under the ESA as “threatened” in 1993,&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;qualifying it for protection under the ESA.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(Cite: DR. ANNA HAN)&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)&amp;nbsp;An injunction would stop the creation of a Dam and would allow for the continued existence of the Delta Smelt&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="350" width="630" x="690" y="-550" as="geometry" />
        </mxCell>
        <mxCell id="028UrlmJrJneQdrqf-a3-2" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#66FF66);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;DECLARATION OF&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;i&gt;LISA KLOPPENBERG&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(a) in the name&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(b) founded to protect and preserve the natural environment in the Bay Area&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(c) especially those hovering on the&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;brink of extinction&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(d) Actual: environmental teaching and learning sessions, publishing environmental information online, funding and organizing environmental cleanup activities, and providing a forum for connecting environmental advocates across local and national organizations. CEC engages in litigation from time to time when necessary to fulfill its mission.&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="430" x="790" y="-860" as="geometry" />
        </mxCell>
        <mxCell id="028UrlmJrJneQdrqf-a3-4" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#00FF00);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Complaint&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(c) injunction&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Which does not require individual relief &lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="260" x="1320" y="-790" as="geometry" />
        </mxCell>
        <mxCell id="r3H19bF7bejNYLiliI3L-0" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Bennett v. Spear, 520 U.S. 154, 169, 1 (1997))&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) &quot;is fairly tracable&quot; becuse government &quot;action has a determinative or coercive effect on what follows&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The creation of the Sac Dam would threaten the fish becuse &quot;....&quot; which is fairly tracable to the FERC&#39;s lack of consultation with&amp;nbsp;U.S. Fish and Wildlife Service. This construction is still contingent upon ____&#39;s, or another third party approval, does not excuse FERC&#39;s determinative effect on the creation of the dam in a vital ecosystem.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="440" x="430" y="-140" as="geometry" />
        </mxCell>
        <mxCell id="r3H19bF7bejNYLiliI3L-5" edge="1" parent="hZvGdWm9dUrXAthSrBff-1" source="r3H19bF7bejNYLiliI3L-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="r3H19bF7bejNYLiliI3L-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3H19bF7bejNYLiliI3L-2" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Spokeo, Inc. v. Robins, 578 U.S. 330, 339, (May 24, 2016)&lt;/u&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;First, the plaintiff must have suffered an “injury in fact”—an invasion of a legally protected interest which is&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(a)&lt;b&gt; concrete and particularized and&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Particularized - &quot;must affect the plaintiff in a personal and individual way.”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Concrete - &quot;Congress is well positioned to identify intangible harms that meet minimum Article III requirements&quot; - tie to substantially by ESA?&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="-140" y="-440" as="geometry" />
        </mxCell>
        <mxCell id="r3H19bF7bejNYLiliI3L-4" parent="hZvGdWm9dUrXAthSrBff-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;strokeColor=light-dark(#000000,#3399FF);" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px;&quot;&gt;&lt;b&gt;&lt;u&gt;Friends of the Earth, Inc. v. Laidlaw Env&#39;t Servs. (TOC), Inc., 528 U.S. 167, 184, 120(2000)&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) First, the plaintiff must have suffered an “injury in fact”—an invasion of a legally protected interest which is&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span class=&quot;Apple-tab-span&quot; style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;b&gt;(b) “actual or imminent, not ‘conjectural’ or ‘hypothetical,’&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;directly affected those affiants&#39; recreational, aesthetic, and economic interests&quot; constituted actual and imminent.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="560" x="-190" y="-110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="6G-MBRNxCyyo0UBbjGvR" name="extra cases">
    <mxGraphModel dx="611" dy="360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="vxRbtxPrfeDPJCSrmPd2-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="200.51" width="404" y="40" as="geometry" />
        </mxCell>
        <mxCell id="vxRbtxPrfeDPJCSrmPd2-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
