  <diagram name="Page-1" id="rtwjt1CX6FByuuT1yKK2">
    <mxGraphModel dx="2218" dy="660" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_SMD5cSwjPZak6i9WwJ0-18" edge="1" parent="1" source="IX6JCB2Itipd9EHsRNt4-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="_SMD5cSwjPZak6i9WwJ0-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IX6JCB2Itipd9EHsRNt4-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;u&gt;The Lysine Cartel Overview&amp;nbsp;&lt;br&gt;&lt;/u&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;&lt;span style=&quot;text-align: left;&quot;&gt;United States v. Andreas&lt;/span&gt;&lt;span style=&quot;text-decoration-color: currentcolor;&quot;&gt;:&lt;/span&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- &quot;process of agreement&quot; the conversations used to replace the &quot;invisible hand&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Introduces Archer-Daniels-Midland Company (ADM), the world&#39;s largest producer of grain-derived food additives&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;The Conspiracy: From 1991 to 1995, ADM orchestrated a global cartel to artificially inflate the price of the amino acid lysine&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Code-named &quot;Harvest King&quot; by the FBI, this became one of the most historically significant antitrust prosecutions in global history&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Our competitors are our friends. Our customers are the enemy.&quot;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="290" width="430" x="-410" y="980" as="geometry" />
        </mxCell>
        <mxCell id="_SMD5cSwjPZak6i9WwJ0-4" edge="1" parent="1" source="_SMD5cSwjPZak6i9WwJ0-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="_SMD5cSwjPZak6i9WwJ0-3" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_SMD5cSwjPZak6i9WwJ0-11" edge="1" parent="1" source="_SMD5cSwjPZak6i9WwJ0-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" target="IX6JCB2Itipd9EHsRNt4-1">
          <mxGeometry relative="1" as="geometry" />
