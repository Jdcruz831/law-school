        <mxCell id="_SMD5cSwjPZak6i9WwJ0-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Collaboration Among Competitors &quot;Cartels&quot;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Per Se Conspiracy Agreement §1 Sherman Act&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Benefit consumers v. what disadvantages&amp;nbsp;&lt;/p&gt;" vertex="1">
