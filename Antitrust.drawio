          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Perfect Competition &amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Price takers: Firms that lack any power to influence market prices;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Marginal Cost Pricing:&amp;nbsp;A condition where the price of a good equals the cost of producing one additional unit. This ensures production levels are optimized for consumer needs&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Efficiencies:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- Allocative Efficiency: Resources reflect consumer preference.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Production Efficiency: Goods are produced at the lowest possible cost.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;- &lt;/span&gt;Consumption Efficiency: Goods are consumed by those who value them most.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Aggregate Surplus: The sum of consumer surplus (value minus price) and producer surplus&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(price minus cost), representing the total economic benefit generated by a market.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Consumer Surplus: the &quot;I got a deal feeling&quot; &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Goal of perfect compitition is to protect the Consumer surplus. &lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="280" width="540" x="-1870" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-10" edge="1" parent="1" source="6OgzCKJpHTBAjpVMQ7r7-7" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="6OgzCKJpHTBAjpVMQ7r7-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;&lt;b&gt;Ruinous Competition&quot; Defense&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;U.S. v. Trans-Missouri Freight Association (1897)&lt;/i&gt;&amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&quot;Every contract or trust ect. that retrains trade will be considered illegal&quot; *Changes below&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Price- fixing is not necessary.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Freight Association argued Railroads required massive initial investments in fixed assets&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;and high maintenance costs. Thus the price- fixing was reasonable.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;However, court rejected because &lt;u&gt;a reasonable rate is determined by great&amp;nbsp;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;u&gt;uncertainty and an infinite variety of facts. &lt;/u&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;u&gt;&lt;br&gt;&lt;/u&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;comparison between now and then: contracts that protect supply chain and purchase,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;compared to the trusts that limit who&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; was allowed to  buy what portion of the product &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- Issue: our ability to contract would be gone, with the word &quot;every read into it&quot; &lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="540" x="-520" y="90" as="geometry" />
        </mxCell>
        <mxCell id="cuFKMwS91Nt2jhl05T2R-2" edge="1" parent="1" source="6OgzCKJpHTBAjpVMQ7r7-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cuFKMwS91Nt2jhl05T2R-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;Rule of Reason&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Standard Oil Co. of New Jersey v. United States&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Changes president to allow for a reasonableness standard for restraint in trade!!!&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Creation of an oil trusts where a single board coordinated production, distribution, and pricing as a single monopoly.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Court said §1 prohibits unreasonable restraints of trade, where the judicial review evelauutes the actual economic effects of business conduct.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="540" x="-610" y="390" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Monopoly &amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- High Barry of entry&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;DWL (Dead weight loss): Where a consumer would have purchased and producer could have made money from those sales. Yet, for society this is not a productive use of resources.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="550" x="-1150" y="-100" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-17" edge="1" parent="1" source="6OgzCKJpHTBAjpVMQ7r7-14" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="6OgzCKJpHTBAjpVMQ7r7-16" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Elements &amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) C,C,C - Contract, Combination or Conspiracy&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Restraint of trade&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3) Cross state foreign nations&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="310" x="60" y="90" as="geometry" />
        </mxCell>
        <mxCell id="6OgzCKJpHTBAjpVMQ7r7-16" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Restraint of Trade &amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Reasonable price&quot;&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="310" x="180" y="300" as="geometry" />
        </mxCell>
        <mxCell id="cuFKMwS91Nt2jhl05T2R-9" edge="1" parent="1" source="cuFKMwS91Nt2jhl05T2R-1" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="cuFKMwS91Nt2jhl05T2R-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cuFKMwS91Nt2jhl05T2R-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;Reasonable Prices&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;United States v. Trenton Potteries Co.&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Trenton did not argue that they were not price fixing, but that their prices were reasonable&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;20 individuals and 23 corporations who were members of a trade organization called the Sanitary Potters&#39; Association&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A combination to fix and maintain uniform prices for the sale of sanitary pottery&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;imit sales of their pottery exclusively to a special group &quot;legitimate jobbers&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Fair price, doesn&#39;t mean that the anti-compedative conduct is reasonable.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;fair today is not fair tomorrow&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Provide businesses with certainty&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="540" x="-720" y="740" as="geometry" />
        </mxCell>
        <mxCell id="cuFKMwS91Nt2jhl05T2R-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Per Se Standard&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- applied as prohibited, without looking at real effects,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;price fixing, bid rigging, all per se illegal.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Hardcore violations.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;If we assume conduct is per se, then could get false positive or false negative.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="300" x="-1780" y="810" as="geometry" />
        </mxCell>
        <mxCell id="vckHXgLplF4Kg2YT6i-C-10" edge="1" parent="1" source="cuFKMwS91Nt2jhl05T2R-5" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="vckHXgLplF4Kg2YT6i-C-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cuFKMwS91Nt2jhl05T2R-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Rule of reason&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;- Look at the actual anticompetitive effects,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;not assuming the effect is bad, has to be proven. &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Conduct that is anti-compedative could be allowed &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="300" x="-1460" y="810" as="geometry" />
        </mxCell>
        <mxCell id="kkeC9HCrWpV9b_ha4c07-3" edge="1" parent="1" source="cuFKMwS91Nt2jhl05T2R-8" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="kkeC9HCrWpV9b_ha4c07-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cuFKMwS91Nt2jhl05T2R-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;Ruinous Competition&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;United States v. Socony-Vacuum Oill&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&amp;nbsp;Co.&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- per se rule applied even tho no price fixing, but the agreement of Dancing partners were anti-compedative&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Intent is not determinative, it&#39;s the effect.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Footnote 59: can be guilty of conspiracy although incapable of committing the objective offense.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;for per se: Just care about the agreement (don&#39;t care about the harm A.K.A. the mismanagement of power.)&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;No Agreed-Upon Price&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;Ruinous Competition &amp;amp; Stabilization&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;market distress or ruinous competition could justify private price manipulation&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="460" x="-940" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="kkeC9HCrWpV9b_ha4c07-5" edge="1" parent="1" source="kkeC9HCrWpV9b_ha4c07-2" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="kkeC9HCrWpV9b_ha4c07-4" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kkeC9HCrWpV9b_ha4c07-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;Ruinous Competition&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Palmer v. BRG of Georgia&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Geographical mapping is per se illegal, any type of market allocation like time, consumer or what not&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="470" x="-1110" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="kkeC9HCrWpV9b_ha4c07-9" edge="1" parent="1" source="kkeC9HCrWpV9b_ha4c07-4" style="rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="kkeC9HCrWpV9b_ha4c07-8" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kkeC9HCrWpV9b_ha4c07-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Catalano, Inc. v. Target Sales, Inc.&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Credit is a type of price thus a limitation on discounting&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
