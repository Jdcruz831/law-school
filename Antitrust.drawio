        <mxCell id="4JsRU6MnmcjqEv_CBFUN-2" edge="1" parent="1" source="5odS39B4Fs13WX32f58Q-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="4JsRU6MnmcjqEv_CBFUN-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y15FPpZ8XPD8nXM1DQtF-4" edge="1" parent="1" source="5odS39B4Fs13WX32f58Q-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WK7raTN2cYPX6njifJqb-4" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-510" y="1030" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-6" edge="1" parent="1" source="5odS39B4Fs13WX32f58Q-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="WK7raTN2cYPX6njifJqb-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="5odS39B4Fs13WX32f58Q-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Step 1: Market definition&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Intel-compatible PC operating systems:&amp;nbsp;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="-425" y="820" as="geometry" />
        </mxCell>
        <mxCell id="IvCd0s1WbLrDV3PS5k28-3" edge="1" parent="1" source="4JsRU6MnmcjqEv_CBFUN-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" target="IvCd0s1WbLrDV3PS5k28-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4JsRU6MnmcjqEv_CBFUN-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Step 1: Market Share&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;95% (Monopoly): even with Mac 80%&lt;/b&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="-50" y="820" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-8" edge="1" parent="1" source="IvCd0s1WbLrDV3PS5k28-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WK7raTN2cYPX6njifJqb-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IvCd0s1WbLrDV3PS5k28-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Establishing Monopoly power: &amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;applications barrier to entry:&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;More Windows users → more developers writing Windows applications → more applications → more Windows users.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="330" y="820" as="geometry" />
        </mxCell>
        <mxCell id="Y15FPpZ8XPD8nXM1DQtF-2" edge="1" parent="1" source="lwViAtitPI5AUH2SBI---1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Y15FPpZ8XPD8nXM1DQtF-1" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-16" edge="1" parent="1" source="lwViAtitPI5AUH2SBI---1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WK7raTN2cYPX6njifJqb-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lwViAtitPI5AUH2SBI---1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Use of monopoly power for anticompetitive manner&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;anticompetitive effect&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp; &amp;nbsp; - must harm the competitive &lt;i&gt;&lt;b&gt;process&lt;/b&gt;&lt;/i&gt; and thereby harm consumers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;-&quot;harm to one or more competitors will not suffice&quot;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;efforts to gain market share in one market (browsers) served to meet the threat to Microsoft’s&lt;br/&gt;monopoly in another market (operating systems) &lt;/span&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="840" y="450" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-10" edge="1" parent="1" source="Y15FPpZ8XPD8nXM1DQtF-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WK7raTN2cYPX6njifJqb-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Y15FPpZ8XPD8nXM1DQtF-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Design choice and it&#39;s justification&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&amp;nbsp;Restrictions on computer manufacturers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2)&amp;nbsp;Mixing browser and operating-system code so removal would damage Windows&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(3)Overriding the user’s chosen browser in certain circumstances&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="1150" y="710" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Geographic definition&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="260" x="-990" y="1110" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Product definition&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Not reasonably interchangeable that a significant percentage of computer users worldwide could&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;substitute&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;MacOS - &amp;nbsp;consumers would not switch from Windows to Mac OS in response to a substantial price increase because of the costs of acquiring the new hardware needed to run Mac OS (an Apple computer and peripherals)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(handheld devices)&amp;nbsp;information appliances : are used to supplement a PC&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Middlewear it&#39;s self (Navigator and Java): &quot;reasonably foreseeable future&quot;&amp;nbsp;middleware’s ultimate potential consumers could not now abandon their operating systems and switch to middleware in response to a sustained price for Windows, Nor is middleware likely to overtake the operating system as the primary platform for software development any time in the near future.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Distinction/ contradiction: a future threat in the market, does not implicitly mean there is a current interchangeable &amp;nbsp;product in the market&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="610" x="-695" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-7" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Establishing Monopoly power: &amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Microsoft argued down, that even large market share, small market power because software has little to no Barry to entry .&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;most consumers prefer operating systems for which a large number of applications have already been written; and (2) most&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;developers prefer to write for operating systems that already have a substantial consumer base. This “chicken-and-egg”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Microsoft next argues that the applications barrier to entry is not an entry barrier at all, but a reflection of Windows’&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;popularity.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;gained dominance was competitive, but is still power,&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;costs borne by all market participants should be&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;considered entry barriers is the subject of much debate&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;costs of the industry and how should they be considered for Barry to entry?&lt;/p&gt;" vertex="1">
          <mxGeometry height="330" width="420" x="290" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-12" edge="1" parent="1" source="WK7raTN2cYPX6njifJqb-9" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WK7raTN2cYPX6njifJqb-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-14" edge="1" parent="1" source="WK7raTN2cYPX6njifJqb-9" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="WK7raTN2cYPX6njifJqb-13" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Design choice and it&#39;s justification&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) the way in which it integrated IE&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;[“Internet Explorer” Internet browser, Eds.] into Windows;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(2) its various dealings with Original Equipment Manufacturers&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(“OEMs”), Internet Access Providers (“IAPs”), Internet Content Providers (“ICPs”), Independent Software Vendors (“ISVs”),&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;and Apple Computer;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;(3) its efforts to contain and to subvert Java technologies; and&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(4) its course of conduct as a whole. Upon&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;appeal, Microsoft argues that it did not engage in any exclusionary conduct.&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="470" x="1010" y="910" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;(2)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) removing any desktop icons, folders, or “Start” menu entries;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;-confusion among novice users&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) altering the initial boot sequence; &lt;b&gt;defense worked&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;and (3) otherwise altering the appearance of the Windows desktop.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;that OEMs are not able to promote rival&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;browsers, which keeps developers focused upon the APIs in Windows&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;windows argument: copyright&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="470" x="1620" y="880" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-13" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;(1)&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;IE out of the Add/Remove Programs utility,&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;unpleasant consequences for users -&amp;nbsp;overriding the user’s preference prevents some people from using other browsers&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ensure[s] that the deletion of any file containing browsing-&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;specific routines would also delete vital operating system routines and thus cripple Windows.&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="440" x="1130" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="WK7raTN2cYPX6njifJqb-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Causation exclusion of nascent threats&lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) the exclusion of nascent threats is the type&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;of conduct that is reasonably capable of contributing significantly to a defendant’s continued monopoly power.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;whether&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Java and Navigator reasonably constituted nascent threats at the time Microsoft engaged in the anticompetitive conduct at issue&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="1260" y="450" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="important-cases-study-2026" name="Important Cases — Issue, Ruling &amp; Facts">
