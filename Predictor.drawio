        </mxCell>
        <mxCell id="joe-custom-head" value="Custom Firm Topic: Dataset Design Agent" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="120" y="115" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="joe-existing-head" value="Existing Chambers / JOE Topic: Known Data Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="980" y="115" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="custom-1" value="Firm creates custom topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#4f83cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="175" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="custom-2" value="Topic intake agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d6ff;strokeColor=#8b5cf6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="245" y="255" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="custom-3" value="Clarify business question&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;What decision should this prediction support?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d6ff;strokeColor=#8b5cf6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="245" y="335" width="250" height="70" as="geometry" />
