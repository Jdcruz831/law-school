        <mxCell id="Ww_3Ysm3qYvl4xZfR5K2-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin: 4px 0px 0px; text-align: center; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;u&gt;Adverser possession of property&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Specific elements:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px;&quot;&gt;(1)&amp;nbsp;&lt;b&gt;Open &amp;amp; notorious&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px;&quot;&gt;(2)&amp;nbsp;&lt;b&gt;Continuous&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px;&quot;&gt;(3)&amp;nbsp;&lt;b&gt;Exclusive&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px;&quot;&gt;(4)&amp;nbsp;&lt;b&gt;Actua&lt;/b&gt;l:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px;&quot;&gt;(5)&amp;nbsp;&lt;b&gt;Non-permissiv&lt;/b&gt;e&lt;/p&gt;&lt;p style=&quot;margin: 0px 0px 0px 8px;&quot;&gt;(6)&amp;nbsp;&lt;b&gt;Statutory period&lt;/b&gt;:&lt;/p&gt;" vertex="1">
