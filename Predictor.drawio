  <diagram id="backend-topic-recipes" name="Backend Topic Recipe Flow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="bt-title" value="JOE Backend: Topic-Driven Dataset Recipe Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="980" height="50" as="geometry" />
        </mxCell>
        <mxCell id="bt-note" value="Core idea: a topic is no longer just a label. Each topic can provide search parameters, LLM extraction fields, excerpt hints, and topic-specific analyzers. Custom firm topics use the same pipeline with generic defaults plus optional AI-filled recipe fields." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="85" width="1260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bt-left-band" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#7aa7e8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="175" width="430" height="380" as="geometry" />
        </mxCell>
        <mxCell id="bt-right-band" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="175" width="430" height="380" as="geometry" />
        </mxCell>
        <mxCell id="bt-left-head" value="Catalog Topic Path" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="95" y="190" width="340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="bt-right-head" value="Custom Firm Topic Path" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1265" y="190" width="340" height="35" as="geometry" />
        </mxCell>
        <mxCell id="bt-catalog" value="topic_catalog.json&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Known topics like attorneys-fees&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#4f83cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="135" y="245" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bt-catalog-fields" value="Catalog fields&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;slug, name, category, specific_factors, search, analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4f83cc;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="135" y="345" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-custom-input" value="Firm enters topic_name&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Example: motion to seal, arbitration clause, sanctions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1305" y="245" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bt-custom-config" value="optional topic_config&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;AI agent may fill search + analysis blanks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#8b5cf6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1305" y="345" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-api" value="/api/topic&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;j_post: judge_slug, topic_name, topic_config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4f83cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="615" y="185" width="470" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bt-normalize" value="_normalize_topic_config(topic_name, topic_slug, topic_config)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;merges catalog entry + custom config + defaults&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="585" y="300" width="530" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-resolved" value="resolved_topic&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;name, slug, description, category, specific_factors, search, analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="425" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-search-vars" value="search_recipe variables&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;query_terms, include_description_terms, exclude_description_terms, document_start_terms, court, type, order_by, max_orders, assigned_to_judge, query_filters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="625" width="420" height="135" as="geometry" />
        </mxCell>
        <mxCell id="bt-analysis-vars" value="analysis_recipe variables&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;relevance_field, excerpt_hints, amount_fields, outcome_fields, reasoning_questions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="625" width="420" height="135" as="geometry" />
        </mxCell>
        <mxCell id="bt-query" value="_build_topic_query(judge_name, search_recipe)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;(&amp;quot;attorney fees&amp;quot; OR lodestar) AND assignedTo:Alsup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="585" width="510" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-cl" value="_search_orders(session, judge_name, topic_config=resolved_topic)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;CourtListener /api/rest/v4/search&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="700" width="510" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-filter" value="_matches_topic_document(doc, search_recipe)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;filters description by starts, includes, excludes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="595" y="815" width="510" height="75" as="geometry" />
        </mxCell>
        <mxCell id="bt-pull" value="_pull_document(session, order)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;recap_document_id, document_text, page_count, document_source&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="925" width="510" height="75" as="geometry" />
        </mxCell>
        <mxCell id="bt-excerpt" value="_relevant_excerpt(text, analysis_recipe)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;uses excerpt_hints to center the LLM context on topic-specific language&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="1035" width="510" height="75" as="geometry" />
        </mxCell>
        <mxCell id="bt-llm" value="_analyze_order(order, topic_name, resolved_topic)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;builds JSON schema from amount_fields + outcome_fields + relevance_field&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="910" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bt-pass" value="pass_one + pass_two&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;structured metadata + reasoning answers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#8b5cf6;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="1040" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bt-analyzer" value="run_statistical_analysis(enriched, judge_name, topic_name)&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;generic analyzers + topic-specific analyzers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="910" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bt-topic-analyzer" value="Attorney's Fees example&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;analyze_attorney_fee_hours_factors(): block_billing, vague_entries, duplicative_work, overstaffing, clerical_admin_work, apportionment, fees_on_fees&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1035" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="bt-output" value="Saved topic JSON&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;data/topics/{judge_slug}/{topic_slug}.json&lt;br&gt;orders, patterns, prediction, contributors, analysis_audit, search_recipe, analysis_recipe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#4f83cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="1150" width="510" height="75" as="geometry" />
        </mxCell>
        <mxCell id="bt-legend" value="Blue = user/catalog input | Orange = recipe normalization | Green = CourtListener search + documents | Purple = LLM extraction | Red = analytics/modeling | Output JSON stores the recipe used for auditability" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="230" y="1225" width="1240" height="25" as="geometry" />
        </mxCell>
        <mxCell id="bt-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f83cc;" edge="1" parent="1" source="bt-catalog" target="bt-catalog-fields"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;" edge="1" parent="1" source="bt-custom-input" target="bt-custom-config"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e3" value="catalog entry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f83cc;fontSize=11;" edge="1" parent="1" source="bt-catalog-fields" target="bt-normalize"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e4" value="firm config" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;fontSize=11;" edge="1" parent="1" source="bt-custom-config" target="bt-normalize"><mxGeometry relative="1" as="geometry" /></mxCell>
