  <diagram id="ca-attorney-fees-algorithm" name="CA Attorney Fees Algorithm">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="fee-title" value="California Attorney Fees: Reduction / Anti-Reduction Algorithm" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=26;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="880" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fee-note" value="Critical rule: keywords are correlation signals, not proof that a judge likes an argument. The algorithm should prioritize legally valid reasons stated in orders." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="85" width="1040" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fee-intake" value="Fee motion / opposition package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#4f83cc;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="170" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fee-entitlement" value="1. Entitlement screen&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Statute or contract? Prevailing party? Mandatory or discretionary? Fee claims only or mixed claims?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#4f83cc;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="260" width="290" height="85" as="geometry" />
        </mxCell>
        <mxCell id="fee-lodestar" value="2. Lodestar baseline&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Reasonable hours x reasonable market rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="375" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hours-head" value="Hours Reduction Factors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="245" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="hours-list" value="Block billing&lt;br&gt;Vague entries&lt;br&gt;Duplicative work&lt;br&gt;Overstaffing&lt;br&gt;Clerical/admin work&lt;br&gt;Unnecessary research&lt;br&gt;Intra-office conferences&lt;br&gt;Unsuccessful or unrelated claims&lt;br&gt;Poor apportionment&lt;br&gt;Fees-on-fees reasonableness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="310" width="330" height="235" as="geometry" />
        </mxCell>
        <mxCell id="rate-head" value="Rate Reduction Factors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="590" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rate-list" value="Unsupported hourly rates&lt;br&gt;Rates above local market&lt;br&gt;Experience/rate mismatch&lt;br&gt;Out-of-market counsel without justification&lt;br&gt;Unsupported paralegal or law clerk rates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="655" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="success-head" value="Result / Success Factors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="850" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="success-list" value="Limited success&lt;br&gt;Nominal recovery&lt;br&gt;Abandoned theories&lt;br&gt;Unsuccessful claims&lt;br&gt;Public-interest value despite low damages&lt;br&gt;Common core of facts analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#b85450;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="70" y="915" width="330" height="155" as="geometry" />
        </mxCell>
        <mxCell id="judge-head" value="Judge-Specific Prediction Layer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="245" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="judge-list" value="Prior fee orders by judge&lt;br&gt;Reduction percentage history&lt;br&gt;Line-item cuts vs across-the-board haircuts&lt;br&gt;Arguments the judge accepted&lt;br&gt;Arguments the judge rejected&lt;br&gt;Required evidentiary support&lt;br&gt;Preferred order structure / citations&lt;br&gt;Tolerance for block billing and staffing&lt;br&gt;Local market-rate language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#8b5cf6;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="310" width="330" height="235" as="geometry" />
        </mxCell>
        <mxCell id="keywords-head" value="Language Signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="590" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="keywords-list" value="Unique words in successful motions&lt;br&gt;Unique words in successful oppositions&lt;br&gt;Words appearing in judge orders&lt;br&gt;Separate judge language from party language&lt;br&gt;Control for statutory phrases and boilerplate&lt;br&gt;Use as correlation, not legal argument by itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#8b5cf6;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="655" width="330" height="175" as="geometry" />
        </mxCell>
        <mxCell id="just-head" value="Justification Signals" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#8b5cf6;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="875" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="just-list" value="Repeating reasons for reduction&lt;br&gt;Repeating reasons to deny reduction&lt;br&gt;Which facts made the reason persuasive&lt;br&gt;Whether the judge required examples&lt;br&gt;Whether the judge accepted percentage cuts&lt;br&gt;Whether proportionality arguments worked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbf7ff;strokeColor=#8b5cf6;align=left;spacingLeft=14;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1200" y="940" width="330" height="155" as="geometry" />
        </mxCell>
        <mxCell id="fee-data" value="Dataset Extraction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9ead3;strokeColor=#6aa84f;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="500" width="400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fee-data-list" value="Requested amount&lt;br&gt;Awarded amount&lt;br&gt;Reduction percentage&lt;br&gt;Statutory / contract basis&lt;br&gt;Moving party and opposing party posture&lt;br&gt;Arguments raised in opposition&lt;br&gt;Evidence offered for rates and hours&lt;br&gt;Judge's stated reasons&lt;br&gt;Case type, court, judge, date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#6aa84f;align=left;spacingLeft=16;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="600" y="565" width="400" height="220" as="geometry" />
        </mxCell>
        <mxCell id="fee-model" value="Prediction Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="835" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fee-output" value="Output: strategy for this judge&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Likely reduction range + best arguments + evidence needed + phrases to avoid overclaiming&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2ff;strokeColor=#4f83cc;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="945" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fee-example" value="Example recommendation: This judge historically responds to block billing and vague entries more than proportionality. Use specific billing examples and propose a line-item reduction or 20-30% haircut." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4ff;strokeColor=#7aa7e8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="510" y="1060" width="580" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fee-legend" value="Blue = motion/intake/output | Orange = lodestar baseline | Red = reduction factors/model | Purple = judge and language signals | Green = dataset fields" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="330" y="1140" width="940" height="30" as="geometry" />
        </mxCell>
        <mxCell id="fee-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f83cc;" edge="1" parent="1" source="fee-intake" target="fee-entitlement"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="fee-entitlement" target="fee-lodestar"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6aa84f;" edge="1" parent="1" source="fee-lodestar" target="fee-data"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="hours-list" target="fee-data-list"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="rate-list" target="fee-data-list"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="success-list" target="fee-model"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;" edge="1" parent="1" source="judge-list" target="fee-data-list"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fee-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;" edge="1" parent="1" source="keywords-list" target="fee-model"><mxGeometry relative="1" as="geometry" /></mxCell>
