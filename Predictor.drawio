        <mxCell id="bt-e7" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6aa84f;fontSize=11;" edge="1" parent="1" source="bt-resolved" target="bt-query"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6aa84f;" edge="1" parent="1" source="bt-search-vars" target="bt-query"><mxGeometry relative="1" as="geometry" /></mxCell>
