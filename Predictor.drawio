        <mxCell id="bt-e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;" edge="1" parent="1" source="bt-llm" target="bt-pass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="bt-pass" target="bt-analyzer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="bt-analyzer" target="bt-topic-analyzer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f83cc;" edge="1" parent="1" source="bt-topic-analyzer" target="bt-output"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="bt-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4f83cc;" edge="1" parent="1" source="bt-pass" target="bt-output"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="JOE Backend Pipeline Flow" id="joe-backend-pipeline-flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== TITLE ===================== -->
        <mxCell id="title" value="JOE — Judicial Outcome Engine&#10;Backend Pipeline Flow (app.py → pipeline.py → analyzer.py)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="360" y="20" width="640" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== PHASE BANDS (background) ===================== -->
        <mxCell id="band-ui" value="" style="rounded=1;fillColor=#dae8fc;strokeColor=none;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="band-cfg" value="" style="rounded=1;fillColor=#e1d5e7;strokeColor=none;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="1320" height="240" as="geometry" />
        </mxCell>
        <mxCell id="band-search" value="" style="rounded=1;fillColor=#d5e8d4;strokeColor=none;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="1320" height="360" as="geometry" />
        </mxCell>
        <mxCell id="band-pull" value="" style="rounded=1;fillColor=#d4e1f5;strokeColor=none;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="band-llm" value="" style="rounded=1;fillColor=#ffe6cc;strokeColor=none;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="1320" height="360" as="geometry" />
        </mxCell>
        <mxCell id="band-stat" value="" style="rounded=1;fillColor=#f8cecc;strokeColor=none;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="1570" width="1320" height="360" as="geometry" />
        </mxCell>
        <mxCell id="band-store" value="" style="rounded=1;fillColor=#f5f5f5;strokeColor=none;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="40" y="1950" width="1320" height="300" as="geometry" />
        </mxCell>

        <!-- ===================== PHASE LABELS (left) ===================== -->
        <mxCell id="lbl-ui" value="① REQUEST&#10;(Flask UI)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#1f4e79;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="20" y="195" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lbl-cfg" value="② TOPIC → PARAMETERS&#10;(config resolution)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#6a1b9a;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="0" y="475" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lbl-search" value="③ STAGE 1 — SEARCH&#10;(CourtListener)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#1b5e20;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="10" y="795" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lbl-pull" value="④ STAGE 2 — PULL DOCS" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#1f4e79;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="10" y="1075" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lbl-llm" value="⑤ STAGE 3 — LLM&#10;(optional, Ollama)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#b8540a;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="10" y="1335" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lbl-stat" value="⑥ STAGE 4 — STATISTICS&#10;(always runs)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;fontColor=#a02020;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="0" y="1715" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="lbl-store" value="⑦ STORE + READ BACK" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=12;fontColor=#555555;rotation=-90;" vertex="1" parent="1">
          <mxGeometry x="10" y="2075" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== MAIN COLUMN NODES ===================== -->
        <!-- ① REQUEST -->
        <mxCell id="n1" value="START&#10;User picks Court → Judge → Topic&#10;(firm/index.html · firm/judge.html)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="POST /api/topic&#10;{ judge_slug, topic_name, topic_config? }&#10;app.py → api_add_topic()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="200" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Spawn background thread → run_pipeline()&#10;(returns {status: started} immediately;&#10;UI then polls /api/topic/status)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="290" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- ② TOPIC CONFIG -->
        <mxCell id="n4" value="_normalize_topic_config()&#10;Look up topic in topic_catalog.json,&#10;deep-merge over DEFAULT_SEARCH_RECIPE&#10;+ DEFAULT_ANALYSIS_RECIPE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="410" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="save_topic() placeholder → status: searching&#10;data/topics/&lt;judge&gt;/&lt;topic&gt;.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="530" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- ③ SEARCH -->
        <mxCell id="n6" value="_search_orders()&#10;_build_topic_query(): join query_terms with OR&#10;+ AND assignedTo:&lt;JudgeLastName&gt;&#10;GET CourtListener /search/ (paginated, rate-limited)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="670" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="_matches_topic_document() ?&#10;starts-with document_start_terms,&#10;not exclude_description_terms,&#10;contains include_description_terms" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="790" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="Collect up to MAX_ORDERS (25) order records&#10;{ case_name, docket, recap_document_id,&#10;date_filed, description, absolute_url }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="930" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n8b" value="No matches →&#10;status: complete&#10;(empty result)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="800" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- ④ PULL DOCS -->
        <mxCell id="n9" value="_pull_document()  (per order)&#10;GET CourtListener /recap-documents/ → plain_text&#10;FREE text only — never bills PACER&#10;status: pulling_documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1050" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- ⑤ LLM -->
        <mxCell id="n10" value="_ollama_available() ?&#10;(localhost:11434)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="1210" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="_analyze_order()  (per doc, status: analyzing)&#10;Pass 1 → structured metadata as JSON&#10;(schema built from analysis_recipe fields)&#10;Pass 2 → reasoning questions (only if relevant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1340" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="_build_patterns()  (award stats / outcome counts)&#10;_build_prediction()  (LLM-written legal memo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1450" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n11b" value="Ollama OFF →&#10;mark orders analyzed = false&#10;(skip LLM, keep going)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="1215" width="180" height="80" as="geometry" />
        </mxCell>

        <!-- ⑥ STATISTICS -->
        <mxCell id="n13" value="analyzer.run_statistical_analysis()&#10;build_feature_matrix() → run ~15 analyzers&#10;(see panel on right). Each emits contributors[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1590" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="_apply_fdr()  (multiple-comparison correction)&#10;_generate_summary()  (plain-English per finding)&#10;sort by influence, cap at MAX_CONTRIBUTORS (25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1700" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="Returns contributors[] + analysis_audit&#10;(which analyzers ran / found / skipped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1810" width="320" height="60" as="geometry" />
        </mxCell>

        <!-- ⑦ STORE + READBACK -->
        <mxCell id="n16" value="save_topic() → data/topics/&lt;judge&gt;/&lt;topic&gt;.json&#10;(strip document_text) · status: complete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="1970" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="UI reads back the JSON&#10;• firm/topic.html → patterns, prediction,&#10;  contributors + evidence (quotes, page cites)&#10;• /admin dashboard → audit + aggregates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="2070" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="END" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="500" y="2180" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- ===================== SIDE ANNOTATIONS ===================== -->
        <mxCell id="note-cfg" value="WHAT THE TOPIC SUPPLIES (the &quot;parameters&quot;)&#10;&#10;search recipe → query_terms, court, order_by,&#10;max_orders, document_start_terms,&#10;include / exclude_description_terms, query_filters&#10;&#10;analysis recipe → relevance_field, amount_fields,&#10;outcome_fields, reasoning_questions, excerpt_hints&#10;&#10;specific_factors → topic-specific scrutiny tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#9673a6;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="400" width="540" height="200" as="geometry" />
        </mxCell>

        <mxCell id="note-analyzers" value="STAGE 4 ANALYZERS (analyzer.py — all run, results merged)&#10;&#10;Outcome: grant_deny_rate · anchoring (award/request ratio) · temporal_trends&#10;Party: party_patterns (Fisher) · pro_se · attorney/firm patterns · moving_party&#10;Language: word_correlations (TF-IDF + Spearman) · judicial_sentiment&#10;Document: citation_patterns · document_complexity · order_length_outcome · statutory_basis&#10;Meta: seasonal&#10;Topic-specific: attorney_fee_hours_factors (only for Attorney's Fees topic)&#10;&#10;Each finding → { name, influence 0-1, direction, summary, evidence[], method, p_value, confidence }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#b85450;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="1585" width="540" height="230" as="geometry" />
        </mxCell>

        <mxCell id="note-external" value="EXTERNAL SERVICES&#10;• CourtListener REST v4 (search + recap-documents)&#10;  rate-limited 1.5s, retries on 429/5xx&#10;• Ollama (llama3) on localhost:11434 — optional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="800" y="690" width="540" height="90" as="geometry" />
        </mxCell>

        <!-- ===================== EDGES ===================== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="keep" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7b" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n7" target="n8b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10b" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="n10" target="n11b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=1;entryY=0;" edge="1" parent="1" source="n11b" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
<diagram name="JOE Postgres Storage" id="joe-postgres-storage">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="pg-title" value="JOE Storage Layer — Postgres&#10;How topic analysis is stored, and how the app reads/writes it" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="420" y="20" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- ===== LEFT: the seam / flow ===== -->
        <mxCell id="pg-app" value="APPLICATION&#10;pipeline.py · app.py · reanalyze.py&#10;(call 4 functions only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="pg-seam" value="storage.py  (the seam)&#10;&#10;save_topic()  ·  load_topic()&#10;list_topics()  ·  list_all_topics()&#10;&#10;backend switch: TOPIC_STORAGE_BACKEND&#10;(.env via python-dotenv)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="pg-json" value="JSON files (fallback)&#10;TOPIC_STORAGE_BACKEND=json&#10;data/topics/&lt;judge&gt;/&lt;topic&gt;.json&#10;import/export &amp; emergency only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pg-pgbadge" value="PostgreSQL (default)&#10;DATABASE_URL → RDS in the cloud&#10;init once via init_db.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="300" height="80" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT: the three tables (ER) ===== -->
        <mxCell id="t-records" value="topic_records&#10;━━━━━━━━━━━━━━━━━&#10;PK (judge_slug, topic_slug)&#10;judge_name · topic_name&#10;status · category&#10;topic_data  JSONB  ← &quot;shell&quot;:&#10;   recipes, patterns, prediction,&#10;   specific_factors, analysis_audit&#10;created_at · updated_at" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="360" height="190" as="geometry" />
        </mxCell>

        <mxCell id="t-orders" value="topic_orders   (one row per ruling)&#10;━━━━━━━━━━━━━━━━━&#10;PK (judge_slug, topic_slug, order_key)&#10;recap_document_id · order_index&#10;case_name · docket_number · date_filed&#10;document_available · document_source&#10;document_storage_key  → S3 (future)&#10;order_data  JSONB:&#10;   pass_one, pass_two, factor_findings&#10;FK → topic_records  (ON DELETE CASCADE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="380" width="400" height="210" as="geometry" />
        </mxCell>

        <mxCell id="t-contrib" value="topic_contributors  (one row per finding)&#10;━━━━━━━━━━━━━━━━━&#10;PK id (BIGSERIAL)&#10;judge_slug · topic_slug&#10;name · influence · direction&#10;method · p_value&#10;contributor_data  JSONB:&#10;   evidence, summary, statistic, _extra&#10;FK → topic_records  (ON DELETE CASCADE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="380" width="380" height="200" as="geometry" />
        </mxCell>

        <mxCell id="t-s3" value="Amazon S3  (future)&#10;━━━━━━━━━━━━━━━━━&#10;raw document_text blobs,&#10;keyed by recap_document_id.&#10;DB stores only the key,&#10;not the megabytes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1010" y="120" width="360" height="170" as="geometry" />
        </mxCell>

        <!-- ===== NOTES ===== -->
        <mxCell id="pg-note-map" value="ONE topic JSON  →  THREE tables&#10;• small/flexible parts (recipes, patterns, prediction) → topic_records.topic_data (JSONB)&#10;• each order → a row in topic_orders (queryable columns + order_data JSONB)&#10;• each contributor → a row in topic_contributors&#10;load_topic() stitches them back into the original topic dict; the app code is unchanged." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#9673a6;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="850" height="120" as="geometry" />
        </mxCell>

        <mxCell id="pg-note-idx" value="WHY POSTGRES&#10;• GIN indexes on order_data / topic_data → query INSIDE the JSON&#10;• btree on recap_document_id, (topic_slug, judge_slug)&#10;• /admin &amp; stats become SQL aggregates,&#10;  not a full directory scan&#10;• concurrent workers can all write at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#82b366;dashed=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="430" height="150" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="pg-app" target="pg-seam"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe2" value="default" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="pg-seam" target="pg-pgbadge"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe3" value="opt-in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="pg-seam" target="pg-json"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe4" value="reads/writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="pg-pgbadge" target="t-orders"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe5" value="FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="t-orders" target="t-records"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe6" value="FK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=none;fontSize=10;" edge="1" parent="1" source="t-contrib" target="t-records"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe7" value="document_storage_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;dashed=1;fontSize=10;" edge="1" parent="1" source="t-orders" target="t-s3"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Attorney Topic Worksheet" id="attorney-topic-worksheet">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="atw-title" value="Attorney-Reviewed Topic Worksheet&#10;What lawyers need to give us so the predictor can create reliable legal topics" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=24;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="310" y="20" width="1080" height="70" as="geometry" />
        </mxCell>

        <mxCell id="atw-purpose" value="Goal: turn lawyer expertise into a structured topic the model can search for, extract from orders, and compare across judges.&#10;&#10;We are NOT asking for a law review memo. We need checklists, outcome choices, search phrases, and the facts/reasons judges actually rely on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="1460" height="90" as="geometry" />
        </mxCell>

        <mxCell id="atw-flow-1" value="1. Pick a Legal Topic&#10;recurring motion, claim, defense, or remedy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="230" height="80" as="geometry" />
        </mxCell>
        <mxCell id="atw-flow-2" value="2. Define Outcomes&#10;what counts as win, loss, partial win, reduction, or element failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="410" y="250" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="atw-flow-3" value="3. List Search Signals&#10;terms courts use in orders, plus noise to exclude" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="250" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="atw-flow-4" value="4. Build Decision Map&#10;elements, factors, subfactors, yes/no questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1030" y="250" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="atw-flow-5" value="5. Lawyer-Facing Output&#10;what prediction should answer for a practicing attorney" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1340" y="250" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="atw-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-flow-1" target="atw-flow-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="atw-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-flow-2" target="atw-flow-3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="atw-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-flow-3" target="atw-flow-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="atw-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-flow-4" target="atw-flow-5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="atw-left-heading" value="Fill-In Outline for Lawyers" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="atw-right-heading" value="What the Predictor Does With It" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="920" y="390" width="520" height="40" as="geometry" />
        </mxCell>

        <mxCell id="atw-ws-identity" value="A. Topic Identity&#10;Topic name: ________________________________&#10;Practice area: ______________________________&#10;What legal question is being predicted?&#10;_____________________________________________&#10;Common procedural posture: motion / claim / defense / remedy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="450" width="700" height="135" as="geometry" />
        </mxCell>

        <mxCell id="atw-ws-shape" value="B. Outcome Shape&#10;Choose one:&#10;[ ] Independent topic: one main ruling drives the result.&#10;    Examples: attorney fees, motion to dismiss, summary judgment.&#10;[ ] Conjunctive topic: every required element must be satisfied.&#10;    Examples: adverse possession, negligence, preliminary injunction.&#10;&#10;Main result categories: granted / denied / granted in part / other / element failed / amount reduced" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="610" width="700" height="155" as="geometry" />
        </mxCell>

        <mxCell id="atw-ws-search" value="C. Search Terms and Noise Filters&#10;Terms courts actually use in orders:&#10;1. __________________  2. __________________  3. __________________&#10;4. __________________  5. __________________  6. __________________&#10;&#10;Words that mean this is probably NOT a ruling:&#10;notice / declaration / opposition / reply / request / memorandum in support / other: ____________&#10;&#10;Order titles to include: order / opinion / memorandum / judgment / findings / other: ____________" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="790" width="700" height="175" as="geometry" />
        </mxCell>

        <mxCell id="atw-ws-extract" value="D. What to Extract From Each Order&#10;Key dollar amounts / numbers: ________________________________________________&#10;Key yes/no fields: ___________________________________________________________&#10;Key categorical fields: ______________________________________________________&#10;Citations/statutes that matter: ______________________________________________&#10;&#10;Reasoning questions an associate should answer:&#10;1. What legal standard did the judge apply?&#10;2. Why did the judge reach the result?&#10;3. Which fact or element was decisive?&#10;4. What pattern would matter to a lawyer filing this motion?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="990" width="700" height="205" as="geometry" />
        </mxCell>

        <mxCell id="atw-ws-map" value="E. Decision Map: Factors and Subfactors&#10;For independent topics: list the scrutiny factors that push outcome high/low.&#10;For conjunctive topics: list each required element, then factors under each element.&#10;&#10;Element / Factor: ________________________________&#10;What proves it? ______________________________________________________________&#10;What defeats it? _____________________________________________________________&#10;Terms of art judges use: ____________________________________________________&#10;Yes/no leaf question: Did the court rely on ________________________________ ?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="120" y="1220" width="700" height="145" as="geometry" />
        </mxCell>

        <mxCell id="atw-map-1" value="Topic schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="930" y="465" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="atw-map-2" value="Search recipe&#10;find likely orders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1230" y="430" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="atw-map-3" value="Extraction recipe&#10;pull outcomes, amounts, reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1230" y="530" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="atw-map-4" value="Factor tree&#10;elements → factors → yes/no leaf questions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1230" y="630" width="230" height="75" as="geometry" />
        </mxCell>
        <mxCell id="atw-map-5" value="Presentation recipe&#10;plain-English prediction for lawyers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="1230" y="735" width="230" height="70" as="geometry" />
        </mxCell>

        <mxCell id="atw-me1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-map-1" target="atw-map-2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="atw-me2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-map-1" target="atw-map-3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="atw-me3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-map-1" target="atw-map-4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="atw-me4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="atw-map-1" target="atw-map-5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="atw-good" value="Good attorney input looks like this:&#10;&#10;Topic: preliminary injunction&#10;Outcome: granted / denied / partial / TRO only&#10;Elements: likelihood of success, irreparable harm, balance of equities, public interest&#10;Leaf question: Did the court require non-speculative irreparable harm?&#10;Search terms: preliminary injunction, TRO, irreparable harm, likelihood of success&#10;Practitioner question: What argument does this judge usually treat as the weak link?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="860" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="atw-bad" value="Not enough detail:&#10;&#10;&quot;Judges decide preliminary injunctions by equity.&quot;&#10;&#10;Why not enough? It does not tell us what orders to find, what outcome to measure, which elements matter, what terms judges use, or what the model should extract." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="930" y="1080" width="620" height="130" as="geometry" />
        </mxCell>

        <mxCell id="atw-final" value="Final lawyer check before marking attorney-reviewed:&#10;[ ] This is a real recurring issue in written rulings.&#10;[ ] Outcomes are measurable from the order.&#10;[ ] Search terms find rulings, not just filings.&#10;[ ] Factor tree matches the doctrine lawyers actually argue.&#10;[ ] Leaf questions are answerable yes/no from the order text.&#10;[ ] Prediction output answers a question a lawyer would ask before filing." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="1230" width="620" height="135" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
