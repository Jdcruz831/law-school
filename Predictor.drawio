        <mxCell id="bt-e12" value="analysis" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8b5cf6;fontSize=11;" edge="1" parent="1" source="bt-resolved" target="bt-excerpt"><mxGeometry relative="1" as="geometry" /></mxCell>
