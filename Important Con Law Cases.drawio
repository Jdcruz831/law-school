<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Con Law case chart" version="24.7.17">
  <diagram id="page0" name="Start here">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CON LAW · IMPORTANT CASES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Scope: cases named on Constitution and Test Prep in your saved chart. Study map as of November 7, 2026; not a syllabus or a prediction of exam coverage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="intro0" value="&lt;b&gt;1 · Can a federal court decide?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Jurisdiction → standing → timing → political question → state grounds → immunity. Start with Judicial review, Standing, and State immunity tabs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="intro1" value="&lt;b&gt;2 · Which government actor?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Congress → identify a power, then constitutional limits. President → Youngstown and any exclusive power. State → supremacy, preemption, and Dormant Commerce Clause." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="intro2" value="&lt;b&gt;3 · Find the closest factual analogy&lt;/b&gt;&lt;br&gt;&lt;br&gt;Every case card contains a fact trigger, rule, and exam distinction. Compare opposite outcomes: Lopez/Raich; Dole/NFIB; New York/Garcia; Philadelphia/Maine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="intro3" value="&lt;b&gt;4 · Scope and source key&lt;/b&gt;&lt;br&gt;&lt;br&gt;54 distinct cases from both pages. Each case has an original page and cell reference. Some Test Prep-only abbreviations have been expanded from context (Jones, Reno, Garcia, Callais)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="440" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="intro4" value="&lt;b&gt;5 · Coverage conclusion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Test Prep is incomplete as a substitute for Constitution. Open Coverage audit for omissions and partial coverage. A case name appearing once does not equal a complete doctrinal framework." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="220" as="geometry" />
        </mxCell>
        <mxCell id="intro5" value="&lt;b&gt;6 · How to use the chart&lt;/b&gt;&lt;br&gt;&lt;br&gt;Open this file in draw.io and select a topic tab. The companion HTML is searchable and printable. The downloaded original chart remains the source; this file is a separate study aid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page1" name="Judicial review &amp; jurisdiction">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="JUDICIAL REVIEW &amp; JURISDICTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="8 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;Marbury v. Madison (1803)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Undelivered judicial commission; original mandamus request.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Courts apply the Constitution over conflicting statutes; Congress cannot enlarge SCOTUS original jurisdiction.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Right and remedy do not establish this court&amp;#x27;s jurisdiction.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / qmnBMAegnWpMgDC_wxlf-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Fletcher v. Peck (1810)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Georgia rescinds an earlier land grant.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; A state statute can be invalidated under the federal Constitution; rescinding the grant impaired contractual obligations.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Federal judicial review reaches state legislation.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / KJExrowZUuuFt-tTXspJ-3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Martin v. Hunter’s Lessee (1816)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Virginia refuses to follow a Supreme Court mandate about land title.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; SCOTUS may review state-court decisions on federal questions; uniform federal law requires review.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Review attaches to the federal issue, not the identity of the state court.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / KJExrowZUuuFt-tTXspJ-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Cohens v. Virginia (1821)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State criminal conviction involving a claimed federal lottery authorization.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; SCOTUS appellate review of federal questions extends to state criminal judgments even when a state is a party.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; State participation does not automatically make every case exclusively original.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / COWE_IKI9RGzQCRLrS6F-1; Constitution / C0olnXspH3CQYHDvb34H-19; Test Prep / HG-kfVQ57Oy37fDg51bK-10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case4" value="&lt;b&gt;Kline v. Burke Construction Co. (1922)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Parallel state and federal contract litigation.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Lower federal courts need statutory jurisdiction within Article III&amp;#x27;s constitutional capacity.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Constitutional capacity and statutory conferral are separate; jurisdictional control has constitutional limits.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / nGnvCsMC4TkzJVelY6of-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case5" value="&lt;b&gt;Ex parte McCardle (1869)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Congress repeals the statutory appellate habeas route during litigation.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Court dismisses under the Exceptions Clause after Congress withdraws that appellate route.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; An alternative habeas route remained; the Court did not approve every conceivable jurisdiction strip.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / 18EV3NXly3eGwHwJ9PCQ-4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case6" value="&lt;b&gt;United States v. Klein (1871)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Congress changes the legal effect of presidential pardons in pending claims.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may not use jurisdictional legislation to force unconstitutional judicial action or dictate results under existing law.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Congress may change substantive law applicable to pending cases; Klein is not a ban on all outcome-affecting laws.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / C0olnXspH3CQYHDvb34H-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case7" value="&lt;b&gt;Trump v. CASA, Inc. (2025)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Universal injunctions against the birthright-citizenship order.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; At the stay stage, injunctions likely exceeded statutory equitable authority insofar as broader than necessary for complete relief to plaintiffs with standing.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Complete relief can have effects beyond parties; class relief and APA remedies are distinct. CASA did not decide citizenship merits.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / 9A686LOlzWrqTdymGBHn-2; Test Prep / HG-kfVQ57Oy37fDg51bK-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page2" name="Standing &amp; justiciability">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="STANDING &amp; JUSTICIABILITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="8 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;Spokeo, Inc. v. Robins (2016)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Allegedly inaccurate personal information published by a people-search service.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Concrete and particularized are separate requirements; a bare procedural statutory violation may lack concrete injury.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; SCOTUS remanded for concreteness analysis; it did not finally hold Robins had no concrete harm.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;TransUnion LLC v. Ramirez (2021)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Credit files wrongly flag consumers; only some reports reach third parties.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; A statutory violation alone does not establish concrete harm; disseminated false reports supported reputational injury.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; For damages, future risk alone did not establish concrete injury for the undisclosed-file group.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Summers v. Earth Island Institute (2009)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Forest challenge continues after the concrete project dispute is settled.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; An organization needs an identified member facing concrete, imminent harm; someday plans are insufficient.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Aesthetic injury can count, but connect it to a member, place, and likely visit.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Allen v. Wright (1984)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Parents challenge IRS exemptions for discriminatory private schools.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; The asserted school-integration injury was too dependent on independent third-party choices for traceability.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Stigmatic injury alone also failed for plaintiffs not personally denied equal treatment.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-15; Constitution / cJ5OH2NNq5MmNCnX_mFG-20; Constitution / cJ5OH2NNq5MmNCnX_mFG-33; Constitution / cJ5OH2NNq5MmNCnX_mFG-42; Constitution / ltZLwBbUF2npR7WB0Q-s-48&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case4" value="&lt;b&gt;City of Los Angeles v. Lyons (1983)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Past police chokehold; request to enjoin future use.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Past injury may support damages but does not alone establish a real and immediate threat for an injunction.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Analyze standing separately for each requested remedy.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case5" value="&lt;b&gt;Susan B. Anthony List v. Driehaus (2014)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Speakers fear enforcement of a law regulating campaign statements.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Pre-enforcement standing can rest on intended arguably protected conduct, a statutory prohibition, and a credible enforcement threat.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; A plaintiff need not violate the law and await prosecution first.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-33&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case6" value="&lt;b&gt;Zivotofsky v. Clinton (2012)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Passport birthplace statute conflicts with executive policy.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Interpreting a statute and assessing its constitutionality is a judicial task, even in a foreign-affairs dispute.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; This is the justiciability decision; distinguish the 2015 merits decision.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-38; Constitution / cJ5OH2NNq5MmNCnX_mFG-40; Constitution / Jr_ydECLnp-rl0KPYuwt-26&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case7" value="&lt;b&gt;Rucho v. Common Cause (2019)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Partisan packing and cracking in congressional maps.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Federal partisan-gerrymandering claims present political questions without judicially manageable constitutional standards.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Do not equate partisan claims with all racial or voting-rights claims.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-42&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page3" name="State immunity">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="STATE IMMUNITY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="4 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;Hans v. Louisiana (1890)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Citizen sues the citizen&amp;#x27;s own state in federal court.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; State sovereign immunity extends beyond the Eleventh Amendment&amp;#x27;s literal out-of-state-plaintiff wording.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Check consent, valid abrogation, structural surrender, and officer-suit routes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / C0olnXspH3CQYHDvb34H-5; Test Prep / HG-kfVQ57Oy37fDg51bK-4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Ex parte Young (1908)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State officer threatens to enforce an unconstitutional statute.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Prospective relief against an enforcing state officer can stop an ongoing violation of federal law.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Not a general route to retrospective damages from the state treasury; not merely a contempt doctrine.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / 9A686LOlzWrqTdymGBHn-3; Test Prep / HG-kfVQ57Oy37fDg51bK-2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Galette v. New Jersey Transit Corp. (2026)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Bus-accident suits against NJ Transit in other states&amp;#x27; courts.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; NJ Transit is not an arm of New Jersey entitled to its interstate sovereign immunity.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Examine entity structure, state liability, and control; state-created does not automatically mean immune.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / C0olnXspH3CQYHDvb34H-7; Test Prep / HG-kfVQ57Oy37fDg51bK-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Fitzpatrick v. Bitzer (1976)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State employees seek Title VII damages for sex discrimination.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Valid Fourteenth Amendment §5 legislation can abrogate state immunity.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Require unmistakably clear intent and valid enforcement legislation; ordinary Article I power usually does not suffice.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / HG-kfVQ57Oy37fDg51bK-9&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page4" name="Congressional powers 1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CONGRESSIONAL POWERS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="8 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;McCulloch v. Maryland (1819)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; National bank charter and Maryland&amp;#x27;s tax on the bank.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may use appropriate means adapted to legitimate enumerated ends; a state cannot tax the federal bank.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Necessary does not mean indispensable. Analyze both implied power and federal supremacy.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-53; Constitution / Jr_ydECLnp-rl0KPYuwt-32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Wickard v. Filburn (1942)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Homegrown wheat substitutes for purchases.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may aggregate the interstate effects of a class of local economic activity.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Home consumption is not automatically outside commerce power.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / oQBPyLlifDMNVyRZqu1i-1; Test Prep / JmaqZS_z_HP7oz48ixAH-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Heart of Atlanta Motel v. United States (1964)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Motel serving interstate travelers discriminates by race.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may prohibit discrimination in accommodations affecting interstate commerce.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Connect the business and burden to interstate travel.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / oQBPyLlifDMNVyRZqu1i-3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Katzenbach v. McClung (1964)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Local restaurant buys food moving through interstate commerce.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may reach local restaurant discrimination based on the aggregate effects of that economic class.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Local customers do not end the commerce inquiry.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / oQBPyLlifDMNVyRZqu1i-3&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case4" value="&lt;b&gt;United States v. Lopez (1995)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Federal ban on gun possession near schools.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Commerce power reaches channels, instrumentalities/persons/things, and activities substantially affecting commerce; this law exceeded it.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Noneconomic possession plus attenuated economic consequences lacks a meaningful limiting principle.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / c0eh9S0Abd1rjmFVfu8c-9; Test Prep / Xi6R8VFtuRbqRZCLOG7g-2; Test Prep / B6Lnn4QgyuMP3YLCs58v-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case5" value="&lt;b&gt;United States v. Morrison (2000)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Federal civil remedy for gender-motivated violence.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Aggregate economic consequences do not alone justify regulating noneconomic violence under the Commerce Clause.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Fourteenth Amendment enforcement also cannot directly remedy purely private conduct here.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / bpNmOR_SoLcWIGrnu4r9-12; Test Prep / yBkmQJfWIpP3PkYPqzID-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case6" value="&lt;b&gt;Gonzales v. Raich (2005)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Locally cultivated medical marijuana used at home.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may regulate local instances of an economic class within a comprehensive interstate commodity scheme.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Compare the comprehensive market regulation with Lopez and Morrison.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / c0eh9S0Abd1rjmFVfu8c-11; Test Prep / TKLQM6di_nTa3z7qgkxl-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case7" value="&lt;b&gt;NFIB v. Sebelius (2012)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Insurance payment and threatened loss of existing Medicaid funds.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Commerce did not authorize compelling entry into commerce; Roberts rejected Necessary &amp;amp; Proper; payment survived as a tax; Medicaid threat was coercive.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Analyze each power separately. Label is not decisive; expansion funds could be conditioned without threatening existing funding.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / c0eh9S0Abd1rjmFVfu8c-13; Constitution / bpNmOR_SoLcWIGrnu4r9-3; Test Prep / Y0OPa0thbyV8DsBOdKr--1; Test Prep / D-PfUDDaMhyuyHUpV2Kp-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page5" name="Congressional powers 2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CONGRESSIONAL POWERS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="1 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;South Dakota v. Dole (1987)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Small share of highway funds conditioned on drinking age 21.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Spending conditions need general welfare, clear notice, relatedness, no independent constitutional bar, and no coercion.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; The modest inducement survived; compare NFIB&amp;#x27;s existing-funding threat.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / bpNmOR_SoLcWIGrnu4r9-1; Test Prep / Xi6R8VFtuRbqRZCLOG7g-6; Test Prep / Gnz2annpa-CYrGyf_cMR-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page6" name="Reconstruction enforcement">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RECONSTRUCTION ENFORCEMENT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="4 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;Jones v. Alfred H. Mayer Co. (1968)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Private refusal to sell a home because of race.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may rationally identify and legislate against badges and incidents of slavery under Thirteenth Amendment §2.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Unlike Fourteenth Amendment §5, this power can reach private racial discrimination.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / HdfO-nH2aJV_gOckw8U0-14&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;City of Boerne v. Flores (1997)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; RFRA applied to state/local land-use decisions.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Fourteenth Amendment §5 is remedial; prophylactic legislation needs congruence and proportionality to constitutional injury.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Congress enforces constitutional rights; it does not redefine their substance.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / HdfO-nH2aJV_gOckw8U0-11&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Louisiana v. Callais (2026)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Louisiana creates a second majority-Black district to meet asserted VRA duties.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Court invalidated the racial gerrymander and construed VRA §2 to fit Fifteenth Amendment enforcement limits, invoking congruence and proportionality.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Distinguish Boerne&amp;#x27;s Fourteenth Amendment setting; review Callais&amp;#x27;s specific §2 framework for a redistricting question.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / HdfO-nH2aJV_gOckw8U0-12&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Shelby County v. Holder (2013)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Old coverage formula determines jurisdictions subject to preclearance.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; VRA §4(b)&amp;#x27;s differential coverage was invalid because it did not reflect current conditions justifying the burdens.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; The decision invalidated the coverage formula, not VRA §2 or the text of §5 preclearance itself.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / vA_hC0EoCeZEVq46xzTu-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page7" name="Federalism &amp; executive power">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="FEDERALISM &amp; EXECUTIVE POWER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="7 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;New York v. United States (1992)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; States must regulate radioactive waste or take title and liability.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress cannot compel state legislatures to administer a federal regulatory program.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Both alternatives were unconstitutional commands; permissible funding incentives are different.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / okMoveg5JXnLUUQTt713-14; Test Prep / gDnyKX3dXUXfb1rj6tRG-1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Printz v. United States (1997)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Local officers ordered to run federal handgun background checks.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress cannot conscript state/local executive officials to administer federal law.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Temporary duties do not cure commandeering; distinguish direct regulation of the state&amp;#x27;s own activity.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / gDnyKX3dXUXfb1rj6tRG-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Murphy v. NCAA (2018)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Federal law prevents states from repealing sports-betting prohibitions.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; An order to retain state prohibitions commandeers legislative authority just as an order to enact them does.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Valid preemption regulates private actors pursuant to federal power; a bare order to a legislature is different.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / gDnyKX3dXUXfb1rj6tRG-10&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Garcia v. San Antonio Metropolitan Transit Authority (1985)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Federal wage-and-hour law applied to a public transit employer.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Generally applicable federal employment regulation can govern state/local employers.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; The state is regulated as an employer, rather than ordered to regulate its residents.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / gDnyKX3dXUXfb1rj6tRG-4&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case4" value="&lt;b&gt;Reno v. Condon (2000)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Federal law restricts disclosure of DMV personal information.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may regulate a state&amp;#x27;s own database activities without requiring it to regulate private citizens.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Contrast state-as-data-holder with conscripted state regulator.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Test Prep / gDnyKX3dXUXfb1rj6tRG-6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case5" value="&lt;b&gt;Youngstown Sheet &amp;amp; Tube Co. v. Sawyer (1952)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; President seizes steel mills during the Korean War.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Seizure lacked authority; Jackson&amp;#x27;s concurrence organizes power by congressional authorization, silence, or opposition.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Maximum authority → twilight → lowest ebb. Commander in Chief is not general domestic lawmaking power.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / Jr_ydECLnp-rl0KPYuwt-21&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case6" value="&lt;b&gt;Zivotofsky v. Kerry (2015)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Congress directs passports to list Israel for Jerusalem-born citizens.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; President&amp;#x27;s exclusive recognition power prevails over a conflicting statute.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; An exclusive power may prevail at Youngstown&amp;#x27;s lowest ebb; this is not exclusive control of all foreign affairs.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / cJ5OH2NNq5MmNCnX_mFG-38; Constitution / cJ5OH2NNq5MmNCnX_mFG-40; Constitution / Jr_ydECLnp-rl0KPYuwt-26&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page8" name="Supremacy &amp; preemption">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SUPREMACY &amp; PREEMPTION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="2 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;Dawson v. Steager (2019)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State tax break benefits certain state retirees but excludes a similar federal marshal.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Discriminatory taxation of materially similar federal retirees violates intergovernmental tax immunity under 4 U.S.C. §111.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Compare duties and relevant differences, not merely job titles.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / Jr_ydECLnp-rl0KPYuwt-28&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Pacific Gas &amp;amp; Electric Co. v. State Energy Resources Conservation &amp;amp; Development Commission (1983)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; California pauses nuclear construction over waste-disposal economics.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Federal occupation of nuclear safety did not displace the state&amp;#x27;s preserved economic regulation.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Separate express, field, impossibility, and obstacle analysis; permission to build is not a command to build.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-13&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page9" name="Dormant Commerce Clause 1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DORMANT COMMERCE CLAUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="8 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;City of Philadelphia v. New Jersey (1978)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State bans imported waste while accepting equivalent local waste.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Facial discrimination is virtually per se invalid absent a legitimate goal with no adequate nondiscriminatory alternative.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; A legitimate environmental aim does not justify discriminatory means.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-23&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Hughes v. Oklahoma (1979)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State bars export of locally caught minnows.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Natural-resource conservation does not excuse discriminatory export restrictions when alternatives exist.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; State ownership rhetoric does not remove commerce scrutiny.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;Dean Milk Co. v. Madison (1951)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Milk must be processed within five miles of the city.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; A geographic restriction fails where reasonable nondiscriminatory health protections are available.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Harming some in-state businesses does not cure discrimination against interstate commerce.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-28&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Maine v. Taylor (1986)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Ban on imported live baitfish protects local ecosystems.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Discrimination survived because legitimate ecological risks had no adequate practicable nondiscriminatory alternative.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; The rare successful justification; compare Philadelphia and Hughes.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-30&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case4" value="&lt;b&gt;Bacchus Imports, Ltd. v. Dias (1984)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Hawaii exempts selected local alcoholic products from its tax.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Protectionist purpose and discriminatory effect invalidate the local-product exemption.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Helping only a small local industry is still protectionism.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-32&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case5" value="&lt;b&gt;United Haulers Ass’n v. Oneida-Herkimer Solid Waste Management Authority (2007)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Waste must go to publicly owned facilities; all private firms treated alike.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Favoring a public provider performing a traditional public function is not the same discrimination as favoring local private business.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Continue to examine nondiscriminatory burdens; public ownership is not a universal exemption.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-34&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case6" value="&lt;b&gt;Pike v. Bruce Church, Inc. (1970)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State requires local packing of locally grown cantaloupes.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; An evenhanded local law fails if its interstate burden is clearly excessive relative to putative local benefits.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; First separate discriminatory laws from this burden-balancing route.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-40&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case7" value="&lt;b&gt;Kassel v. Consolidated Freightways Corp. (1981)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Iowa restricts truck length, forcing rerouting or equipment changes.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; The restriction failed in light of interstate burdens and weak asserted safety benefits; opinions differed in reasoning.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Examine evidence and exceptions rather than accepting a safety label at face value.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-40&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page10" name="Dormant Commerce Clause 2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DORMANT COMMERCE CLAUSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="4 case cards · Facts → Rule → Exam cue. Source references point into your original Con Law.drawio. Cross-topic cases appear once; use search in the preview." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="case0" value="&lt;b&gt;National Pork Producers Council v. Ross (2023)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; California conditions in-state pork sales on production standards affecting farms elsewhere.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Out-of-state effects alone do not create an almost per se violation; the pleaded challenge failed.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Fractured Pike reasoning did not abolish Pike; identify an interstate-commerce burden, not simply compliance cost.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-42&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case1" value="&lt;b&gt;Reeves, Inc. v. Stake (1980)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State-owned cement plant favors resident buyers.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; A state participating in the market may generally favor residents under the Dormant Commerce Clause.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; This exception concerns participation in the relevant market, not regulatory authority everywhere.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-44&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case2" value="&lt;b&gt;South-Central Timber Development, Inc. v. Wunnicke (1984)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; State timber sale requires later in-state processing.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Market-participant protection does not extend to downstream restrictions outside the market in which the state participates.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Separate selling raw timber from regulating later processing.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-46&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="600" height="480" as="geometry" />
        </mxCell>
        <mxCell id="case3" value="&lt;b&gt;Prudential Insurance Co. v. Benjamin (1946)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;FACTS&lt;/b&gt; Congress authorizes state insurance regulation and taxation despite interstate effects.&lt;br&gt;&lt;br&gt;&lt;b&gt;RULE&lt;/b&gt; Congress may authorize state discrimination that the dormant commerce limitation would otherwise prohibit.&lt;br&gt;&lt;br&gt;&lt;b&gt;EXAM CUE&lt;/b&gt; Identify congressional authorization; other constitutional constraints remain.&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#657788&quot;&gt;SOURCE Constitution / ltZLwBbUF2npR7WB0Q-s-48&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="690" width="600" height="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page11" name="Coverage audit 1">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DOES TEST PREP COVER CONSTITUTION? · NO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Compared actual text on both pages, not merely matching case names. “Covered” means comparable study substance, not a guarantee of exam completeness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="audit0" value="&lt;b&gt;Judicial review &amp;amp; jurisdiction · MISSING / PARTIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cohens appears only in the immunity context. Add Marbury, Fletcher, Martin, statutory jurisdiction, Kline, McCardle, Klein, and original versus appellate jurisdiction." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3eb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit1" value="&lt;b&gt;Standing · MISSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add injury (concrete, particularized, actual/imminent), causation, redressability, relief-specific and provision-specific standing. Cases: Spokeo, TransUnion, Summers, Allen, Lyons." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3eb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit2" value="&lt;b&gt;Timing &amp;amp; review limits · MISSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add ripeness/mootness, pre-enforcement standing (SBA List), political questions (Zivotofsky/Clinton and Rucho), and adequate/independent state grounds. Constitution itself gives only brief timing rules." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3eb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit3" value="&lt;b&gt;Commerce &amp;amp; Necessary and Proper · MOSTLY COVERED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lopez, Wickard, Morrison, Raich, and NFIB are present. Add McCulloch by name and its legitimate-end/appropriate-means analysis; add Heart of Atlanta and McClung applications." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7f4;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="490" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit4" value="&lt;b&gt;Taxing &amp;amp; spending · PARTIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Core tax-versus-penalty and Dole/NFIB rules are present. Missing express treatment of labels not controlling, permissible behavioral purpose, export-tax limits, direct-tax apportionment, Sixteenth Amendment, and transfer-versus-ownership taxes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7f4;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit5" value="&lt;b&gt;State sovereign immunity · SUBSTANTIALLY COVERED&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hans, Galette, Young, waiver, structural surrender, abrogation and Cohens review appear. Correct overstatements: immunity is not absolute; Young concerns ongoing federal violations and prospective relief." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7f4;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="790" width="600" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page12" name="Coverage audit 2">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DOES TEST PREP COVER CONSTITUTION? · NO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Compared actual text on both pages, not merely matching case names. “Covered” means comparable study substance, not a guarantee of exam completeness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="audit0" value="&lt;b&gt;Executive power · MISSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add Article II authority and Youngstown categories, the steel-seizure application, and Zivotofsky/Kerry recognition power; Constitution also has Article II structural text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3eb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit1" value="&lt;b&gt;Federal immunity &amp;amp; preemption · MISSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add McCulloch, Dawson, federal-officer immunity, express/field/conflict preemption, and PG&amp;amp;E. Separate impossibility from obstacle conflict." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3eb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit2" value="&lt;b&gt;Dormant Commerce Clause · MISSING&lt;/b&gt;&lt;br&gt;&lt;br&gt;Add discrimination versus Pike burdens; Philadelphia, Hughes, Dean Milk, Maine, Bacchus, United Haulers, Kassel, National Pork Producers; market participation, downstream limits, congressional authorization." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3eb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit3" value="&lt;b&gt;Constitutional text &amp;amp; structure · PARTIAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Test Prep summarizes selected powers, not the fuller Article I/II/III text, Article III tenure/pay and criminal-trial provisions, or all enumerated powers found in Constitution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7f4;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="490" width="600" height="270" as="geometry" />
        </mxCell>
        <mxCell id="audit4" value="&lt;b&gt;Material added by Test Prep · ADDITIONAL COVERAGE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Test Prep adds Jones, Boerne, Callais, Shelby County, Fitzpatrick, Garcia, Reno, Printz and Murphy. Constitution is not a complete substitute for Test Prep either." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f7f4;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="600" height="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page13" name="Corrections &amp; sources">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="CORRECTIONS AND SOURCES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The new case cards use qualified formulations where the original notes overstate or mislabel a rule. Original notes are preserved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fix0" value="&lt;b&gt;Supremacy Clause quotation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Constitution labels the Tenth Amendment reservation of powers as Article VI supremacy text. Article VI instead makes the Constitution, valid federal laws, and treaties supreme over contrary state law." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix1" value="&lt;b&gt;Article III labels&lt;/b&gt;&lt;br&gt;&lt;br&gt;Article III §2 cl.1 defines categories of judicial power, not exclusively appellate jurisdiction. Clause 2 separates SCOTUS original and appellate jurisdiction. Cohens prevents treating every state-party case as exclusively original." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="190" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix2" value="&lt;b&gt;Spokeo and Klein&lt;/b&gt;&lt;br&gt;&lt;br&gt;Spokeo remanded for a separate concreteness analysis; it did not finally reject Robins’s injury. Klein does not prohibit Congress from changing substantive law applicable to pending litigation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="495" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix3" value="&lt;b&gt;McCardle and Young&lt;/b&gt;&lt;br&gt;&lt;br&gt;McCardle left an alternate habeas route intact but did not decide all constitutional limits on jurisdiction stripping. Young allows certain prospective federal-law suits against officers; its core is not judicial contempt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="495" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix4" value="&lt;b&gt;CASA and relief&lt;/b&gt;&lt;br&gt;&lt;br&gt;CASA concerns the scope of statutory equitable authority at the stay stage. Relief may reach beyond named parties when needed to give plaintiffs complete relief. It did not hold that class actions are the only possible broad remedy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix5" value="&lt;b&gt;Tax and spending language&lt;/b&gt;&lt;br&gt;&lt;br&gt;A payment need not be labeled a tax to be sustained under the taxing power. Conditional spending concerns grants/funding conditions, not just enforcement of ordinary government contracts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="800" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix6" value="&lt;b&gt;National Pork Producers&lt;/b&gt;&lt;br&gt;&lt;br&gt;The decision rejected automatic invalidation based merely on out-of-state effects. Its fragmented Pike analysis should not be compressed into a universal rule resolving every extraterritorial regulation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="1105" width="600" height="275" as="geometry" />
        </mxCell>
        <mxCell id="fix7" value="&lt;b&gt;Limits on this review&lt;/b&gt;&lt;br&gt;&lt;br&gt;The case scope comes from your chart, not a class syllabus or lecture history. Non-case topics remain important. The audit compares your two pages; it does not certify that either page covers the full course." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="680" y="1105" width="600" height="275" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page14" name="Source links">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1320" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="SOURCE LINKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10283f;strokeColor=#10283f;fontColor=#ffffff;fontSize=26;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Case selection and original notes: your saved chart. Recent opinions and selected doctrinal corrections were checked against the linked materials. Other cards synthesize the source notes; this is not a full citator review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf3f8;strokeColor=#edf3f8;fontColor=#10283f;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1240" height="70" as="geometry" />
