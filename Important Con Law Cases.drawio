          <mxGeometry x="40" y="500" width="1240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="src3" value="&lt;b&gt;CASA opinion&lt;/b&gt;&lt;br&gt;https://www.law.cornell.edu/supremecourt/text/24A884" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1" link="https://www.law.cornell.edu/supremecourt/text/24A884">
          <mxGeometry x="40" y="655" width="1240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="src4" value="&lt;b&gt;TransUnion opinion&lt;/b&gt;&lt;br&gt;https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1" link="https://www.supremecourt.gov/opinions/20pdf/20-297_4g25.pdf">
          <mxGeometry x="40" y="810" width="1240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="src5" value="&lt;b&gt;National Pork Producers opinion&lt;/b&gt;&lt;br&gt;https://www.supremecourt.gov/opinions/22pdf/21-468_c0ne.pdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1" link="https://www.supremecourt.gov/opinions/22pdf/21-468_c0ne.pdf">
          <mxGeometry x="40" y="965" width="1240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="src6" value="&lt;b&gt;Congressional Research Service: jurisdiction and Klein&lt;/b&gt;&lt;br&gt;https://www.congress.gov/crs_external_products/R/PDF/R44967/R44967.7.pdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f8fb;strokeColor=#c9d5df;fontColor=#10283f;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=top;spacing=18;overflow=hidden;" vertex="1" parent="1" link="https://www.congress.gov/crs_external_products/R/PDF/R44967/R44967.7.pdf">
          <mxGeometry x="40" y="1120" width="1240" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
