          </mxGeometry>
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-47" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-12" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-46" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-12" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Built-in cause of action&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;DeVillier, 601 U.S. at 291&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;An owner may bring an uncompensated-taking claim in federal court under § 1983.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="350" x="-350" y="685" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Official conduct&amp;nbsp;even when the official abuses or exceeds lawful authority&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;West v. Atkins, 487 U.S. 42, 49–50 (1988)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Official conduct can remain under color of state law even when the official abuses or exceeds lawful authority.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="370" x="110" y="1270" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-19" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-16" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-24" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-16" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-23" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-26" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-16" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-25" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-40" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-16" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-39" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-16" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Municipal policy or custom&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell, 436 U.S. at 691, 694&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The municipality’s policy or custom must cause the deprivation; employing the responsible officer is insufficient.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="520" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;single official decision can establish policy&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Pembaur, 475 U.S. at 480&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A single decision by a properly constituted legislative body can constitute official municipal policy.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="310" x="920" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-22" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-20" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" target="t4PtQhD98tMtrIm2gATw-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Direct causation&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Bryan County, 520 U.S. at 404–05&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The municipality’s own action must directly cause the deprivation. When that action itself violates federal law, it establishes the necessary municipal causation.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="810" y="930" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;TIE:&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;Ending the taking does not erase compensation owed for its duration&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell, 436 U.S. at 691, 694&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The municipality’s policy or custom must cause the deprivation; employing the responsible officer is insufficient.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="470" x="60" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-28" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-25" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-27" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-51" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-25" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" target="t4PtQhD98tMtrIm2gATw-48">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-25" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;municipalities later denied compensation is&amp;nbsp;municipal policy&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Slaybaugh v. Rutherford County&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The municipality’s policy or custom must cause the deprivation; employing the responsible officer is insufficient.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="880" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-27" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;sheriff&#39;s offices are funded by governing bodies, and thus suit may be brought against the county.&amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Slaybaugh v. Rutherford County&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;697&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Tenn. Code Ann. § 8-8-201, provides that sheriff&#39;s offices are to be funded by county governing bodies, id. § 8-20-120, and further provides that any person incurring an injury “resulting from any act or failure to act on the part of any deputy appointed by the sheriff may bring suit against the county in which the sheriff serves,” id. § 8-8-302(a) &amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="430" x="820" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-32" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-29" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-31" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-29" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;§ 1983 supplies the exclusive federal damages remedy for violations of § 1981 rights by state actors.&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Jett v. Dallas Indep. Sch. Dist., 491 U.S. 701, 733, 109 S. Ct. 2702, 2722, 105 L. Ed. 2d 598 (1989)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="580" x="-1030" y="740" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-34" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-31" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-33" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-31" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;§1981 &amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;All persons&amp;nbsp;have the same right in every State and Territory to make and enforce contracts, to sue, be parties and give evidence&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="580" x="-1300" y="970" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-33" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;1981 is only for Discrimination&lt;/b&gt;&amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;General Building Contractors v. Pennsylvania&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;We conclude, therefore, that § 1981, like the Equal Protection Clause, can be violated only by purposeful discrimination.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Gen. Bldg. Contractors Ass&#39;n, Inc. v. Pennsylvania, 458 U.S. 375, 391, 102 S. Ct. 3141, 3150, 73 L. Ed. 2d 835 (1982)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="580" x="-1470" y="1190" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-38" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-35" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-37" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-35" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;expressly declined to decide whether the Takings Clause itself supplies that cause of action.&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;DeVillier&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="650" x="-1850" y="660" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-49" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-37" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-48" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-53" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-37" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-52" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-56" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-37" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="t4PtQhD98tMtrIm2gATw-55" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-37" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;claims for just compensation are grounded in the Constitution itself&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-2310" y="910" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-39" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Town&#39;s and County&#39;s denial of responsibility for compensating the plaintiffs&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Slaybaugh v. Rutherford Cnty., Tennessee, &amp;nbsp;698-699&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;complete destruction to a home while arresting their son.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;signed by Captain Kyle Evans, Staff Attorney, and states that the “RCS[D] denies responsibility for any damage to your home.”&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;In short, the Complaint adequately alleges that the plaintiffs&#39; injury was directly caused by policies attributable to the Town and the County.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the decision was apparently made by an “official[ ] with final decision-making authority&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="650" x="140" y="1720" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-41" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;The ability to bring multiple routes to remedy, maybe limitations on remedies, but allowed to try multiple legal throeies.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule 8(d)(2)&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;A party may set out 2 or more claims . . . If a party makes alternative statements, the pleading itself is sufficient if any one of the claims are sufficient.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Fed. R. Civ. P. 8&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Cleveland v. Pol&#39;y Mgmt. Sys. Corp&lt;/b&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Our ordinary Rules recognize that a person may not be sure in advance upon which legal theory she will succeed, and so permits parties . . . &amp;nbsp;“state as many separate claims as the party has, regardless of consistency.”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Cleveland v. Pol&#39;y Mgmt. Sys. Corp&lt;/i&gt;., 526 U.S. 795, 805, 119 S. Ct. 1597, 1603, 143 L. Ed. 2d 966 (1999)&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="510" x="680" y="110" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-46" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Built-in cause of action&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;DeVillier, 601 U.S. at 291&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The availability of § 1983 does not establish its exclusivity.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Prior decisions show that property owners may use that statute to enforce their compensation rights;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;they do not resolve whether the Takings Clause independently authorizes a compensation claim.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;DeVillier expressly left that question open.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;We ask this Court to recognize our direct compensation claim based on the Clause’s self-executing obligation, as described in First English and Jacobs.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="460" x="-700" y="950" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-48" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;First English&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;no subsequent action by the government can relieve it of the duty to provide compensation&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-1310" y="1600" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-54" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-52" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" target="t4PtQhD98tMtrIm2gATw-48">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-52" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Self executing character of this specific constitutional provision&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;First English Evangelical Lutheran Church of Glendale v. Los Angeles County&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;We have recognized that a landowner is entitled to bring an action in inverse condemnation as a result of “ ‘the self-executing character of the constitutional provision with respect to compensation....’&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;482 U.S. 304, 315, 107 S.Ct. 2378, 2386&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Facts:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A church operated a campground for disabled children that was destroyed by flooding.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The county then adopted an ordinance prohibiting rebuilding in the flood area.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The church alleged that the ordinance deprived it of all use of its property and sought compensation. California courts rejected&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="680" x="-3040" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-55" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the right to just compensation could not be taken away by statute&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;The form of the remedy did not qualify the right. It rested upon the Fifth Amendment. Statutory recognition was not necessary.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Jacobs v. United States, 290 U.S. 13, 17, 54 S. Ct. 26, 28, 78 L. Ed. 142 (1933)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-2250" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;restitution principles recognize liability for benefits obtained through unauthorized property use&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="3130" y="950" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-3" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Section 1983’s existence does not categorically foreclose an independent restitution claim&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="2860" y="930" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-9" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;O’Donnell does not establish that police activity can never support unjust enrichment&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="3070" y="750" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Restitution must correspond to enrichment, with no duplicate recovery&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="3120" y="380" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-18" edge="1" parent="1" source="asF2fj-k3maLoz7lA8SP-15" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="asF2fj-k3maLoz7lA8SP-17" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-20" edge="1" parent="1" source="asF2fj-k3maLoz7lA8SP-15" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="asF2fj-k3maLoz7lA8SP-19" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2003.9473684210534" y="700.0000000000005" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-15" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;that local government can owe restitution for benefits obtained without authority&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;In Ward v. Board of Love County, Okl.&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- The Choctaw tribe being unlawfully taxed&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Supreme Court ruled that the Choctaw tribe was due restitution as the county was unjustly enriched, when they should not have been.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;even without statutory authority authorizing repayment&lt;i&gt;.&quot;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="610" x="1970" y="580" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-17" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Governmental bodies have an obligation to do justice&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;&amp;nbsp;Ward v. Board of Love County, Okl. 24&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Justice VAN DEVANTER&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the obligation to do justice rests upon all persons, natural and artificial .. &quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="1770" y="800" as="geometry" />
        </mxCell>
        <mxCell id="asF2fj-k3maLoz7lA8SP-19" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;The obligation can exist without an express repayment statute&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&amp;nbsp;&lt;i&gt;Ward v. Board of Love County, Okl. 24&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;...if a county obtains the money or property of others without authority, the law, independent of any statute, will compel restitution or compensation.’&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Statue is not needed, the common law supplements this right independently&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="2290" y="800" as="geometry" />
        </mxCell>
        <mxCell id="aPMj0_xVcds68NP1dcye-3" edge="1" parent="1" source="asF2fj-k3maLoz7lA8SP-17" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="aPMj0_xVcds68NP1dcye-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aPMj0_xVcds68NP1dcye-4" edge="1" parent="1" source="asF2fj-k3maLoz7lA8SP-19" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="aPMj0_xVcds68NP1dcye-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aPMj0_xVcds68NP1dcye-6" edge="1" parent="1" source="aPMj0_xVcds68NP1dcye-1" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="aPMj0_xVcds68NP1dcye-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aPMj0_xVcds68NP1dcye-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Property Claim&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Alleged wrong is unauthorized use of the Nguyens’ property without consent or payment&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="2030" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="aPMj0_xVcds68NP1dcye-10" edge="1" parent="1" source="aPMj0_xVcds68NP1dcye-5" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="aPMj0_xVcds68NP1dcye-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aPMj0_xVcds68NP1dcye-5" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Restitution is the proper relief for unjust enrichment.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Alleged wrong is unauthorized use of the Nguyens’ property without consent or payment&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Liu, 591 U.S. 71, 79–80 (2020)&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="1990" y="1290" as="geometry" />
        </mxCell>
