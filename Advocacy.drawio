        <mxCell id="k8BEP7BhALAoowO3T5WO-25" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-26" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-54" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-26" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Built-in cause of action&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;DeVillier, 601 U.S. at 291&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;An owner may bring an uncompensated-taking claim in federal court under § 1983.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="350" x="-350" y="685" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-27" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Official conduct&amp;nbsp;even when the official abuses or exceeds lawful authority&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;West v. Atkins, 487 U.S. 42, 49–50 (1988)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Official conduct can remain under color of state law even when the official abuses or exceeds lawful authority.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="390" x="-490" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-4" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-32" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-32" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;(b) Municipal policy or custom&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell, 436 U.S. at 691, 694&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The City Council&#39;s vote to deny repayment for the destruction is the Policy causing the harm to our clients.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="290" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-6" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-33" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-33" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Single official decision can establish policy&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Pembaur v. City of Cincinnati&lt;/i&gt;&lt;/span&gt;&lt;i&gt;, 475 U.S. at 480&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A single decision by a properly constituted legislative body can constitute official municipal policy.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;“municipal liability may be imposed for a single decision by municipal policymakers&quot; 480&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Facts&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Deputy sheriffs went to Dr. Pembaur’s medical clinic&amp;nbsp;chopped down the door with an axe in search for employees. the prosecutor after being informed of the situation said “go in and get [the witnesses].”&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="210" width="530" x="-30" y="1260" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-27" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-35" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-35" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Direct causation&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Bryan County, 520 U.S. at 404–05&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;When a municipality’s own decision violates a federal right, establishing that violation also establishes municipal causation.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;facts&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Court rejected liability based on the sheriff’s inadequate screening of a deputy.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;“proof that the municipality’s decision was unconstitutional would suffice to establish that the municipality itself was liable for the plaintiff’s constitutional injury.”&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="222" width="480" x="230" y="1818" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-36" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;TIE:&amp;nbsp;&lt;span style=&quot;text-align: left;&quot;&gt;Ending the taking does not erase compensation owed for its duration&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell, 436 U.S. at 691, 694&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The municipality’s policy or custom must cause the deprivation; employing the responsible officer is insufficient.&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="470" x="-1250" y="2570" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-37" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-39" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-40" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-39" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;municipalities later denied compensation is&amp;nbsp;municipal policy&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Slaybaugh v. Rutherford County&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-The municipality’s policy or custom must cause the deprivation; employing the responsible officer is insufficient.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="340" x="410" y="2790" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-40" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;sheriff&#39;s offices are funded by governing bodies, and thus suit may be brought against the county.&amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Slaybaugh v. Rutherford County&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;697&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Tenn. Code Ann. § 8-8-201, provides that sheriff&#39;s offices are to be funded by county governing bodies, id. § 8-20-120, and further provides that any person incurring an injury “resulting from any act or failure to act on the part of any deputy appointed by the sheriff may bring suit against the county in which the sheriff serves,” id. § 8-8-302(a) &amp;nbsp;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="430" x="830" y="2750" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-41" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-42" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-44" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-42" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;§ 1983 supplies the exclusive federal damages remedy for violations of § 1981 rights by state actors.&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Jett v. Dallas Indep. Sch. Dist., 491 U.S. 701, 733, 109 S. Ct. 2702, 2722, 105 L. Ed. 2d 598 (1989)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="580" x="-1030" y="740" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-43" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-44" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-45" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-44" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;§1981 &amp;nbsp;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;All persons&amp;nbsp;have the same right in every State and Territory to make and enforce contracts, to sue, be parties and give evidence&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="400" x="-1070" y="940" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-45" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;1981 is only for Discrimination&lt;/b&gt;&amp;nbsp; &amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;General Building Contractors v. Pennsylvania&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;We conclude, therefore, that § 1981, like the Equal Protection Clause, can be violated only by purposeful discrimination.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Gen. Bldg. Contractors Ass&#39;n, Inc. v. Pennsylvania, 458 U.S. 375, 391, 102 S. Ct. 3141, 3150, 73 L. Ed. 2d 835 (1982)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="580" x="-1290" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-46" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-47" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-51" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-47" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;expressly declined to decide whether the Takings Clause itself supplies that cause of action.&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;DeVillier&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="650" x="-1850" y="660" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-49" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-51" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-57" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-50" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-51" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-58" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-51" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;claims for just compensation are grounded in the Constitution itself&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-2310" y="910" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-53" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;The ability to bring multiple routes to remedy, maybe limitations on remedies, but allowed to try multiple legal throeies.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Rule 8(d)(2)&lt;/b&gt;:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;A party may set out 2 or more claims . . . If a party makes alternative statements, the pleading itself is sufficient if any one of the claims are sufficient.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Fed. R. Civ. P. 8&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;b&gt;Cleveland v. Pol&#39;y Mgmt. Sys. Corp&lt;/b&gt;:&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Our ordinary Rules recognize that a person may not be sure in advance upon which legal theory she will succeed, and so permits parties . . . &amp;nbsp;“state as many separate claims as the party has, regardless of consistency.”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i&gt;Cleveland v. Pol&#39;y Mgmt. Sys. Corp&lt;/i&gt;., 526 U.S. 795, 805, 119 S. Ct. 1597, 1603, 143 L. Ed. 2d 966 (1999)&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="510" x="680" y="110" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-54" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Built-in cause of action&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;DeVillier, 601 U.S. at 291&lt;/i&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The availability of § 1983 does not establish its exclusivity.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Prior decisions show that property owners may use that statute to enforce their compensation rights;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;they do not resolve whether the Takings Clause independently authorizes a compensation claim.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;DeVillier expressly left that question open.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;We ask this Court to recognize our direct compensation claim based on the Clause’s self-executing obligation, as described in First English and Jacobs.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="240" width="460" x="-560" y="910" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-55" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;First English&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;no subsequent action by the government can relieve it of the duty to provide compensation&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-1330" y="2340" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-56" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-57" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" target="k8BEP7BhALAoowO3T5WO-55">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-57" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Self executing character of this specific constitutional provision&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;First English Evangelical Lutheran Church of Glendale v. Los Angeles County&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;We have recognized that a landowner is entitled to bring an action in inverse condemnation as a result of “ ‘the self-executing character of the constitutional provision with respect to compensation....’&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;482 U.S. 304, 315, 107 S.Ct. 2378, 2386&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Facts:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A church operated a campground for disabled children that was destroyed by flooding.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The county then adopted an ordinance prohibiting rebuilding in the flood area.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The church alleged that the ordinance deprived it of all use of its property and sought compensation. California courts rejected&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="680" x="-3040" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-58" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the right to just compensation could not be taken away by statute&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;The form of the remedy did not qualify the right. It rested upon the Fifth Amendment. Statutory recognition was not necessary.&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Jacobs v. United States, 290 U.S. 13, 17, 54 S. Ct. 26, 28, 78 L. Ed. 142 (1933)&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-2250" y="1370" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-3" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-59" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-2" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-5" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-59" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-4" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2205" y="1380" />
              <mxPoint x="2775" y="1380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-10" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-59" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-9" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-59" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;measured by the defendant&#39;s wrongful gain&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Liu v. Sec. (2020)&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;Restitution&quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Charles Liu and Xin Wang raised nearly $27 million from foreign investors through the EB–5 immigration investment program&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;SEC took that money&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;It held that equitable disgorgement under the statute must generally be limited to the wrongdoer’s net profits, with legitimate expenses deducted&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="470" x="2025" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-60" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Section 1983’s existence does not categorically foreclose an independent restitution claim&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="2840" y="940" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-61" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;O’Donnell does not establish that police activity can never support unjust enrichment&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="3070" y="750" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-62" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Restitution must correspond to enrichment, with no duplicate recovery&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="3110" y="340" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-63" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-65" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-66" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-64" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-65" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-67" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2003.9473684210534" y="700.0000000000005" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-65" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;that local government can owe restitution for benefits obtained without authority&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;In Ward v. Board of Love County, Okl.&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- The Choctaw tribe being unlawfully taxed&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- Supreme Court ruled that the Choctaw tribe was due restitution as the county was unjustly enriched, when they should not have been.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;even without statutory authority authorizing repayment&lt;i&gt;.&quot;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="610" x="1950" y="560" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-0" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-66" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-66" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Governmental bodies have an obligation to do justice&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;&amp;nbsp;Ward v. Board of Love County, Okl. 24&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Justice VAN DEVANTER&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the obligation to do justice rests upon all persons, natural and artificial .. &quot;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="1730" y="820" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-1" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-67" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-59">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-67" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;The obligation can exist without an express repayment statute&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&amp;nbsp;&lt;i&gt;Ward v. Board of Love County, Okl. 24&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;...if a county obtains the money or property of others without authority, the law, independent of any statute, will compel restitution or compensation.’&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Statue is not needed, the common law supplements this right independently&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="2240" y="820" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-3" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="7UmE-EegbWgFKarbt5wQ-0" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-0" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Elements&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell v. Department of Social Services&lt;/i&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Monell Liability:&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a) An underlying violation of a federal right. - &lt;b&gt;showed in takings&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b) &lt;/span&gt;A municipal policy or custom- main argument about the ruling &lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(c) Causation - causation tied in &lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="100" y="840" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-2" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-15" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-23" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="635" as="sourcePoint" />
            <mxPoint x="435" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-23" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Municipality is a suable “person”&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell, 436 U.S. at 690&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Municipalities are persons subject to suit under § 1983.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="360" x="310" y="683" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-7" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="7UmE-EegbWgFKarbt5wQ-5" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-35">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-11" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="7UmE-EegbWgFKarbt5wQ-5" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-10" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-5" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Single official decision can establish policy&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Here,&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- city council voted and notified the nyuens that their claim had been denied. We argue this constitutes a policy under Pembaur.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;if a single statement from a prosecutor constitutes policy then the ruling of a city council certainly meets this threshold.&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="480" x="-80" y="1580" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-25" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="7UmE-EegbWgFKarbt5wQ-9" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-9" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Town&#39;s and County&#39;s denial of responsibility for compensating the plaintiffs&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Slaybaugh v. Rutherford Cnty., Tennessee,&lt;/i&gt; &amp;nbsp;698-699&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;In Slaybaugh, the district court held that official post-damage denials of compensation adequately alleged municipal policies causing the claimed constitutional injury.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;complete destruction to a home while arresting their son.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;signed by Captain Kyle Evans, Staff Attorney, and states that the “RCS[D] denies responsibility for any damage to your home.”&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;In short, the Complaint adequately alleges that the plaintiffs&#39; injury was directly caused by policies attributable to the Town and the County.&quot;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the decision was apparently made by an “official[ ] with final decision-making authority&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="650" x="-630" y="2050" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-18" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="7UmE-EegbWgFKarbt5wQ-10" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-10" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Timing&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Knick v. Township of Scott&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The obligation arises at the taking and remains payable afterward.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;A later payment of compensation may remedy the constitutional violation that occurred at the time of the taking&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="480" x="-340" y="1818" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-19" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation should be self executing because...&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;First English&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;no subsequent action by the government can relieve it of the duty to provide compensation&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="-610" y="2860" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-26" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="7UmE-EegbWgFKarbt5wQ-22" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-22" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Direct causation&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;As our takings argument will establish,&amp;nbsp;the Nguyens were constitutionally entitled to just compensation.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Under Bryan County, when the municipal decision itself violates the federal right, proving that violation also establishes municipal causation&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;we contend that the Council’s denial satisfies that rule.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="168" width="460" x="290" y="2110" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-24" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Lack of a later payment&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Under &lt;i&gt;Pembaur&lt;/i&gt;, the Council’s affirmative denial constitutes municipal policy. We contend that this denial itself deprived the Nguyens of constitutionally owed compensation and therefore satisfies &lt;i&gt;Bryan County’s&lt;/i&gt; causation requirement, warranting reversal and remand.&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="580" x="-210" y="2500" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-7" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="cCM4lZB7ySH9hDjqr1Nz-2" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-6" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-2" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;restitution damages for benefit of use of another land&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Jacque v. Steenberg Homes&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Facts:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Steenberg repeatedly asked permission to deliver a mobile home across the Jacques’ snow-covered field. They refused, but the company plowed a path and crossed anyway&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="525" x="1500" y="1460" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-8" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="cCM4lZB7ySH9hDjqr1Nz-4" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-4" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Physical Damage&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Wegner v. Milwaukee Mutual Insurance Co., 479 N.W.2d 38, 42&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Minneapolis police department severely damaged a house owned by Harriet G. Wegner while attempting to apprehend an armed suspect. Including&amp;nbsp;tear gas and concussion grenades.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;We hold that where an innocent third party&#39;s property is damaged by the police in the course of apprehending a suspect, *42 that property is damaged within the meaning of the constitution.&quot;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&quot;the citizens of the City should all bear the cost of the benefit conferred&quot;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="470" x="2540" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-12" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="cCM4lZB7ySH9hDjqr1Nz-6" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-6" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;Avoided damages Damages&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;“need not be a profit that was realized; it can be a cost that was avoided.”&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;A competitor obtained PPG’s confidential information about its Opticor technology through a former employee. It used that information to advance its own development efforts, bypassing work it otherwise would have needed to perform.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Although there was no evidence that the competitor sold products incorporating the technology, the Third Circuit upheld an unjust-enrichment award based on research-and-development costs the competitor avoided.&lt;/p&gt;" vertex="1">
          <mxGeometry height="190" width="670" x="1900" y="1930" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-13" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="cCM4lZB7ySH9hDjqr1Nz-9" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;defaultLabelBackgroundColor=gap;" target="cCM4lZB7ySH9hDjqr1Nz-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-9" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Economic Damage&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Armstrong v. United States, 364 U.S. 40 (1960)&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;value of private liens&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;the government exercised its contractual right to take title to the unfinished boats and remaining materials. The suppliers could no longer enforce their liens because the government and its property were protected by sovereign immunity&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;“the Government, for its own advantage, destroyed the value of the liens”&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Court remanded to determine the value of the property interests taken&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="470" x="2040" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="cCM4lZB7ySH9hDjqr1Nz-11" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;b&gt;Bring it&amp;nbsp;home&amp;nbsp;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(1) We seek restitution for unauthorized use of the Nguyens’ property, under &lt;i&gt;WARD &lt;/i&gt;as a recognized obligation against government bodies.&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;Under, &lt;i&gt;Liu&lt;/i&gt; We seek the proven value of the City’s unauthorized use or actual cost savings, not automatic reimbursement of the $112,678 repair bill.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;(2) Benefit:&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(a) Mission City obtained access to and use of the Nguyens’ home without consent or payment,&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;under &lt;/span&gt;&lt;i style=&quot;white-space: pre;&quot;&gt;Jacque&lt;/i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; this type of use of another land without permission is a classic example where restitution is appropriate and considered a benefit to the user. &lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(b) The City’s operation deprived the Nguyens of their home’s use during nearly 90 days of repairs &lt;/span&gt;&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Armstrong&lt;/i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; demonstrates that destruction of a property interest can be a benefit for government&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;i style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/i&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;(c) The operation caused $112,678 in repair costs. Like the homeowner in Wegner, the Nguyens bore the expense of a police operation undertaken&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;for public purposes.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;The Court should reverse and remand because the City’s alleged unauthorized use of the Nguyens’ home warrants consideration of an independent&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;restitution claim.&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="320" width="940" x="1800" y="2200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
