          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-7" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-8" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-47" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-8" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Takings/ Just compensation&amp;nbsp;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- establish there is a substantive right to compensation.&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;Established by:&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Knick &amp;amp; 5th — (1)&amp;nbsp;Timing: The right arises immediately upon an uncompensated taking. Id. at 192.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(2) T&lt;/span&gt;he compensation right rests on the Fifth Amendment. Id. at 190–91.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;(3) &lt;/span&gt;Ending the taking does not erase compensation owed for its duration. Id. at 192–93.&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&quot;The Framers meant to prohibit the Federal Government from taking property without paying for it.&quot; 2019 Justice Roberts&lt;/span&gt; &lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="720" x="-1580" y="410" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-9" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-15" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;" target="k8BEP7BhALAoowO3T5WO-21" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="7UmE-EegbWgFKarbt5wQ-1" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-23" style="edgeStyle=orthogonalEdgeStyle;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="7UmE-EegbWgFKarbt5wQ-0" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-15" parent="k8BEP7BhALAoowO3T5WO-1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Mission City’s own decision to deny constitutionally required compensation supports liability under §1983&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Knick v. Township of Scott&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&amp;nbsp;“may bring his claim in federal court under §1983 at that time”—when the government takes property without just compensation&quot;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="155" width="560" x="170" y="480" as="geometry" />
        </mxCell>
        <mxCell id="k8BEP7BhALAoowO3T5WO-17" edge="1" parent="k8BEP7BhALAoowO3T5WO-1" source="k8BEP7BhALAoowO3T5WO-21" style="edgeStyle=none;curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=gap;" target="k8BEP7BhALAoowO3T5WO-60" value="">
