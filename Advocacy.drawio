        <mxCell id="t4PtQhD98tMtrIm2gATw-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Unjust enrichment&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;- The Nguyen&#39;s right to bring an unjust enrichment claim is not blocked by&amp;nbsp;Mission City’s governmental status&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="2230" y="280" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;§ 1983 enforces the compensation right&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Knick, 588 U.S. at 185&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;An owner may bring an uncompensated-taking claim in federal court under § 1983.&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="110" width="350" x="-200" y="960" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-10" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=13;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Municipality is a suable “person”&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Monell, 436 U.S. at 690&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Municipalities are persons subject to suit under § 1983.&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="450" x="-25" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="t4PtQhD98tMtrIm2gATw-13" edge="1" parent="1" source="t4PtQhD98tMtrIm2gATw-12" style="curved=1;rounded=0;curveGeometry=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
