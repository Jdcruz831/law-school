        <mxCell id="XDFivQQymPn6_W2-JGWK-3" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XuRoIDHrA27UM8weoBv-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;-&amp;nbsp;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="430" x="450" y="-90" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-39" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-38" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-41" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-40" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XuRoIDHrA27UM8weoBv-2" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Fourth Amendment &amp;amp; Individual § 1983 Liability (Count I)&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;The Claim: Captain Quick’s mistaken entry into the Nguyens&#39; home to&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;execute an arrest warrant for a third party (Jacob Patterson) violated the&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;Fourth Amendment, and his mistake was not objectively reasonable [JA 2, 25].&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt; The Defense: Captain Quick is shielded by Qualified Immunity because&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;his mistake was an objectively reasonable mistake of fact, and the right&amp;nbsp;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;was not &quot;clearly established&quot; with specificity in November 2024 [JA 8, 25, 32].&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="430" x="-880" y="130" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-43" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-6" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-42" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-45" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-6" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-44" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XuRoIDHrA27UM8weoBv-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Fifth Amendment Inverse Condemnation&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Claim: The SWAT team&#39;s physical destruction of the Nguyens&#39; home ($112,678 in damages) to execute a warrant was a public &quot;taking&quot; of private property for public use, requiring &quot;just compensation&quot; under the Fifth Amendment [JA 3]. The Defense: Tactical law enforcement damage is a non-compensable exercise of the state&#39;s emergency Police Power (or necessity), which operates as an exception to the Takings Clause [JA 9, 26, 32].&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="430" x="100" y="240" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-47" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-8" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-46" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-49" edge="1" parent="1" source="0XuRoIDHrA27UM8weoBv-8" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-48" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0XuRoIDHrA27UM8weoBv-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Municipal Liability &amp;amp; Section 1983 Policy/Custom&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;The Claim: Mission City is liable under § 1983 because its City Council—the final policymaking body—voted to deny the Nguyens just compensation, thereby officially executing the municipal policy that completed the Fifth Amendment violation [JA 3–4, 28]. The Defense: There was no municipal policy to raid the wrong home, and the City cannot be held liable under a vicarious liability (respondeat superior) theory [JA 28, 32].&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="430" x="1010" y="230" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-51" edge="1" parent="1" source="XDFivQQymPn6_W2-JGWK-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-50" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-53" edge="1" parent="1" source="XDFivQQymPn6_W2-JGWK-1" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="XDFivQQymPn6_W2-JGWK-52" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Fourth Claim for Relief (Unjust Enrichment against Defendant Mission City)&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Fourth Claim for Relief (Unjust Enrichment against Defendant Mission City): A common-law equitable claim alleging that Mission City received a measurable benefit by entering and using the Nguyens&#39; home without their consent, which is unjust for the City to retain without restitution [JA 4, 29].&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="430" x="1890" y="220" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-4" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;honest mistake&quot; doctrine&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Maryland v. Garrison (1987)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;While the purposes justifying a police search strictly limit the permissible extent of the search, the Court has also recognized the need to allow some latitude for honest mistakes that are made by officers in the dangerous and difficult process of making arrests and executing search warrants.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Maryland v. Garrison, 480 U.S. 79, 87, 107 S. Ct. 1013, 1018, 94 L. Ed. 2d 72 (1987)&lt;/p&gt;" vertex="1">
          <mxGeometry height="205" width="360" x="-1070" y="925" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-6" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&amp;nbsp;Qualified Immunity two prongs aren&#39;t mandatory&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Pearson v. Callahan&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;First, a court must **816 decide whether the facts that a plaintiff has alleged (see Fed. Rules Civ. Proc. 12(b)(6), (c)) or shown (see Rules 50, 56) make out a violation of a constitutional right. 533 U.S., at 201, 121 S.Ct. 2151. Second, if the plaintiff has satisfied this first step, the court must decide whether the right at issue was “clearly established” at the time of defendant&#39;s alleged misconduct. Ibid. Qualified immunity is applicable unless the official&#39;s conduct violated a clearly established constitutional right.&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Pearson v. Callahan, 555 U.S. 223, 232, 129 S. Ct. 808, 815–16, 172 L. Ed. 2d 565 (2009)&lt;/p&gt;" vertex="1">
          <mxGeometry height="230" width="390" x="-1000" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-8" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&amp;nbsp;Qualified immunity is denied when a warrant is so facially deficient&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Groh v. Ramirez, 540 U.S. 551 (2004&lt;/i&gt;&lt;/span&gt;&lt;i&gt;)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;“a warrant may be so facially deficient—i.e., in failing to particularize the place to be searched or the things to be seized—that the executing officers cannot reasonably presume it to be valid.”&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;540 U.S. 551, 565, 124 S.Ct. 1284, 1294&lt;/p&gt;" vertex="1">
          <mxGeometry height="170" width="330" x="-540" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-11" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&amp;nbsp;Prior case with duplicate facts&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;Hope v. Pelzer (2002&lt;/i&gt;&lt;/span&gt;&lt;i&gt;)&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="60" width="250" x="-1650" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-14" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&quot;totality of the circumstances&quot;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;District of Columbia v. Wesby (2018)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="270" x="-970" y="1238" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-16" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Right of action for inverse condemnation&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Knick v. Township of Scott (2019)&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="300" x="160" y="750" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-18" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;per se physical taking&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Cedar Point Nursery v. Hassid (2021)&amp;nbsp;&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="330" x="-240" y="935" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-20" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;Pursue Fifth Amendment remedies&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Devillier v. Texas (2024&lt;/i&gt;)&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="70" width="270" y="850" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;SWAT damage does not constitute a compensable taking under the Fifth Amendment.&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Baker v. City of McKinney (5th Cir. 2023)&amp;nbsp;&lt;br&gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="340" x="300" y="835" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-24" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;municipalities can be sued under § 1983, but only when the constitutional injury was caused by an official policy, custom, or practice.&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Monell v. Department of Social Services (1978)&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/i&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="100" width="320" x="1090" y="720" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-26" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Single decision by a municipal official&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;text-align: left;&quot;&gt;&lt;i&gt;&amp;nbsp;&lt;/i&gt;&lt;/span&gt;&amp;nbsp;&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Pembaur v. City of Cincinnati (1986)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="80" width="280" x="800" y="790" as="geometry" />
        </mxCell>
        <mxCell id="XDFivQQymPn6_W2-JGWK-28" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;span style=&quot;text-align: left;&quot;&gt;Municipalities do not possess qualified immunity&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;text-align: center; margin: 4px 0px 0px; text-decoration-color: currentcolor;&quot;&gt;&lt;i&gt;Owen v. City of Independence (1980)&lt;/i&gt;&lt;br&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
